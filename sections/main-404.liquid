{% comment %}
  Meeeku 404 Page
  Clean, on-brand page shown when any URL cannot be resolved by Shopify.
  Product pages are handled by templates/product.json → sections/main-product.liquid.
{% endcomment %}

<div class="page-width" style="
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 6rem 2rem;
">

  <span class="meeeku-badge meeeku-badge--ethnic" style="
    font-size: 1.4rem;
    padding: 0.5rem 1.6rem;
    border-radius: 30px;
    margin-bottom: 1.5rem;
    display: inline-block;
  ">
    🌸 Page Not Found
  </span>

  <h1 style="
    color: #3D2355;
    font-size: 3.6rem;
    font-weight: 800;
    margin: 1rem 0 1.5rem;
    line-height: 1.2;
  ">
    Oops! We couldn't find that page
  </h1>

  <p style="
    color: #666;
    font-size: 1.6rem;
    max-width: 500px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  ">
    The page you're looking for might have been moved, renamed, or is currently being updated.
  </p>

  <div style="display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap;">
    <a href="/collections/all" style="
      display: inline-block;
      background: #FF6097;
      border: 2px solid #FF6097;
      color: #FFF;
      border-radius: 30px;
      padding: 1.2rem 3rem;
      font-size: 1.5rem;
      font-weight: 700;
      text-decoration: none;
      box-shadow: 0 6px 20px rgba(255, 96, 151, 0.3);
      transition: opacity 0.2s ease;
    " onmouseover="this.style.opacity='0.88'" onmouseout="this.style.opacity='1'">
      Explore Catalog ✨
    </a>
    <a href="/" style="
      display: inline-block;
      background: #FFF0F5;
      border: 2px solid #F8BBD0;
      color: #6B3FA0;
      border-radius: 30px;
      padding: 1.2rem 3rem;
      font-size: 1.5rem;
      font-weight: 700;
      text-decoration: none;
      transition: background 0.2s ease;
    " onmouseover="this.style.background='#F8BBD0'" onmouseout="this.style.background='#FFF0F5'">
      Back to Home 🏠
    </a>
  </div>

</div>

{% schema %}
{
  "name": "404 Page",
  "tag": "section",
  "class": "section",
  "settings": []
}
{% endschema %}
