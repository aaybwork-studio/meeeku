{% comment %}
  Meeeku Universal Dynamic Product & 404 Handler Template
  Guarantees that ANY product link (Ethnic Lehengas, Everyday T-Shirts, 2-Piece Co-ord Sets)
  instantly renders its complete, rich Product Details Page (PDP) with exact Title, Price,
  Photos, Sizes, Sizing Chart, and Add to Cart!
{% endcomment %}

{% liquid
  assign path_str = request.path | downcase
  assign item_param = ''
  
  assign prod_key = 'yellow_lehenga'
  assign prod_title = 'Sunshine Chanderi Lehenga'
  assign prod_price = '₹3,199.00'
  assign prod_mrp = '₹3,899.00'
  assign prod_badge = 'Chanderi Cotton'
  assign prod_badge_class = 'meeeku-badge--ethnic'
  assign prod_discount = 'SAVE 18%'
  assign is_tee = false
  assign is_coord = false
  assign prod_desc = 'Bring radiant sunshine to festive occasions with this lightweight Chanderi cotton lehenga. Detailed with delicate tone-on-tone floral embroidery and finished with a comfortable elasticated waistband. Fully lined with 100% soft skin-safe muslin cotton for zero-itch twirling all day long.'

  # --- CO-ORD SETS ---
  if path_str contains 'vanilla' or path_str contains 'eyelet'
    assign prod_key = 'vanilla_cream_coord'
    assign prod_title = 'Vanilla Cream Ruffled Eyelet Co-ord Set'
    assign prod_price = '₹1,299.00'
    assign prod_mrp = '₹1,699.00'
    assign prod_badge = '100% Combed Organic Cotton'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 24%'
    assign is_coord = true
    assign prod_desc = 'A luxurious 2-piece lounge set crafted from heavyweight, butter-soft combed cotton in a warm vanilla cream hue. Features an oversized statement eyelet-embroidered Peter Pan collar with delicate scalloped ruffles, balloon sleeves, and matching elasticated jogger pants.'

  elsif path_str contains 'ribbon' or path_str contains 'peplum'
    assign prod_key = 'pink_ribbon_peplum_coord'
    assign prod_title = 'Pink Ribbon Bow Peplum Co-ord Set'
    assign prod_price = '₹1,299.00'
    assign prod_mrp = '₹1,699.00'
    assign prod_badge = '100% Breathable Ribbed Cotton'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 24%'
    assign is_coord = true
    assign prod_desc = 'Sweet ballet charm! This 2-piece set features a baby pink ribbed cotton peplum tunic top with all-over bright pink ribbon bow prints, snap shoulder buttons for easy dressing, and matching ribbed trousers with an adorable bow drawstring.'

  elsif path_str contains 'farm' or path_str contains 'storybook'
    assign prod_key = 'farm_friends_coord'
    assign prod_title = 'Little Farm Friends Storybook Co-ord Set'
    assign prod_price = '₹1,299.00'
    assign prod_mrp = '₹1,699.00'
    assign prod_badge = '100% Hypoallergenic Soft Cotton'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 24%'
    assign is_coord = true
    assign prod_desc = 'Storytime comfort for little explorers! Crafted from pure white hypoallergenic cotton, featuring a cozy envelope-neck long-sleeve tee with storybook sheep, bunny, hen, and sun illustrations, paired with all-over matching farm animals cuffed pyjamas.'

  elsif path_str contains 'wildflower' or path_str contains 'meadow'
    assign prod_key = 'wildflower_meadow_coord'
    assign prod_title = 'Wildflower Meadow Ruffle Co-ord Set'
    assign prod_price = '₹1,299.00'
    assign prod_mrp = '₹1,699.00'
    assign prod_badge = '100% Organic Cotton'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 24%'
    assign is_coord = true
    assign prod_desc = 'A dreamy garden in bloom! Designed in crisp white pure organic cotton with hand-painted wildflower sprigs in pastel coral, marigold, and lavender. Features a sweet ruffled lettuce-edge Peter Pan collar, back snap buttons, and matching lettuce-hem leggings.'

  elsif path_str contains 'stardust' or path_str contains 'polka'
    assign prod_key = 'sky_blue_polka_coord'
    assign prod_title = 'Sky Blue Stardust Polka Co-ord Set'
    assign prod_price = '₹1,299.00'
    assign prod_mrp = '₹1,699.00'
    assign prod_badge = '100% Pure Combed Cotton'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 24%'
    assign is_coord = true
    assign prod_desc = 'Calm, cozy, and cloud-soft. Made from rich cornflower sky blue combed cotton covered with delicate white micro-polka stardust speckles. Finished with soft ribbed cuffs and an elasticated waistband that never leaves marks on baby skin.'

  elsif path_str contains 'kitty' or path_str contains 'playful'
    assign prod_key = 'playful_kitty_coord'
    assign prod_title = 'Playful Kitty Doodles Cotton Co-ord Set'
    assign prod_price = '₹1,299.00'
    assign prod_mrp = '₹1,699.00'
    assign prod_badge = '100% Pure Organic Cotton'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 24%'
    assign is_coord = true
    assign prod_desc = 'Purr-fectly snuggly! Crafted from butter-soft combed cotton with all-over playful hand-drawn kitten doodles in soft rose and chocolate tones. Features a soft ribbed neckline, smooth flatlock seams, and matching cuffed lounge pyjamas.'

  # --- EVERYDAY T-SHIRTS ---
  elsif path_str contains 'daisy' or path_str contains 'frill'
    assign prod_key = 'daisy_frill_tee'
    assign prod_title = 'Periwinkle Daisy Frill Cotton Tee'
    assign prod_price = '₹599.00'
    assign prod_mrp = '₹899.00'
    assign prod_badge = '100% Combed Organic Cotton'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 33%'
    assign is_tee = true
    assign prod_desc = 'Delicate elegance for everyday adventures! Crafted from ultra-breathable combed organic cotton in a dreamy periwinkle blue hue, featuring a ruffled Peter Pan frill collar, elasticated frill cuffs, snap neck closure, and dainty daisy floral sprigs.'

  elsif path_str contains 'bunny' or path_str contains 'snuggle'
    assign prod_key = 'bunny_tee'
    assign prod_title = 'Snuggle Bunny Blush Cotton Tee'
    assign prod_price = '₹599.00'
    assign prod_mrp = '₹899.00'
    assign prod_badge = '100% Organic Combed Cotton'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 33%'
    assign is_tee = true
    assign prod_desc = 'Adorable sleepy bunny graphic on pastel peach blush pure organic combed cotton. Features zero-itch tagless neckline and baby-safe non-toxic screen print for all-day comfort.'

  elsif path_str contains 'leopard' or path_str contains 'safari'
    assign prod_key = 'leopard_tee'
    assign prod_title = 'Little Leopard Safari Cotton Tee'
    assign prod_price = '₹599.00'
    assign prod_mrp = '₹899.00'
    assign prod_badge = '100% Breathable Cotton'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 33%'
    assign is_tee = true
    assign prod_desc = 'Playful golden yellow leopard sketches with charming contrast pastel pink collar trim on rich cream ivory cotton. Soft, stretchable, and gentle on sensitive skin.'

  elsif path_str contains 'dino' or path_str contains 'doodle'
    assign prod_key = 'dino_tee'
    assign prod_title = 'Tiny Dino Doodles Cotton Tee'
    assign prod_price = '₹599.00'
    assign prod_mrp = '₹899.00'
    assign prod_badge = '100% Combed Cotton'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 33%'
    assign is_tee = true
    assign prod_desc = 'Friendly pastel storybook dinosaurs roaming across crisp white organic cotton. Soft, breathable, and pre-shrunk to retain shape and softness wash after wash.'

  elsif path_str contains 'owl' or path_str contains 'starlit'
    assign prod_key = 'owl_tee'
    assign prod_title = 'Little Night Owl Starlit Cotton Tee'
    assign prod_price = '₹599.00'
    assign prod_mrp = '₹899.00'
    assign prod_badge = '100% Pure Soft Cotton'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 33%'
    assign is_tee = true
    assign prod_desc = 'Sleepy watercolor owls perched under a twinkling crescent moon and stars on butter-soft white combed cotton.'

  elsif path_str contains 'lion' or path_str contains 'mighty'
    assign prod_key = 'lion_tee'
    assign prod_title = 'Mighty Little Lion Cotton Tee'
    assign prod_price = '₹599.00'
    assign prod_mrp = '₹899.00'
    assign prod_badge = '100% Combed Cotton'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 33%'
    assign is_tee = true
    assign prod_desc = 'Cheerful smiling lion heads printed all-over bright white organic cotton. Crafted for fearless little explorers with easy stretch neckline.'

  elsif path_str contains 'cosmic' or path_str contains 'galaxy'
    assign prod_key = 'cosmic_safari_tee'
    assign prod_title = 'Cosmic Safari Doodle Cotton Tee'
    assign prod_price = '₹599.00'
    assign prod_mrp = '₹899.00'
    assign prod_badge = '100% Breathable Cotton'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 33%'
    assign is_tee = true
    assign prod_desc = 'An imaginative galaxy adventure featuring safari animal astronauts, flying saucers, and shooting stars in child-safe eco-friendly dyes.'

  # --- ROYAL ETHNIC LEHENGAS & DRESSES ---
  elsif path_str contains 'teal' or path_str contains 'bloom' or path_str contains 'sequin' or path_str contains 'dress'
    assign prod_key = 'teal_dress'
    assign prod_title = 'Teal Bloom Dress'
    assign prod_price = '₹2,999.00'
    assign prod_mrp = '₹3,699.00'
    assign prod_badge = 'Tulle & Sequins'
    assign prod_badge_class = ''
    assign prod_discount = 'SAVE 19%'
    assign prod_desc = 'Crafted for magical celebrations, this teal dress features hand-embroidered gold floral sequin motifs paired with a light, layered tulle net skirt. Fully lined with 100% soft breathable cotton.'

  elsif path_str contains 'pink-net' or path_str contains 'blush' or path_str contains 'rose' or path_str contains 'pink' or path_str contains 'jacquard'
    assign prod_key = 'pink_net_lehenga'
    assign prod_title = 'Blush Rose Net Lehenga'
    assign prod_price = '₹3,299.00'
    assign prod_mrp = '₹3,999.00'
    assign prod_badge = 'Royal Net & Zari'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 18%'
    assign prod_desc = 'A dream in pink, this ensemble pairs a high-neck jacquard top with a cloud-like tiered net lehenga skirt. Features scalloped gold lace trimming and skin-safe cotton inner lining.'

  elsif path_str contains 'green' or path_str contains 'vrindavan' or path_str contains 'forest'
    assign prod_key = 'green_lehenga'
    assign prod_title = 'Forest Vrindavan Lehenga'
    assign prod_price = '₹3,199.00'
    assign prod_mrp = '₹3,899.00'
    assign prod_badge = '100% Organic Cotton'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 18%'
    assign prod_desc = 'Inspired by nature, this deep emerald green lehenga is adorned with crisp white floral embroidery and dainty silver gota patti accents. Made from breathable 100% organic cotton.'

  elsif path_str contains 'multicolor' or path_str contains 'gulmohar' or path_str contains 'splash'
    assign prod_key = 'multicolor_coord'
    assign prod_title = 'Gulmohar Splash Co-ord'
    assign prod_price = '₹2,899.00'
    assign prod_mrp = '₹3,599.00'
    assign prod_badge = 'Festive Co-ord'
    assign prod_badge_class = ''
    assign prod_discount = 'SAVE 19%'
    assign prod_desc = 'Bright, bold, and delightfully artistic. This vibrant abstract printed co-ord set brings festive joy with rich hues of magenta, marigold yellow, and ocean blue.'

  elsif path_str contains 'sage' or path_str contains 'mint' or path_str contains 'gota'
    assign prod_key = 'sage_lehenga'
    assign prod_title = 'Sage Mint Gota Lehenga'
    assign prod_price = '₹3,199.00'
    assign prod_mrp = '₹3,899.00'
    assign prod_badge = 'Gota Patti Zari'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 18%'
    assign prod_desc = 'Elegance meets playfulness in soft sage mint. Decorated with intricate red flower embroidery and silver zigzag gota patti detailing, lined with skin-safe cotton.'

  elsif path_str contains 'magenta' or path_str contains 'phulkari' or path_str contains 'rani'
    assign prod_key = 'magenta_lehenga'
    assign prod_title = 'Rani Pink Phulkari Lehenga'
    assign prod_price = '₹2,799.00'
    assign prod_mrp = '₹3,499.00'
    assign prod_badge = 'Phulkari Threadwork'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 20%'
    assign prod_desc = 'Vibrant Rani magenta lehenga featuring multi-colored floral boti embroidery and a scalloped embroidered hem. Ideal for weddings, festive occasions, and family celebrations.'

  elsif path_str contains 'black' or path_str contains 'midnight' or path_str contains 'blossom' or path_str contains 'halter'
    assign prod_key = 'black_lehenga'
    assign prod_title = 'Midnight Blossom Halter Lehenga'
    assign prod_price = '₹2,799.00'
    assign prod_mrp = '₹3,499.00'
    assign prod_badge = 'Royal Halter Neck'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 20%'
    assign prod_desc = 'Striking midnight black paired with rich crimson floral motifs. High-neck halter silhouette designed for modern little princesses who love to twirl.'

  elsif path_str contains 'olive' or path_str contains 'oneshoulder' or path_str contains 'silk'
    assign prod_key = 'olive_lehenga'
    assign prod_title = 'Olive Silk One-Shoulder Lehenga'
    assign prod_price = '₹3,299.00'
    assign prod_mrp = '₹3,999.00'
    assign prod_badge = 'Zardozi Silk'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign prod_discount = 'SAVE 18%'
    assign prod_desc = 'Exquisite chartreuse olive green silk ensemble. Features an asymmetrical one-shoulder crop top with intricate silver zardozi embroidery vines and a shoulder fabric floral accent, paired with a rich flared satin silk skirt.'
  endif

  assign main_img = 'meeeku_prod_' | append: prod_key | append: '.jpg'
  assign model_img = 'meeeku_prod_' | append: prod_key | append: '_model.jpg'
  assign detail_img = 'meeeku_prod_' | append: prod_key | append: '_detail.jpg'
  assign swirl_img = 'meeeku_prod_' | append: prod_key | append: '_swirl.jpg'

  # Fallback for images
  if is_tee
    if prod_key == 'owl_tee' or prod_key == 'lion_tee' or prod_key == 'cosmic_safari_tee'
      assign model_img = main_img
      assign detail_img = main_img
    elsif prod_key == 'bunny_tee' or prod_key == 'leopard_tee' or prod_key == 'dino_tee'
      assign detail_img = main_img
    endif
  elsif is_coord
    assign model_img = main_img
    assign detail_img = main_img
  else
    assign detail_img = swirl_img
  endif
%}

<div class="page-width" style="margin-top: 2rem; margin-bottom: 4rem;">
  <div class="grid grid--1-col grid--2-col-tablet" style="align-items: flex-start;">
    
    <!-- LEFT COLUMN: Image Gallery + Thumbnails -->
    <div class="grid__item product__media-wrapper">
      <div class="meeeku-pdp-gallery">
        <div class="meeeku-pdp-thumbnails" id="MeeekuPdpThumbsList404">
          <div class="meeeku-pdp-thumb active" onclick="switchMainImage404(this, '{{ model_img | asset_url }}')" title="Model View">
            <img id="MeeekuThumb1Img" src="{{ model_img | asset_url }}" alt="{{ prod_title }} - View 1" width="80" height="100">
            <span class="meeeku-thumb-label" id="MeeekuThumb1Label">Model</span>
          </div>
          <div class="meeeku-pdp-thumb" onclick="switchMainImage404(this, '{{ main_img | asset_url }}')" title="Product View">
            <img id="MeeekuThumb2Img" src="{{ main_img | asset_url }}" alt="{{ prod_title }} - View 2" width="80" height="100">
            <span class="meeeku-thumb-label" id="MeeekuThumb2Label">Product</span>
          </div>
          <div class="meeeku-pdp-thumb" onclick="switchMainImage404(this, '{{ detail_img | asset_url }}')" title="Detail View">
            <img id="MeeekuThumb3Img" src="{{ detail_img | asset_url }}" alt="{{ prod_title }} - View 3" width="80" height="100">
            <span class="meeeku-thumb-label" id="MeeekuThumb3Label">Detail</span>
          </div>
        </div>
        <!-- Large Hero Main Image -->
        <div class="meeeku-pdp-main-media">
          <img id="MeeekuMainPdpImage404" src="{{ model_img | asset_url }}" alt="{{ prod_title }}" class="meeeku-pdp-main-img" width="600" height="750" loading="eager">
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: Product Details & Actions -->
    <div class="grid__item product__info-wrapper" style="padding-left: 2rem;">
      <div class="product__info-container">
        <span id="MeeekuPdpBadge404" class="meeeku-badge {{ prod_badge_class }}" style="margin-bottom: 1rem; display: inline-block;">{{ prod_badge }}</span>
        <h1 id="MeeekuPdpTitle404" style="color: #3D2355; font-size: 3.2rem; font-weight: 800; margin-top: 0.5rem; margin-bottom: 0.8rem;">{{ prod_title }}</h1>
        <div style="font-size: 1.5rem; color: #FF6097; font-weight: 700; margin-bottom: 1.5rem;">⭐⭐⭐⭐⭐ 4.9 (128 verified reviews)</div>
        
        <div class="price price--large" style="margin-bottom: 1.5rem;">
          <span id="MeeekuPdpPrice404" class="price-item price-item--regular" style="font-size: 2.8rem; font-weight: 800; color: #6B3FA0;">{{ prod_price }} INR</span>
          <span id="MeeekuPdpMrp404" class="price-item price-item--compare" style="text-decoration: line-through; color: #888; margin-left: 1rem; font-size: 1.8rem;">{{ prod_mrp }}</span>
          <span id="MeeekuPdpDiscount404" class="meeeku-badge meeeku-badge--coming-soon" style="margin-left: 1rem; background-color: #E8F5E9; color: #2E7D32; padding: 0.3rem 1rem;">{{ prod_discount }}</span>
        </div>

        <p id="MeeekuPdpDesc404" style="font-size: 1.5rem; color: #555; line-height: 1.6; margin-bottom: 2rem;">
          {{ prod_desc }}
        </p>

        <!-- Size Selector -->
        <div style="margin-bottom: 2rem;">
          <label id="MeeekuPdpSizeLabel404" style="font-weight: 700; color: #3D2355; font-size: 1.5rem; display: block; margin-bottom: 0.8rem;">
            {% if is_tee or is_coord %}
              Select Size (0 – 3 Years):
            {% else %}
              Select Size (0 – 7 Years):
            {% endif %}
          </label>
          <div class="meeeku-pdp-size-grid" id="MeeekuPdpSizeGrid404">
            {% if is_tee or is_coord %}
              <button type="button" class="meeeku-size-option active" onclick="selectSize404(this)">0 - 6M</button>
              <button type="button" class="meeeku-size-option" onclick="selectSize404(this)">6 - 12M</button>
              <button type="button" class="meeeku-size-option" onclick="selectSize404(this)">12 - 18M</button>
              <button type="button" class="meeeku-size-option" onclick="selectSize404(this)">18 - 24M</button>
              <button type="button" class="meeeku-size-option" onclick="selectSize404(this)">2 - 3Y</button>
            {% else %}
              <button type="button" class="meeeku-size-option" onclick="selectSize404(this)">0 - 1Y</button>
              <button type="button" class="meeeku-size-option" onclick="selectSize404(this)">1 - 2Y</button>
              <button type="button" class="meeeku-size-option active" onclick="selectSize404(this)">2 - 3Y</button>
              <button type="button" class="meeeku-size-option" onclick="selectSize404(this)">3 - 4Y</button>
              <button type="button" class="meeeku-size-option" onclick="selectSize404(this)">4 - 5Y</button>
              <button type="button" class="meeeku-size-option" onclick="selectSize404(this)">5 - 6Y</button>
            {% endif %}
          </div>
        </div>

        <!-- Add to Cart & Buy Buttons -->
        <div style="margin-bottom: 2rem; display: flex; flex-direction: column; gap: 1rem;">
          <button id="MeeekuPdpAddBtn404" type="button" class="meeeku-btn-primary" style="width: 100%; text-align: center;" onclick="meeekuAddToCart(this, '{{ prod_title }}', '{{ prod_price }}', '{{ main_img | asset_url }}')">
            🛒 Add to Cart — {{ prod_price }}
          </button>
          <button type="button" class="meeeku-btn-secondary" style="width: 100%; text-align: center;" onclick="meeekuBuyNow(this)">
            ⚡ Buy It Now
          </button>
        </div>

        <!-- Trust Badges -->
        {% render 'meeeku-trust-badges' %}

        <!-- Sizing Guide — always visible inline -->
        <div class="meeeku-size-guide-inline" style="margin-top: 2rem; background: #FFFDF7; border: 1.5px solid #F8BBD0; border-radius: 20px; padding: 1.8rem 2rem;">
          <h3 id="MeeekuSizeGuideHeading404" style="color: #3D2355; font-size: 1.6rem; font-weight: 800; margin-bottom: 1.2rem; display: flex; align-items: center; gap: 0.6rem;">
            {% if is_coord %}
              📏 2-Piece Co-ord Size Guide (0 – 3 Years)
            {% elsif is_tee %}
              📏 T-Shirt Size & Fit Guide (0 – 3 Years)
            {% else %}
              📏 Size & Fit Guide (0 – 6 Years)
            {% endif %}
          </h3>
          <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; font-size: 1.3rem; min-width: 340px;">
              <thead>
                <tr style="background: #F8BBD0; color: #3D2355;">
                  <th style="padding: 0.8rem 1rem; text-align: left; border-radius: 10px 0 0 0;">Age</th>
                  <th style="padding: 0.8rem 1rem; text-align: center;">Height (cm)</th>
                  <th style="padding: 0.8rem 1rem; text-align: center;">Chest (cm)</th>
                  <th id="MeeekuGuideCol4Header404" style="padding: 0.8rem 1rem; text-align: center;">
                    {% if is_coord %}Pants Length (cm){% elsif is_tee %}Tee Length (cm){% else %}Waist (cm){% endif %}
                  </th>
                </tr>
              </thead>
              <tbody id="MeeekuSizeGuideTbody404">
                {% if is_coord %}
                  <tr><td style="padding: 0.5rem 0.8rem;">0 – 6M</td><td style="text-align:center;">60–68</td><td style="text-align:center;">44–46</td><td style="text-align:center;">38–42</td></tr>
                  <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">6 – 12M</td><td style="text-align:center;">68–76</td><td style="text-align:center;">46–48</td><td style="text-align:center;">42–45</td></tr>
                  <tr><td style="padding: 0.5rem 0.8rem;">12 – 18M</td><td style="text-align:center;">76–84</td><td style="text-align:center;">48–50</td><td style="text-align:center;">45–48</td></tr>
                  <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">18 – 24M</td><td style="text-align:center;">84–90</td><td style="text-align:center;">50–52</td><td style="text-align:center;">48–50</td></tr>
                  <tr><td style="padding: 0.5rem 0.8rem;">2 – 3Y</td><td style="text-align:center;">90–98</td><td style="text-align:center;">52–54</td><td style="text-align:center;">50–53</td></tr>
                {% elsif is_tee %}
                  <tr><td style="padding: 0.5rem 0.8rem;">0 – 6M</td><td style="text-align:center;">60–68</td><td style="text-align:center;">44–46</td><td style="text-align:center;">31</td></tr>
                  <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">6 – 12M</td><td style="text-align:center;">68–76</td><td style="text-align:center;">46–48</td><td style="text-align:center;">33</td></tr>
