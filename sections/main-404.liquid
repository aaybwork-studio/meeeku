          <div class="meeeku-pdp-thumbs-list" id="MeeekuFallbackThumbsList">
            <!-- Dynamically populated by JS -->
          </div>
          <div class="meeeku-pdp-hero-image">
            <img id="MeeekuFallbackHeroImg" 
                 src="{{ 'meeeku_prod_daisy_frill_tee.jpg' | asset_url }}" 
                 alt="Meeeku Luxury Kids Wear" 
                 width="600" 
                 height="750" 
                 loading="eager"
                 style="border-radius: 24px; width: 100%; object-fit: cover; border: 2px solid #F8BBD0; box-shadow: 0 12px 36px rgba(107, 63, 160, 0.08);">
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Product Info & Form -->
      <div class="meeeku-pdp-info-col">
        <span class="meeeku-badge meeeku-badge--tee" id="MeeekuFallbackBadge" style="display: inline-block; margin-bottom: 0.8rem;">100% Combed Organic Cotton</span>
        <h1 class="meeeku-pdp-title" id="MeeekuFallbackTitle">Periwinkle Daisy Frill Cotton Tee</h1>

        <div style="display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1.2rem;">
          <span style="color: #FFB300; font-size: 1.5rem;">⭐⭐⭐⭐⭐</span>
          <span style="font-weight: 700; color: #FF6097; font-size: 1.35rem;">4.9 (128 verified reviews)</span>
        </div>

        <div style="margin-bottom: 1.5rem; display: flex; align-items: baseline; gap: 1rem;">
          <span class="meeeku-pdp-price" id="MeeekuFallbackPrice">₹599.00</span>
          <span style="font-size: 1.6rem; color: #888; text-decoration: line-through;" id="MeeekuFallbackMrp">₹899.00</span>
          <span class="meeeku-badge" id="MeeekuFallbackDiscount" style="background: #E8F5E9; color: #2E7D32; font-size: 1.1rem; padding: 0.2rem 0.8rem;">SAVE 33%</span>
        </div>

        <div id="MeeekuFallbackDesc" style="color: #555; font-size: 1.45rem; line-height: 1.6; margin-bottom: 1.8rem;">
          Delightfully charming for sunny day adventures! Crafted from 100% skin-safe, super-soft combed cotton in a soothing periwinkle blue shade. Features delicate daisy flower prints and a sweet frilled ruffle neckline.
        </div>

        <!-- Size Selector -->
        <div style="margin-bottom: 1.8rem;">
          <label id="MeeekuFallbackSizeLabel" style="font-weight: 700; color: #3D2355; font-size: 1.45rem; display: block; margin-bottom: 0.8rem;">
            Select Size:
          </label>
          <div class="meeeku-pdp-size-grid" id="MeeekuFallbackSizeGrid">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- Add to Cart & Buy It Now CTAs -->
        <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
          <button type="button" class="meeeku-btn-primary" id="MeeekuFallbackAddCartBtn" style="width: 100%; text-align: center; font-size: 1.5rem; padding: 1.2rem; cursor: pointer;" onclick="meeekuFallbackAddToCart()">
            🛒 Add to Cart — <span id="MeeekuFallbackBtnPrice">₹599.00</span>
          </button>
          <button type="button" class="meeeku-btn-secondary" style="width: 100%; text-align: center; font-size: 1.5rem; padding: 1.2rem; cursor: pointer;" onclick="meeekuFallbackBuyNow()">
            ⚡ Buy It Now
          </button>
        </div>

        <!-- Trust Badges -->
        {% render 'meeeku-trust-badges' %}

        <!-- Collapsible Accordion Tabs -->
        <div class="meeeku-accordion" style="margin-top: 2.5rem; border-top: 1px solid #F8BBD0;">
          <details class="meeeku-accordion-item" open>
            <summary style="font-weight: 700; font-size: 1.5rem; color: #3D2355; padding: 1.2rem 0; cursor: pointer; display: flex; justify-content: space-between;">
              <span>📏 Size Guide & Measurements</span>
              <span>+</span>
            </summary>
            <div id="MeeekuFallbackSizeGuide" style="padding-bottom: 1.5rem;">
              <!-- Sizing table -->
            </div>
          </details>

          <details class="meeeku-accordion-item">
            <summary style="font-weight: 700; font-size: 1.5rem; color: #3D2355; padding: 1.2rem 0; cursor: pointer; display: flex; justify-content: space-between;">
              <span>🚚 Shipping & Easy Returns</span>
              <span>+</span>
            </summary>
            <div style="padding-bottom: 1.5rem; color: #666; font-size: 1.35rem; line-height: 1.6;">
              <p>• <strong>Free Express Shipping</strong> across India on all prepaid orders.</p>
              <p>• Dispatched within 24–48 hours from our Mumbai studio.</p>
              <p>• 7-day hassle-free size exchange policy. Zero questions asked!</p>
            </div>
          </details>
        </div>

      </div>
    </div>
