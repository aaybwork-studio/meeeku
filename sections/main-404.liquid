      { key: 'vanilla_cream_coord', title: 'Vanilla Cream Eyelet Co-ord',    price: '₹1,299', img: 'meeeku_prod_vanilla_cream_coord.jpg',      handle: 'vanilla-cream-ruffled-eyelet-coord-set' },
      { key: 'pink_ribbon_peplum_coord', title: 'Pink Ribbon Peplum Co-ord', price: '₹1,299', img: 'meeeku_prod_pink_ribbon_peplum_coord.jpg', handle: 'pink-ribbon-bow-peplum-coord-set' },
      { key: 'yellow_lehenga',    title: 'Sunshine Chanderi Lehenga',        price: '₹3,299', img: 'meeeku_prod_yellow_lehenga.jpg',           handle: 'sunshine-chanderi-lehenga' },
      { key: 'pink_net_lehenga',  title: 'Blush Rose Net Lehenga',           price: '₹3,299', img: 'meeeku_prod_pink_net_lehenga.jpg',         handle: 'blush-rose-net-lehenga' },
      { key: 'green_lehenga',     title: 'Vrindavan Garden Lehenga',         price: '₹3,499', img: 'meeeku_prod_green_lehenga.jpg',            handle: 'vrindavan-garden-lehenga' },
      { key: 'magenta_lehenga',   title: 'Rani Phulkari Lehenga',            price: '₹3,499', img: 'meeeku_prod_magenta_lehenga.jpg',          handle: 'rani-phulkari-magenta-lehenga' },
      { key: 'teal_dress',        title: 'Teal Bloom Dress',                 price: '₹2,499', img: 'meeeku_prod_teal_dress.jpg',              handle: 'teal-bloom-dress' },
    ];

    var assetBaseUrl = "{{ 'meeeku_prod_daisy_frill_tee.jpg' | asset_url }}".replace("meeeku_prod_daisy_frill_tee.jpg", "").split("?")[0];

    /* Filter out current product and pick 4 */
    var recs = ALL_RECS.filter(function(p) {
      return path.indexOf(p.handle) === -1 && path.indexOf(p.key.replace(/_/g, '-')) === -1;
    }).slice(0, 4);

    /* Fallback: just take first 4 if filter returns fewer */
    if (recs.length < 4) {
      recs = ALL_RECS.filter(function(p, idx) { return idx < 4; });
    }

    var grid = document.getElementById('MeeekuRecommendedGrid');
    if (!grid) return;

    recs.forEach(function(prod) {
      var card = document.createElement('a');
      card.href = '/products/' + prod.handle;
      card.style.cssText = [
        'display: block',
        'background: #FFFDF7',
        'border: 1.5px solid #F8BBD0',
        'border-radius: 20px',
        'overflow: hidden',
        'text-decoration: none',
        'cursor: pointer',
        'transition: box-shadow 0.2s ease, transform 0.2s ease',
      ].join(';');

      card.addEventListener('mouseover', function() {
        card.style.boxShadow = '0 10px 32px rgba(107,63,160,0.14)';
        card.style.transform = 'translateY(-4px)';
      });
      card.addEventListener('mouseout', function() {
        card.style.boxShadow = 'none';
        card.style.transform = 'translateY(0)';
      });

      var img = document.createElement('img');
      img.src = assetBaseUrl + prod.img;
      img.alt = prod.title;
      img.loading = 'lazy';
      img.style.cssText = 'width:100%; aspect-ratio:4/5; object-fit:cover; object-position:top center; display:block;';

      var info = document.createElement('div');
      info.style.cssText = 'padding: 1rem 1.2rem 1.4rem;';
      info.innerHTML = [
        '<div style="font-size:1.3rem; font-weight:700; color:#3D2355; line-height:1.3; margin-bottom:0.4rem;">' + prod.title + '</div>',
        '<div style="font-size:1.25rem; color:#6B3FA0; font-weight:800;">' + prod.price + '</div>',
      ].join('');

      card.appendChild(img);
      card.appendChild(info);
      grid.appendChild(card);
    });
  })();
  </script>

</div><!-- end MeeekuProductFallbackWrapper -->

<!-- Standard Clean 404 Page (shown by JS if URL is NOT /products/) -->
<div id="MeeekuStandard404Wrapper" style="display: none;">
  <div class="template-404 page-width page-margin center" style="padding: 6rem 2rem; text-align: center;">
    <span class="meeeku-badge meeeku-badge--ethnic" style="font-size: 1.4rem; padding: 0.5rem 1.6rem; border-radius: 30px; margin-bottom: 1.5rem; display: inline-block;">
      🌸 Page Not Found
    </span>
    <h1 class="title" style="color: #3D2355; font-size: 3.6rem; font-weight: 800; margin: 1rem 0 1.5rem;">
      Oops! We couldn't find that page
    </h1>
    <p style="color: #666; font-size: 1.6rem; max-width: 500px; margin: 0 auto 2.5rem; line-height: 1.6;">
      The page you are looking for might have been moved or is currently being updated.
    </p>
    <div style="display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap;">
      <a href="/collections/all" class="button button--primary meeeku-btn-pill" style="padding: 1.2rem 3rem; font-size: 1.5rem; background: #FF6097; border-color: #FF6097; color: #FFF; text-decoration: none; border-radius: 30px; font-weight: 700; box-shadow: 0 6px 20px rgba(255, 96, 151, 0.3);">
        Explore Catalog ✨
      </a>
      <a href="/" class="button button--secondary meeeku-btn-pill" style="padding: 1.2rem 3rem; font-size: 1.5rem; background: #FFF0F5; border: 2px solid #F8BBD0; color: #6B3FA0; text-decoration: none; border-radius: 30px; font-weight: 700;">
        Back to Home 🏠
      </a>
    </div>
  </div>
</div>

<!-- JS Router: detect /products/ in browser URL and show the right section -->
<script>
(function() {
  var path = window.location.pathname.toLowerCase();
  if (path.indexOf('/products/') !== -1) {
    document.getElementById('MeeekuProductFallbackWrapper').style.display = 'block';
  } else {
    document.getElementById('MeeekuStandard404Wrapper').style.display = 'block';
  }
})();
</script>

