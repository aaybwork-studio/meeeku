{% comment %}
  Meeeku Universal Dynamic Product Fallback & 404 Handler
  Guarantees that ANY product link (Ethnic Lehengas, Everyday T-Shirts, 2-Piece Co-ord Sets)
  instantly renders its complete, rich Product Details Page (PDP) with exact Title, Price,
  Photos, Sizes, Sizing Chart, and Add to Cart even if the product is drafted or unrouted!
{% endcomment %}

<!-- PDP Layout Styles (needed since main-product.liquid styles don't load on 404) -->
<style>
.meeeku-pdp-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: flex-start;
}
.meeeku-pdp-gallery-wrapper {
  display: flex;
  gap: 1.2rem;
  align-items: flex-start;
}
.meeeku-pdp-thumbs-list {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  width: 75px;
  flex-shrink: 0;
}
.meeeku-pdp-thumb-item {
  width: 75px;
  height: 95px;
  border-radius: 12px;
  overflow: hidden;
  border: 2px solid #F8BBD0;
  cursor: pointer;
  opacity: 0.7;
  transition: all 0.2s ease;
  background: #FFF;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.meeeku-pdp-thumb-item.active,
.meeeku-pdp-thumb-item:hover {
  opacity: 1;
  border-color: #6B3FA0;
  transform: scale(1.04);
}
.meeeku-pdp-thumb-item img {
  width: 100%;
  height: 75px;
  object-fit: cover;
  object-position: top center;
}
.meeeku-pdp-thumb-item span {
  font-size: 0.85rem;
  font-weight: 700;
  color: #6B3FA0;
  text-align: center;
  width: 100%;
  background: #FFF9F4;
}
.meeeku-pdp-hero-image {
  flex: 1;
  border-radius: 20px;
  overflow: hidden;
  border: 2px solid #F8BBD0;
  box-shadow: 0 8px 24px rgba(107, 63, 160, 0.08);
}
.meeeku-pdp-hero-image img {
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  object-position: top center;
  display: block;
}
.meeeku-pdp-title {
  color: #3D2355;
  font-size: 2.8rem;
  font-weight: 800;
  margin-bottom: 0.6rem;
  line-height: 1.2;
}
.meeeku-pdp-price {
  font-size: 2.6rem;
  font-weight: 800;
  color: #6B3FA0;
}
.meeeku-pdp-size-grid {
  display: flex;
  gap: 0.8rem;
  flex-wrap: wrap;
}
.meeeku-size-btn {
  border: 2px solid #F8BBD0;
  border-radius: 25px;
  padding: 0.6rem 1.4rem;
  font-size: 1.3rem;
  font-weight: 700;
  color: #3D2355;
  background: #FFFDF7;
  cursor: pointer;
  transition: all 0.2s ease;
}
.meeeku-size-btn.active,
.meeeku-size-btn:hover {
  background: #6B3FA0;
  color: #FFF;
  border-color: #6B3FA0;
}
.meeeku-pdp-info-col {
  padding-top: 1rem;
}
@media screen and (max-width: 749px) {
  .meeeku-pdp-layout {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .meeeku-pdp-gallery-wrapper {
    flex-direction: column-reverse;
  }
  .meeeku-pdp-thumbs-list {
    flex-direction: row;
    width: 100%;
    justify-content: center;
  }
  .meeeku-pdp-title {
    font-size: 2.2rem;
  }
}
</style>

<!-- Product PDP Fallback (shown by JS if URL contains /products/) -->
<div id="MeeekuProductFallbackWrapper" style="display: none;">
  <product-info id="MainProduct-404" class="product-info page-width meeeku-pdp-container" style="display: block; padding-top: 2rem; padding-bottom: 5rem;">
    <div class="meeeku-pdp-layout">
      
