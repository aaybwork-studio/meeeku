      if (path.indexOf('magenta') !== -1 || path.indexOf('phulkari') !== -1 || path.indexOf('rani') !== -1) return 'magenta_lehenga';
      if (path.indexOf('sage') !== -1 || path.indexOf('mint') !== -1) return 'sage_lehenga';
      if (path.indexOf('black') !== -1 || path.indexOf('midnight') !== -1) return 'black_lehenga';
      if (path.indexOf('olive') !== -1) return 'olive_lehenga';
      if (path.indexOf('multicolor') !== -1 || path.indexOf('gulmohar') !== -1) return 'multicolor_coord';

      return 'daisy_frill_tee';
    }

    var key = detectKey();
    var item = CATALOG[key] || CATALOG['daisy_frill_tee'];
    window.currentMeeekuFallbackItem = item;
    window.currentMeeekuSelectedSize = item.sizes[0];

    document.getElementById('MeeekuFallbackTitle').textContent = item.title;
    document.getElementById('MeeekuFallbackBadge').textContent = item.badge;
    document.getElementById('MeeekuFallbackBadge').className = "meeeku-badge " + item.badgeClass;
    document.getElementById('MeeekuFallbackPrice').textContent = item.price;
    document.getElementById('MeeekuFallbackBtnPrice').textContent = item.price;
    document.getElementById('MeeekuFallbackMrp').textContent = item.mrp;
    document.getElementById('MeeekuFallbackDiscount').textContent = item.discount;
    document.getElementById('MeeekuFallbackDesc').textContent = item.desc;

    // Render Hero & Thumbnails
    var heroImg = document.getElementById('MeeekuFallbackHeroImg');
    heroImg.src = assetBaseUrl + item.images[0];
    heroImg.alt = item.title;

    var thumbsContainer = document.getElementById('MeeekuFallbackThumbsList');
    thumbsContainer.innerHTML = "";
    item.images.forEach(function(imgName, idx) {
      var thumbDiv = document.createElement('div');
      thumbDiv.className = "meeeku-pdp-thumb-item" + (idx === 0 ? " active" : "");
      thumbDiv.innerHTML = "<img src='" + (assetBaseUrl + imgName) + "' alt='" + item.title + "' width='75' height='95'><span>View " + (idx + 1) + "</span>";
      thumbDiv.onclick = function() {
        document.querySelectorAll('.meeeku-pdp-thumb-item').forEach(function(el) { el.classList.remove('active'); });
        thumbDiv.classList.add('active');
        heroImg.src = assetBaseUrl + imgName;
      };
      thumbsContainer.appendChild(thumbDiv);
    });

    // Render Size Grid
    var sizeGrid = document.getElementById('MeeekuFallbackSizeGrid');
    sizeGrid.innerHTML = "";
    item.sizes.forEach(function(sizeStr, idx) {
      var btn = document.createElement('button');
      btn.type = "button";
      btn.className = "meeeku-size-btn" + (idx === 0 ? " active" : "");
      btn.textContent = sizeStr;
      btn.onclick = function() {
        document.querySelectorAll('#MeeekuFallbackSizeGrid .meeeku-size-btn').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        window.currentMeeekuSelectedSize = sizeStr;
      };
      sizeGrid.appendChild(btn);
    });

    // Render Size Guide Table
    var sizeGuide = document.getElementById('MeeekuFallbackSizeGuide');
    if (item.type === "tee" || item.type === "coord") {
      sizeGuide.innerHTML = "<div class='meeeku-size-table-wrapper' style='overflow-x:auto;'><table style='width:100%; border-collapse:collapse; text-align:left; font-size:1.35rem;'><tr style='background:#FFF0F5; color:#3D2355;'><th style='padding:0.8rem;'>Age Size</th><th style='padding:0.8rem;'>Chest</th><th style='padding:0.8rem;'>Length</th><th style='padding:0.8rem;'>Waist</th></tr><tr><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>0 - 6 Months</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>18 in</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>11 in</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>14 in</td></tr><tr><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>6 - 12 Months</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>20 in</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>12 in</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>15 in</td></tr><tr><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>12 - 18 Months</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>21 in</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>13 in</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>16 in</td></tr><tr><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>18 - 24 Months</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>22 in</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>14 in</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>17 in</td></tr><tr><td style='padding:0.8rem;'>2 - 3 Years</td><td style='padding:0.8rem;'>23 in</td><td style='padding:0.8rem;'>15 in</td><td style='padding:0.8rem;'>18 in</td></tr></table></div>";
    } else {
      sizeGuide.innerHTML = "<div class='meeeku-size-table-wrapper' style='overflow-x:auto;'><table style='width:100%; border-collapse:collapse; text-align:left; font-size:1.35rem;'><tr style='background:#FFF0F5; color:#3D2355;'><th style='padding:0.8rem;'>Age Size</th><th style='padding:0.8rem;'>Chest</th><th style='padding:0.8rem;'>Top Length</th><th style='padding:0.8rem;'>Skirt Length</th><th style='padding:0.8rem;'>Waist</th></tr><tr><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>2 - 3 Years</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>22 in</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>10 in</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>20 in</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>18 in</td></tr><tr><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>4 - 5 Years</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>24 in</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>11 in</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>24 in</td><td style='padding:0.8rem; border-bottom:1px solid #F8BBD0;'>20 in</td></tr><tr><td style='padding:0.8rem;'>6 - 7 Years</td><td style='padding:0.8rem;'>26 in</td><td style='padding:0.8rem;'>12 in</td><td style='padding:0.8rem;'>28 in</td><td style='padding:0.8rem;'>22 in</td></tr></table></div>";
    }
  })();

  function meeekuFallbackAddToCart() {
    var item = window.currentMeeekuFallbackItem;
    var size = window.currentMeeekuSelectedSize || "Standard";
    var assetBaseUrl = "{{ 'meeeku_prod_daisy_frill_tee.jpg' | asset_url }}".replace("meeeku_prod_daisy_frill_tee.jpg", "");
    var imgUrl = assetBaseUrl + item.images[0];
    if (typeof meeekuAddToCartCatalog === "function") {
      meeekuAddToCartCatalog(item.title, item.price, imgUrl, size);
    } else {
      alert("Added " + item.title + " (" + size + ") to cart!");
    }
  }

  function meeekuFallbackBuyNow() {
    meeekuFallbackAddToCart();
    window.location.href = "/checkout";
  }
  </script>

