function switchMainImage404(thumbElement, imageUrl) {
  document.querySelectorAll('.meeeku-pdp-thumb').forEach(function(el) { el.classList.remove('active'); });
  thumbElement.classList.add('active');
  const mainImg = document.getElementById('MeeekuMainPdpImage404');
  if (mainImg) mainImg.src = imageUrl;
}

function selectSize404(btn) {
  document.querySelectorAll('.meeeku-size-option').forEach(function(el) { el.classList.remove('active'); });
  btn.classList.add('active');
}

function meeekuAddToCart(btn, title, price, imgUrl) {
  const selectedSizeEl = document.querySelector('.meeeku-size-option.active');
  const selectedSize = selectedSizeEl ? selectedSizeEl.innerText.trim() : '0 - 6M';
  
  if (typeof meeekuAddToCartCatalog === 'function') {
    meeekuAddToCartCatalog(title, price, imgUrl, selectedSize);
  } else {
    let cart = [];
    try {
      cart = JSON.parse(localStorage.getItem('meeeku_active_cart') || '[]');
    } catch(e) { cart = []; }
    
    let titleLower = (title || '').toLowerCase();
    let isCoord = titleLower.includes('co-ord') || titleLower.includes('set') || titleLower.includes('lounge') || titleLower.includes('peplum') || titleLower.includes('eyelet') || titleLower.includes('stardust') || titleLower.includes('kitty') || titleLower.includes('meadow') || titleLower.includes('storybook');
    let finalPrice = isCoord ? '₹1,299.00' : price;

    cart.push({
      id: 'item_' + Date.now(),
      title: title,
      price: finalPrice,
      img: imgUrl,
      size: selectedSize,
      qty: 1
    });
    localStorage.setItem('meeeku_active_cart', JSON.stringify(cart));
    localStorage.setItem('meeeku_user_cart', JSON.stringify(cart));
    localStorage.setItem('meeeku_cart', JSON.stringify(cart));
    showMeeekuToast('🎉 Added ' + title + ' (' + selectedSize + ') to Bag!');
    if (typeof openMeeekuCart === 'function') openMeeekuCart();
  }
}

function meeekuBuyNow(btn) {
  showMeeekuToast('⚡ Redirecting to Secure Checkout...');
  setTimeout(function() {
    const drawer = document.querySelector('cart-drawer');
    if (drawer && typeof drawer.open === 'function') {
      drawer.open();
    }
  }, 400);
}

function showMeeekuToast(msg) {
  const toast = document.getElementById('MeeekuCartToast');
  if (toast) {
    toast.innerText = msg;
    toast.classList.add('show');
    setTimeout(function() {
      toast.classList.remove('show');
    }, 2800);
  }
}

function resolveUniversalProductKey() {
  const urlParams = new URLSearchParams(window.location.search);
  const itemParam = urlParams.get('item');
  if (itemParam && MEEEKU_UNIVERSAL_CATALOG[itemParam]) {
    return itemParam;
  }

  const path = window.location.pathname.toLowerCase();

  // Co-ords
  if (path.includes('vanilla') || path.includes('eyelet')) return 'vanilla_cream_coord';
  if (path.includes('ribbon') || path.includes('peplum')) return 'pink_ribbon_peplum_coord';
  if (path.includes('farm') || path.includes('storybook')) return 'farm_friends_coord';
  if (path.includes('wildflower') || path.includes('meadow')) return 'wildflower_meadow_coord';
  if (path.includes('stardust') || path.includes('polka')) return 'sky_blue_polka_coord';
  if (path.includes('kitty') || path.includes('playful')) return 'playful_kitty_coord';

  // T-Shirts
  if (path.includes('daisy') || path.includes('frill')) return 'daisy_frill_tee';
  if (path.includes('bunny') || path.includes('snuggle')) return 'bunny_tee';
  if (path.includes('leopard') || path.includes('safari')) return 'leopard_tee';
  if (path.includes('dino') || path.includes('doodle')) return 'dino_tee';
  if (path.includes('owl') || path.includes('starlit')) return 'owl_tee';
  if (path.includes('lion') || path.includes('mighty')) return 'lion_tee';
  if (path.includes('cosmic') || path.includes('galaxy')) return 'cosmic_safari_tee';

  // Lehengas
  if (path.includes('teal') || path.includes('sequin')) return 'teal_dress';
  if (path.includes('pink-net') || path.includes('blush') || path.includes('rose')) return 'pink_net_lehenga';
  if (path.includes('green') || path.includes('vrindavan') || path.includes('forest')) return 'green_lehenga';
  if (path.includes('multicolor') || path.includes('gulmohar') || path.includes('splash')) return 'multicolor_coord';
  if (path.includes('sage') || path.includes('mint') || path.includes('gota')) return 'sage_lehenga';
  if (path.includes('magenta') || path.includes('phulkari') || path.includes('rani')) return 'magenta_lehenga';
  if (path.includes('black') || path.includes('midnight') || path.includes('halter')) return 'black_lehenga';
  if (path.includes('olive') || path.includes('oneshoulder') || path.includes('silk')) return 'olive_lehenga';
  if (path.includes('yellow') || path.includes('sunshine') || path.includes('chanderi')) return 'yellow_lehenga';

  return 'yellow_lehenga';
}

function hydrateUniversalPdp() {
  const prodKey = resolveUniversalProductKey();
  const data = MEEEKU_UNIVERSAL_CATALOG[prodKey];
  if (!data) return;

  // Title
  const titleEl = document.getElementById('MeeekuPdpTitle404');
  if (titleEl) titleEl.textContent = data.title;

  // Badge
  const badgeEl = document.getElementById('MeeekuPdpBadge404');
  if (badgeEl) {
    badgeEl.textContent = data.badge;
    badgeEl.className = 'meeeku-badge ' + (data.badgeClass || '');
  }

  // Pricing
  const priceEl = document.getElementById('MeeekuPdpPrice404');
  if (priceEl) priceEl.textContent = data.price + ' INR';
  const mrpEl = document.getElementById('MeeekuPdpMrp404');
  if (mrpEl) mrpEl.textContent = data.mrp;
  const discountEl = document.getElementById('MeeekuPdpDiscount404');
  if (discountEl) discountEl.textContent = data.discount;

  // Description
  const descEl = document.getElementById('MeeekuPdpDesc404');
  if (descEl) descEl.textContent = data.desc;

  // Button
  const addBtn = document.getElementById('MeeekuPdpAddBtn404');
  if (addBtn) {
    addBtn.textContent = '🛒 Add to Cart — ' + data.price;
    addBtn.onclick = function() { meeekuAddToCart(addBtn, data.title, data.price, data.images.flatlay || data.images.model); };
  }

  // Size Grid
  const sizeGridEl = document.getElementById('MeeekuPdpSizeGrid404');
  const sizeLabelEl = document.getElementById('MeeekuPdpSizeLabel404');
  if (sizeLabelEl) {
    sizeLabelEl.textContent = (data.is_tee || data.is_coord) ? 'Select Size (0 – 3 Years):' : 'Select Size (0 – 7 Years):';
  }
  if (sizeGridEl && data.sizes) {
    let sizeButtonsHtml = '';
    data.sizes.forEach((sz, idx) => {
      const activeCls = idx === 0 ? 'active' : '';
      sizeButtonsHtml += `<button type="button" class="meeeku-size-option ${activeCls}" onclick="selectSize404(this)">${sz}</button>`;
    });
    sizeGridEl.innerHTML = sizeButtonsHtml;
  }

  // Main Image & Thumbnails
  const mainImgEl = document.getElementById('MeeekuMainPdpImage404');
  if (mainImgEl) {
    mainImgEl.src = data.images.model || data.images.flatlay;
    mainImgEl.alt = data.title;
  }

  const thumb1Img = document.getElementById('MeeekuThumb1Img');
  const thumb2Img = document.getElementById('MeeekuThumb2Img');
  const thumb3Img = document.getElementById('MeeekuThumb3Img');
  const thumbs = document.querySelectorAll('.meeeku-pdp-thumb');

  if (thumb1Img) thumb1Img.src = data.images.model || data.images.flatlay;
  if (thumb2Img) thumb2Img.src = data.images.flatlay || data.images.model;
  if (thumb3Img) thumb3Img.src = data.images.detail || data.images.flatlay;

  if (thumbs.length >= 3) {
    thumbs.forEach(t => t.classList.remove('active'));
    thumbs[0].classList.add('active');
    thumbs[0].onclick = function() { switchMainImage404(thumbs[0], data.images.model || data.images.flatlay); };
    thumbs[1].onclick = function() { switchMainImage404(thumbs[1], data.images.flatlay || data.images.model); };
    thumbs[2].onclick = function() { switchMainImage404(thumbs[2], data.images.detail || data.images.flatlay); };
  }

  // Size Guide Table
  const guideHeading = document.getElementById('MeeekuSizeGuideHeading404');
  const guideTbody = document.getElementById('MeeekuSizeGuideTbody404');
  const guideCol4Header = document.getElementById('MeeekuGuideCol4Header404');

  if (guideHeading) {
    guideHeading.textContent = data.is_coord ? '📏 2-Piece Co-ord Size Guide (0 – 3 Years)' : (data.is_tee ? '📏 T-Shirt Size & Fit Guide (0 – 3 Years)' : '📏 Size & Fit Guide (0 – 6 Years)');
  }
  if (guideCol4Header) {
    guideCol4Header.textContent = data.is_coord ? 'Pants Length (cm)' : (data.is_tee ? 'Tee Length (cm)' : 'Waist (cm)');
  }
  if (guideTbody) {
    if (data.is_coord) {
      guideTbody.innerHTML = `
        <tr><td style="padding: 0.5rem 0.8rem;">0 – 6M</td><td style="text-align:center;">60–68</td><td style="text-align:center;">44–46</td><td style="text-align:center;">38–42</td></tr>
        <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">6 – 12M</td><td style="text-align:center;">68–76</td><td style="text-align:center;">46–48</td><td style="text-align:center;">42–45</td></tr>
        <tr><td style="padding: 0.5rem 0.8rem;">12 – 18M</td><td style="text-align:center;">76–84</td><td style="text-align:center;">48–50</td><td style="text-align:center;">45–48</td></tr>
        <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">18 – 24M</td><td style="text-align:center;">84–90</td><td style="text-align:center;">50–52</td><td style="text-align:center;">48–50</td></tr>
        <tr><td style="padding: 0.5rem 0.8rem;">2 – 3Y</td><td style="text-align:center;">90–98</td><td style="text-align:center;">52–54</td><td style="text-align:center;">50–53</td></tr>
      `;
    } else if (data.is_tee) {
      guideTbody.innerHTML = `
        <tr><td style="padding: 0.5rem 0.8rem;">0 – 6M</td><td style="text-align:center;">60–68</td><td style="text-align:center;">44–46</td><td style="text-align:center;">31</td></tr>
        <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">6 – 12M</td><td style="text-align:center;">68–76</td><td style="text-align:center;">46–48</td><td style="text-align:center;">33</td></tr>
        <tr><td style="padding: 0.5rem 0.8rem;">12 – 18M</td><td style="text-align:center;">76–84</td><td style="text-align:center;">48–50</td><td style="text-align:center;">35</td></tr>
        <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">18 – 24M</td><td style="text-align:center;">84–90</td><td style="text-align:center;">50–52</td><td style="text-align:center;">37</td></tr>
        <tr><td style="padding: 0.5rem 0.8rem;">2 – 3Y</td><td style="text-align:center;">90–98</td><td style="text-align:center;">52–54</td><td style="text-align:center;">40</td></tr>
      `;
    } else {
      guideTbody.innerHTML = `
        <tr><td style="padding: 0.7rem 1rem;">0 – 1Y</td><td style="text-align:center;">70–80</td><td style="text-align:center;">44–47</td><td style="text-align:center;">43–46</td></tr>
        <tr style="background: #FFF9F4;"><td style="padding: 0.7rem 1rem;">1 – 2Y</td><td style="text-align:center;">80–90</td><td style="text-align:center;">47–50</td><td style="text-align:center;">46–49</td></tr>
        <tr><td style="padding: 0.7rem 1rem;">2 – 3Y</td><td style="text-align:center;">90–98</td><td style="text-align:center;">50–53</td><td style="text-align:center;">49–52</td></tr>
        <tr style="background: #FFF9F4;"><td style="padding: 0.7rem 1rem;">3 – 4Y</td><td style="text-align:center;">98–104</td><td style="text-align:center;">53–56</td><td style="text-align:center;">52–55</td></tr>
        <tr><td style="padding: 0.7rem 1rem;">4 – 5Y</td><td style="text-align:center;">104–110</td><td style="text-align:center;">56–59</td><td style="text-align:center;">55–58</td></tr>
        <tr style="background: #FFF9F4;"><td style="padding: 0.7rem 1rem;">5 – 6Y</td><td style="text-align:center;">110–116</td><td style="text-align:center;">59–62</td><td style="text-align:center;">58–61</td></tr>
      `;
    }
  }
}

document.addEventListener('DOMContentLoaded', hydrateUniversalPdp);
</script>

