{% comment %}
  Meeeku Sample Product & 404 Handler Template
  Ensures sample product clicks always render the full Meeeku Product Details Page (PDP)!
{% endcomment %}

<div class="page-width" style="margin-top: 2rem; margin-bottom: 4rem;">
  <div class="grid grid--1-col grid--2-col-tablet" style="align-items: flex-start;">
    
    <!-- LEFT COLUMN: Sticky Gallery + Far-Left Thumbnails -->
    <div class="grid__item product__media-wrapper">
      <div class="meeeku-pdp-gallery">
        <!-- Far-Left Vertical Thumbnails -->
        <div class="meeeku-pdp-thumbnails">
          <div class="meeeku-pdp-thumb active" onclick="switchMainImage404(this, '{{ 'placeholder_ethnic_1.jpg' | asset_url }}')">
            <img src="{{ 'placeholder_ethnic_1.jpg' | asset_url }}" alt="Lehenga Front View" width="80" height="100">
          </div>
          <div class="meeeku-pdp-thumb" onclick="switchMainImage404(this, '{{ 'carousel_product_1.jpg' | asset_url }}')">
            <img src="{{ 'carousel_product_1.jpg' | asset_url }}" alt="Lehenga Full View" width="80" height="100">
          </div>
          <div class="meeeku-pdp-thumb" onclick="switchMainImage404(this, '{{ 'placeholder_nightsuit_1.jpg' | asset_url }}')">
            <img src="{{ 'placeholder_nightsuit_1.jpg' | asset_url }}" alt="Nightsuit Preview" width="80" height="100">
          </div>
        </div>
        <!-- Large Hero Main Image -->
        <div class="meeeku-pdp-main-media">
          <img id="MeeekuMainPdpImage404" src="{{ 'placeholder_ethnic_1.jpg' | asset_url }}" alt="Royal Pink & Gold Lehenga Choli" class="meeeku-pdp-main-img" width="600" height="750" loading="eager">
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: Scrolling Product Details & Actions -->
    <div class="grid__item product__info-wrapper">
      <div class="product__info-container" style="padding-left: 1rem;">
        <span class="meeeku-badge meeeku-badge--ethnic">Girls Indian Ethnic</span>
        <h1 style="color: #3D2355; font-size: 3.2rem; font-weight: 800; margin-top: 1rem; margin-bottom: 0.5rem;">Royal Pink & Gold Lehenga Choli Set</h1>
        <div style="font-size: 1.5rem; color: #FF6097; font-weight: 700; margin-bottom: 1rem;">⭐⭐⭐⭐⭐ 4.9 (128 verified reviews)</div>
        
        <div class="price price--large" style="margin-bottom: 1.5rem;">
          <span class="price-item price-item--regular" style="font-size: 2.4rem; font-weight: 800; color: #6B3FA0;">₹2,499.00 INR</span>
          <span class="price-item price-item--compare" style="text-decoration: line-through; color: #888; margin-left: 1rem; font-size: 1.8rem;">₹3,499.00</span>
          <span class="meeeku-badge meeeku-badge--coming-soon" style="margin-left: 1rem; background-color: #E8F5E9; color: #2E7D32;">SAVE 30%</span>
        </div>

        <p style="font-size: 1.5rem; color: #555; line-height: 1.6; margin-bottom: 2rem;">
          Handcrafted festive Lehenga set made with lightweight organza and 100% soft breathable cotton lining. Guaranteed zero-itch comfort for your little princess during Diwali and weddings!
        </p>

        <!-- Size Selector -->
        <div style="margin-bottom: 2rem;">
          <label style="font-weight: 700; color: #3D2355; font-size: 1.5rem; display: block; margin-bottom: 0.8rem;">Select Size:</label>
          <div style="display: flex; gap: 0.8rem; flex-wrap: wrap;">
            <button type="button" class="meeeku-size-option" onclick="selectSize404(this)">0 - 1Y</button>
            <button type="button" class="meeeku-size-option" onclick="selectSize404(this)">1 - 2Y</button>
            <button type="button" class="meeeku-size-option active" onclick="selectSize404(this)">2 - 3Y</button>
            <button type="button" class="meeeku-size-option" onclick="selectSize404(this)">3 - 4Y</button>
            <button type="button" class="meeeku-size-option" onclick="selectSize404(this)">4 - 5Y</button>
            <button type="button" class="meeeku-size-option" onclick="selectSize404(this)">5 - 6Y</button>
          </div>
        </div>

        <!-- Add to Cart & Buy Buttons -->
        <div style="margin-bottom: 2rem; display: flex; flex-direction: column; gap: 1rem;">
          <button type="button" class="meeeku-btn-primary" style="width: 100%; text-align: center;" onclick="meeekuAddToCart(this)">
            🛒 Add to Cart — ₹2,499.00
          </button>
          <button type="button" class="meeeku-btn-secondary" style="width: 100%; text-align: center;" onclick="meeekuBuyNow(this)">
            ⚡ Buy It Now
          </button>
        </div>

        <!-- Trust Badges & Interactive Snippets -->
        {% render 'meeeku-trust-badges' %}
        {% render 'meeeku-size-guide' %}
        {% render 'meeeku-wash-care' %}

      </div>
    </div>

  </div>
</div>

<!-- Cart Toast Notification Element -->
<div id="MeeekuCartToast" class="meeeku-cart-toast">
  🎉 Added to your Meeeku Cart!
</div>

<script>
function switchMainImage404(thumbElement, imageUrl) {
  document.querySelectorAll('.meeeku-pdp-thumb').forEach(function(el) { el.classList.remove('active'); });
  thumbElement.classList.add('active');
  document.getElementById('MeeekuMainPdpImage404').src = imageUrl;
}
function selectSize404(btn) {
  document.querySelectorAll('.meeeku-size-option').forEach(function(el) { el.classList.remove('active'); });
  btn.classList.add('active');
}
function meeekuAddToCart(btn) {
  const container = document.getElementById('MeeekuCartItemsContainer');
  const emptyNotice = document.getElementById('MeeekuCartEmptyNotice');
  const summary = document.getElementById('MeeekuCartSummary');
  const subtotal = document.getElementById('MeeekuCartSubtotal');
  const cartDot = document.getElementById('MeeekuCartDot');

  if (emptyNotice) emptyNotice.style.display = 'none';
  if (summary) summary.style.display = 'block';

  const itemId = 'MeeekuCartItem-' + Date.now();
  const imgUrl = document.getElementById('MeeekuMainPdpImage404') ? document.getElementById('MeeekuMainPdpImage404').src : '{{ "placeholder_ethnic_1.jpg" | asset_url }}';

  const itemHtml = `
    <div id="${itemId}" class="meeeku-cart-item" style="display: flex; gap: 1.5rem; align-items: center; background: #FFFDF7; border: 2px solid #F8BBD0; border-radius: 20px; padding: 1.2rem; margin-bottom: 1.5rem; box-shadow: 0 4px 14px rgba(107,63,160,0.06);">
      <img src="${imgUrl}" alt="Royal Pink Lehenga Choli" width="80" height="100" style="border-radius: 14px; object-fit: cover; width: 70px; height: 90px;">
      <div style="flex-grow: 1;">
        <h4 style="margin: 0 0 0.3rem; font-size: 1.5rem; font-weight: 700; color: #3D2355;">Royal Pink & Gold Lehenga Set</h4>
        <div style="font-size: 1.2rem; color: #666; margin-bottom: 0.4rem;">Size: 2 - 3 Years (2Y)</div>
        <div style="font-size: 1.6rem; font-weight: 800; color: #6B3FA0;">₹2,499.00</div>
      </div>
      <button type="button" style="background: transparent; border: none; font-size: 1.8rem; cursor: pointer; color: #888;" onclick="removeMeeekuCartItem('${itemId}')">✕</button>
    </div>
  `;

  if (container) {
    container.insertAdjacentHTML('beforeend', itemHtml);
  }

  if (subtotal) subtotal.innerText = '₹2,499.00 INR';
  if (cartDot) cartDot.classList.add('has-items');

  const drawer = document.querySelector('cart-drawer');
  if (drawer && typeof drawer.open === 'function') {
    drawer.open();
  }
  showMeeekuToast('🎉 Royal Lehenga added to your Cart!');
}
function meeekuBuyNow(btn) {
  showMeeekuToast('⚡ Redirecting to Secure Checkout...');
  setTimeout(function() {
    const drawer = document.querySelector('cart-drawer');
    if (drawer && typeof drawer.open === 'function') {
      drawer.open();
    }
  }, 400);
}
function showMeeekuToast(msg) {
  const toast = document.getElementById('MeeekuCartToast');
  if (toast) {
    toast.innerText = msg;
    toast.classList.add('show');
    setTimeout(function() {
      toast.classList.remove('show');
    }, 2800);
  }
}
</script>
