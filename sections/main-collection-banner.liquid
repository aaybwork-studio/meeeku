{% comment %} Simple Clean Catalog Heading Banner {% endcomment %}

<div class="page-width meeeku-catalog-banner">
  <h1 class="meeeku-catalog-heading">
    {%- if collection.handle == 'all' or collection.title == 'Products' -%}
      Catalog
    {%- else -%}
      {{ collection.title | escape }}
    {%- endif -%}
  </h1>
  {%- if section.settings.show_collection_description and collection.description != blank -%}
    <div class="meeeku-catalog-subtext">{{ collection.description }}</div>
  {%- endif -%}
</div>

<style>
.meeeku-catalog-banner {
  text-align: center;
  padding-top: 3.5rem;
  padding-bottom: 1rem;
}

.meeeku-catalog-heading {
  font-size: clamp(2.8rem, 4vw, 3.8rem);
  font-weight: 800;
  color: #3D2355;
  margin: 0;
  line-height: 1.2;
  letter-spacing: -0.5px;
}

.meeeku-catalog-subtext {
  font-size: 1.5rem;
  color: #6B3FA0;
  margin-top: 0.8rem;
}
</style>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    }
  ]
}
{% endschema %}
