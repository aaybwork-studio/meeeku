{% comment %}
  Meeeku Everyday Basic T-Shirts Lineup Section (Shopify OS 2.0 Dynamic CMS Connected)
  Features 100% Pure Combed Cotton Tees (0-6M to 2-3Y) at Flat ₹599/- with dynamic Shopify product cards and fallback.
{% endcomment %}

{% liquid
  assign target_collection = section.settings.collection
  if target_collection == blank and collections['basic-t-shirts'] != blank
    assign target_collection = collections['basic-t-shirts']
  elsif target_collection == blank and collections['tees'] != blank
    assign target_collection = collections['tees']
  endif

  assign limit = section.settings.products_to_show | default: 6
%}

<div class="page-width meeeku-tees-section" id="MeeekuTees-{{ section.id }}" style="padding-top: 4.5rem; padding-bottom: 5.5rem;">
  
  <!-- Section Header -->
  <div class="text-center" style="margin-bottom: 3.5rem; text-align: center;">
    {% if section.settings.badge != blank %}
      <span class="meeeku-badge" style="background: #E8F5E9; color: #2E7D32; font-size: 1.25rem; padding: 0.4rem 1.4rem; font-weight: 700; border-radius: 20px; display: inline-block;">
        {{ section.settings.badge }}
      </span>
    {% endif %}
    <h2 class="h1" style="color: #3D2355; margin-top: 1rem; font-size: 3.6rem; font-weight: 800; letter-spacing: -0.02em;">
      {{ section.settings.title | default: 'Everyday Storybook Cotton T-Shirts' }}
    </h2>
    <p style="color: #6B3FA0; font-size: 1.65rem; max-width: 680px; margin: 0.6rem auto 0; line-height: 1.5;">
      {{ section.settings.subtitle | default: 'Ultra-soft, skin-safe basic tees tailored with gentle stretch, tagless comfort & playful hand-drawn prints. Built for zero-itch play from 0-6 Months to 2-3 Years.' }}
    </p>
    <div style="margin-top: 1.2rem; display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
      <span class="meeeku-badge" style="background: #EDE7F6; color: #512DA8; font-size: 1.2rem; padding: 0.35rem 1rem;">✨ 100% Pure Combed Cotton</span>
      <span class="meeeku-badge" style="background: #FFF3E0; color: #E65100; font-size: 1.2rem; padding: 0.35rem 1rem;">☁️ Zero-Itch Soft Ribbing</span>
      <span class="meeeku-badge" style="background: #E0F7FA; color: #00838F; font-size: 1.2rem; padding: 0.35rem 1rem;">👶 Sizes 0-6M to 2-3Y</span>
    </div>
  </div>

  <!-- T-Shirts Product Grid -->
  <div class="meeeku-tees-grid">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% if block.settings.product != blank %}
          {% render 'meeeku-featured-card', product: block.settings.product, custom_badge: block.settings.custom_badge %}
        {% endif %}
      {% endfor %}
    {% elsif target_collection != blank and target_collection.products.size > 0 %}
      {% for prod in target_collection.products limit: limit %}
        {% render 'meeeku-featured-card', product: prod %}
      {% endfor %}
    {% else %}
      {% assign count = 0 %}
      {% for prod in collections.all.products %}
        {% assign p_type = prod.type | downcase %}
        {% assign p_tags = prod.tags | join: ',' | downcase %}
        {% if p_type contains 'tee' or p_tags contains 'tee' %}
          {% render 'meeeku-featured-card', product: prod %}
          {% assign count = count | plus: 1 %}
          {% if count >= limit %}{% break %}{% endif %}
        {% endif %}
      {% endfor %}
      {% if count == 0 %}
        <!-- Curated Fallbacks -->
        {% render 'meeeku-featured-card-fallback' %}
      {% endif %}
    {% endif %}
  </div>

  <!-- View All T-Shirts CTA -->
  <div style="text-align: center; margin-top: 3.5rem;">
    <a href="{{ section.settings.view_all_link | default: '/collections/all?category=tees' }}" class="button button--primary meeeku-btn-pill" style="font-size: 1.5rem; padding: 1.2rem 3rem; background: #2E7D32; border-color: #2E7D32;">
      {{ section.settings.view_all_label | default: '👕 Explore Full Everyday T-Shirts Collection →' }}
    </a>
  </div>

</div>

<style>
.meeeku-tees-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.2rem;
}

@media screen and (max-width: 890px) {
  .meeeku-tees-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem;
  }
}

@media screen and (max-width: 550px) {
  .meeeku-tees-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .meeeku-tees-section {
    padding-top: 2.5rem !important;
    padding-bottom: 3.5rem !important;
  }
  .meeeku-tees-section h2.h1 {
    font-size: 2.4rem !important;
  }
  .meeeku-tees-section p {
    font-size: 1.35rem !important;
  }
}
</style>

{% schema %}
{
  "name": "Meeeku Everyday Tees",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "🌱 NEW ARRIVALS • 100% ORGANIC COTTON"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Everyday Storybook Cotton T-Shirts"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Ultra-soft, skin-safe basic tees tailored with gentle stretch, tagless comfort & playful hand-drawn prints. Built for zero-itch play from 0-6 Months to 2-3 Years."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select T-Shirts Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Products to show"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button Label",
      "default": "👕 Explore Full Everyday T-Shirts Collection →"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Curated Tee",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "custom_badge",
          "label": "Custom Badge"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Meeeku Everyday Tees"
    }
  ]
}
{% endschema %}
