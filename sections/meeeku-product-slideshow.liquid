{% comment %}
  Meeeku White Background Interactive Hero Product Carousel
{% endcomment %}

<div class="meeeku-slideshow-wrapper">
  <div class="meeeku-slideshow-container" id="MeeekuSlideshow-{{ section.id }}">
    
    <!-- Slide 1: Indian Ethnic Lehenga -->
    <div class="meeeku-slide active" data-index="0">
      <div class="page-width meeeku-slide__inner">
        <div class="meeeku-slide__content">
          <span class="meeeku-badge meeeku-badge--ethnic">Girls Collection (2-5Y)</span>
          <h2 class="meeeku-slide__title">Royal Silk & Cotton Lehengas</h2>
          <p class="meeeku-slide__sub">Handcrafted Indian Ethnic wear lined with 100% soft cotton for zero-itch festive fun.</p>
          <div class="meeeku-slide__actions">
            <a href="/collections/indian-ethnic" class="button button--primary">Shop Ethnic Collection 👑</a>
          </div>
        </div>
        <div class="meeeku-slide__media">
          <img src="{{ 'carousel_product_1.jpg' | asset_url }}" alt="Girls Indian Ethnic Lehenga 2-5Y" class="meeeku-slide-img" width="800" height="450" loading="eager">
        </div>
      </div>
    </div>

    <!-- Slide 2: Organic Cotton Nightsuits -->
    <div class="meeeku-slide" data-index="1">
      <div class="page-width meeeku-slide__inner">
        <div class="meeeku-slide__content">
          <span class="meeeku-badge meeeku-badge--nightsuits">100% Organic Cotton</span>
          <h2 class="meeeku-slide__title">Cloud-Soft Printed Nightsuits</h2>
          <p class="meeeku-slide__sub">Ultra-breathable sleepwear Pyjama sets featuring whimsical hand-illustrated prints.</p>
          <div class="meeeku-slide__actions">
            <a href="/collections/nightsuits" class="button button--secondary">Shop Cozy Nightsuits 🌙</a>
          </div>
        </div>
        <div class="meeeku-slide__media">
          <img src="{{ 'carousel_product_2.jpg' | asset_url }}" alt="Girls Organic Cotton Nightsuits 2-5Y" class="meeeku-slide-img" width="800" height="450" loading="lazy">
        </div>
      </div>
    </div>

    <!-- Slide 3: Boys Teaser -->
    <div class="meeeku-slide" data-index="2">
      <div class="page-width meeeku-slide__inner">
        <div class="meeeku-slide__content">
          <span class="meeeku-badge meeeku-badge--coming-soon">Launching Soon!</span>
          <h2 class="meeeku-slide__title">Little Princes Boys Line</h2>
          <p class="meeeku-slide__sub">Handsome Kurtas & cozy loungewear for boys (2-5Y). Join our VIP early access list!</p>
          <div class="meeeku-slide__actions">
            <a href="#meeeku-boys-waitlist" class="button button--primary" style="background-color: #1976D2;">Join Boys Waitlist 🚀</a>
          </div>
        </div>
        <div class="meeeku-slide__media">
          <img src="{{ 'carousel_product_3.jpg' | asset_url }}" alt="Boys Kurta Pyjama Collection 2-5Y" class="meeeku-slide-img" width="800" height="450" loading="lazy">
        </div>
      </div>
    </div>

    <!-- Navigation Arrows -->
    <button type="button" class="meeeku-slideshow__nav meeeku-slideshow__nav--prev" onclick="moveMeeekuSlide('{{ section.id }}', -1)" aria-label="Previous slide">&#10094;</button>
    <button type="button" class="meeeku-slideshow__nav meeeku-slideshow__nav--next" onclick="moveMeeekuSlide('{{ section.id }}', 1)" aria-label="Next slide">&#10095;</button>

    <!-- Dots Indicators -->
    <div class="meeeku-slideshow__dots">
      <span class="meeeku-dot active" onclick="setMeeekuSlide('{{ section.id }}', 0)"></span>
      <span class="meeeku-dot" onclick="setMeeekuSlide('{{ section.id }}', 1)"></span>
      <span class="meeeku-dot" onclick="setMeeekuSlide('{{ section.id }}', 2)"></span>
    </div>

  </div>
</div>

<style>
.meeeku-slideshow-wrapper {
  position: relative;
  width: 100%;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFDF7 100%);
  border-bottom: 2px solid #F8BBD0;
  padding: 3rem 0;
  overflow: hidden;
}
.meeeku-slideshow-container {
  position: relative;
  width: 100%;
  min-height: 440px;
}
.meeeku-slide {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.6s ease-in-out, visibility 0.6s ease-in-out;
  display: flex;
  align-items: center;
}
.meeeku-slide.active {
  position: relative;
  opacity: 1;
  visibility: visible;
}
.meeeku-slide__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
  margin: 0 auto;
}
.meeeku-slide__content {
  text-align: left;
}
.meeeku-slide__title {
  color: #3D2355 !important;
  font-size: 3.8rem;
  font-weight: 800;
  line-height: 1.15;
  margin-top: 1.2rem;
  margin-bottom: 1rem;
}
.meeeku-slide__sub {
  color: #6B3FA0;
  font-size: 1.6rem;
  margin-bottom: 2rem;
  line-height: 1.5;
}
.meeeku-slide__media {
  display: flex;
  justify-content: center;
  align-items: center;
}
.meeeku-slide-img {
  max-width: 100%;
  height: auto;
  max-height: 400px;
  object-fit: contain;
  filter: drop-shadow(0 10px 20px rgba(107, 63, 160, 0.08));
}
.meeeku-slideshow__nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 5;
  background: #FFFDF7;
  border: 1px solid #F8BBD0;
  color: #3D2355;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  font-size: 2rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.3s ease, transform 0.3s ease;
  box-shadow: 0 4px 12px rgba(107, 63, 160, 0.1);
}
.meeeku-slideshow__nav:hover {
  background: #FFF0F5;
  transform: translateY(-50%) scale(1.1);
}
.meeeku-slideshow__nav--prev {
  left: 1.5rem;
}
.meeeku-slideshow__nav--next {
  right: 1.5rem;
}
.meeeku-slideshow__dots {
  display: flex;
  justify-content: center;
  gap: 0.8rem;
  margin-top: 2rem;
}
.meeeku-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #E0E0E0;
  cursor: pointer;
  transition: background 0.3s ease, transform 0.3s ease;
}
.meeeku-dot.active {
  background: #FF6097;
  transform: scale(1.3);
}

@media screen and (max-width: 749px) {
  .meeeku-slide__inner {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .meeeku-slide__content {
    text-align: center;
  }
}
</style>

<script>
let currentMeeekuSlide = 0;
function moveMeeekuSlide(sectionId, step) {
  const container = document.getElementById('MeeekuSlideshow-' + sectionId);
  if(!container) return;
  const slides = container.querySelectorAll('.meeeku-slide');
  const dots = container.querySelectorAll('.meeeku-dot');
  slides[currentMeeekuSlide].classList.remove('active');
  dots[currentMeeekuSlide].classList.remove('active');
  currentMeeekuSlide = (currentMeeekuSlide + step + slides.length) % slides.length;
  slides[currentMeeekuSlide].classList.add('active');
  dots[currentMeeekuSlide].classList.add('active');
}
function setMeeekuSlide(sectionId, index) {
  const container = document.getElementById('MeeekuSlideshow-' + sectionId);
  if(!container) return;
  const slides = container.querySelectorAll('.meeeku-slide');
  const dots = container.querySelectorAll('.meeeku-dot');
  slides[currentMeeekuSlide].classList.remove('active');
  dots[currentMeeekuSlide].classList.remove('active');
  currentMeeekuSlide = index;
  slides[currentMeeekuSlide].classList.add('active');
  dots[currentMeeekuSlide].classList.add('active');
}
// Auto advance every 5 seconds
setInterval(function() {
  const container = document.querySelector('.meeeku-slideshow-container');
  if (container) {
    const sectionId = container.id.replace('MeeekuSlideshow-', '');
    moveMeeekuSlide(sectionId, 1);
  }
}, 5000);
</script>

{% schema %}
{
  "name": "Meeeku Product Slideshow",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Meeeku Product Slideshow"
    }
  ]
}
{% endschema %}
