{% comment %}
  Meeeku Full-Width Scenery Hero Carousel with Lifestyle Model Banners & Overlay Cards
{% endcomment %}

<div class="meeeku-slideshow-wrapper">
  <div class="meeeku-slideshow-container" id="MeeekuSlideshow-{{ section.id }}">
    
    <!-- Slide 1: Indian Ethnic -->
    <div class="meeeku-slide active" data-index="0">
      <div class="meeeku-hero-bg meeeku-hero-bg--1" style="background-image: url('{{ 'meeeku_hero_scenery_ethnic_wide.jpg' | asset_url }}')"></div>
      <div class="page-width meeeku-slide__content-wrapper">
        <div class="meeeku-hero-col-text">
          <span class="meeeku-badge meeeku-badge--ethnic">Girls Indian Ethnic</span>
          <h2 class="meeeku-slide__headline">Sunshine Chanderi Lehengas</h2>
          <p class="meeeku-slide__tagline">Handcrafted with 100% soft muslin cotton lining for zero-itch festive twirling all day long.</p>
          <a href="/collections/all?category=ethnic" class="button button--primary meeeku-btn-pill">Shop Ethnic Wear 👑</a>
        </div>
      </div>
    </div>

    <!-- Slide 2: Festive Indo-Western Dresses -->
    <div class="meeeku-slide" data-index="1">
      <div class="meeeku-hero-bg meeeku-hero-bg--2" style="background-image: url('{{ 'meeeku_hero_scenery_dresses_wide.jpg' | asset_url }}')"></div>
      <div class="page-width meeeku-slide__content-wrapper">
        <div class="meeeku-hero-col-text">
          <span class="meeeku-badge" style="background: #E0F7FA; color: #00838F; border-color: #4DD0E1;">Tulle & Sequins</span>
          <h2 class="meeeku-slide__headline">Teal Bloom Sequined Dresses</h2>
          <p class="meeeku-slide__tagline">Voluminous tulle net skirts with sparkling floral sequin embroidery and matching headbands.</p>
          <a href="/collections/all?category=dresses" class="button button--secondary meeeku-btn-pill">Shop Festive Dresses ✨</a>
        </div>
      </div>
    </div>

    <!-- Slide 3: Festive Co-ords -->
    <div class="meeeku-slide" data-index="2">
      <div class="meeeku-hero-bg meeeku-hero-bg--3" style="background-image: url('{{ 'meeeku_hero_scenery_coords_wide.jpg' | asset_url }}')"></div>
      <div class="page-width meeeku-slide__content-wrapper">
        <div class="meeeku-hero-col-text">
          <span class="meeeku-badge" style="background: #FFF8E1; color: #F57F17; border-color: #FFE082;">Festive Co-ord Sets</span>
          <h2 class="meeeku-slide__headline">Gulmohar Splash & Festive Co-ords</h2>
          <p class="meeeku-slide__tagline">Vibrant abstract prints and regal olive silk two-piece sets designed for comfortable playful twirls.</p>
          <a href="/collections/all?category=coords" class="button button--primary meeeku-btn-pill" style="background-color: #F57F17; border-color: #F57F17;">Explore Co-ord Sets 🌸</a>
        </div>
      </div>
    </div>

    <!-- Navigation Arrows -->
    <button type="button" class="meeeku-slideshow__nav meeeku-slideshow__nav--prev" onclick="moveMeeekuSlide('{{ section.id }}', -1)" aria-label="Previous slide">&#10094;</button>
    <button type="button" class="meeeku-slideshow__nav meeeku-slideshow__nav--next" onclick="moveMeeekuSlide('{{ section.id }}', 1)" aria-label="Next slide">&#10095;</button>

    <!-- Dots Indicators -->
    <div class="meeeku-slideshow__dots">
      <span class="meeeku-dot active" onclick="setMeeekuSlide('{{ section.id }}', 0)"></span>
      <span class="meeeku-dot" onclick="setMeeekuSlide('{{ section.id }}', 1)"></span>
      <span class="meeeku-dot" onclick="setMeeekuSlide('{{ section.id }}', 2)"></span>
    </div>

  </div>
</div>

<style>
.meeeku-slideshow-wrapper {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 580px;
  overflow: hidden;
  background-color: #FFFDF7;
}
.meeeku-slideshow-container {
  position: relative;
  width: 100%;
  height: 100%;
}
.meeeku-slide {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.7s ease-in-out, visibility 0.7s ease-in-out;
  display: flex;
  align-items: center;
}
.meeeku-slide.active {
  opacity: 1;
  visibility: visible;
}
.meeeku-hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background-size: cover;
  background-position: center center;
}
.meeeku-hero-bg--1 {
  /* background-image set via inline style - Liquid not processed in CSS blocks */
}
.meeeku-hero-bg--2 {
  /* background-image set via inline style - Liquid not processed in CSS blocks */
}
.meeeku-hero-bg--3 {
  /* background-image set via inline style - Liquid not processed in CSS blocks */
}
.meeeku-slide__content-wrapper {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  height: 100%;
  width: 100%;
}
.meeeku-hero-col-text {
  text-align: left;
  max-width: 520px;
  background: rgba(255, 253, 247, 0.92);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-radius: 28px;
  padding: 3rem;
  border: 2px solid #F8BBD0;
  box-shadow: 0 12px 36px rgba(107, 63, 160, 0.14);
}
.meeeku-slide__headline {
  color: #3D2355 !important;
  font-size: 3.4rem;
  font-weight: 800;
  line-height: 1.2;
  margin-top: 1rem;
  margin-bottom: 0.8rem;
}
.meeeku-slide__tagline {
  color: #555;
  font-size: 1.5rem;
  margin-bottom: 2rem;
  line-height: 1.5;
}
.meeeku-btn-pill {
  border-radius: 30px !important;
  font-size: 1.5rem !important;
  padding: 1.1rem 2.4rem !important;
}
.meeeku-slideshow__nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 5;
  background: rgba(255, 253, 247, 0.92);
  border: 1px solid #F8BBD0;
  color: #3D2355;
  width: 48px;
  height: 48px;
  border-radius: 50% !important;
  font-size: 2rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.3s ease, transform 0.3s ease;
  backdrop-filter: blur(4px);
  box-shadow: 0 4px 14px rgba(0,0,0,0.12);
}
.meeeku-slideshow__nav:hover {
  background: #FF6097;
  color: #FFF;
  transform: translateY(-50%) scale(1.1);
}
.meeeku-slideshow__nav--prev {
  left: 2rem;
}
.meeeku-slideshow__nav--next {
  right: 2rem;
}
.meeeku-slideshow__dots {
  position: absolute;
  bottom: 1.5rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  display: flex;
  gap: 0.8rem;
}
.meeeku-dot {
  width: 12px;
  height: 12px;
  border-radius: 50% !important;
  background: rgba(61, 35, 85, 0.25);
  cursor: pointer;
  transition: background 0.3s ease, transform 0.3s ease;
  border: 1px solid #F8BBD0;
}
.meeeku-dot.active {
  background: #FF6097;
  transform: scale(1.3);
}

@media screen and (max-width: 850px) {
  .meeeku-slideshow-wrapper {
    height: 440px !important;
  }
  .meeeku-hero-col-text {
    max-width: 100% !important;
    padding: 2rem 1.6rem !important;
  }
  .meeeku-slide__headline {
    font-size: 2.5rem !important;
  }
  .meeeku-slideshow__nav {
    display: none !important;
  }
}
</style>

<script>
let currentMeeekuSlide = 0;
function moveMeeekuSlide(sectionId, step) {
  const container = document.getElementById('MeeekuSlideshow-' + sectionId);
  if(!container) return;
  const slides = container.querySelectorAll('.meeeku-slide');
  const dots = container.querySelectorAll('.meeeku-dot');
  slides[currentMeeekuSlide].classList.remove('active');
  dots[currentMeeekuSlide].classList.remove('active');
  currentMeeekuSlide = (currentMeeekuSlide + step + slides.length) % slides.length;
  slides[currentMeeekuSlide].classList.add('active');
  dots[currentMeeekuSlide].classList.add('active');
}
function setMeeekuSlide(sectionId, index) {
  const container = document.getElementById('MeeekuSlideshow-' + sectionId);
  if(!container) return;
  const slides = container.querySelectorAll('.meeeku-slide');
  const dots = container.querySelectorAll('.meeeku-dot');
  slides[currentMeeekuSlide].classList.remove('active');
  dots[currentMeeekuSlide].classList.remove('active');
  currentMeeekuSlide = index;
  slides[currentMeeekuSlide].classList.add('active');
  dots[currentMeeekuSlide].classList.add('active');
}

document.addEventListener('DOMContentLoaded', function() {
  const container = document.querySelector('.meeeku-slideshow-container');
  if (!container) return;
  let touchStartX = 0;
  let touchEndX = 0;
  container.addEventListener('touchstart', function(e) {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });
  container.addEventListener('touchend', function(e) {
    touchEndX = e.changedTouches[0].screenX;
    const sectionId = container.id.replace('MeeekuSlideshow-', '');
    if (touchStartX - touchEndX > 40) moveMeeekuSlide(sectionId, 1);
    else if (touchEndX - touchStartX > 40) moveMeeekuSlide(sectionId, -1);
  }, { passive: true });
});

setInterval(function() {
  const container = document.querySelector('.meeeku-slideshow-container');
  if (container) {
    const sectionId = container.id.replace('MeeekuSlideshow-', '');
    moveMeeekuSlide(sectionId, 1);
  }
}, 6000);
</script>

{% schema %}
{
  "name": "Meeeku Product Slideshow",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Meeeku Product Slideshow"
    }
  ]
}
{% endschema %}
