{% comment %}
  Meeeku Dynamic Hero Carousel & Scenery Slideshow (Shopify OS 2.0 CMS Connected)
  Fully editable via Shopify Theme Customizer: add, remove, and reorder slide blocks, upload desktop/mobile images, customize headings, tags, button CTAs, and links.
{% endcomment %}

{% liquid
  assign autoplay = section.settings.autoplay | default: true
  assign interval = section.settings.autoplay_interval | default: 6 | times: 1000
  assign slide_count = section.blocks.size
%}

<div class="meeeku-slideshow-wrapper" id="MeeekuSlideshowWrapper-{{ section.id }}">
  <div class="meeeku-slideshow-container" id="MeeekuSlideshow-{{ section.id }}" data-autoplay="{{ autoplay }}" data-interval="{{ interval }}">
    
    {% if slide_count > 0 %}
      {% for block in section.blocks %}
        {% liquid
          assign bg_img = block.settings.image
          assign mob_img = block.settings.mobile_image | default: bg_img
          assign badge = block.settings.badge_text
          assign heading = block.settings.heading
          assign tagline = block.settings.tagline
          assign btn_label = block.settings.button_label
          assign btn_link = block.settings.button_link | default: '/collections/all'
          assign btn_style = block.settings.button_style | default: 'primary'
        %}
        <div class="meeeku-slide {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {% if bg_img != blank %}
            <picture>
              {% if mob_img != blank and mob_img != bg_img %}
                <source media="(max-width: 749px)" srcset="{{ mob_img | image_url: width: 800 }}">
              {% endif %}
              <img src="{{ bg_img | image_url: width: 1920 }}" 
                   alt="{{ heading | default: 'Meeeku Hero Banner' | escape }}" 
                   class="meeeku-hero-bg-img" 
                   width="1920" 
                   height="1080" 
                   {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}>
            </picture>
          {% else %}
            <!-- Default Fallback Image based on slide index -->
            {% liquid
              assign default_asset = 'meeeku_hero_scenery_ethnic_wide.jpg'
              if forloop.index == 2
                assign default_asset = 'meeeku_hero_scenery_dresses_wide.jpg'
              elsif forloop.index == 3
                assign default_asset = 'meeeku_hero_scenery_coords_wide.jpg'
              endif
            %}
            <img src="{{ default_asset | asset_url }}" alt="{{ heading | escape }}" class="meeeku-hero-bg-img" width="1920" height="1080" {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}>
          {% endif %}

          <div class="page-width meeeku-slide__content-wrapper">
            <div class="meeeku-hero-col-text">
              {% if badge != blank %}
                <span class="meeeku-badge" style="background: {{ block.settings.badge_bg | default: '#EDE7F6' }}; color: {{ block.settings.badge_color | default: '#512DA8' }};">
                  {{ badge }}
                </span>
              {% endif %}
              
              {% if heading != blank %}
                <h2 class="meeeku-slide__headline">{{ heading }}</h2>
              {% endif %}

              {% if tagline != blank %}
                <p class="meeeku-slide__tagline">{{ tagline }}</p>
              {% endif %}

              {% if btn_label != blank %}
                <a href="{{ btn_link }}" class="button button--{{ btn_style }} meeeku-btn-pill">
                  {{ btn_label }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}

    {% else %}
      <!-- Fallback Default Brand Slides (Active when 0 blocks are configured) -->
      <!-- Slide 1: Indian Ethnic -->
      <div class="meeeku-slide active" data-index="0">
        <img src="{{ 'meeeku_hero_scenery_ethnic_wide.jpg' | asset_url }}" alt="Sunshine Chanderi Lehengas" class="meeeku-hero-bg-img" width="1920" height="1080" loading="eager">
        <div class="page-width meeeku-slide__content-wrapper">
          <div class="meeeku-hero-col-text">
            <span class="meeeku-badge meeeku-badge--ethnic">Girls Indian Ethnic</span>
            <h2 class="meeeku-slide__headline">Sunshine Chanderi Lehengas</h2>
            <p class="meeeku-slide__tagline">Handcrafted with 100% soft muslin cotton lining for zero-itch festive twirling all day long.</p>
            <a href="/collections/all?category=ethnic" class="button button--primary meeeku-btn-pill">Shop Ethnic Wear 👑</a>
          </div>
        </div>
      </div>

      <!-- Slide 2: Boys Collection & Winterwear -->
      <div class="meeeku-slide" data-index="1">
        <img src="{{ 'meeeku_prod_boy_pinstripe_linen_coord.jpg' | asset_url }}" alt="Boys Collection & Winterwear" class="meeeku-hero-bg-img" width="1920" height="1080" loading="lazy">
        <div class="page-width meeeku-slide__content-wrapper">
          <div class="meeeku-hero-col-text">
            <span class="meeeku-badge" style="background: #FFF8E1; color: #F57F17; border-color: #FFE082;">👦 Boys Collection • In Stock</span>
            <h2 class="meeeku-slide__headline">Handsome Co-ords & Cozy Winterwear</h2>
            <p class="meeeku-slide__tagline">Linen-cotton button-downs, comfy tracksuits & 100% skin-safe lounge sets for active little boys (0-6Y).</p>
            <a href="/collections/all?category=boys" class="button button--primary meeeku-btn-pill" style="background-color: #F57F17; border-color: #F57F17; color: #FFF; font-weight: 700;">Shop Boys Line 👦</a>
          </div>
        </div>
      </div>

      <!-- Slide 3: 2-Piece Organic Cotton Co-ords -->
      <div class="meeeku-slide" data-index="2">
        <img src="{{ 'meeeku_hero_scenery_coords_wide.jpg' | asset_url }}" alt="2-Piece Organic Cotton Co-ords" class="meeeku-hero-bg-img" width="1920" height="1080" loading="lazy">
        <div class="page-width meeeku-slide__content-wrapper">
          <div class="meeeku-hero-col-text">
            <span class="meeeku-badge" style="background: #E0F2F1; color: #00695C; border-color: #80CBC4;">Organic 2-Piece Co-ords ✨</span>
            <h2 class="meeeku-slide__headline">Organic 2-Piece Co-ord Sets</h2>
            <p class="meeeku-slide__tagline">Cloud-soft matching lounge sets with ruffled eyelet collars & storybook prints (0-6M to 3-4Y).</p>
            <a href="/collections/all?category=coords" class="button button--primary meeeku-btn-pill" style="background-color: #00695C; border-color: #00695C; font-weight: 700;">Shop 2-Piece Co-ords 🌸</a>
          </div>
        </div>
      </div>
    {% endif %}

    <!-- Navigation Arrows -->
    <button type="button" class="meeeku-slideshow__nav meeeku-slideshow__nav--prev" onclick="moveMeeekuSlide('{{ section.id }}', -1)" aria-label="Previous slide">&#10094;</button>
    <button type="button" class="meeeku-slideshow__nav meeeku-slideshow__nav--next" onclick="moveMeeekuSlide('{{ section.id }}', 1)" aria-label="Next slide">&#10095;</button>

    <!-- Dots Indicators -->
    <div class="meeeku-slideshow__dots">
      {% assign dot_count = slide_count %}
      {% if dot_count == 0 %}{% assign dot_count = 3 %}{% endif %}
      {% for i in (1..dot_count) %}
        <span class="meeeku-dot {% if forloop.first %}active{% endif %}" onclick="setMeeekuSlide('{{ section.id }}', {{ forloop.index0 }})"></span>
      {% endfor %}
    </div>

  </div>
</div>

<style>
.meeeku-slideshow-wrapper {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 580px;
  overflow: hidden;
  background-color: #FFFDF7;
}
.meeeku-slideshow-container {
  position: relative;
  width: 100%;
  height: 100%;
}
.meeeku-slide {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.7s ease-in-out, visibility 0.7s ease-in-out;
  display: flex;
  align-items: center;
}
.meeeku-slide.active {
  opacity: 1;
  visibility: visible;
}
.meeeku-hero-bg-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
  z-index: 1;
}
.meeeku-slide__content-wrapper {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  height: 100%;
  width: 100%;
}
.meeeku-hero-col-text {
  text-align: left;
  max-width: 520px;
  background: rgba(255, 253, 247, 0.92);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-radius: 28px;
  padding: 3rem;
  border: 2px solid #F8BBD0;
  box-shadow: 0 12px 36px rgba(107, 63, 160, 0.14);
}
.meeeku-slide__headline {
  color: #3D2355 !important;
  font-size: 3.4rem;
  font-weight: 800;
  line-height: 1.2;
  margin-top: 1rem;
  margin-bottom: 0.8rem;
}
.meeeku-slide__tagline {
  color: #555;
  font-size: 1.5rem;
  margin-bottom: 2rem;
  line-height: 1.5;
}
.meeeku-btn-pill {
  border-radius: 30px !important;
  font-size: 1.5rem !important;
  padding: 1.1rem 2.4rem !important;
}
.meeeku-slideshow__nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 5;
  background: rgba(255, 253, 247, 0.92);
  border: 1px solid #F8BBD0;
  color: #3D2355;
  width: 48px;
  height: 48px;
  border-radius: 50% !important;
  font-size: 2rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.3s ease, transform 0.3s ease;
  backdrop-filter: blur(4px);
  box-shadow: 0 4px 14px rgba(0,0,0,0.12);
}
.meeeku-slideshow__nav:hover {
  background: #FF6097;
  color: #FFF;
  transform: translateY(-50%) scale(1.1);
}
.meeeku-slideshow__nav--prev {
  left: 2rem;
}
.meeeku-slideshow__nav--next {
  right: 2rem;
}
.meeeku-slideshow__dots {
  position: absolute;
  bottom: 1.5rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  display: flex;
  gap: 0.8rem;
}
.meeeku-dot {
  width: 12px;
  height: 12px;
  border-radius: 50% !important;
  background: rgba(61, 35, 85, 0.25);
  cursor: pointer;
  transition: background 0.3s ease, transform 0.3s ease;
  border: 1px solid #F8BBD0;
}
.meeeku-dot.active {
  background: #FF6097;
  transform: scale(1.3);
}

@media screen and (max-width: 850px) {
  .meeeku-slideshow-wrapper {
    height: 440px !important;
  }
  .meeeku-hero-col-text {
    max-width: 100% !important;
    padding: 2rem 1.6rem !important;
  }
  .meeeku-slide__headline {
    font-size: 2.5rem !important;
  }
  .meeeku-slideshow__nav {
    display: none !important;
  }
}
</style>

<script>
window.MeeekuSlideshowState = window.MeeekuSlideshowState || {};

function moveMeeekuSlide(sectionId, step) {
  const container = document.getElementById('MeeekuSlideshow-' + sectionId);
  if (!container) return;
  const slides = container.querySelectorAll('.meeeku-slide');
  const dots = container.querySelectorAll('.meeeku-dot');
  if (slides.length <= 1) return;

  let current = window.MeeekuSlideshowState[sectionId] || 0;
  slides[current].classList.remove('active');
  if (dots[current]) dots[current].classList.remove('active');

  current = (current + step + slides.length) % slides.length;
  window.MeeekuSlideshowState[sectionId] = current;

  slides[current].classList.add('active');
  if (dots[current]) dots[current].classList.add('active');
}

function setMeeekuSlide(sectionId, index) {
  const container = document.getElementById('MeeekuSlideshow-' + sectionId);
  if (!container) return;
  const slides = container.querySelectorAll('.meeeku-slide');
  const dots = container.querySelectorAll('.meeeku-dot');
  if (slides.length <= index) return;

  let current = window.MeeekuSlideshowState[sectionId] || 0;
  slides[current].classList.remove('active');
  if (dots[current]) dots[current].classList.remove('active');

  window.MeeekuSlideshowState[sectionId] = index;

  slides[index].classList.add('active');
  if (dots[index]) dots[index].classList.add('active');
}

document.addEventListener('DOMContentLoaded', function() {
  const containers = document.querySelectorAll('.meeeku-slideshow-container');
  containers.forEach(function(container) {
    const sectionId = container.id.replace('MeeekuSlideshow-', '');
    window.MeeekuSlideshowState[sectionId] = 0;

    let touchStartX = 0;
    let touchEndX = 0;
    container.addEventListener('touchstart', function(e) {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    container.addEventListener('touchend', function(e) {
      touchEndX = e.changedTouches[0].screenX;
      if (touchStartX - touchEndX > 40) moveMeeekuSlide(sectionId, 1);
      else if (touchEndX - touchStartX > 40) moveMeeekuSlide(sectionId, -1);
    }, { passive: true });

    const isAutoplay = container.getAttribute('data-autoplay') === 'true';
    const intervalMs = parseInt(container.getAttribute('data-interval')) || 6000;
    if (isAutoplay) {
      setInterval(function() {
        moveMeeekuSlide(sectionId, 1);
      }, intervalMs);
    }
  });
});
</script>

{% schema %}
{
  "name": "Meeeku Product Slideshow",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Change slide every",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Background Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Background Image (Optional)"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "default": "Girls Indian Ethnic"
        },
        {
          "type": "color",
          "id": "badge_bg",
          "label": "Badge Background Color",
          "default": "#EDE7F6"
        },
        {
          "type": "color",
          "id": "badge_color",
          "label": "Badge Text Color",
          "default": "#512DA8"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Headline",
          "default": "Sunshine Chanderi Lehengas"
        },
        {
          "type": "textarea",
          "id": "tagline",
          "label": "Tagline",
          "default": "Handcrafted with 100% soft muslin cotton lining for zero-itch festive twirling all day long."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop Ethnic Wear 👑"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button Style",
          "options": [
            { "value": "primary", "label": "Primary Pink" },
            { "value": "secondary", "label": "Secondary Pastel" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Meeeku Product Slideshow",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "badge_text": "Girls Indian Ethnic",
            "heading": "Sunshine Chanderi Lehengas",
            "tagline": "Handcrafted with 100% soft muslin cotton lining for zero-itch festive twirling all day long.",
            "button_label": "Shop Ethnic Wear 👑",
            "button_link": "/collections/all?category=ethnic"
          }
        },
        {
          "type": "slide",
          "settings": {
            "badge_text": "👦 Boys Collection • In Stock",
            "badge_bg": "#FFF8E1",
            "badge_color": "#F57F17",
            "heading": "Handsome Co-ords & Cozy Winterwear",
            "tagline": "Linen-cotton button-downs, comfy tracksuits & 100% skin-safe lounge sets for active little boys (0-6Y).",
            "button_label": "Shop Boys Line 👦",
            "button_link": "/collections/all?category=boys",
            "button_style": "primary"
          }
        },
        {
          "type": "slide",
          "settings": {
            "badge_text": "Organic 2-Piece Co-ords ✨",
            "badge_bg": "#E0F2F1",
            "badge_color": "#00695C",
            "heading": "Organic 2-Piece Co-ord Sets",
            "tagline": "Cloud-soft matching lounge sets with ruffled eyelet collars & storybook prints (0-6M to 3-4Y).",
            "button_label": "Shop 2-Piece Co-ords 🌸",
            "button_link": "/collections/all?category=coords"
          }
        }
      ]
    }
  ]
}
{% endschema %}
