{% comment %}
  Meeeku Reworked Customer Support & Interactive Care Hub Section
{% endcomment %}

<div class="page-width meeeku-contact-hub" style="padding-top: 2rem; padding-bottom: 5rem;">
  <!-- Header Banner -->
  <div class="text-center" style="margin-bottom: 3rem;">
    <span class="meeeku-badge meeeku-badge--ethnic">We're Here to Help 💕</span>
    <h1 style="color: #3D2355; font-size: 3.4rem; font-weight: 800; margin-top: 0.8rem; margin-bottom: 0.5rem;">Contact Meeeku Customer Care</h1>
    <p style="color: #6B3FA0; font-size: 1.6rem; max-width: 620px; margin: 0 auto;">Have questions about sizing, organic fabric lining, or shipping? Our team is happy to assist!</p>
  </div>

  <div class="meeeku-contact-grid">
    <!-- Left Column: Customer Care Info Card -->
    <div class="meeeku-contact-info-card">
      <div class="text-center" style="margin-bottom: 2rem;">
        <img src="{{ 'logo.png' | asset_url }}" alt="Meeeku Brand Logo" width="100" height="100" style="max-height: 70px; width: auto; margin-bottom: 0.8rem;">
        <h3 style="color: #3D2355; font-size: 2.2rem; font-weight: 700; margin: 0;">Meeeku Studio Support</h3>
      </div>

      <div class="meeeku-contact-details">
        <div class="meeeku-contact-item">
          <span class="meeeku-contact-icon">💌</span>
          <div>
            <strong>Email Support</strong>
            <p><a href="mailto:hello@meeeku.com" style="color: #6B3FA0; text-decoration: none; font-weight: 600;">hello@meeeku.com</a></p>
          </div>
        </div>

        <div class="meeeku-contact-item">
          <span class="meeeku-contact-icon">💬</span>
          <div>
            <strong>WhatsApp & Phone</strong>
            <p><a href="tel:+919876543210" style="color: #6B3FA0; text-decoration: none; font-weight: 600;">+91 98765 43210</a></p>
          </div>
        </div>

        <div class="meeeku-contact-item">
          <span class="meeeku-contact-icon">📍</span>
          <div>
            <strong>Design Studio</strong>
            <p style="color: #555;">Jaipur & New Delhi, India</p>
          </div>
        </div>

        <div class="meeeku-contact-item">
          <span class="meeeku-contact-icon">⏰</span>
          <div>
            <strong>Studio Hours</strong>
            <p style="color: #555;">Monday – Saturday (10:00 AM – 7:00 PM IST)</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Styled Contact Form -->
    <div class="meeeku-contact-form-card">
      <h3 style="color: #3D2355; font-size: 2.2rem; font-weight: 700; margin-top: 0; margin-bottom: 1.5rem;">Send Us a Message</h3>

      {% form 'contact', id: 'ContactForm', class: 'meeeku-form-inner' %}
        {%- if form.posted_successfully? -%}
          <div class="form-status form-status-list form__message" tabindex="-1" autofocus style="color: #2E7D32; background: #E8F5E9; padding: 1.2rem; border-radius: 16px; margin-bottom: 1.5rem; font-weight: 600;">
            🎉 Thank you for reaching out! The Meeeku team will get back to you within 24 hours.
          </div>
        {%- endif -%}

        <div class="meeeku-field-group">
          <label for="ContactForm-name" style="display: block; font-weight: 700; color: #3D2355; margin-bottom: 0.5rem;">Your Full Name *</label>
          <input
            class="field__input"
            autocomplete="name"
            type="text"
            id="ContactForm-name"
            name="contact[Name]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="e.g. Ananya Sharma"
            required
            style="border: 2px solid #F8BBD0 !important; background: #FFFFFF !important; border-radius: 20px !important; width: 100%; padding: 1rem 1.4rem;"
          >
        </div>

        <div class="meeeku-field-group" style="margin-top: 1.2rem;">
          <label for="ContactForm-email" style="display: block; font-weight: 700; color: #3D2355; margin-bottom: 0.5rem;">Your Email Address *</label>
          <input
            class="field__input"
            autocomplete="email"
            type="email"
            id="ContactForm-email"
            name="contact[email]"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            placeholder="e.g. ananya@example.com"
            required
            style="border: 2px solid #F8BBD0 !important; background: #FFFFFF !important; border-radius: 20px !important; width: 100%; padding: 1rem 1.4rem;"
          >
        </div>

        <div class="meeeku-field-group" style="margin-top: 1.2rem;">
          <label for="ContactForm-phone" style="display: block; font-weight: 700; color: #3D2355; margin-bottom: 0.5rem;">Phone Number (Optional)</label>
          <input
            type="tel"
            id="ContactForm-phone"
            class="field__input"
            autocomplete="tel"
            name="contact[Phone]"
            pattern="[0-9\-]*"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            placeholder="+91 98765 43210"
            style="border: 2px solid #F8BBD0 !important; background: #FFFFFF !important; border-radius: 20px !important; width: 100%; padding: 1rem 1.4rem;"
          >
        </div>

        <div class="meeeku-field-group" style="margin-top: 1.2rem;">
          <label for="ContactForm-body" style="display: block; font-weight: 700; color: #3D2355; margin-bottom: 0.5rem;">How Can We Help You? *</label>
          <textarea
            rows="4"
            id="ContactForm-body"
            class="text-area field__input"
            name="contact[Comment]"
            placeholder="Tell us about sizing questions, order updates, or custom requests..."
            required
            style="border: 2px solid #F8BBD0 !important; background: #FFFFFF !important; border-radius: 20px !important; width: 100%; padding: 1rem 1.4rem;"
          >{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>

        <button type="submit" class="meeeku-btn-primary" style="width: 100%; text-align: center; margin-top: 1.5rem;">
          💌 Send Message to Meeeku Care
        </button>
      {% endform %}
    </div>
  </div>

  <!-- Image 2 Section: Quick Customer Resources (Size Guide & Wash Care) -->
  <div style="margin-top: 4rem; background: #FFFDF7; border: 2px solid #F8BBD0; border-radius: 28px; padding: 3rem 2.5rem; text-center;">
    <h3 style="color: #3D2355; font-size: 2.4rem; font-weight: 800; margin-top: 0; margin-bottom: 1.5rem; text-align: center;">Quick Care & Fit Guides</h3>
    
    <div style="display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap; margin-bottom: 2rem;">
      <!-- Link to Size Guide Modal -->
      <button type="button" class="meeeku-size-option" onclick="document.getElementById('MeeekuSizeGuideModal').style.display='flex'" style="font-size: 1.5rem; padding: 1rem 2rem;">
        📏 Size & Fit Guide (2-5Y)
      </button>

      <!-- Toggle Wash Care Accordion -->
      <button type="button" class="meeeku-size-option" onclick="toggleContactAccordion('ContactWashCareAcc')" style="font-size: 1.5rem; padding: 1rem 2rem;">
        🧺 Wash & Fabric Care Instructions
      </button>
    </div>

    <!-- Smooth Expandable Wash Care Accordion (Image 3 Fix) -->
    <div class="meeeku-accordion-item" id="ContactWashCareAcc" style="max-width: 750px; margin: 0 auto;">
      <div class="meeeku-accordion-header" onclick="toggleContactAccordion('ContactWashCareAcc')">
        <span>🧺 Wash & Fabric Care Instructions</span>
        <span class="meeeku-accordion-icon">▼</span>
      </div>
      <div class="meeeku-accordion-content">
        <ul style="line-height: 1.8; color: #555; font-size: 1.45rem; padding-left: 1.5rem; margin: 0;">
          <li><strong>Organza & Silk Lehengas:</strong> Dry clean only for first 2 washes. Hand wash in cold water with mild liquid detergent thereafter.</li>
          <li><strong>Organic Cotton Nightsuits:</strong> Gentle machine wash in cold water with like colors. Tumble dry low or line dry in shade.</li>
          <li><strong>Ironing:</strong> Warm iron on reverse side. Do not iron directly on zari embroidery or foil prints.</li>
        </ul>
      </div>
    </div>
  </div>

</div>

<script>
function toggleContactAccordion(id) {
  const item = document.getElementById(id);
  if (item) {
    item.classList.toggle('active');
  }
}
</script>

<style>
.meeeku-contact-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2.5rem;
  align-items: flex-start;
}
.meeeku-contact-info-card,
.meeeku-contact-form-card {
  background: #FFFDF7;
  border-radius: 28px;
  padding: 2.5rem 2.2rem;
  border: 2px solid #F8BBD0;
}
.meeeku-contact-details {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.meeeku-contact-item {
  display: flex;
  align-items: flex-start;
  gap: 1.2rem;
  font-size: 1.5rem;
}
.meeeku-contact-icon {
  font-size: 2.2rem;
}
</style>

{% schema %}
{
  "name": "Contact Form",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}
