{% comment %}
  Meeeku Reworked Customer Support & Contact Hub Section
{% endcomment %}

<div class="page-width meeeku-contact-hub" style="padding-top: 3rem; padding-bottom: 5rem;">
  <!-- Header Banner -->
  <div class="text-center" style="margin-bottom: 3rem;">
    <span class="meeeku-badge meeeku-badge--ethnic">We're Here to Help 💕</span>
    <h1 style="color: #3D2355; font-size: 3.6rem; font-weight: 800; margin-top: 1rem; margin-bottom: 0.5rem;">Contact Meeeku Customer Care</h1>
    <p style="color: #6B3FA0; font-size: 1.6rem;">Have questions about sizing, fabric lining, or shipping? Our team is always happy to assist!</p>
  </div>

  <div class="meeeku-contact-grid">
    <!-- Left Column: Customer Care Info Card -->
    <div class="meeeku-contact-info-card">
      <div class="text-center" style="margin-bottom: 2rem;">
        <img src="{{ 'logo.png' | asset_url }}" alt="Meeeku Brand Logo" width="100" height="100" style="max-height: 80px; width: auto; margin-bottom: 1rem;">
        <h3 style="color: #3D2355; font-size: 2.2rem; font-weight: 700;">Meeeku Studio Support</h3>
      </div>

      <div class="meeeku-contact-details">
        <div class="meeeku-contact-item">
          <span class="meeeku-contact-icon">💌</span>
          <div>
            <strong>Email Support</strong>
            <p><a href="mailto:hello@meeeku.com" style="color: #6B3FA0; text-decoration: none; font-weight: 600;">hello@meeeku.com</a></p>
          </div>
        </div>

        <div class="meeeku-contact-item">
          <span class="meeeku-contact-icon">💬</span>
          <div>
            <strong>WhatsApp & Phone</strong>
            <p><a href="tel:+919876543210" style="color: #6B3FA0; text-decoration: none; font-weight: 600;">+91 98765 43210</a></p>
          </div>
        </div>

        <div class="meeeku-contact-item">
          <span class="meeeku-contact-icon">📍</span>
          <div>
            <strong>Design Studio</strong>
            <p style="color: #555;">Jaipur & New Delhi, India</p>
          </div>
        </div>

        <div class="meeeku-contact-item">
          <span class="meeeku-contact-icon">⏰</span>
          <div>
            <strong>Studio Hours</strong>
            <p style="color: #555;">Monday – Saturday (10:00 AM – 7:00 PM IST)</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Styled Contact Form -->
    <div class="meeeku-contact-form-card">
      <h3 style="color: #3D2355; font-size: 2.2rem; font-weight: 700; margin-bottom: 1.5rem;">Send Us a Message</h3>

      {% form 'contact', id: 'ContactForm', class: 'meeeku-form-inner' %}
        {%- if form.posted_successfully? -%}
          <div class="form-status form-status-list form__message" tabindex="-1" autofocus style="color: #2E7D32; background: #E8F5E9; padding: 1.2rem; border-radius: 16px; margin-bottom: 1.5rem; font-weight: 600;">
            🎉 Thank you for reaching out! The Meeeku team will get back to you within 24 hours.
          </div>
        {%- endif -%}

        <div class="meeeku-field-group">
          <label for="ContactForm-name" style="display: block; font-weight: 700; color: #3D2355; margin-bottom: 0.5rem;">Your Full Name *</label>
          <input
            class="field__input"
            autocomplete="name"
            type="text"
            id="ContactForm-name"
            name="contact[Name]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="e.g. Ananya Sharma"
            required
            style="border: 2px solid #F8BBD0 !important; background: #FFFFFF !important; border-radius: 20px !important; width: 100%; padding: 1rem 1.4rem;"
          >
        </div>

        <div class="meeeku-field-group" style="margin-top: 1.5rem;">
          <label for="ContactForm-email" style="display: block; font-weight: 700; color: #3D2355; margin-bottom: 0.5rem;">Your Email Address *</label>
          <input
            class="field__input"
            autocomplete="email"
            type="email"
            id="ContactForm-email"
            name="contact[email]"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            placeholder="e.g. ananya@example.com"
            required
            style="border: 2px solid #F8BBD0 !important; background: #FFFFFF !important; border-radius: 20px !important; width: 100%; padding: 1rem 1.4rem;"
          >
        </div>

        <div class="meeeku-field-group" style="margin-top: 1.5rem;">
          <label for="ContactForm-phone" style="display: block; font-weight: 700; color: #3D2355; margin-bottom: 0.5rem;">Phone Number (Optional)</label>
          <input
            type="tel"
            id="ContactForm-phone"
            class="field__input"
            autocomplete="tel"
            name="contact[Phone]"
            pattern="[0-9\-]*"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            placeholder="+91 98765 43210"
            style="border: 2px solid #F8BBD0 !important; background: #FFFFFF !important; border-radius: 20px !important; width: 100%; padding: 1rem 1.4rem;"
          >
        </div>

        <div class="meeeku-field-group" style="margin-top: 1.5rem;">
          <label for="ContactForm-body" style="display: block; font-weight: 700; color: #3D2355; margin-bottom: 0.5rem;">How Can We Help You? *</label>
          <textarea
            rows="5"
            id="ContactForm-body"
            class="text-area field__input"
            name="contact[Comment]"
            placeholder="Tell us about sizing questions, order updates, or custom requests..."
            required
            style="border: 2px solid #F8BBD0 !important; background: #FFFFFF !important; border-radius: 20px !important; width: 100%; padding: 1rem 1.4rem;"
          >{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>

        <button type="submit" class="button button--primary" style="width: 100%; border-radius: 30px; margin-top: 2rem; font-size: 1.6rem; padding: 1.2rem;">
          💌 Send Message to Meeeku Care
        </button>
      {% endform %}
    </div>
  </div>
</div>

<style>
.meeeku-contact-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 3rem;
  align-items: flex-start;
}
.meeeku-contact-info-card {
  background: #FFFDF7;
  border-radius: 28px;
  padding: 3rem 2.5rem;
  border: 2px solid #F8BBD0;
  box-shadow: 0 10px 30px rgba(107, 63, 160, 0.08);
}
.meeeku-contact-details {
  display: flex;
  flex-direction: column;
  gap: 1.8rem;
}
.meeeku-contact-item {
  display: flex;
  align-items: flex-start;
  gap: 1.2rem;
  font-size: 1.5rem;
}
.meeeku-contact-icon {
  font-size: 2.2rem;
}
.meeeku-contact-form-card {
  background: #FFFDF7;
  border-radius: 28px;
  padding: 3rem 2.5rem;
  border: 2px solid #F8BBD0;
  box-shadow: 0 10px 30px rgba(107, 63, 160, 0.08);
}
</style>

{% schema %}
{
  "name": "Contact Form",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}
