{% comment %}
  Meeeku Dynamic Featured Products & Bestsellers Grid (Shopify OS 2.0 CMS Connected)
  Dynamically pulls real-time products, images, titles, pricing, variants, and discounts from Shopify.
  Allows merchant to select a Collection, pick individual Product blocks to rotate, or adjust count/columns in Theme Customizer.
{% endcomment %}

{% liquid
  assign title = section.settings.title | default: 'Featured Bestsellers'
  assign subtitle = section.settings.subtitle | default: 'Our most-loved 100% skin-safe cotton tees, 2-piece co-ord sets, and handcrafted festive lehengas.'
  assign badge = section.settings.badge | default: '⭐ Parent Favourites'
  assign limit = section.settings.products_to_show | default: 8
  assign cols_desktop = section.settings.columns_desktop | default: 4

  assign has_custom_blocks = false
  if section.blocks.size > 0
    assign has_custom_blocks = true
  endif

  assign target_collection = section.settings.collection
  if target_collection == blank and collections['all'] != blank and collections['all'].products.size > 0
    assign target_collection = collections['all']
  endif
%}

<section class="meeeku-featured-section page-width" id="MeeekuFeatured-{{ section.id }}" style="padding-top: 3.5rem; padding-bottom: 4.5rem;">
  
  <!-- Section Heading (Centered) -->
  <div style="text-align: center; margin-bottom: 3.5rem; width: 100%;">
    {% if badge != blank %}
      <span class="meeeku-badge meeeku-badge--popular" style="margin-bottom: 0.8rem; display: inline-block; font-size: 1.2rem; padding: 0.4rem 1.4rem;">
        {{ badge }}
      </span>
    {% endif %}
    <h2 style="color: #3D2355; font-size: 3.2rem; font-weight: 800; margin: 0.6rem 0 0.8rem; letter-spacing: -0.5px; text-align: center;">
      {{ title }}
    </h2>
    {% if subtitle != blank %}
      <p style="color: #666; font-size: 1.55rem; max-width: 580px; margin: 0 auto; line-height: 1.5; text-align: center;">
        {{ subtitle }}
      </p>
    {% endif %}
  </div>

  <!-- Dynamic Product Grid -->
  <div class="meeeku-featured-grid meeeku-grid--cols-{{ cols_desktop }}">
    
    {% if has_custom_blocks %}
      {% for block in section.blocks %}
        {% assign prod = block.settings.product %}
        {% if prod != blank %}
          {% render 'meeeku-featured-card', product: prod, custom_badge: block.settings.custom_badge, block_id: block.id %}
        {% endif %}
      {% endfor %}

    {% elsif target_collection != blank and target_collection.products.size > 0 %}
      {% for prod in target_collection.products limit: limit %}
        {% render 'meeeku-featured-card', product: prod %}
      {% endfor %}

    {% else %}
      <!-- Fallback Default Brand Showcase (Active when store has 0 products configured in Shopify) -->
      {% render 'meeeku-featured-card-fallback' %}
    {% endif %}

  </div>

  <!-- View All CTA Button -->
  {% if section.settings.show_view_all %}
    <div style="text-align: center; margin-top: 3.8rem; width: 100%;">
      <a href="{{ section.settings.view_all_link | default: '/collections/all' }}" class="meeeku-btn-primary" style="display: inline-block; text-decoration: none; padding: 1.2rem 3.5rem; font-size: 1.6rem; border-radius: 35px; box-shadow: 0 6px 20px rgba(255, 96, 151, 0.35);">
        {{ section.settings.view_all_label | default: 'View Full Catalog 👑' }}
      </a>
    </div>
  {% endif %}

</section>

<style>
.meeeku-featured-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
}
.meeeku-featured-grid.meeeku-grid--cols-3 {
  grid-template-columns: repeat(3, 1fr);
}
.meeeku-featured-grid.meeeku-grid--cols-4 {
  grid-template-columns: repeat(4, 1fr);
}
.meeeku-featured-grid.meeeku-grid--cols-2 {
  grid-template-columns: repeat(2, 1fr);
}

@media screen and (max-width: 990px) {
  .meeeku-featured-grid,
  .meeeku-featured-grid.meeeku-grid--cols-3,
  .meeeku-featured-grid.meeeku-grid--cols-4 {
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
}

@media screen and (max-width: 550px) {
  .meeeku-featured-grid,
  .meeeku-featured-grid.meeeku-grid--cols-3,
  .meeeku-featured-grid.meeeku-grid--cols-4 {
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
}
</style>

{% schema %}
{
  "name": "Featured Products Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Section Badge",
      "default": "⭐ Parent Favourites"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Bestsellers"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Our most-loved 100% skin-safe cotton tees, 2-piece co-ord sets, and handcrafted festive lehengas."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8,
      "label": "Number of products to show"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "4",
      "label": "Number of columns on desktop"
    },
    {
      "type": "header",
      "content": "View All Button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show 'View All' button"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "default": "View Full Catalog 👑",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "featured_product",
      "name": "Curated Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "custom_badge",
          "label": "Custom Badge (e.g. Best Seller, New Arrival, 2-Piece Set)",
          "placeholder": "⭐ Best Seller"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Meeeku Featured Products",
      "settings": {
        "title": "Featured Bestsellers",
        "products_to_show": 8,
        "columns_desktop": "4"
      }
    }
  ]
}
{% endschema %}
