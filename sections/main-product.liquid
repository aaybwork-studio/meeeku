{% comment %}
  Meeeku Universal Dynamic Product Template OS 2.0
  Natively renders ANY Shopify product object, with multi-image gallery, size variant pills, and rich sizing guides.
  Includes client-side instant hydration for previewing all newly added products seamlessly.
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_img = product.featured_image | default: product.images.first
  
  assign p_title = product.title | downcase
  assign p_type = product.type | downcase
  assign p_handle = product.handle | downcase
  assign p_tags = product.tags | join: ',' | downcase

  assign is_boy = false
  assign is_girl = false
  assign is_nightwear = false
  assign is_winterwear = false
  assign is_coord = false
  assign is_tee = false
  assign is_pajama = false
  assign is_towel = false
  assign is_ethnic = false
  assign is_sweater = false
  assign is_frock = false

  if p_tags contains 'sweater' or p_tags contains 'knitwear' or p_type contains 'sweater' or p_title contains 'sweater' or p_handle contains 'sweater'
    assign is_sweater = true
    assign is_winterwear = true
  endif
  if p_tags contains 'ethnic' or p_type contains 'ethnic' or p_tags contains 'lehenga' or p_type contains 'lehenga' or p_title contains 'lehenga' or p_handle contains 'lehenga'
    assign is_ethnic = true
  endif
  if is_ethnic == false
    if p_tags contains 'frock' or p_tags contains 'dress' or p_type contains 'frock' or p_title contains 'frock' or p_handle contains 'frock'
      assign is_frock = true
      assign is_girl = true
    endif
  endif
  if p_tags contains 'boys' or p_type contains 'boys' or p_title contains 'boy' or p_handle contains 'boy'
    assign is_boy = true
  endif
  if p_tags contains 'girls' or p_type contains 'girls' or p_title contains 'girl' or p_handle contains 'girl' or is_ethnic or is_frock
    assign is_girl = true
  endif
  if p_tags contains 'nightwear' or p_tags contains 'nightsuit' or p_type contains 'nightwear' or p_title contains 'nightsuit' or p_title contains 'sleep' or p_handle contains 'nightsuit'
    assign is_nightwear = true
  endif
  if p_tags contains 'winterwear' or p_type contains 'winterwear' or p_tags contains 'winter' or p_tags contains 'fleece' or p_title contains 'winter' or p_title contains 'tracksuit' or p_title contains 'fleece' or p_title contains 'hoodie' or is_sweater
    assign is_winterwear = true
  endif
  if p_tags contains 'pajamas' or p_tags contains 'pajama' or p_type contains 'pajama' or p_title contains 'pajama' or p_handle contains 'pajama'
    assign is_pajama = true
  endif
  if p_tags contains 'towels' or p_tags contains 'towel' or p_tags contains 'blanket' or p_tags contains 'swaddle' or p_type contains 'towel' or p_type contains 'blanket' or p_title contains 'towel' or p_title contains 'blanket'
    assign is_towel = true
  endif
  if is_ethnic == false and is_sweater == false and is_frock == false
    if p_tags contains 'coord' or p_tags contains 'co-ord' or p_type contains 'coord' or p_type contains 'co-ord' or p_title contains 'coord' or p_title contains 'co-ord'
      assign is_coord = true
    endif
  endif
  if p_tags contains 'tee' or p_type contains 'tee' or p_title contains 'tee' or p_title contains 'sweatshirt' or p_handle contains 'tee'
    assign is_tee = true
  endif

  if is_ethnic
    assign category_badge = '👑 Handcrafted Royal Ethnic'
    assign badge_class = 'meeeku-badge--ethnic'
  elsif is_sweater
    assign category_badge = '🧶 100% Cotton Knit'
    assign badge_class = 'meeeku-badge--winter'
  elsif is_frock
    assign category_badge = '👗 Princess Bubble Frock'
    assign badge_class = 'meeeku-badge--coord'
  elsif is_pajama
    assign category_badge = '🧸 2-Pack Pajama Set'
    assign badge_class = 'meeeku-badge--pajama'
  elsif is_towel
    assign category_badge = '🛁 100% Organic Muslin & Terry'
    assign badge_class = 'meeeku-badge--towel'
  elsif is_boy and is_winterwear
    assign category_badge = '👦 Boys Winterwear Tracksuit'
    assign badge_class = 'meeeku-badge--boy'
  elsif is_boy and is_coord
    assign category_badge = '👦 Boys Linen Co-ord Set'
    assign badge_class = 'meeeku-badge--boy'
  elsif is_nightwear
    assign category_badge = '🌙 Pure Cotton Nightsuit'
    assign badge_class = 'meeeku-badge--night'
  elsif is_girl and is_winterwear
    assign category_badge = '❄️ Cozy Winterwear'
    assign badge_class = 'meeeku-badge--winter'
  elsif is_coord
    assign category_badge = '🌸 2-Piece Cotton Co-ord'
    assign badge_class = 'meeeku-badge--coord'
  elsif is_tee
    assign category_badge = '👕 100% Combed Cotton'
    assign badge_class = 'meeeku-badge--tee'
  else
    assign category_badge = '✨ Meeeku Premium Quality'
    assign badge_class = 'meeeku-badge--ethnic'
  endif

  assign has_discount = false
  if current_variant.compare_at_price > current_variant.price
    assign has_discount = true
    assign savings = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price
  endif
%}

<product-info id="MainProduct-{{ section.id }}" class="product-info page-width meeeku-pdp-container" data-section="{{ section.id }}" data-product-id="{{ product.id }}" style="display: block; padding-top: 2rem; padding-bottom: 5rem;">
  
  <div class="meeeku-pdp-layout">
    <!-- LEFT COLUMN: Image Gallery -->
    <div class="meeeku-pdp-gallery-col">
      <div class="meeeku-pdp-gallery-wrapper">
        <div class="meeeku-pdp-thumbs-list" id="MeeekuPdpThumbsList" style="{% if product.images.size <= 1 %}display: none;{% endif %}">
          {% if product.images.size > 1 %}
            {% for img in product.images %}
              <div class="meeeku-pdp-thumb-item {% if forloop.first %}active{% endif %}" 
                   onclick="meeekuSwitchMainPdpImg(this, '{{ img | image_url: width: 900 }}')">
                <img src="{{ img | image_url: width: 160 }}" alt="{{ img.alt | default: product.title }}" width="75" height="95" loading="lazy">
                <span>View {{ forloop.index }}</span>
              </div>
            {% endfor %}
          {% endif %}
        </div>

        <div class="meeeku-pdp-hero-image">
          {% if featured_img %}
            <img id="MeeekuMainPdpImage" 
                 src="{{ featured_img | image_url: width: 900 }}" 
                 alt="{{ product.title | escape }}" 
                 width="600" 
                 height="750" 
                 loading="eager">
          {% else %}
            <!-- Fallback Image -->
            <img id="MeeekuMainPdpImage" 
                 src="{{ 'meeeku_prod_yellow_lehenga.jpg' | asset_url }}" 
                 alt="{{ product.title | escape }}" 
                 width="600" 
                 height="750" 
                 loading="eager">
          {% endif %}
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: Product Info & Form -->
    <div class="meeeku-pdp-info-col">
      <span class="meeeku-badge {{ badge_class }}" id="MeeekuPdpBadge" style="display: inline-block; margin-bottom: 0.8rem;">{{ category_badge }}</span>
      <h1 class="meeeku-pdp-title" id="MeeekuPdpTitle">{{ product.title }}</h1>

      <div style="display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1.2rem;">
        <span style="color: #FFB300; font-size: 1.5rem;">⭐⭐⭐⭐⭐</span>
        <span style="font-weight: 700; color: #FF6097; font-size: 1.35rem;">4.9 (128 verified reviews)</span>
      </div>

      <div style="margin-bottom: 1.5rem; display: flex; align-items: baseline; gap: 1rem;">
        <span class="meeeku-pdp-price" id="MeeekuDisplayPriceText">{{ current_variant.price | money }}</span>
        <span style="font-size: 1.6rem; color: #888; text-decoration: line-through; {% unless has_discount %}display:none;{% endunless %}" id="MeeekuDisplayMrpText">
          {{ current_variant.compare_at_price | money }}
        </span>
        <span class="meeeku-badge" id="MeeekuDisplayDiscountBadge" style="background: #E8F5E9; color: #2E7D32; font-size: 1.1rem; padding: 0.2rem 0.8rem; {% unless has_discount %}display:none;{% endunless %}">
          SAVE {{ savings }}%
        </span>
      </div>

      <div id="MeeekuPdpDescription" style="color: #555; font-size: 1.45rem; line-height: 1.6; margin-bottom: 1.8rem;">
        {% if product.description != blank %}
          {{ product.description }}
        {% else %}
          <p>Crafted from 100% skin-safe, zero-itch breathable fabric. Designed for cozy everyday play, gentle bedtime sleep, and festive family celebrations.</p>
          <ul>
            <li>100% Pure Combed Organic Cotton / Linen blend</li>
            <li>Zero-itch tagless collar & flatlock seams</li>
            <li>Elasticated comfort waistbands for easy movement</li>
            <li>Gentle Machine Wash Cold</li>
          </ul>
        {% endif %}
      </div>

      {% form 'product', product, id: 'MeeekuPdpNativeForm', class: 'meeeku-pdp-form' %}
        <input type="hidden" name="id" id="MeeekuVariantIdInput" value="{{ current_variant.id }}">
        
        <!-- Size Selector -->
        <div style="margin-bottom: 1.8rem;">
          <label id="MeeekuPdpSizeLabel" style="font-weight: 700; color: #3D2355; font-size: 1.45rem; display: block; margin-bottom: 0.8rem;">
            Select Size ({% if is_towel %}One Size 0-3Y{% elsif is_pajama or is_tee or is_coord %}0 – 3 Years{% elsif is_winterwear %}1 – 6 Years{% else %}0 – 7 Years{% endif %}):
          </label>
          <div class="meeeku-pdp-size-grid" id="MeeekuPdpSizeGrid">
            {% if product.variants.size > 0 %}
              {% for variant in product.variants %}
                <button type="button" 
                        class="meeeku-size-btn {% if variant.id == current_variant.id %}active{% endif %} {% unless variant.available %}sold-out{% endunless %}" 
                        data-variant-id="{{ variant.id }}"
                        data-price="{{ variant.price | money }}"
                        data-compare-price="{{ variant.compare_at_price | money }}"
                        data-available="{{ variant.available }}"
                        onclick="meeekuSelectVariantBtn(this, '{{ variant.id }}', '{{ variant.price | money }}', '{{ variant.compare_at_price | money }}')">
                  {{ variant.title }}
                </button>
              {% endfor %}
            {% else %}
              <button type="button" class="meeeku-size-btn active" onclick="meeekuSelectVariantBtn(this, '', '{{ current_variant.price | money }}')">Standard</button>
            {% endif %}
          </div>
        </div>

        <!-- Add to Cart & Buy It Now CTAs -->
        <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
          <button type="submit" name="add" class="meeeku-btn-primary" style="width: 100%; text-align: center; font-size: 1.5rem; padding: 1.2rem; cursor: pointer;">
            🛒 Add to Cart — <span id="MeeekuBtnPriceLabel">{{ current_variant.price | money }}</span>
          </button>
          <button type="button" class="meeeku-btn-secondary" style="width: 100%; text-align: center; font-size: 1.5rem; padding: 1.2rem; cursor: pointer;" onclick="meeekuTriggerBuyNow()">
            ⚡ Buy It Now
          </button>
        </div>
      {% endform %}

      <!-- Trust Badges -->
      {% render 'meeeku-trust-badges' %}

      <!-- Sizing Guide Inline -->
      <div class="meeeku-size-guide-inline" style="margin-top: 2rem; background: #FFFDF7; border: 1.5px solid #F8BBD0; border-radius: 20px; padding: 1.8rem;">
        <h3 id="MeeekuSizeGuideHeading" style="color: #3D2355; font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem;">
          {% if is_towel %}
            🛁 Bath Towel & Blanket Dimensions (0 – 3 Years)
          {% elsif is_pajama %}
            🧸 2-Pack Pajamas Size & Fit Guide (0 – 3 Years)
          {% elsif is_winterwear %}
            ❄️ Winterwear & Tracksuit Size Guide (1 – 6 Years)
          {% elsif is_tee %}
            📏 T-Shirt Size & Fit Guide (0 – 3 Years)
          {% elsif is_coord %}
            📏 2-Piece Co-ord Size Guide (0 – 3 Years)
          {% else %}
            📏 Size & Fit Guide (0 – 7 Years)
          {% endif %}
        </h3>
        <div id="MeeekuSizeGuideTableWrap" style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; font-size: 1.25rem;">
            <thead>
              <tr style="background: #F8BBD0; color: #3D2355;" id="MeeekuSizeGuideTheadRow">
                <th style="padding: 0.6rem 0.8rem; text-align: left;">Age</th>
                <th style="padding: 0.6rem 0.8rem; text-align: center;">Height (cm)</th>
                <th style="padding: 0.6rem 0.8rem; text-align: center;">Chest (cm)</th>
                <th style="padding: 0.6rem 0.8rem; text-align: center;">Length / Waist</th>
              </tr>
            </thead>
            <tbody id="MeeekuSizeGuideTbody">
              {% if is_towel %}
                <tr><td style="padding: 0.5rem 0.8rem; font-weight: 700;">One Size (0-3Y)</td><td style="text-align:center;">80 - 90 cm</td><td style="text-align:center;">Generous Wrap</td><td style="text-align:center;">85cm x 85cm</td></tr>
              {% elsif is_pajama %}
                <tr><td style="padding: 0.5rem 0.8rem;">0 – 6M</td><td style="text-align:center;">60–68</td><td style="text-align:center;">44–46</td><td style="text-align:center;">Waist: 18" | Inseam: 9"</td></tr>
                <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">6 – 12M</td><td style="text-align:center;">68–76</td><td style="text-align:center;">46–48</td><td style="text-align:center;">Waist: 19" | Inseam: 11"</td></tr>
                <tr><td style="padding: 0.5rem 0.8rem;">12 – 18M</td><td style="text-align:center;">76–84</td><td style="text-align:center;">48–50</td><td style="text-align:center;">Waist: 19.5" | Inseam: 13"</td></tr>
                <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">18 – 24M</td><td style="text-align:center;">84–90</td><td style="text-align:center;">50–52</td><td style="text-align:center;">Waist: 20" | Inseam: 14.5"</td></tr>
                <tr><td style="padding: 0.5rem 0.8rem;">2 – 3Y</td><td style="text-align:center;">90–98</td><td style="text-align:center;">52–54</td><td style="text-align:center;">Waist: 21" | Inseam: 16"</td></tr>
              {% elsif is_winterwear %}
                <tr><td style="padding: 0.5rem 0.8rem;">1 – 2Y</td><td style="text-align:center;">80–90</td><td style="text-align:center;">48–51</td><td style="text-align:center;">Top: 36cm | Pant: 46cm</td></tr>
                <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">2 – 3Y</td><td style="text-align:center;">90–98</td><td style="text-align:center;">50–53</td><td style="text-align:center;">Top: 39cm | Pant: 51cm</td></tr>
                <tr><td style="padding: 0.5rem 0.8rem;">3 – 4Y</td><td style="text-align:center;">98–104</td><td style="text-align:center;">53–56</td><td style="text-align:center;">Top: 42cm | Pant: 56cm</td></tr>
                <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">4 – 5Y</td><td style="text-align:center;">104–110</td><td style="text-align:center;">56–59</td><td style="text-align:center;">Top: 45cm | Pant: 61cm</td></tr>
                <tr><td style="padding: 0.5rem 0.8rem;">5 – 6Y</td><td style="text-align:center;">110–116</td><td style="text-align:center;">59–62</td><td style="text-align:center;">Top: 48cm | Pant: 66cm</td></tr>
              {% elsif is_tee or is_coord %}
                <tr><td style="padding: 0.5rem 0.8rem;">0 – 6M</td><td style="text-align:center;">60–68</td><td style="text-align:center;">44–46</td><td style="text-align:center;">31 cm</td></tr>
                <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">6 – 12M</td><td style="text-align:center;">68–76</td><td style="text-align:center;">46–48</td><td style="text-align:center;">33 cm</td></tr>
                <tr><td style="padding: 0.5rem 0.8rem;">12 – 18M</td><td style="text-align:center;">76–84</td><td style="text-align:center;">48–50</td><td style="text-align:center;">35 cm</td></tr>
                <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">18 – 24M</td><td style="text-align:center;">84–90</td><td style="text-align:center;">50–52</td><td style="text-align:center;">37 cm</td></tr>
                <tr><td style="padding: 0.5rem 0.8rem;">2 – 3Y</td><td style="text-align:center;">90–98</td><td style="text-align:center;">52–54</td><td style="text-align:center;">40 cm</td></tr>
              {% else %}
                <tr><td style="padding: 0.5rem 0.8rem;">0 – 1Y</td><td style="text-align:center;">70–80</td><td style="text-align:center;">46–49</td><td style="text-align:center;">45–48</td></tr>
                <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">1 – 2Y</td><td style="text-align:center;">80–90</td><td style="text-align:center;">48–51</td><td style="text-align:center;">47–50</td></tr>
                <tr><td style="padding: 0.5rem 0.8rem;">2 – 3Y</td><td style="text-align:center;">90–98</td><td style="text-align:center;">50–53</td><td style="text-align:center;">49–52</td></tr>
                <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">3 – 4Y</td><td style="text-align:center;">98–104</td><td style="text-align:center;">53–56</td><td style="text-align:center;">52–55</td></tr>
                <tr><td style="padding: 0.5rem 0.8rem;">4 – 5Y</td><td style="text-align:center;">104–110</td><td style="text-align:center;">56–59</td><td style="text-align:center;">55–58</td></tr>
                <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">5 – 6Y</td><td style="text-align:center;">110–116</td><td style="text-align:center;">59–62</td><td style="text-align:center;">58–61</td></tr>
                <tr><td style="padding: 0.5rem 0.8rem;">6 – 7Y</td><td style="text-align:center;">116–122</td><td style="text-align:center;">62–65</td><td style="text-align:center;">61–64</td></tr>
              {% endif %}
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</product-info>

<style>
.meeeku-pdp-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: flex-start;
  position: relative;
}
.meeeku-pdp-gallery-wrapper {
  display: flex;
  gap: 1.2rem;
  align-items: flex-start;
}
.meeeku-pdp-thumbs-list {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  width: 75px;
  flex-shrink: 0;
}
.meeeku-pdp-thumb-item {
  width: 75px;
  height: 95px;
  border-radius: 12px;
  overflow: hidden;
  border: 2px solid #F8BBD0;
  cursor: pointer;
  opacity: 0.7;
  transition: all 0.2s ease;
  background: #FFF;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.meeeku-pdp-thumb-item.active,
.meeeku-pdp-thumb-item:hover {
  opacity: 1;
  border-color: #6B3FA0;
  transform: scale(1.04);
}
.meeeku-pdp-thumb-item img {
  width: 100%;
  height: 75px;
  object-fit: cover;
  object-position: top center;
}
.meeeku-pdp-thumb-item span {
  font-size: 0.85rem;
  font-weight: 700;
  color: #6B3FA0;
  text-align: center;
  width: 100%;
  background: #FFF9F4;
}
.meeeku-pdp-hero-image {
  flex: 1;
  border-radius: 24px;
  overflow: hidden;
  border: 2px solid #F8BBD0;
  background: #FFFDF7;
  box-shadow: 0 10px 30px rgba(107, 63, 160, 0.08);
}
.meeeku-pdp-hero-image img {
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  object-position: top center;
  display: block;
}
.meeeku-pdp-title {
  color: #3D2355;
  font-size: 2.8rem;
  font-weight: 800;
  margin: 0 0 0.8rem;
  line-height: 1.25;
}
.meeeku-pdp-price {
  font-size: 2.4rem;
  font-weight: 800;
  color: #6B3FA0;
}
.meeeku-pdp-size-grid {
  display: flex;
  gap: 0.8rem;
  flex-wrap: wrap;
}
.meeeku-size-btn {
  border: 2px solid #F8BBD0;
  background: #FFFDF7;
  color: #3D2355;
  padding: 0.6rem 1.4rem;
  border-radius: 25px;
  font-size: 1.35rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
}
.meeeku-size-btn:hover,
.meeeku-size-btn.active {
  background: #FF6097;
  color: #FFF;
  border-color: #FF6097;
}
.meeeku-size-btn.sold-out {
  opacity: 0.4;
  text-decoration: line-through;
  cursor: not-allowed;
}
.meeeku-badge--tee { background: #E8F5E9; color: #2E7D32; border: 1px solid #A5D6A7; }
.meeeku-badge--coord { background: #E0F2F1; color: #00695C; border: 1px solid #80CBC4; }
.meeeku-badge--ethnic { background: #FFF0F5; color: #6B3FA0; border: 1px solid #F8BBD0; }
.meeeku-badge--boy { background: #FFF8E1; color: #F57F17; border: 1px solid #FFE082; }
.meeeku-badge--night { background: #F3E5F5; color: #4A148C; border: 1px solid #CE93D8; }
.meeeku-badge--winter { background: #FCE4EC; color: #C2185B; border: 1px solid #F48FB1; }
.meeeku-badge--pajama { background: #EDE7F6; color: #512DA8; border: 1px solid #D1C4E9; }
.meeeku-badge--towel { background: #E0F7FA; color: #00838F; border: 1px solid #80DEEA; }

@media screen and (max-width: 749px) {
  .meeeku-pdp-layout {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .meeeku-pdp-gallery-wrapper {
    flex-direction: column-reverse;
  }
  .meeeku-pdp-thumbs-list {
    flex-direction: row;
    width: 100%;
    overflow-x: auto;
    justify-content: center;
  }
  .meeeku-pdp-title {
    font-size: 2.2rem;
  }
}
</style>

<script>
const MEEKU_ALL_PRODUCTS = {
  "sunshine-chanderi-lehenga": {
    "handle": "sunshine-chanderi-lehenga",
    "title": "Sunshine Chanderi Lehenga",
