{% comment %}
  Meeeku Universal Dynamic Product Template OS 2.0
  Natively renders ANY Shopify product object, with multi-image gallery, size variant pills, and rich sizing guides.
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_img = product.featured_image | default: product.images.first
  
  assign p_title = product.title | downcase
  assign p_type = product.type | downcase
  assign p_handle = product.handle | downcase
  assign p_tags = product.tags | join: ',' | downcase

  assign is_tee = false
  assign is_coord = false
  assign is_ethnic = false

  if p_type contains 'tee' or p_tags contains 'tee' or p_tags contains 'basic' or p_title contains 'tee' or p_handle contains 'tee'
    assign is_tee = true
  elsif p_type contains 'co-ord' or p_type contains 'outfit set' or p_tags contains 'coord' or p_tags contains 'co-ord' or p_title contains 'co-ord' or p_title contains 'set' or p_handle contains 'coord'
    assign is_coord = true
  else
    assign is_ethnic = true
  endif

  if is_tee
    assign category_badge = '100% Combed Organic Cotton'
    assign badge_class = 'meeeku-badge--tee'
  elsif is_coord
    assign category_badge = 'Pure Breathable Cotton'
    assign badge_class = 'meeeku-badge--coord'
  else
    assign category_badge = 'Royal Festive Ethnic'
    assign badge_class = 'meeeku-badge--ethnic'
  endif

  assign has_discount = false
  if current_variant.compare_at_price > current_variant.price
    assign has_discount = true
    assign savings = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price
  endif
%}

<product-info id="MainProduct-{{ section.id }}" class="product-info page-width meeeku-pdp-container" data-section="{{ section.id }}" data-product-id="{{ product.id }}" style="display: block; padding-top: 2rem; padding-bottom: 5rem;">
  
  <div class="meeeku-pdp-layout">
    <!-- LEFT COLUMN: Image Gallery -->
    <div class="meeeku-pdp-gallery-col">
      <div class="meeeku-pdp-gallery-wrapper">
        {% if product.images.size > 1 %}
          <div class="meeeku-pdp-thumbs-list" id="MeeekuPdpThumbsList">
            {% for img in product.images %}
              <div class="meeeku-pdp-thumb-item {% if forloop.first %}active{% endif %}" 
                   onclick="meeekuSwitchMainPdpImg(this, '{{ img | image_url: width: 900 }}')">
                <img src="{{ img | image_url: width: 160 }}" alt="{{ img.alt | default: product.title }}" width="75" height="95" loading="lazy">
                <span>View {{ forloop.index }}</span>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        <div class="meeeku-pdp-hero-image">
          {% if featured_img %}
            <img id="MeeekuMainPdpImage" 
                 src="{{ featured_img | image_url: width: 900 }}" 
                 alt="{{ product.title | escape }}" 
                 width="600" 
                 height="750" 
                 loading="eager"
                 style="border-radius: 24px; width: 100%; object-fit: cover; border: 2px solid #F8BBD0; box-shadow: 0 12px 36px rgba(107, 63, 160, 0.08);">
          {% else %}
            <!-- Fallback Image -->
            <img id="MeeekuMainPdpImage" 
                 src="{{ 'meeeku_prod_yellow_lehenga.jpg' | asset_url }}" 
                 alt="{{ product.title | escape }}" 
                 width="600" 
                 height="750" 
                 loading="eager"
                 style="border-radius: 24px; width: 100%; object-fit: cover; border: 2px solid #F8BBD0; box-shadow: 0 12px 36px rgba(107, 63, 160, 0.08);">
          {% endif %}
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: Product Info & Form -->
    <div class="meeeku-pdp-info-col">
      <span class="meeeku-badge {{ badge_class }}" id="MeeekuPdpBadge" style="display: inline-block; margin-bottom: 0.8rem;">{{ category_badge }}</span>
      <h1 class="meeeku-pdp-title" id="MeeekuPdpTitle">{{ product.title }}</h1>

      <div style="display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1.2rem;">
        <span style="color: #FFB300; font-size: 1.5rem;">⭐⭐⭐⭐⭐</span>
        <span style="font-weight: 700; color: #FF6097; font-size: 1.35rem;">4.9 (128 verified reviews)</span>
      </div>

      <div style="margin-bottom: 1.5rem; display: flex; align-items: baseline; gap: 1rem;">
        <span class="meeeku-pdp-price" id="MeeekuDisplayPriceText">{{ current_variant.price | money }}</span>
        <span style="font-size: 1.6rem; color: #888; text-decoration: line-through; {% unless has_discount %}display:none;{% endunless %}" id="MeeekuDisplayMrpText">
          {{ current_variant.compare_at_price | money }}
        </span>
        <span class="meeeku-badge" id="MeeekuDisplayDiscountBadge" style="background: #E8F5E9; color: #2E7D32; font-size: 1.1rem; padding: 0.2rem 0.8rem; {% unless has_discount %}display:none;{% endunless %}">
          SAVE {{ savings }}%
        </span>
      </div>

      <div id="MeeekuPdpDescription" style="color: #555; font-size: 1.45rem; line-height: 1.6; margin-bottom: 1.8rem;">
        {% if product.description != blank %}
          {{ product.description }}
        {% else %}
          Crafted from 100% skin-safe, zero-itch breathable fabric. Designed for playful moments and royal festive celebrations.
        {% endif %}
      </div>

      {% form 'product', product, id: 'MeeekuPdpNativeForm', class: 'meeeku-pdp-form' %}
        <input type="hidden" name="id" id="MeeekuVariantIdInput" value="{{ current_variant.id }}">
        
        <!-- Size Selector -->
        <div style="margin-bottom: 1.8rem;">
          <label id="MeeekuPdpSizeLabel" style="font-weight: 700; color: #3D2355; font-size: 1.45rem; display: block; margin-bottom: 0.8rem;">
            Select Size ({% if is_tee or is_coord %}0 – 3 Years{% else %}0 – 7 Years{% endif %}):
          </label>
          <div class="meeeku-pdp-size-grid" id="MeeekuPdpSizeGrid">
            {% if product.variants.size > 0 %}
              {% for variant in product.variants %}
                <button type="button" 
                        class="meeeku-size-btn {% if variant.id == current_variant.id %}active{% endif %} {% unless variant.available %}sold-out{% endunless %}" 
                        data-variant-id="{{ variant.id }}"
                        data-price="{{ variant.price | money }}"
                        data-compare-price="{{ variant.compare_at_price | money }}"
                        data-available="{{ variant.available }}"
                        onclick="meeekuSelectVariantBtn(this, '{{ variant.id }}', '{{ variant.price | money }}', '{{ variant.compare_at_price | money }}')">
                  {{ variant.title }}
                </button>
              {% endfor %}
            {% else %}
              <button type="button" class="meeeku-size-btn active" onclick="meeekuSelectVariantBtn(this, '', '{{ current_variant.price | money }}')">Standard</button>
            {% endif %}
          </div>
        </div>

        <!-- Add to Cart & Buy It Now CTAs -->
        <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
          <button type="submit" name="add" class="meeeku-btn-primary" style="width: 100%; text-align: center; font-size: 1.5rem; padding: 1.2rem; cursor: pointer;">
            🛒 Add to Cart — <span id="MeeekuBtnPriceLabel">{{ current_variant.price | money }}</span>
          </button>
          <button type="button" class="meeeku-btn-secondary" style="width: 100%; text-align: center; font-size: 1.5rem; padding: 1.2rem; cursor: pointer;" onclick="meeekuTriggerBuyNow()">
            ⚡ Buy It Now
          </button>
        </div>
      {% endform %}

      <!-- Trust Badges -->
      {% render 'meeeku-trust-badges' %}

      <!-- Sizing Guide Inline -->
      <div class="meeeku-size-guide-inline" style="margin-top: 2rem; background: #FFFDF7; border: 1.5px solid #F8BBD0; border-radius: 20px; padding: 1.8rem;">
        <h3 id="MeeekuSizeGuideHeading" style="color: #3D2355; font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem;">
          {% if is_tee %}📏 T-Shirt Size & Fit Guide (0 – 3 Years){% elsif is_coord %}📏 2-Piece Co-ord Size Guide (0 – 3 Years){% else %}📏 Size & Fit Guide (0 – 7 Years){% endif %}
        </h3>
        <div id="MeeekuSizeGuideTableWrap" style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; font-size: 1.25rem;">
            <thead>
              <tr style="background: #F8BBD0; color: #3D2355;">
                <th style="padding: 0.6rem 0.8rem; text-align: left;">Age</th>
                <th style="padding: 0.6rem 0.8rem; text-align: center;">Height (cm)</th>
                <th style="padding: 0.6rem 0.8rem; text-align: center;">Chest (cm)</th>
                <th style="padding: 0.6rem 0.8rem; text-align: center;">{% if is_tee or is_coord %}Length (cm){% else %}Waist (cm){% endif %}</th>
              </tr>
            </thead>
            <tbody id="MeeekuSizeGuideTbody">
              {% if is_tee or is_coord %}
                <tr><td style="padding: 0.5rem 0.8rem;">0 – 6M</td><td style="text-align:center;">60–68</td><td style="text-align:center;">44–46</td><td style="text-align:center;">31</td></tr>
                <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">6 – 12M</td><td style="text-align:center;">68–76</td><td style="text-align:center;">46–48</td><td style="text-align:center;">33</td></tr>
                <tr><td style="padding: 0.5rem 0.8rem;">12 – 18M</td><td style="text-align:center;">76–84</td><td style="text-align:center;">48–50</td><td style="text-align:center;">35</td></tr>
                <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">18 – 24M</td><td style="text-align:center;">84–90</td><td style="text-align:center;">50–52</td><td style="text-align:center;">37</td></tr>
                <tr><td style="padding: 0.5rem 0.8rem;">2 – 3Y</td><td style="text-align:center;">90–98</td><td style="text-align:center;">52–54</td><td style="text-align:center;">40</td></tr>
              {% else %}
                <tr><td style="padding: 0.5rem 0.8rem;">0 – 1Y</td><td style="text-align:center;">70–80</td><td style="text-align:center;">46–49</td><td style="text-align:center;">45–48</td></tr>
                <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">1 – 2Y</td><td style="text-align:center;">80–90</td><td style="text-align:center;">48–51</td><td style="text-align:center;">47–50</td></tr>
                <tr><td style="padding: 0.5rem 0.8rem;">2 – 3Y</td><td style="text-align:center;">90–98</td><td style="text-align:center;">50–53</td><td style="text-align:center;">49–52</td></tr>
                <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">4 – 5Y</td><td style="text-align:center;">104–110</td><td style="text-align:center;">56–59</td><td style="text-align:center;">55–58</td></tr>
                <tr><td style="padding: 0.5rem 0.8rem;">6 – 7Y</td><td style="text-align:center;">116–122</td><td style="text-align:center;">62–65</td><td style="text-align:center;">61–64</td></tr>
              {% endif %}
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</product-info>

<style>
.meeeku-pdp-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: flex-start;
  position: relative;
}
.meeeku-pdp-gallery-wrapper {
  display: flex;
  gap: 1.2rem;
  align-items: flex-start;
}
.meeeku-pdp-thumbs-list {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  width: 75px;
  flex-shrink: 0;
}
.meeeku-pdp-thumb-item {
  width: 75px;
  height: 95px;
  border-radius: 12px;
  overflow: hidden;
  border: 2px solid #F8BBD0;
  cursor: pointer;
  opacity: 0.7;
  transition: all 0.2s ease;
  background: #FFF;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.meeeku-pdp-thumb-item.active,
.meeeku-pdp-thumb-item:hover {
  opacity: 1;
  border-color: #6B3FA0;
  transform: scale(1.04);
}
.meeeku-pdp-thumb-item img {
  width: 100%;
  height: 75px;
  object-fit: cover;
  object-position: top center;
}
.meeeku-pdp-thumb-item span {
  font-size: 0.85rem;
  font-weight: 700;
  color: #6B3FA0;
  text-align: center;
  width: 100%;
  background: #FFF9F4;
}
.meeeku-pdp-hero-image {
  flex: 1;
  border-radius: 20px;
  overflow: hidden;
  border: 2px solid #F8BBD0;
  box-shadow: 0 8px 24px rgba(107, 63, 160, 0.08);
}
.meeeku-pdp-hero-image img {
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  object-position: top center;
  display: block;
}
.meeeku-pdp-title {
  color: #3D2355;
  font-size: 2.8rem;
  font-weight: 800;
  margin-bottom: 0.6rem;
  line-height: 1.2;
}
.meeeku-pdp-price {
  font-size: 2.6rem;
  font-weight: 800;
  color: #6B3FA0;
}
.meeeku-pdp-size-grid {
  display: flex;
  gap: 0.8rem;
  flex-wrap: wrap;
}
.meeeku-size-btn {
  border: 2px solid #F8BBD0;
  border-radius: 25px;
  padding: 0.6rem 1.4rem;
  font-size: 1.3rem;
  font-weight: 700;
  color: #3D2355;
  background: #FFFDF7;
  cursor: pointer;
  transition: all 0.2s ease;
}
.meeeku-size-btn.active,
.meeeku-size-btn:hover {
  background: #6B3FA0;
  color: #FFF;
  border-color: #6B3FA0;
}
.meeeku-size-btn.sold-out {
  opacity: 0.5;
  text-decoration: line-through;
  cursor: not-allowed;
}

@media screen and (max-width: 749px) {
  .meeeku-pdp-layout {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .meeeku-pdp-gallery-wrapper {
    flex-direction: column-reverse;
  }
  .meeeku-pdp-thumbs-list {
    flex-direction: row;
    width: 100%;
    justify-content: center;
  }
  .meeeku-pdp-title {
    font-size: 2.2rem;
  }
}
</style>

<script>
function meeekuSwitchMainPdpImg(thumb, imgUrl) {
  document.querySelectorAll('.meeeku-pdp-thumb-item').forEach(el => el.classList.remove('active'));
  thumb.classList.add('active');
  const mainImg = document.getElementById('MeeekuMainPdpImage');
  if (mainImg) mainImg.src = imgUrl;
}

function meeekuSelectVariantBtn(btn, variantId, priceFormatted, comparePriceFormatted) {
  document.querySelectorAll('.meeeku-size-btn').forEach(el => el.classList.remove('active'));
  btn.classList.add('active');
  
  if (variantId) {
    const hiddenInput = document.getElementById('MeeekuVariantIdInput');
    if (hiddenInput) hiddenInput.value = variantId;
  }
  if (priceFormatted) {
    const label = document.getElementById('MeeekuBtnPriceLabel');
    if (label) label.textContent = priceFormatted;
    const txt = document.getElementById('MeeekuDisplayPriceText');
    if (txt) txt.textContent = priceFormatted;
  }
  if (comparePriceFormatted) {
    const mrp = document.getElementById('MeeekuDisplayMrpText');
    if (mrp) {
      mrp.textContent = comparePriceFormatted;
      mrp.style.display = 'inline';
    }
  }
}

function meeekuAddToCartNative(variantId, title, price, img, sizeTitle) {
  let cart = [];
  try {
    cart = JSON.parse(localStorage.getItem('meeeku_active_cart') || localStorage.getItem('meeeku_user_cart') || localStorage.getItem('meeeku_cart') || '[]');
  } catch (e) { cart = []; }

  const size = sizeTitle || 'Standard';
  const existing = cart.find(i => i.title === title && i.size === size);
  if (existing) {
    let q = existing.qty || existing.quantity || 1;
    existing.qty = q + 1;
    existing.quantity = q + 1;
  } else {
    cart.push({
      id: variantId || ('item_' + Date.now()),
      title: title,
      price: price,
      img: img,
      size: size,
      qty: 1,
      quantity: 1
    });
  }

  localStorage.setItem('meeeku_active_cart', JSON.stringify(cart));
  localStorage.setItem('meeeku_user_cart', JSON.stringify(cart));
  localStorage.setItem('meeeku_cart', JSON.stringify(cart));

  if (variantId && !isNaN(parseInt(variantId))) {
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: parseInt(variantId), quantity: 1 }] })
    }).catch(() => {});
  }

  const dot = document.getElementById('MeeekuCartDot');
  if (dot) dot.classList.add('has-items');

  const totalCount = cart.reduce((sum, i) => sum + i.quantity, 0);
  const countBubbles = document.querySelectorAll('.cart-count-bubble span');
  countBubbles.forEach(b => b.textContent = totalCount);
}

function meeekuTriggerBuyNow() {
  const activeSizeBtn = document.querySelector('.meeeku-size-btn.active');
  const sizeTitle = activeSizeBtn ? activeSizeBtn.innerText.trim() : 'Standard';
  const hiddenInput = document.getElementById('MeeekuVariantIdInput');
  const variantId = hiddenInput ? hiddenInput.value : '';
  const title = {{ product.title | json }};
  const price = document.getElementById('MeeekuDisplayPriceText') ? document.getElementById('MeeekuDisplayPriceText').innerText.trim() : '';
  const heroImg = document.getElementById('MeeekuMainPdpImage');
  const img = heroImg ? heroImg.src : '';

  meeekuAddToCartNative(variantId, title, price, img, sizeTitle);

  if (variantId && !isNaN(parseInt(variantId))) {
    window.location.href = '/cart/' + variantId + ':1?checkout';
  } else {
    window.location.href = '/cart';
  }
}

document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('MeeekuPdpNativeForm');
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      const activeSizeBtn = document.querySelector('.meeeku-size-btn.active');
      const sizeTitle = activeSizeBtn ? activeSizeBtn.innerText.trim() : 'Standard';
      const hiddenInput = document.getElementById('MeeekuVariantIdInput');
      const variantId = hiddenInput ? hiddenInput.value : '';
      const title = {{ product.title | json }};
      const price = document.getElementById('MeeekuDisplayPriceText') ? document.getElementById('MeeekuDisplayPriceText').innerText.trim() : '';
      const heroImg = document.getElementById('MeeekuMainPdpImage');
      const img = heroImg ? heroImg.src : '';

      meeekuAddToCartNative(variantId, title, price, img, sizeTitle);

      const btn = form.querySelector('button[type="submit"]');
      if (btn) btn.innerHTML = '✅ Added! Opening Cart...';

      setTimeout(function() {
        window.location.href = '/cart';
      }, 400);
    });
  }
});
</script>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Product information"
    }
  ]
}
{% endschema %}
