{% comment %}
  Meeeku Scoped & Universal Client-Hydrated Single Product Template
  Supports 100% accurate dynamic switching for all Ethnic Lehengas and Everyday T-Shirts
{% endcomment %}

<product-info id="MainProduct-{{ section.id }}" class="product-info page-width meeeku-pdp-container" data-section="{{ section.id }}" data-product-id="{{ product.id }}" style="display: block; padding-top: 2rem; padding-bottom: 5rem;">
  
  {% liquid
    assign prod_key = 'yellow_lehenga'
    assign prod_category_badge = 'Chanderi Cotton'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign default_price_val = '₹3,199.00'
    assign default_mrp_val = '₹3,899.00'
    assign discount_label = 'SAVE 17%'
    assign is_tee = false
    
    assign t = product.title | downcase
    assign h = product.handle | downcase

    if h contains 'daisy' or h contains 'frill' or t contains 'daisy' or t contains 'frill'
      assign prod_key = 'daisy_frill_tee'
      assign prod_category_badge = '100% Combed Organic Cotton'
      assign default_price_val = '₹599.00'
      assign default_mrp_val = '₹899.00'
      assign discount_label = 'SAVE 33%'
      assign is_tee = true
    elsif h contains 'bunny' or h contains 'snuggle' or t contains 'bunny' or t contains 'snuggle'
      assign prod_key = 'bunny_tee'
      assign prod_category_badge = '100% Combed Cotton'
      assign default_price_val = '₹599.00'
      assign default_mrp_val = '₹899.00'
      assign discount_label = 'SAVE 33%'
      assign is_tee = true
    elsif h contains 'leopard' or h contains 'safari' or t contains 'leopard'
      assign prod_key = 'leopard_tee'
      assign prod_category_badge = '100% Combed Cotton'
      assign default_price_val = '₹599.00'
      assign default_mrp_val = '₹899.00'
      assign discount_label = 'SAVE 33%'
      assign is_tee = true
    elsif h contains 'dino' or h contains 'dinosaur' or t contains 'dino'
      assign prod_key = 'dino_tee'
      assign prod_category_badge = '100% Organic Cotton'
      assign default_price_val = '₹599.00'
      assign default_mrp_val = '₹899.00'
      assign discount_label = 'SAVE 33%'
      assign is_tee = true
    elsif h contains 'owl' or h contains 'starlit' or t contains 'owl'
      assign prod_key = 'owl_tee'
      assign prod_category_badge = '100% Pure Soft Cotton'
      assign default_price_val = '₹599.00'
      assign default_mrp_val = '₹899.00'
      assign discount_label = 'SAVE 33%'
      assign is_tee = true
    elsif h contains 'lion' or h contains 'mighty' or t contains 'lion'
      assign prod_key = 'lion_tee'
      assign prod_category_badge = '100% Combed Cotton'
      assign default_price_val = '₹599.00'
      assign default_mrp_val = '₹899.00'
      assign discount_label = 'SAVE 33%'
      assign is_tee = true
    elsif h contains 'cosmic' or h contains 'galaxy' or t contains 'cosmic'
      assign prod_key = 'cosmic_safari_tee'
      assign prod_category_badge = '100% Breathable Cotton'
      assign default_price_val = '₹599.00'
      assign default_mrp_val = '₹899.00'
      assign discount_label = 'SAVE 33%'
      assign is_tee = true
    elsif h contains 'teal' or h contains 'bloom' or h contains 'sequin' or t contains 'teal'
      assign prod_key = 'teal_dress'
      assign prod_category_badge = 'Royal Tulle & Sequins'
      assign default_price_val = '₹2,999.00'
      assign default_mrp_val = '₹3,699.00'
    elsif h contains 'pink-net' or h contains 'blush' or h contains 'rose' or t contains 'blush'
      assign prod_key = 'pink_net_lehenga'
      assign prod_category_badge = 'Royal Net & Zari'
      assign default_price_val = '₹3,299.00'
      assign default_mrp_val = '₹3,999.00'
    elsif h contains 'green' or h contains 'vrindavan' or t contains 'forest'
      assign prod_key = 'green_lehenga'
      assign prod_category_badge = '100% Organic Cotton'
      assign default_price_val = '₹3,199.00'
      assign default_mrp_val = '₹3,899.00'
    endif

    assign main_img_name = 'meeeku_prod_' | append: prod_key | append: '.jpg'
    assign model_img_name = 'meeeku_prod_' | append: prod_key | append: '_model.jpg'
    assign swirl_img_name = 'meeeku_prod_' | append: prod_key | append: '_swirl.jpg'

    assign display_title = product.title
    if display_title == blank
      if is_tee
        assign display_title = 'Periwinkle Daisy Frill Cotton Tee'
      else
        assign display_title = 'Sunshine Chanderi Lehenga'
      endif
    endif

    assign display_price = product.price | money
    if product.price == 0 or product.price == blank or display_price contains '0.00'
      assign display_price = default_price_val
    endif

    assign active_variant_id = product.selected_or_first_available_variant.id
  %}

  <div class="meeeku-pdp-layout">
    <!-- LEFT COLUMN: Image Gallery -->
    <div class="meeeku-pdp-gallery-col">
      <div class="meeeku-pdp-gallery-wrapper">
        <div class="meeeku-pdp-thumbs-list" id="MeeekuPdpThumbsList">
          <div class="meeeku-pdp-thumb-item active" onclick="meeekuSwitchMainPdpImg(this, '{{ model_img_name | asset_url }}')">
            <img src="{{ model_img_name | asset_url }}" alt="Model View" width="80" height="100">
            <span>Model</span>
          </div>
          <div class="meeeku-pdp-thumb-item" onclick="meeekuSwitchMainPdpImg(this, '{{ main_img_name | asset_url }}')">
            <img src="{{ main_img_name | asset_url }}" alt="Flatlay View" width="80" height="100">
            <span>Product</span>
          </div>
          <div class="meeeku-pdp-thumb-item" onclick="meeekuSwitchMainPdpImg(this, '{{ swirl_img_name | asset_url }}')">
            <img src="{{ swirl_img_name | asset_url }}" alt="Fabric Detail" width="80" height="100">
            <span>Detail</span>
          </div>
        </div>

        <div class="meeeku-pdp-hero-image">
          <img id="MeeekuMainPdpImage" src="{{ model_img_name | asset_url }}" alt="{{ display_title }}" width="600" height="750" loading="eager" style="border-radius: 24px; width: 100%; object-fit: cover; border: 2px solid #F8BBD0; box-shadow: 0 12px 36px rgba(107, 63, 160, 0.08);">
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: Product Info & Native Shopify Form -->
    <div class="meeeku-pdp-info-col">
      <span class="meeeku-badge {{ prod_badge_class }}" id="MeeekuPdpBadge" style="display: inline-block; margin-bottom: 0.8rem;">{{ prod_category_badge }}</span>
      <h1 class="meeeku-pdp-title" id="MeeekuPdpTitle">{{ display_title }}</h1>

      <div style="display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1.2rem;">
        <span style="color: #FFB300; font-size: 1.5rem;">⭐⭐⭐⭐⭐</span>
        <span style="font-weight: 700; color: #FF6097; font-size: 1.35rem;">4.9 (128 verified reviews)</span>
      </div>

      <div style="margin-bottom: 1.5rem; display: flex; align-items: baseline; gap: 1rem;">
        <span class="meeeku-pdp-price" id="MeeekuDisplayPriceText">{{ display_price }} INR</span>
        <span style="font-size: 1.6rem; color: #888; text-decoration: line-through;" id="MeeekuDisplayMrpText">{{ default_mrp_val }}</span>
        <span class="meeeku-badge" id="MeeekuDisplayDiscountBadge" style="background: #E8F5E9; color: #2E7D32; font-size: 1.1rem; padding: 0.2rem 0.8rem;">{{ discount_label }}</span>
      </div>

      <div id="MeeekuPdpDescription" style="color: #555; font-size: 1.45rem; line-height: 1.6; margin-bottom: 1.8rem;">
        {% if product.description != blank %}
          {{ product.description }}
        {% elsif is_tee %}
          Crafted from 100% ultra-soft combed cotton, this everyday essential tee features playful storybook art, smooth zero-itch collar ribbing, and easy-stretch movement. Gentle on delicate baby skin for playtime, daycare, and cozy naps.
        {% else %}
          Bring radiant sunshine to festive occasions with this handcrafted cotton lehenga. Detailed with delicate embroidery and finished with a comfortable elasticated waistband. Fully lined with 100% soft skin-safe muslin cotton for zero-itch twirling all day long.
        {% endif %}
      </div>

      {% form 'product', product, id: 'MeeekuPdpNativeForm', class: 'meeeku-pdp-form' %}
        <input type="hidden" name="id" id="MeeekuVariantIdInput" value="{{ active_variant_id }}">
        
        <!-- Size Selector -->
        <div style="margin-bottom: 1.8rem;">
          <label id="MeeekuPdpSizeLabel" style="font-weight: 700; color: #3D2355; font-size: 1.45rem; display: block; margin-bottom: 0.8rem;">
            {% if is_tee %}Select Size (0 – 3 Years):{% else %}Select Size (0 – 6 Years):{% endif %}
          </label>
          <div class="meeeku-pdp-size-grid" id="MeeekuPdpSizeGrid">
            {% if is_tee %}
              <button type="button" class="meeeku-size-btn" onclick="meeekuSelectVariantBtn(this, '', '{{ display_price }}')">0 - 6M</button>
              <button type="button" class="meeeku-size-btn active" onclick="meeekuSelectVariantBtn(this, '', '{{ display_price }}')">6 - 12M</button>
              <button type="button" class="meeeku-size-btn" onclick="meeekuSelectVariantBtn(this, '', '{{ display_price }}')">12 - 18M</button>
              <button type="button" class="meeeku-size-btn" onclick="meeekuSelectVariantBtn(this, '', '{{ display_price }}')">18 - 24M</button>
              <button type="button" class="meeeku-size-btn" onclick="meeekuSelectVariantBtn(this, '', '{{ display_price }}')">2 - 3Y</button>
            {% else %}
              <button type="button" class="meeeku-size-btn" onclick="meeekuSelectVariantBtn(this, '', '{{ display_price }}')">2 - 3Y</button>
              <button type="button" class="meeeku-size-btn active" onclick="meeekuSelectVariantBtn(this, '', '{{ display_price }}')">4 - 5Y</button>
              <button type="button" class="meeeku-size-btn" onclick="meeekuSelectVariantBtn(this, '', '{{ display_price }}')">6 - 7Y</button>
            {% endif %}
          </div>
        </div>

        <!-- Add to Cart & Buy It Now CTAs -->
        <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
          <button type="submit" name="add" class="meeeku-btn-primary" style="width: 100%; text-align: center; font-size: 1.5rem; padding: 1.2rem;">
            🛒 Add to Cart — <span id="MeeekuBtnPriceLabel">{{ display_price }}</span>
          </button>
          <button type="button" class="meeeku-btn-secondary" style="width: 100%; text-align: center; font-size: 1.5rem; padding: 1.2rem;" onclick="meeekuTriggerBuyNow()">
            ⚡ Buy It Now
          </button>
        </div>
      {% endform %}

      <!-- Trust Badges -->
      {% render 'meeeku-trust-badges' %}

      <!-- Sizing Guide Inline -->
      <div class="meeeku-size-guide-inline" style="margin-top: 2rem; background: #FFFDF7; border: 1.5px solid #F8BBD0; border-radius: 20px; padding: 1.8rem;">
        <h3 id="MeeekuSizeGuideHeading" style="color: #3D2355; font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem;">
          {% if is_tee %}📏 T-Shirt Size & Fit Guide (0 – 3 Years){% else %}📏 Size & Fit Guide (0 – 6 Years){% endif %}
        </h3>
        <div id="MeeekuSizeGuideTableWrap" style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; font-size: 1.25rem;">
            <thead>
              <tr style="background: #F8BBD0; color: #3D2355;">
                <th style="padding: 0.6rem 0.8rem; text-align: left;">Age</th>
                <th style="padding: 0.6rem 0.8rem; text-align: center;">Height (cm)</th>
                <th style="padding: 0.6rem 0.8rem; text-align: center;">Chest (cm)</th>
                <th style="padding: 0.6rem 0.8rem; text-align: center;">{% if is_tee %}Length (cm){% else %}Waist (cm){% endif %}</th>
              </tr>
            </thead>
            <tbody id="MeeekuSizeGuideTbody">
              {% if is_tee %}
                <tr><td style="padding: 0.5rem 0.8rem;">0 – 6M</td><td style="text-align:center;">60–68</td><td style="text-align:center;">44–46</td><td style="text-align:center;">31</td></tr>
                <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">6 – 12M</td><td style="text-align:center;">68–76</td><td style="text-align:center;">46–48</td><td style="text-align:center;">33</td></tr>
                <tr><td style="padding: 0.5rem 0.8rem;">12 – 18M</td><td style="text-align:center;">76–84</td><td style="text-align:center;">48–50</td><td style="text-align:center;">35</td></tr>
                <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">18 – 24M</td><td style="text-align:center;">84–90</td><td style="text-align:center;">50–52</td><td style="text-align:center;">37</td></tr>
                <tr><td style="padding: 0.5rem 0.8rem;">2 – 3Y</td><td style="text-align:center;">90–98</td><td style="text-align:center;">52–54</td><td style="text-align:center;">40</td></tr>
              {% else %}
                <tr><td style="padding: 0.5rem 0.8rem;">2 – 3Y</td><td style="text-align:center;">90–98</td><td style="text-align:center;">50–53</td><td style="text-align:center;">49–52</td></tr>
                <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">4 – 5Y</td><td style="text-align:center;">104–110</td><td style="text-align:center;">56–59</td><td style="text-align:center;">55–58</td></tr>
                <tr><td style="padding: 0.5rem 0.8rem;">6 – 7Y</td><td style="text-align:center;">116–122</td><td style="text-align:center;">62–65</td><td style="text-align:center;">61–64</td></tr>
              {% endif %}
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</product-info>

<style>
.meeeku-pdp-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: flex-start;
  position: relative;
}
.meeeku-pdp-gallery-wrapper {
  display: flex;
  gap: 1.2rem;
  align-items: flex-start;
}
.meeeku-pdp-thumbs-list {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  width: 75px;
  flex-shrink: 0;
}
.meeeku-pdp-thumb-item {
  width: 75px;
  height: 95px;
  border-radius: 12px;
  overflow: hidden;
  border: 2px solid #F8BBD0;
  cursor: pointer;
  opacity: 0.7;
  transition: all 0.2s ease;
  background: #FFF;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.meeeku-pdp-thumb-item.active,
.meeeku-pdp-thumb-item:hover {
  opacity: 1;
  border-color: #6B3FA0;
  transform: scale(1.04);
}
.meeeku-pdp-thumb-item img {
  width: 100%;
  height: 75px;
  object-fit: cover;
  object-position: top center;
}
.meeeku-pdp-thumb-item span {
  font-size: 0.85rem;
  font-weight: 700;
  color: #6B3FA0;
  text-align: center;
  width: 100%;
  background: #FFF9F4;
}
.meeeku-pdp-hero-image {
  flex: 1;
  border-radius: 20px;
  overflow: hidden;
  border: 2px solid #F8BBD0;
  box-shadow: 0 8px 24px rgba(107, 63, 160, 0.08);
}
.meeeku-pdp-hero-image img {
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  object-position: top center;
  display: block;
}
.meeeku-pdp-title {
  color: #3D2355;
  font-size: 2.8rem;
  font-weight: 800;
  margin-bottom: 0.6rem;
  line-height: 1.2;
}
.meeeku-pdp-price {
  font-size: 2.6rem;
  font-weight: 800;
  color: #6B3FA0;
}
.meeeku-pdp-size-grid {
  display: flex;
  gap: 0.8rem;
  flex-wrap: wrap;
}
.meeeku-size-btn {
  border: 2px solid #F8BBD0;
  border-radius: 25px;
  padding: 0.6rem 1.4rem;
  font-size: 1.3rem;
  font-weight: 700;
  color: #3D2355;
  background: #FFFDF7;
  cursor: pointer;
  transition: all 0.2s ease;
}
.meeeku-size-btn.active,
.meeeku-size-btn:hover {
  background: #6B3FA0;
  color: #FFF;
  border-color: #6B3FA0;
}

@media screen and (max-width: 749px) {
  .meeeku-pdp-layout {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .meeeku-pdp-gallery-wrapper {
    flex-direction: column-reverse;
  }
  .meeeku-pdp-thumbs-list {
    flex-direction: row;
    width: 100%;
    justify-content: center;
  }
  .meeeku-pdp-title {
    font-size: 2.2rem;
  }
}
</style>

