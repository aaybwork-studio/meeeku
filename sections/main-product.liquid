let currentActiveItemData = null;

function resolvePdpProductKey() {
  const urlParams = new URLSearchParams(window.location.search);
  const itemParam = urlParams.get('item');
  if (itemParam && MEEEKU_PDP_CATALOG[itemParam]) {
    return itemParam;
  }

  const path = window.location.pathname.toLowerCase();
  for (const key of Object.keys(MEEEKU_PDP_CATALOG)) {
    const slug = key.replace(/_/g, '-');
    if (path.includes(slug) || path.includes(key)) {
      return key;
    }
  }

  if (path.includes('daisy') || path.includes('frill')) return 'daisy_frill_tee';
  if (path.includes('bunny') || path.includes('snuggle')) return 'bunny_tee';
  if (path.includes('leopard') || path.includes('safari-tee')) return 'leopard_tee';
  if (path.includes('dino') || path.includes('dinosaur')) return 'dino_tee';
  if (path.includes('owl') || path.includes('starlit')) return 'owl_tee';
  if (path.includes('lion') || path.includes('mighty')) return 'lion_tee';
  if (path.includes('cosmic') || path.includes('galaxy')) return 'cosmic_safari_tee';
  if (path.includes('teal') || path.includes('bloom')) return 'teal_dress';
  if (path.includes('pink-net') || path.includes('blush-rose')) return 'pink_net_lehenga';
  if (path.includes('green') || path.includes('vrindavan')) return 'green_lehenga';
  if (path.includes('gulmohar') || path.includes('multicolor')) return 'multicolor_coord';
  if (path.includes('bandhani') || path.includes('surajmukhi')) return 'red_bandhani_lehenga';
  if (path.includes('magenta') || path.includes('phulkari')) return 'magenta_lehenga';
  if (path.includes('black') || path.includes('midnight')) return 'black_lehenga';
  if (path.includes('olive')) return 'olive_lehenga';

  return '{{ prod_key }}';
}

function hydrateMeeekuPdp() {
  const itemKey = resolvePdpProductKey();
  const data = MEEEKU_PDP_CATALOG[itemKey];
  if (!data) return;

  currentActiveItemData = data;

  // Title
  const titleEl = document.getElementById('MeeekuPdpTitle');
  if (titleEl) titleEl.textContent = data.title;
  document.title = data.title + ' — Meeeku (Varsha Creations)';

  // Badge
  const badgeEl = document.getElementById('MeeekuPdpBadge');
  if (badgeEl) {
    badgeEl.textContent = data.badge;
    badgeEl.className = 'meeeku-badge ' + (data.badgeClass || 'meeeku-badge--ethnic');
  }

  // Price & MRP & Discount
  const priceEl = document.getElementById('MeeekuDisplayPriceText');
  if (priceEl) priceEl.textContent = data.price + ' INR';
  const mrpEl = document.getElementById('MeeekuDisplayMrpText');
  if (mrpEl) mrpEl.textContent = data.mrp;
  const discountEl = document.getElementById('MeeekuDisplayDiscountBadge');
  if (discountEl) discountEl.textContent = data.discount;
  const btnPriceEl = document.getElementById('MeeekuBtnPriceLabel');
  if (btnPriceEl) btnPriceEl.textContent = data.price;

  // Description
  const descEl = document.getElementById('MeeekuPdpDescription');
  if (descEl) descEl.textContent = data.desc;

  // Size Label & Size Grid
  const sizeLabelEl = document.getElementById('MeeekuPdpSizeLabel');
  if (sizeLabelEl) {
    sizeLabelEl.textContent = data.is_tee ? 'Select Size (0 – 3 Years):' : 'Select Size (0 – 6 Years):';
  }

  const sizeGridEl = document.getElementById('MeeekuPdpSizeGrid');
  if (sizeGridEl && data.sizes) {
    sizeGridEl.innerHTML = '';
    data.sizes.forEach((sz, idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'meeeku-size-btn' + (idx === 1 ? ' active' : '');
      btn.textContent = sz;
      btn.onclick = function() {
        meeekuSelectVariantBtn(btn, '', data.price);
      };
      sizeGridEl.appendChild(btn);
    });
  }

  // Gallery Thumbs & Hero Image
  const heroImg = document.getElementById('MeeekuMainPdpImage');
  const thumbsList = document.getElementById('MeeekuPdpThumbsList');
  if (heroImg && data.images) {
    heroImg.src = data.images.model || data.images.flatlay;
    heroImg.alt = data.title;
  }

  if (thumbsList && data.images) {
    thumbsList.innerHTML = `
      <div class="meeeku-pdp-thumb-item active" onclick="meeekuSwitchMainPdpImg(this, '${data.images.model || data.images.flatlay}')">
        <img src="${data.images.model || data.images.flatlay}" alt="Model View" width="80" height="100">
        <span>Model</span>
      </div>
      <div class="meeeku-pdp-thumb-item" onclick="meeekuSwitchMainPdpImg(this, '${data.images.flatlay}')">
        <img src="${data.images.flatlay}" alt="Flatlay View" width="80" height="100">
        <span>Product</span>
      </div>
      <div class="meeeku-pdp-thumb-item" onclick="meeekuSwitchMainPdpImg(this, '${data.images.detail || data.images.flatlay}')">
        <img src="${data.images.detail || data.images.flatlay}" alt="Detail View" width="80" height="100">
        <span>Detail</span>
      </div>
    `;
  }

  // Size Guide Table
  const guideHeading = document.getElementById('MeeekuSizeGuideHeading');
  const guideTbody = document.getElementById('MeeekuSizeGuideTbody');
  if (guideHeading) {
    guideHeading.textContent = data.is_tee ? '📏 T-Shirt Size & Fit Guide (0 – 3 Years)' : '📏 Size & Fit Guide (0 – 6 Years)';
  }
  if (guideTbody) {
    if (data.is_tee) {
      guideTbody.innerHTML = `
        <tr><td style="padding: 0.5rem 0.8rem;">0 – 6M</td><td style="text-align:center;">60–68</td><td style="text-align:center;">44–46</td><td style="text-align:center;">31</td></tr>
        <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">6 – 12M</td><td style="text-align:center;">68–76</td><td style="text-align:center;">46–48</td><td style="text-align:center;">33</td></tr>
        <tr><td style="padding: 0.5rem 0.8rem;">12 – 18M</td><td style="text-align:center;">76–84</td><td style="text-align:center;">48–50</td><td style="text-align:center;">35</td></tr>
        <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">18 – 24M</td><td style="text-align:center;">84–90</td><td style="text-align:center;">50–52</td><td style="text-align:center;">37</td></tr>
        <tr><td style="padding: 0.5rem 0.8rem;">2 – 3Y</td><td style="text-align:center;">90–98</td><td style="text-align:center;">52–54</td><td style="text-align:center;">40</td></tr>
      `;
    } else {
      guideTbody.innerHTML = `
        <tr><td style="padding: 0.5rem 0.8rem;">2 – 3Y</td><td style="text-align:center;">90–98</td><td style="text-align:center;">50–53</td><td style="text-align:center;">49–52</td></tr>
        <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">4 – 5Y</td><td style="text-align:center;">104–110</td><td style="text-align:center;">56–59</td><td style="text-align:center;">55–58</td></tr>
        <tr><td style="padding: 0.5rem 0.8rem;">6 – 7Y</td><td style="text-align:center;">116–122</td><td style="text-align:center;">62–65</td><td style="text-align:center;">61–64</td></tr>
      `;
    }
  }
}

function meeekuSwitchMainPdpImg(thumb, imgUrl) {
  document.querySelectorAll('.meeeku-pdp-thumb-item').forEach(el => el.classList.remove('active'));
  thumb.classList.add('active');
  const mainImg = document.getElementById('MeeekuMainPdpImage');
  if (mainImg) mainImg.src = imgUrl;
}

function meeekuSelectVariantBtn(btn, variantId, priceFormatted) {
  document.querySelectorAll('.meeeku-size-btn').forEach(el => el.classList.remove('active'));
  btn.classList.add('active');
  if (variantId) {
    const hiddenInput = document.getElementById('MeeekuVariantIdInput');
    if (hiddenInput) hiddenInput.value = variantId;
  }
  if (priceFormatted) {
    const label = document.getElementById('MeeekuBtnPriceLabel');
    if (label) label.textContent = priceFormatted;
    const txt = document.getElementById('MeeekuDisplayPriceText');
    if (txt) txt.textContent = priceFormatted + ' INR';
  }
}

function meeekuAddToCartUnified(title, price, img, variantId, sizeTitle) {
  let cart = [];
  try {
    cart = JSON.parse(localStorage.getItem('meeeku_cart') || '[]');
  } catch (e) { cart = []; }

  const itemKey = (variantId || title) + '_' + (sizeTitle || 'Default');
  const existing = cart.find(i => i.key === itemKey);
  if (existing) {
    existing.quantity += 1;
  } else {
    cart.push({
      key: itemKey,
      id: variantId || '',
      title: title,
      price: price,
      img: img,
      size: sizeTitle || '2 - 3Y',
      quantity: 1
    });
  }

  localStorage.setItem('meeeku_cart', JSON.stringify(cart));
  
  if (variantId && !isNaN(parseInt(variantId))) {
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: parseInt(variantId), quantity: 1 }] })
    }).catch(() => {});
  }

  const dot = document.getElementById('MeeekuCartDot');
  if (dot) dot.classList.add('has-items');

  const totalCount = cart.reduce((sum, i) => sum + i.quantity, 0);
  const countBubbles = document.querySelectorAll('.cart-count-bubble span');
  countBubbles.forEach(b => b.textContent = totalCount);
}

function meeekuTriggerBuyNow() {
  const activeSizeBtn = document.querySelector('.meeeku-size-btn.active');
  const sizeTitle = activeSizeBtn ? activeSizeBtn.innerText.trim() : '2 - 3Y';
  const hiddenInput = document.getElementById('MeeekuVariantIdInput');
  const variantId = hiddenInput ? hiddenInput.value : '';
  const title = currentActiveItemData ? currentActiveItemData.title : '{{ display_title | escape }}';
  const price = currentActiveItemData ? currentActiveItemData.price : '{{ display_price }}';
  const heroImg = document.getElementById('MeeekuMainPdpImage');
  const img = heroImg ? heroImg.src : '';

  meeekuAddToCartUnified(title, price, img, variantId, sizeTitle);

  if (variantId && !isNaN(parseInt(variantId))) {
    window.location.href = '/cart/' + variantId + ':1?checkout';
  } else {
    window.location.href = '/cart';
  }
}

document.addEventListener('DOMContentLoaded', function() {
  hydrateMeeekuPdp();

  const form = document.getElementById('MeeekuPdpNativeForm');
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      const activeSizeBtn = document.querySelector('.meeeku-size-btn.active');
      const sizeTitle = activeSizeBtn ? activeSizeBtn.innerText.trim() : '2 - 3Y';
      const hiddenInput = document.getElementById('MeeekuVariantIdInput');
      const variantId = hiddenInput ? hiddenInput.value : '';
      const title = currentActiveItemData ? currentActiveItemData.title : '{{ display_title | escape }}';
      const price = currentActiveItemData ? currentActiveItemData.price : '{{ display_price }}';
      const heroImg = document.getElementById('MeeekuMainPdpImage');
      const img = heroImg ? heroImg.src : '';

      meeekuAddToCartUnified(title, price, img, variantId, sizeTitle);

      const btn = form.querySelector('button[type="submit"]');
      if (btn) btn.innerHTML = '✅ Added! Opening Cart...';

      setTimeout(function() {
        window.location.href = '/cart';
      }, 400);
    });
  }
});
</script>

