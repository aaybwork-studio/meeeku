{% comment %}
  Meeeku Clean & Scoped Single Product Template
{% endcomment %}

<div id="MainProduct-{{ section.id }}" class="page-width meeeku-pdp-container" style="padding-top: 2rem; padding-bottom: 5rem;">
  
  {% liquid
    assign prod_key = 'yellow_lehenga'
    assign prod_category_badge = 'Chanderi Cotton'
    assign prod_badge_class = 'meeeku-badge--ethnic'
    assign default_price_val = '₹3,199.00'
    assign default_mrp_val = '₹3,899.00'
    
    assign t = product.title | downcase
    assign h = product.handle | downcase

    if h contains 'teal' or h contains 'bloom' or h contains 'sequin' or t contains 'teal' or t contains 'bloom'
      assign prod_key = 'teal_dress'
      assign prod_category_badge = 'Royal Tulle & Sequins'
      assign prod_badge_class = 'meeeku-badge--ethnic'
      assign default_price_val = '₹2,999.00'
      assign default_mrp_val = '₹3,699.00'
    elsif h contains 'pink-net' or h contains 'blush' or h contains 'rose' or h contains 'jacquard' or t contains 'blush' or t contains 'rose'
      assign prod_key = 'pink_net_lehenga'
      assign prod_category_badge = 'Royal Net & Zari'
      assign prod_badge_class = 'meeeku-badge--ethnic'
      assign default_price_val = '₹3,299.00'
      assign default_mrp_val = '₹3,999.00'
    elsif h contains 'green' or h contains 'vrindavan' or h contains 'forest' or t contains 'forest' or t contains 'green'
      assign prod_key = 'green_lehenga'
      assign prod_category_badge = '100% Organic Cotton'
      assign prod_badge_class = 'meeeku-badge--ethnic'
      assign default_price_val = '₹3,199.00'
      assign default_mrp_val = '₹3,899.00'
    elsif h contains 'multicolor' or h contains 'gulmohar' or h contains 'abstract' or h contains 'splash' or t contains 'gulmohar'
      assign prod_key = 'multicolor_coord'
      assign prod_category_badge = 'Ethnic Rayon Lehenga'
      assign prod_badge_class = 'meeeku-badge--ethnic'
      assign default_price_val = '₹2,899.00'
      assign default_mrp_val = '₹3,599.00'
    elsif h contains 'sage' or h contains 'mint' or h contains 'gota' or t contains 'sage' or t contains 'mint'
      assign prod_key = 'sage_lehenga'
      assign prod_category_badge = 'Gota Patti Zari'
      assign prod_badge_class = 'meeeku-badge--ethnic'
      assign default_price_val = '₹3,199.00'
      assign default_mrp_val = '₹3,899.00'
    elsif h contains 'magenta' or h contains 'phulkari' or h contains 'rani' or t contains 'phulkari' or t contains 'rani'
      assign prod_key = 'magenta_lehenga'
      assign prod_category_badge = 'Phulkari Threadwork'
      assign prod_badge_class = 'meeeku-badge--ethnic'
      assign default_price_val = '₹2,799.00'
      assign default_mrp_val = '₹3,499.00'
    elsif h contains 'black' or h contains 'midnight' or h contains 'blossom' or h contains 'halter' or t contains 'midnight'
      assign prod_key = 'black_lehenga'
      assign prod_category_badge = 'Royal Halter Neck'
      assign prod_badge_class = 'meeeku-badge--ethnic'
      assign default_price_val = '₹2,799.00'
      assign default_mrp_val = '₹3,499.00'
    elsif h contains 'olive' or h contains 'oneshoulder' or h contains 'silk' or t contains 'olive'
      assign prod_key = 'olive_lehenga'
      assign prod_category_badge = 'Zardozi Silk'
      assign prod_badge_class = 'meeeku-badge--ethnic'
      assign default_price_val = '₹3,299.00'
      assign default_mrp_val = '₹3,999.00'
    elsif h contains 'ivory' or h contains 'noor' or t contains 'ivory'
      assign prod_key = 'ivory_coord'
      assign prod_category_badge = 'Chikankari Lehenga'
      assign prod_badge_class = 'meeeku-badge--ethnic'
      assign default_price_val = '₹2,899.00'
      assign default_mrp_val = '₹3,599.00'
    endif

    assign main_img_name = 'meeeku_prod_' | append: prod_key | append: '.jpg'
    assign model_img_name = 'meeeku_prod_' | append: prod_key | append: '_model.jpg'
    assign swirl_img_name = 'meeeku_prod_' | append: prod_key | append: '_swirl.jpg'

    assign display_title = product.title
    if display_title == blank
      assign display_title = 'Sunshine Chanderi Lehenga'
    endif

    assign display_price = product.price | money
    if product.price == 0 or product.price == blank or display_price contains '0.00'
      assign display_price = default_price_val
    endif

    assign active_variant_id = product.selected_or_first_available_variant.id
  %}

  <div class="meeeku-pdp-layout">
    <!-- LEFT COLUMN: Image Gallery (Model View + Thumbnails) -->
    <div class="meeeku-pdp-gallery-col">
      <div class="meeeku-pdp-gallery-wrapper">
        <div class="meeeku-pdp-thumbs-list">
          <div class="meeeku-pdp-thumb-item active" onclick="meeekuSwitchMainPdpImg(this, '{{ model_img_name | asset_url }}')">
            <img src="{{ model_img_name | asset_url }}" alt="Model View" width="80" height="100">
            <span>Model</span>
          </div>
          <div class="meeeku-pdp-thumb-item" onclick="meeekuSwitchMainPdpImg(this, '{{ main_img_name | asset_url }}')">
            <img src="{{ main_img_name | asset_url }}" alt="Flatlay View" width="80" height="100">
            <span>Lehenga</span>
          </div>
          <div class="meeeku-pdp-thumb-item" onclick="meeekuSwitchMainPdpImg(this, '{{ swirl_img_name | asset_url }}')">
            <img src="{{ swirl_img_name | asset_url }}" alt="Fabric Detail" width="80" height="100">
            <span>Fabric</span>
          </div>
        </div>

        <div class="meeeku-pdp-hero-image">
          <img id="MeeekuMainPdpImage" src="{{ model_img_name | asset_url }}" alt="{{ display_title }}" width="600" height="750" loading="eager">
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: Product Info & Native Shopify Form -->
    <div class="meeeku-pdp-info-col">
      <span class="meeeku-badge {{ prod_badge_class }}" style="display: inline-block; margin-bottom: 0.8rem;">{{ prod_category_badge }}</span>
      <h1 class="meeeku-pdp-title">{{ display_title }}</h1>

      <div style="display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1.2rem;">
        <span style="color: #FFB300; font-size: 1.5rem;">⭐⭐⭐⭐⭐</span>
        <span style="font-weight: 700; color: #FF6097; font-size: 1.35rem;">4.9 (128 verified reviews)</span>
      </div>

      <div style="margin-bottom: 1.5rem; display: flex; align-items: baseline; gap: 1rem;">
        <span class="meeeku-pdp-price" id="MeeekuDisplayPriceText">{{ display_price }} INR</span>
        <span style="font-size: 1.6rem; color: #888; text-decoration: line-through;">{{ default_mrp_val }}</span>
        <span class="meeeku-badge" style="background: #E8F5E9; color: #2E7D32; font-size: 1.1rem; padding: 0.2rem 0.8rem;">SAVE 17%</span>
      </div>

      <div style="color: #555; font-size: 1.45rem; line-height: 1.6; margin-bottom: 1.8rem;">
        {% if product.description != blank %}
          {{ product.description }}
        {% else %}
          Bring radiant sunshine to festive occasions with this handcrafted cotton lehenga. Detailed with delicate embroidery and finished with a comfortable elasticated waistband. Fully lined with 100% soft skin-safe muslin cotton for zero-itch twirling all day long.
        {% endif %}
      </div>

      {% form 'product', product, id: 'MeeekuPdpNativeForm', class: 'meeeku-pdp-form' %}
        <input type="hidden" name="id" id="MeeekuVariantIdInput" value="{{ active_variant_id }}">
        
        <!-- Size Selector -->
        <div style="margin-bottom: 1.8rem;">
          <label style="font-weight: 700; color: #3D2355; font-size: 1.45rem; display: block; margin-bottom: 0.8rem;">Select Size (0 – 6 Years):</label>
          <div class="meeeku-pdp-size-grid">
            {% if product.variants.size > 0 %}
              {% for variant in product.variants %}
                <button type="button" class="meeeku-size-btn {% if variant.id == active_variant_id %}active{% endif %}" onclick="meeekuSelectVariantBtn(this, '{{ variant.id }}', '{{ variant.price | money }}')">
                  {{ variant.title }}
                </button>
              {% endfor %}
            {% else %}
              <button type="button" class="meeeku-size-btn" onclick="meeekuSelectVariantBtn(this, '', '{{ display_price }}')">2 - 3Y</button>
              <button type="button" class="meeeku-size-btn active" onclick="meeekuSelectVariantBtn(this, '', '{{ display_price }}')">4 - 5Y</button>
              <button type="button" class="meeeku-size-btn" onclick="meeekuSelectVariantBtn(this, '', '{{ display_price }}')">6 - 7Y</button>
            {% endif %}
          </div>
        </div>

        <!-- Add to Cart & Buy It Now CTAs -->
        <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
          <button type="submit" name="add" class="meeeku-btn-primary" style="width: 100%; text-align: center; font-size: 1.5rem; padding: 1.2rem;">
            🛒 Add to Cart — <span id="MeeekuBtnPriceLabel">{{ display_price }}</span>
          </button>
          <button type="button" class="meeeku-btn-secondary" style="width: 100%; text-align: center; font-size: 1.5rem; padding: 1.2rem;" onclick="meeekuTriggerBuyNow()">
            ⚡ Buy It Now
          </button>
        </div>
      {% endform %}

      <!-- Trust Badges -->
      {% render 'meeeku-trust-badges' %}

      <!-- Sizing Guide Inline -->
      <div class="meeeku-size-guide-inline" style="margin-top: 2rem; background: #FFFDF7; border: 1.5px solid #F8BBD0; border-radius: 20px; padding: 1.8rem;">
        <h3 style="color: #3D2355; font-size: 1.5rem; font-weight: 800; margin-bottom: 1rem;">📏 Size & Fit Guide (0 – 6 Years)</h3>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; font-size: 1.25rem;">
            <thead>
              <tr style="background: #F8BBD0; color: #3D2355;">
                <th style="padding: 0.6rem 0.8rem; text-align: left;">Age</th>
                <th style="padding: 0.6rem 0.8rem; text-align: center;">Height (cm)</th>
                <th style="padding: 0.6rem 0.8rem; text-align: center;">Chest (cm)</th>
                <th style="padding: 0.6rem 0.8rem; text-align: center;">Waist (cm)</th>
              </tr>
            </thead>
            <tbody>
              <tr><td style="padding: 0.5rem 0.8rem;">2 – 3Y</td><td style="text-align:center;">90–98</td><td style="text-align:center;">50–53</td><td style="text-align:center;">49–52</td></tr>
              <tr style="background: #FFF9F4;"><td style="padding: 0.5rem 0.8rem;">4 – 5Y</td><td style="text-align:center;">104–110</td><td style="text-align:center;">56–59</td><td style="text-align:center;">55–58</td></tr>
              <tr><td style="padding: 0.5rem 0.8rem;">6 – 7Y</td><td style="text-align:center;">116–122</td><td style="text-align:center;">62–65</td><td style="text-align:center;">61–64</td></tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
.meeeku-pdp-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: flex-start;
  position: relative;
}
.meeeku-pdp-gallery-wrapper {
  display: flex;
  gap: 1.2rem;
  align-items: flex-start;
}
.meeeku-pdp-thumbs-list {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  width: 75px;
  flex-shrink: 0;
}
.meeeku-pdp-thumb-item {
  width: 75px;
  height: 95px;
  border-radius: 12px;
  overflow: hidden;
  border: 2px solid #F8BBD0;
  cursor: pointer;
  opacity: 0.7;
  transition: all 0.2s ease;
  background: #FFF;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.meeeku-pdp-thumb-item.active,
.meeeku-pdp-thumb-item:hover {
  opacity: 1;
  border-color: #6B3FA0;
  transform: scale(1.04);
}
.meeeku-pdp-thumb-item img {
  width: 100%;
  height: 75px;
  object-fit: cover;
  object-position: top center;
}
.meeeku-pdp-thumb-item span {
  font-size: 0.85rem;
  font-weight: 700;
  color: #6B3FA0;
  text-align: center;
  width: 100%;
  background: #FFF9F4;
}
.meeeku-pdp-hero-image {
  flex: 1;
  border-radius: 20px;
  overflow: hidden;
  border: 2px solid #F8BBD0;
  box-shadow: 0 8px 24px rgba(107, 63, 160, 0.08);
}
.meeeku-pdp-hero-image img {
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  object-position: top center;
  display: block;
}
.meeeku-pdp-title {
  color: #3D2355;
  font-size: 2.8rem;
  font-weight: 800;
  margin-bottom: 0.6rem;
  line-height: 1.2;
}
.meeeku-pdp-price {
  font-size: 2.6rem;
  font-weight: 800;
  color: #6B3FA0;
}
.meeeku-pdp-size-grid {
  display: flex;
  gap: 0.8rem;
  flex-wrap: wrap;
}
.meeeku-size-btn {
  border: 2px solid #F8BBD0;
  border-radius: 25px;
  padding: 0.6rem 1.4rem;
  font-size: 1.3rem;
  font-weight: 700;
  color: #3D2355;
  background: #FFFDF7;
  cursor: pointer;
  transition: all 0.2s ease;
}
.meeeku-size-btn.active,
.meeeku-size-btn:hover {
  background: #6B3FA0;
  color: #FFF;
  border-color: #6B3FA0;
}

@media screen and (max-width: 749px) {
  .meeeku-pdp-layout {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .meeeku-pdp-gallery-wrapper {
    flex-direction: column-reverse;
  }
  .meeeku-pdp-thumbs-list {
    flex-direction: row;
    width: 100%;
    justify-content: center;
  }
  .meeeku-pdp-title {
    font-size: 2.2rem;
  }
}
</style>

<script>
function meeekuSwitchMainPdpImg(thumb, imgUrl) {
  document.querySelectorAll('.meeeku-pdp-thumb-item').forEach(el => el.classList.remove('active'));
  thumb.classList.add('active');
  const mainImg = document.getElementById('MeeekuMainPdpImage');
  if (mainImg) mainImg.src = imgUrl;
}

function meeekuSelectVariantBtn(btn, variantId, priceFormatted) {
  document.querySelectorAll('.meeeku-size-btn').forEach(el => el.classList.remove('active'));
  btn.classList.add('active');
  if (variantId) {
    const hiddenInput = document.getElementById('MeeekuVariantIdInput');
    if (hiddenInput) hiddenInput.value = variantId;
  }
  if (priceFormatted) {
    const label = document.getElementById('MeeekuBtnPriceLabel');
    if (label) label.textContent = priceFormatted;
    const txt = document.getElementById('MeeekuDisplayPriceText');
    if (txt) txt.textContent = priceFormatted + ' INR';
  }
}

function meeekuTriggerBuyNow() {
  const hiddenInput = document.getElementById('MeeekuVariantIdInput');
  const variantId = hiddenInput ? hiddenInput.value : '';
  if (variantId) {
    window.location.href = '/cart/' + variantId + ':1?checkout';
  } else {
    const form = document.getElementById('MeeekuPdpNativeForm');
    if (form) form.submit();
  }
}
</script>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Product information"
    }
  ]
}
{% endschema %}
