function meeekuSwitchMainPdpImg(thumb, imgUrl) {
  document.querySelectorAll('.meeeku-pdp-thumb-item').forEach(function(el) { el.classList.remove('active'); });
  if (thumb) thumb.classList.add('active');
  const mainImg = document.getElementById('MeeekuMainPdpImage');
  if (mainImg) mainImg.src = imgUrl;
}

function meeekuSelectVariantBtn(btn, variantId, priceFormatted, comparePriceFormatted) {
  document.querySelectorAll('.meeeku-size-btn').forEach(function(el) { el.classList.remove('active'); });
  btn.classList.add('active');
  
  const hiddenInput = document.getElementById('MeeekuVariantIdInput');
  if (hiddenInput && variantId) {
    hiddenInput.value = variantId;
  }
  if (priceFormatted) {
    const label = document.getElementById('MeeekuBtnPriceLabel');
    if (label) label.textContent = priceFormatted;
    const txt = document.getElementById('MeeekuDisplayPriceText');
    if (txt) txt.textContent = priceFormatted;
  }
  if (comparePriceFormatted) {
    const mrp = document.getElementById('MeeekuDisplayMrpText');
    if (mrp) {
      mrp.textContent = comparePriceFormatted;
      mrp.style.display = 'inline';
    }
  }
}

async function meeekuTriggerBuyNow() {
  const hiddenInput = document.getElementById('MeeekuVariantIdInput');
  let variantId = hiddenInput ? hiddenInput.value : '';
  const title = document.getElementById('MeeekuPdpTitle') ? document.getElementById('MeeekuPdpTitle').innerText.trim() : '';
  const price = document.getElementById('MeeekuDisplayPriceText') ? document.getElementById('MeeekuDisplayPriceText').innerText.trim() : '';
  const heroImg = document.getElementById('MeeekuMainPdpImage');
  const img = heroImg ? heroImg.src : '';
  const activeSizeBtn = document.querySelector('.meeeku-size-btn.active');
  const sizeTitle = activeSizeBtn ? activeSizeBtn.innerText.trim() : 'Standard';

  const path = window.location.pathname;
  let targetHandle = path.includes('/products/') ? path.split('/products/')[1].split('/')[0].split('?')[0] : '';

  if (typeof meeekuAddToCartCatalog === 'function') {
    await meeekuAddToCartCatalog(title, price, img, variantId, sizeTitle, targetHandle);
  }
  window.location.href = '/checkout';
}

async function hydrateMeeekuPdpFromObject(p) {
  if (!p) return;

  const titleEl = document.getElementById('MeeekuPdpTitle');
  if (titleEl) titleEl.innerText = p.title;

  const badgeEl = document.getElementById('MeeekuPdpBadge');
  if (badgeEl) {
    badgeEl.innerText = p.badge || '✨ Meeeku Premium';
    badgeEl.className = 'meeeku-badge ' + (p.badge_class || 'meeeku-badge--ethnic');
  }

  const priceFormatted = '₹' + p.price.toLocaleString('en-IN', {minimumFractionDigits: 2});
  const priceEl = document.getElementById('MeeekuDisplayPriceText');
  if (priceEl) priceEl.innerText = priceFormatted;

  const btnPriceEl = document.getElementById('MeeekuBtnPriceLabel');
  if (btnPriceEl) btnPriceEl.innerText = priceFormatted;

  const mrpEl = document.getElementById('MeeekuDisplayMrpText');
  const discountEl = document.getElementById('MeeekuDisplayDiscountBadge');
  if (p.compare_price > p.price) {
    const compareFormatted = '₹' + p.compare_price.toLocaleString('en-IN', {minimumFractionDigits: 2});
    const discountPct = Math.round((p.compare_price - p.price) / p.compare_price * 100);
    if (mrpEl) {
      mrpEl.innerText = compareFormatted;
      mrpEl.style.display = 'inline';
    }
    if (discountEl) {
      discountEl.innerText = 'SAVE ' + discountPct + '%';
      discountEl.style.display = 'inline';
    }
  } else {
    if (mrpEl) mrpEl.style.display = 'none';
    if (discountEl) discountEl.style.display = 'none';
  }

  const descEl = document.getElementById('MeeekuPdpDescription');
  if (descEl && p.body) {
    descEl.innerHTML = p.body;
  }

  // Hero image & Thumbs
  const mainImg = document.getElementById('MeeekuMainPdpImage');
  const thumbsWrap = document.getElementById('MeeekuPdpThumbsList');
  if (p.images && p.images.length > 0) {
    const firstUrl = 'https://raw.githubusercontent.com/aaybwork-studio/meeeku/main/assets/' + p.images[0];
    if (mainImg) mainImg.src = firstUrl;

    if (thumbsWrap) {
      if (p.images.length > 1) {
        thumbsWrap.style.display = 'flex';
        thumbsWrap.innerHTML = '';
        p.images.forEach(function(imgFn, idx) {
          const thumbUrl = 'https://raw.githubusercontent.com/aaybwork-studio/meeeku/main/assets/' + imgFn;
          const thumb = document.createElement('div');
          thumb.className = 'meeeku-pdp-thumb-item' + (idx === 0 ? ' active' : '');
          thumb.onclick = function() { meeekuSwitchMainPdpImg(thumb, thumbUrl); };
          thumb.innerHTML = '<img src="' + thumbUrl + '" alt="View ' + (idx + 1) + '" width="75" height="95" loading="lazy"><span>View ' + (idx + 1) + '</span>';
          thumbsWrap.appendChild(thumb);
        });
      } else {
        thumbsWrap.style.display = 'none';
      }
    }
  }

  // Attempt to fetch real Shopify product JSON to extract real Shopify Variant IDs!
  let liveVariants = null;
  try {
    const res = await fetch('/products/' + p.handle + '.js');
    if (res.ok) {
      const prodJson = await res.json();
      if (prodJson && prodJson.variants && prodJson.variants.length > 0) {
        liveVariants = prodJson.variants;
      }
    }
  } catch(e) {}

  // Variant size buttons
  const sizeGrid = document.getElementById('MeeekuPdpSizeGrid');
  const hiddenInput = document.getElementById('MeeekuVariantIdInput');

  if (sizeGrid) {
    if (liveVariants && liveVariants.length > 0) {
      sizeGrid.innerHTML = '';
      liveVariants.forEach(function(v, idx) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'meeeku-size-btn' + (idx === 0 ? ' active' : '');
        btn.innerText = v.title;
        btn.setAttribute('data-variant-id', v.id);
        const vPriceFmt = '₹' + (v.price / 100).toLocaleString('en-IN', {minimumFractionDigits: 2});
        const vCompareFmt = v.compare_at_price ? ('₹' + (v.compare_at_price / 100).toLocaleString('en-IN', {minimumFractionDigits: 2})) : '';

        if (idx === 0 && hiddenInput) {
          hiddenInput.value = v.id;
        }

        btn.onclick = function() {
          meeekuSelectVariantBtn(btn, v.id, vPriceFmt, vCompareFmt);
        };
        sizeGrid.appendChild(btn);
      });
    } else if (p.variants && p.variants.length > 0) {
      sizeGrid.innerHTML = '';
      p.variants.forEach(function(sizeName, idx) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'meeeku-size-btn' + (idx === 0 ? ' active' : '');
        btn.innerText = sizeName;
        btn.onclick = function() {
          meeekuSelectVariantBtn(btn, '', priceFormatted, p.compare_price > p.price ? ('₹' + p.compare_price.toLocaleString('en-IN', {minimumFractionDigits: 2})) : '');
        };
        sizeGrid.appendChild(btn);
      });
    }
  }

  // Sizing Guide Heading
  const sizeGuideHeading = document.getElementById('MeeekuSizeGuideHeading');
  if (sizeGuideHeading) {
    if (p.size_guide_type === 'towel') {
      sizeGuideHeading.innerText = '🛁 Bath Towel & Blanket Dimensions (0 – 3 Years)';
    } else if (p.size_guide_type === 'pajama') {
      sizeGuideHeading.innerText = '🧸 2-Pack Pajamas Size & Fit Guide (0 – 3 Years)';
    } else if (p.size_guide_type === 'winter') {
      sizeGuideHeading.innerText = '❄️ Winterwear & Tracksuit Size Guide (1 – 6 Years)';
    } else if (p.size_guide_type === 'tee') {
      sizeGuideHeading.innerText = '📏 T-Shirt Size & Fit Guide (0 – 3 Years)';
    } else if (p.size_guide_type === 'coord') {
      sizeGuideHeading.innerText = '📏 2-Piece Co-ord Size Guide (0 – 3 Years)';
    } else {
      sizeGuideHeading.innerText = '📏 Size & Fit Guide (0 – 7 Years)';
    }
  }
}

document.addEventListener('DOMContentLoaded', function() {
  const path = window.location.pathname;
  let targetHandle = '';
  if (path.includes('/products/')) {
    targetHandle = path.split('/products/')[1].split('/')[0].split('?')[0];
  }
  if (!targetHandle) {
    const urlParams = new URLSearchParams(window.location.search);
    targetHandle = urlParams.get('product') || urlParams.get('handle');
  }

  if (targetHandle && MEEKU_ALL_PRODUCTS[targetHandle]) {
    hydrateMeeekuPdpFromObject(MEEKU_ALL_PRODUCTS[targetHandle]);
  } else {
    try {
      const stored = sessionStorage.getItem('meeeku_current_pdp_product');
      if (stored) {
        const parsed = JSON.parse(stored);
        if (parsed && parsed.handle && MEEKU_ALL_PRODUCTS[parsed.handle]) {
          hydrateMeeekuPdpFromObject(MEEKU_ALL_PRODUCTS[parsed.handle]);
        }
      }
    } catch(e) {}
  }

  const form = document.getElementById('MeeekuPdpNativeForm');
  if (form) {
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      const activeSizeBtn = document.querySelector('.meeeku-size-btn.active');
      const sizeTitle = activeSizeBtn ? activeSizeBtn.innerText.trim() : 'Standard';
      const hiddenInput = document.getElementById('MeeekuVariantIdInput');
      let variantId = hiddenInput ? hiddenInput.value : '';
      if (!variantId && activeSizeBtn && activeSizeBtn.getAttribute('data-variant-id')) {
        variantId = activeSizeBtn.getAttribute('data-variant-id');
      }

      const title = document.getElementById('MeeekuPdpTitle') ? document.getElementById('MeeekuPdpTitle').innerText.trim() : 'Meeeku Garment';
      const price = document.getElementById('MeeekuDisplayPriceText') ? document.getElementById('MeeekuDisplayPriceText').innerText.trim() : '₹999.00';
      const heroImg = document.getElementById('MeeekuMainPdpImage');
      const img = heroImg ? heroImg.src : '';

      const btn = form.querySelector('button[type="submit"]');
      if (btn) btn.innerHTML = '✅ Added!';

      if (typeof meeekuAddToCartCatalog === 'function') {
        await meeekuAddToCartCatalog(title, price, img, variantId, sizeTitle, targetHandle);
      }

      setTimeout(function() {
        if (btn) btn.innerHTML = '🛒 Add to Cart — <span id="MeeekuBtnPriceLabel">' + price + '</span>';
      }, 1400);
    });
  }
});
</script>

