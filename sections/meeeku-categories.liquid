{% comment %}
  Meeeku Luxury Bento Category Grid (Shopify OS 2.0 CMS Connected)
  Allows merchant to customize category titles, images, descriptions, button labels, and links or add new category cards in Shopify Theme Customizer.
{% endcomment %}

{% liquid
  assign badge = section.settings.badge | default: 'Explore Collections'
  assign title = section.settings.title | default: 'Shop by Category'
  assign subtitle = section.settings.subtitle | default: '100% Soft Cotton Muslin Lining • Zero-Itch Guarantee • Handcrafted for Little Princesses (0-6Y)'
  assign block_count = section.blocks.size
%}

<div class="page-width meeeku-categories-section" id="MeeekuCategories-{{ section.id }}">
  <div style="text-align: center; margin-bottom: 3.5rem; width: 100%;">
    {% if badge != blank %}
      <span class="meeeku-badge meeeku-badge--ethnic" style="font-size: 1.25rem; padding: 0.4rem 1.4rem; display: inline-block; margin-bottom: 0.5rem;">
        {{ badge }}
      </span>
    {% endif %}
    {% if title != blank %}
      <h2 class="h1" style="color: #3D2355; margin: 0.6rem auto; font-size: 3.6rem; font-weight: 800; text-align: center;">
        {{ title }}
      </h2>
    {% endif %}
    {% if subtitle != blank %}
      <p style="color: #6B3FA0; font-size: 1.65rem; max-width: 650px; margin: 0.5rem auto 0; text-align: center; line-height: 1.5;">
        {{ subtitle }}
      </p>
    {% endif %}
  </div>

  <div class="meeeku-bento-grid">
    {% if block_count > 0 %}
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'hero_card' %}
            {% liquid
              assign col = block.settings.collection
              assign card_link = block.settings.link | default: col.url | default: '/collections/all?category=ethnic'
              assign card_img = block.settings.image | default: col.image
              assign card_title = block.settings.title | default: col.title | default: 'Royal Indian Ethnic Lehengas'
              assign card_desc = block.settings.description | default: col.description | default: 'Vibrant Chanderi, Phulkari, Jacquard & Zardozi Lehengas crafted with 100% soft skin-safe muslin cotton linings.'
              assign card_badge = block.settings.badge_text | default: '👑 IN STOCK • ETHNIC WEAR'
              assign card_tag = block.settings.tag | default: 'Featured Collection'
              assign card_btn = block.settings.button_label | default: 'Explore Royal Lehengas 👑'
            %}
            <a href="{{ card_link }}" class="meeeku-bento-card meeeku-bento-card--hero" {{ block.shopify_attributes }}>
              <div class="meeeku-bento-card__media">
                {% if card_img != blank %}
                  <img src="{{ card_img | image_url: width: 800 }}" alt="{{ card_title | escape }}" class="meeeku-bento-img" width="800" height="900" loading="eager">
                {% else %}
                  <img src="{{ 'meeeku_prod_yellow_lehenga.jpg' | asset_url }}" alt="{{ card_title | escape }}" class="meeeku-bento-img" width="800" height="900" loading="eager">
                {% endif %}
                {% if card_badge != blank %}
                  <span class="meeeku-badge meeeku-badge--overlay-hero">{{ card_badge }}</span>
                {% endif %}
              </div>
              <div class="meeeku-bento-card__content">
                {% if card_tag != blank %}<div class="meeeku-bento-tag">{{ card_tag }}</div>{% endif %}
                <h3>{{ card_title }}</h3>
                <p>{{ card_desc }}</p>
                <span class="button button--primary meeeku-bento-btn">
                  {{ card_btn }}
                </span>
              </div>
            </a>

          {% when 'category_card' %}
            {% liquid
              assign col = block.settings.collection
              assign card_link = block.settings.link | default: col.url | default: '/collections/all'
              assign card_img = block.settings.image | default: col.image
              assign card_title = block.settings.title | default: col.title | default: 'Everyday Cotton T-Shirts'
              assign card_desc = block.settings.description | default: col.description | default: 'Ultra-soft, skin-safe pure combed cotton tees with playful hand-drawn prints.'
              assign card_badge = block.settings.badge_text
              assign card_btn = block.settings.button_label | default: 'Explore Collection'
              assign card_type = block.settings.card_type | default: 'tees'
              assign default_asset = 'meeeku_prod_bunny_tee.jpg'
              if card_type == 'coords'
                assign default_asset = 'meeeku_prod_vanilla_cream_coord.jpg'
              elsif card_type == 'boys'
                assign default_asset = 'placeholder_boys_teaser.jpg'
              elsif card_type == 'dresses'
                assign default_asset = 'placeholder_ethnic_1.jpg'
              endif
            %}
            <a href="{{ card_link }}" class="meeeku-bento-card meeeku-bento-card--sub meeeku-bento-card--{{ card_type }}" {{ block.shopify_attributes }}>
              <div class="meeeku-bento-card__media">
                {% if card_img != blank %}
                  <img src="{{ card_img | image_url: width: 600 }}" alt="{{ card_title | escape }}" class="meeeku-bento-img" width="500" height="600" loading="lazy">
                {% else %}
                  <img src="{{ default_asset | asset_url }}" alt="{{ card_title | escape }}" class="meeeku-bento-img" width="500" height="600" loading="lazy">
                {% endif %}
                {% if card_badge != blank %}
                  <span class="meeeku-badge meeeku-badge--overlay-sub" style="background: {{ block.settings.badge_bg | default: '#E8F5E9' }}; color: {{ block.settings.badge_color | default: '#2E7D32' }};">
                    {{ card_badge }}
                  </span>
                {% endif %}
              </div>
              <div class="meeeku-bento-card__content">
                <h3>{{ card_title }}</h3>
                <p>{{ card_desc }}</p>
                <span class="button button--primary meeeku-bento-btn-sub" style="background: {{ block.settings.button_bg | default: '#2E7D32' }}; border-color: {{ block.settings.button_bg | default: '#2E7D32' }}; color: {{ block.settings.button_color | default: '#FFF' }};">
                  {{ card_btn }}
                </span>
              </div>
            </a>
        {% endcase %}
      {% endfor %}

    {% else %}
      <!-- Fallback Default Brand Categories -->
      <!-- Bento Hero Card: Royal Ethnic Lehengas -->
      <a href="/collections/all?category=ethnic" class="meeeku-bento-card meeeku-bento-card--hero">
        <div class="meeeku-bento-card__media">
          <img src="{{ 'meeeku_prod_yellow_lehenga.jpg' | asset_url }}" alt="Royal Indian Ethnic Lehengas" class="meeeku-bento-img" width="800" height="900" loading="eager">
          <span class="meeeku-badge meeeku-badge--overlay-hero">👑 IN STOCK • ETHNIC WEAR</span>
        </div>
        <div class="meeeku-bento-card__content">
          <div class="meeeku-bento-tag">Featured Collection</div>
          <h3>Royal Indian Ethnic Lehengas</h3>
          <p>Vibrant Chanderi, Phulkari, Jacquard & Zardozi Lehengas crafted with 100% soft skin-safe muslin cotton linings for itch-free twirling all day.</p>
          <span class="button button--primary meeeku-bento-btn">
            Explore Royal Lehengas 👑
          </span>
        </div>
      </a>

      <!-- Bento Card 2: Everyday Storybook T-Shirts -->
      <a href="/collections/all?category=tees" class="meeeku-bento-card meeeku-bento-card--sub meeeku-bento-card--tees">
        <div class="meeeku-bento-card__media">
          <img src="{{ 'meeeku_prod_bunny_tee.jpg' | asset_url }}" alt="Everyday Organic Cotton T-Shirts" class="meeeku-bento-img" width="500" height="600" loading="lazy">
          <span class="meeeku-badge meeeku-badge--overlay-sub" style="background: #E8F5E9; color: #2E7D32; border: 1.5px solid #A5D6A7;">👕 IN STOCK • EVERYDAY WEAR</span>
        </div>
        <div class="meeeku-bento-card__content">
          <h3>Everyday Cotton T-Shirts</h3>
          <p>Ultra-soft, skin-safe pure combed cotton tees with playful hand-drawn prints. Sizes 0-6M to 2-3Y.</p>
          <span class="button button--primary meeeku-bento-btn-sub" style="background: #2E7D32; border-color: #2E7D32; color: #FFF;">
            Shop Basic Tees 👕
          </span>
        </div>
      </a>

      <!-- Bento Card 3: Festive Co-ords -->
      <a href="/collections/all?category=coords" class="meeeku-bento-card meeeku-bento-card--sub meeeku-bento-card--coords">
        <div class="meeeku-bento-card__media">
          <img src="{{ 'meeeku_prod_vanilla_cream_coord.jpg' | asset_url }}" alt="2-Piece Cotton Co-ord Sets" class="meeeku-bento-img" width="500" height="600" loading="lazy">
          <span class="meeeku-badge meeeku-badge--overlay-sub" style="background: #E0F2F1; color: #00695C; border: 1.5px solid #80CBC4;">🌸 IN STOCK • 2-PIECE SETS</span>
        </div>
        <div class="meeeku-bento-card__content">
          <h3>2-Piece Cotton Co-ord Sets</h3>
          <p>Matching eyelet ruffle tops, storybook sets & ribbed peplum lounge sets in 100% organic cotton.</p>
          <span class="button button--secondary meeeku-bento-btn-sub" style="background: #E0F2F1; color: #00695C; border-color: #80CBC4; font-weight: 700;">
            Shop Co-ords 🌸
          </span>
        </div>
      </a>

      <!-- Bento Card 4: Boys Collection -->
      <a href="/collections/all?category=boys" class="meeeku-bento-card meeeku-bento-card--sub meeeku-bento-card--boys">
        <div class="meeeku-bento-card__media">
          <img src="{{ 'meeeku_prod_boy_pinstripe_linen_coord.jpg' | asset_url }}" alt="Boys Collection" class="meeeku-bento-img" width="500" height="600" loading="lazy">
          <span class="meeeku-badge meeeku-badge--overlay-sub" style="background: #FFF8E1; color: #F57F17; border: 1.5px solid #FFE082;">👦 IN STOCK • BOYS WEAR</span>
        </div>
        <div class="meeeku-bento-card__content">
          <h3>Boys Collection</h3>
          <p>Handsome linen co-ords, warm fleece tracksuits & playful outfits crafted with pure breathable cotton.</p>
          <span class="button button--primary meeeku-bento-btn-sub" style="background: #F57F17; border-color: #F57F17; color: #FFF;">
            Shop Boys Line 👦
          </span>
        </div>
      </a>
    {% endif %}
  </div>
</div>

<style>
.meeeku-categories-section {
  padding-top: 4rem;
  padding-bottom: 5rem;
}
.meeeku-bento-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.2rem;
}
.meeeku-bento-card {
  text-decoration: none !important;
  color: inherit !important;
  background: #FFFDF7;
  border-radius: 28px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(107, 63, 160, 0.07);
  border: 2px solid #F8BBD0;
  transition: transform 0.35s ease, box-shadow 0.35s ease;
  display: flex;
  flex-direction: column;
  cursor: pointer;
  position: relative;
}
.meeeku-bento-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 18px 45px rgba(107, 63, 160, 0.16);
}
.meeeku-bento-card--hero {
  grid-column: span 3;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  background: linear-gradient(135deg, #FFFDF7 0%, #FFF5F8 100%);
  border: 2.5px solid #FF6097;
}
.meeeku-bento-card--hero .meeeku-bento-card__media {
  height: 420px;
  position: relative;
  overflow: hidden;
}
.meeeku-bento-card--hero .meeeku-bento-card__content {
  padding: 3.5rem;
  text-align: left;
}
.meeeku-bento-tag {
  display: inline-block;
  font-size: 1.15rem;
  font-weight: 800;
  color: #FF6097;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 0.8rem;
}
.meeeku-bento-card--hero h3 {
  color: #3D2355;
  font-size: 3.2rem;
  font-weight: 800;
  margin-bottom: 1.2rem;
  line-height: 1.25;
}
.meeeku-bento-card--hero p {
  color: #555;
  font-size: 1.6rem;
  line-height: 1.6;
  margin-bottom: 2.2rem;
}
.meeeku-bento-btn {
  border-radius: 30px !important;
  font-size: 1.55rem !important;
  padding: 1.2rem 2.8rem !important;
  font-weight: 700 !important;
}

.meeeku-bento-card--sub {
  border: 2px dashed #B39DDB;
  background: #FCF9FF;
}
.meeeku-bento-card--coords { border-color: #80CBC4; background: #F4FBFB; }
.meeeku-bento-card--nightsuits { border-color: #CE93D8; background: #FAFAFE; }
.meeeku-bento-card--boys { border-color: #FFE082; background: #FFFDF5; }
.meeeku-bento-card--dresses { border-color: #80DEEA; background: #F0FDFE; }

.meeeku-bento-card--sub .meeeku-bento-card__media {
  height: 280px;
  position: relative;
  overflow: hidden;
}
.meeeku-bento-card--sub .meeeku-bento-card__content {
  padding: 2.2rem 1.8rem;
  text-align: center;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.meeeku-bento-card--sub h3 {
  color: #3D2355;
  font-size: 2.2rem;
  font-weight: 800;
  margin-bottom: 0.6rem;
}
.meeeku-bento-card--sub p {
  color: #666;
  font-size: 1.45rem;
  line-height: 1.5;
  margin-bottom: 1.8rem;
}
.meeeku-bento-btn-sub {
  border-radius: 30px !important;
  font-size: 1.35rem !important;
  padding: 1rem 1.8rem !important;
  font-weight: 700 !important;
  width: 100%;
}
.meeeku-bento-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  transition: transform 0.5s ease;
}
.meeeku-bento-card:hover .meeeku-bento-img {
  transform: scale(1.06);
}
.meeeku-badge--overlay-hero {
  position: absolute;
  top: 1.5rem;
  left: 1.5rem;
  z-index: 2;
  background: linear-gradient(135deg, #FF6097, #E91E63);
  color: #FFF;
  font-weight: 800;
  padding: 0.5rem 1.4rem;
  border-radius: 30px;
  font-size: 1.15rem;
  box-shadow: 0 4px 14px rgba(255, 96, 151, 0.4);
}
.meeeku-badge--overlay-sub {
  position: absolute;
  top: 1.2rem;
  left: 1.2rem;
  z-index: 2;
  font-weight: 800;
  padding: 0.4rem 1.1rem;
  border-radius: 30px;
  font-size: 1.1rem;
}

@media screen and (min-width: 750px) and (max-width: 989px) {
  .meeeku-bento-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  .meeeku-bento-card--hero {
    grid-column: span 2;
    grid-template-columns: 1fr 1fr;
  }
  .meeeku-bento-card--hero .meeeku-bento-card__media {
    height: 340px;
  }
  .meeeku-bento-card--hero .meeeku-bento-card__content {
    padding: 2.5rem;
  }
}

@media screen and (max-width: 749px) {
  .meeeku-categories-section {
    padding-top: 2.5rem;
    padding-bottom: 3.5rem;
  }
  .meeeku-bento-grid {
    grid-template-columns: 1fr;
    gap: 1.8rem;
  }
  .meeeku-bento-card--hero {
    grid-column: span 1;
    grid-template-columns: 1fr;
  }
  .meeeku-bento-card--hero .meeeku-bento-card__media {
    height: 260px;
  }
  .meeeku-bento-card--hero .meeeku-bento-card__content {
    padding: 2rem 1.6rem;
  }
  .meeeku-bento-card--hero h3 {
    font-size: 2.2rem;
  }
  .meeeku-bento-card--hero p {
    font-size: 1.4rem;
    margin-bottom: 1.5rem;
  }
  .meeeku-bento-card--sub .meeeku-bento-card__media {
    height: 220px;
  }
  .meeeku-bento-card--sub .meeeku-bento-card__content {
    padding: 1.8rem 1.4rem;
  }
  .meeeku-bento-card--sub h3 {
    font-size: 1.9rem;
  }
  .meeeku-bento-card--sub p {
    font-size: 1.35rem;
    margin-bottom: 1.4rem;
  }
}
</style>

{% schema %}
{
  "name": "Meeeku Bento Categories",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Section Badge",
      "default": "Explore Collections"
    },
    {
      "type": "text",
