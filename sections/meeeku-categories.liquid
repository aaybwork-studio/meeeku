      "label": "Subheading",
      "default": "100% Soft Cotton Muslin Lining • Zero-Itch Guarantee • Handcrafted for Little Princesses (0-6Y)"
    }
  ],
  "blocks": [
    {
      "type": "hero_card",
      "name": "Featured Hero Card",
      "limit": 1,
