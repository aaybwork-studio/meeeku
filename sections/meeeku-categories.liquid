          "default": "#FFFFFF"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Meeeku Bento Categories",
      "blocks": [
        {
          "type": "hero_card",
          "settings": {
            "title": "Royal Indian Ethnic Lehengas",
            "badge_text": "👑 IN STOCK • ETHNIC WEAR",
