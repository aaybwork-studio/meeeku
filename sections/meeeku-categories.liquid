        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Vibrant Chanderi, Phulkari, Jacquard & Zardozi Lehengas crafted with 100% soft skin-safe muslin cotton linings for itch-free twirling all day."
