{% comment %}
  Meeeku Category Cards Grid (Clickable)
{% endcomment %}

<div class="page-width meeeku-categories-section">
  <div class="text-center" style="margin-bottom: 3rem;">
    <span class="meeeku-badge meeeku-badge--ethnic">Explore Collections</span>
    <h2 class="h1" style="color: #3D2355; margin-top: 1rem;">Shop by Category</h2>
    <p style="color: #6B3FA0; font-size: 1.6rem;">Designed with love, soft fabrics, and zero-itch comfort.</p>
  </div>

  <div class="meeeku-category-grid">
    <!-- Category Card 1: Indian Ethnic -->
    <a href="/collections/all?category=ethnic" class="meeeku-cat-card">
      <div class="meeeku-cat-card__media">
        <img src="{{ 'meeeku_prod_yellow_lehenga.jpg' | asset_url }}" alt="Indian Ethnic Wear for Girls" class="meeeku-cat-img" width="600" height="800" loading="lazy">
        <span class="meeeku-badge meeeku-badge--ethnic meeeku-badge--overlay">Royal Ethnic</span>
      </div>
      <div class="meeeku-cat-card__content">
        <h3>Indian Ethnic Wear</h3>
        <p>Vibrant Lehengas, Anarkalis & Chanderi Kurta sets crafted with soft cotton linings.</p>
        <span class="button button--primary" style="border-radius: 30px;">
          Explore Ethnic Collection 👑
        </span>
      </div>
    </a>

    <!-- Category Card 2: Indo-Western Co-ords -->
    <a href="/collections/all?category=coords" class="meeeku-cat-card">
      <div class="meeeku-cat-card__media">
        <img src="{{ 'meeeku_prod_multicolor_coord.jpg' | asset_url }}" alt="Co-ord Sets for Girls" class="meeeku-cat-img" width="600" height="800" loading="lazy">
        <span class="meeeku-badge meeeku-badge--overlay" style="background: #E0F2F1; color: #00695C; border-color: #80CBC4;">Festive Co-ords</span>
      </div>
      <div class="meeeku-cat-card__content">
        <h3>Festive Co-ord Sets</h3>
        <p>Vibrant abstract printed co-ords & regal olive silk two-piece sets for comfortable playful twirls.</p>
        <span class="button button--secondary" style="border-radius: 30px;">
          Shop Festive Co-ords 🌸
        </span>
      </div>
    </a>

    <!-- Category Card 3: Indo-Western Dresses -->
    <a href="/collections/all?category=dresses" class="meeeku-cat-card">
      <div class="meeeku-cat-card__media">
        <img src="{{ 'meeeku_prod_teal_dress.jpg' | asset_url }}" alt="Indo-Western Dresses for Girls" class="meeeku-cat-img" width="600" height="800" loading="lazy">
        <span class="meeeku-badge meeeku-badge--overlay" style="background: #E0F7FA; color: #00838F; border-color: #4DD0E1;">Tulle & Sequins</span>
      </div>
      <div class="meeeku-cat-card__content">
        <h3>Tulle & Festive Dresses</h3>
        <p>Sparkling sequined tops with voluminous tulle net skirts and zero-itch cotton lining.</p>
        <span class="button button--primary" style="border-radius: 30px; background: #00838F; border-color: #00838F;">
          Shop Festive Dresses ✨
        </span>
      </div>
    </a>
  </div>
</div>

<style>
.meeeku-categories-section {
  padding-top: 4rem;
  padding-bottom: 4rem;
}
.meeeku-category-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 3rem;
}
.meeeku-cat-card {
  text-decoration: none !important;
  color: inherit !important;
  background: #FFFDF7;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(107, 63, 160, 0.08);
  border: 2px solid #F8BBD0;
  transition: transform 0.35s ease, box-shadow 0.35s ease;
  display: flex;
  flex-direction: column;
  cursor: pointer;
}
.meeeku-cat-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 16px 40px rgba(107, 63, 160, 0.16);
}
.meeeku-cat-card__media {
  position: relative;
  height: 440px;
  overflow: hidden;
}
.meeeku-cat-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  transition: transform 0.5s ease;
}
.meeeku-cat-card:hover .meeeku-cat-img {
  transform: scale(1.06);
}
.meeeku-badge--overlay {
  position: absolute;
  top: 1.5rem;
  left: 1.5rem;
  z-index: 2;
}
.meeeku-cat-card__content {
  padding: 2.5rem;
  text-align: center;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.meeeku-cat-card__content h3 {
  color: #3D2355;
  font-size: 2.4rem;
  margin-bottom: 1rem;
}
.meeeku-cat-card__content p {
  color: #666;
  font-size: 1.5rem;
  margin-bottom: 2rem;
}
</style>

{% schema %}
{
  "name": "Meeeku Category Cards",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Meeeku Category Cards"
    }
  ]
}
{% endschema %}
