            "badge_bg": "#E0F2F1",
            "badge_color": "#00695C",
            "button_label": "Shop Co-ords 🌸",
            "button_bg": "#00695C",
            "link": "/collections/all?category=coords"
          }
        },
        {
          "type": "category_card",
          "settings": {
            "card_type": "boys",
            "title": "Boys Collection",
            "badge_text": "👦 IN STOCK • BOYS WEAR",
            "badge_bg": "#FFF8E1",
            "badge_color": "#F57F17",
            "button_label": "Shop Boys Line 👦",
            "button_bg": "#F57F17",
            "link": "/collections/all?category=boys"
          }
        }
      ]
