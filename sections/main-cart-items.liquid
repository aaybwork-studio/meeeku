}

.meeeku-btn-checkout {
  flex: 2;
  border-radius: 30px;
  padding: 1.2rem 1.5rem;
  font-size: 1.5rem;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6097, #E91E63);
  border: none;
  box-shadow: 0 4px 16px rgba(255, 96, 151, 0.4);
