{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<div class="page-width section-{{ section.id }}-padding meeeku-cart-page-container">

  <!-- Smart Meeeku Cart Container -->
  <div id="MeeekuLocalCartWrapper" class="meeeku-cart-wrapper" style="display: none;">
    
    <!-- Cart Page Header -->
    <div class="meeeku-cart-header">
      <div style="display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap;">
        <h1 class="meeeku-cart-title">
          🛍️ Your Meeeku Shopping Bag
        </h1>
        <span id="MeeekuCartCountBadge" class="meeeku-cart-count-badge">
          0 Items
        </span>
      </div>
      <a href="/collections/all" class="meeeku-cart-continue-link">
        ← Continue Shopping
      </a>
    </div>

    <!-- Product Rows Container -->
    <div id="MeeekuLocalCartList" class="meeeku-cart-items-list"></div>

    <!-- Order Summary & Checkout Section -->
    <div class="meeeku-cart-summary-wrapper">
      <div class="meeeku-cart-summary-grid">
        
        <!-- Left Column: Trust & Delivery Benefit -->
        <div class="meeeku-cart-shipping-box">
          <div style="font-size: 2.4rem; flex-shrink: 0;">🚚</div>
          <div>
            <div style="color: #2E7D32; font-size: 1.35rem; font-weight: 800;">Free Shipping Across India</div>
            <div style="color: #555; font-size: 1.2rem; margin-top: 0.2rem;">Delivered in 3–5 business days • 7-day hassle-free exchanges</div>
          </div>
        </div>

        <!-- Right Column: Subtotal & Actions -->
        <div class="meeeku-cart-checkout-box">
          <div class="meeeku-cart-subtotal-row">
            <span style="font-size: 1.5rem; color: #666; font-weight: 600;">Estimated Subtotal:</span>
            <span id="MeeekuLocalCartTotal" class="meeeku-cart-total-price">₹0.00</span>
          </div>

          <div class="meeeku-cart-buttons-row">
            <button type="button" class="button button--secondary meeeku-btn-clear" onclick="meeekuClearCart()">
              Clear Bag
            </button>
            <button type="button" class="button button--primary meeeku-btn-checkout" onclick="meeekuProceedToCheckout()">
              🔒 Checkout
            </button>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- Empty State Fallback -->
  <div id="MeeekuCartEmptyState" class="cart__warnings" style="display: block; text-align: center; padding: 5rem 1rem;">
    <div style="font-size: 4.5rem; margin-bottom: 1.2rem;">🛍️</div>
    <h2 class="cart__empty-text" style="color: #3D2355; font-size: 2.4rem; font-weight: 800; margin-bottom: 0.8rem;">Your Meeeku shopping bag is empty</h2>
    <p style="font-size: 1.5rem; color: #777; margin-bottom: 2rem; max-width: 380px; margin-left: auto; margin-right: auto;">
      Discover our 100% skin-safe organic cotton tees, 2-piece co-ord sets, and handcrafted ethnic lehengas!
    </p>
    <a href="/collections/all" class="button button--primary" style="background: #6B3FA0; border-color: #6B3FA0; border-radius: 30px; padding: 1.2rem 3rem; font-size: 1.5rem; font-weight: 700; text-decoration: none;">
      Explore Collections ✨
    </a>
  </div>

</div>

<style>
.meeeku-cart-page-container {
  max-width: 1000px;
  margin: 0 auto;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}

.meeeku-cart-wrapper {
  background: #FFFDF7;
  border: 2px solid #F8BBD0;
  border-radius: 24px;
  padding: 2.5rem;
  box-shadow: 0 10px 30px rgba(107, 63, 160, 0.08);
  margin-top: 1rem;
}

.meeeku-cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2px solid #FCE4EC;
  padding-bottom: 1.8rem;
  margin-bottom: 2.2rem;
  flex-wrap: wrap;
  gap: 1rem;
}

.meeeku-cart-title {
  color: #3D2355;
  font-size: 2.4rem;
  font-weight: 800;
  margin: 0;
  display: flex;
  align-items: center;
  gap: 0.8rem;
}

.meeeku-cart-count-badge {
  background: #EDE7F6;
  color: #6B3FA0;
  font-size: 1.25rem;
  font-weight: 700;
  padding: 0.3rem 1rem;
  border-radius: 20px;
}

.meeeku-cart-continue-link {
  color: #6B3FA0;
  font-size: 1.4rem;
  font-weight: 700;
  text-decoration: none;
}

.meeeku-cart-items-list {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.meeeku-cart-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.8rem;
  padding: 1.6rem;
  background: #FFFFFF;
  border: 1.5px solid #F8BBD0;
  border-radius: 18px;
  box-shadow: 0 2px 10px rgba(107, 63, 160, 0.04);
}

.meeeku-cart-row-left {
  display: flex;
  align-items: center;
  gap: 1.4rem;
  flex: 1;
  min-width: 0;
}

.meeeku-cart-item-img {
  width: 85px;
  height: 105px;
  object-fit: cover;
  border-radius: 14px;
  border: 1.5px solid #FCE4EC;
  flex-shrink: 0;
}

.meeeku-cart-row-right {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  justify-content: flex-end;
  flex-shrink: 0;
}

.meeeku-cart-summary-wrapper {
  margin-top: 2.8rem;
  border-top: 2px dashed #F8BBD0;
  padding-top: 2.2rem;
}

.meeeku-cart-summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  align-items: center;
}

.meeeku-cart-shipping-box {
  background: #F1F8E9;
  border: 1.5px solid #C8E6C9;
  border-radius: 18px;
  padding: 1.2rem 1.6rem;
  display: flex;
  align-items: center;
  gap: 1.2rem;
}

.meeeku-cart-checkout-box {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 1.2rem;
  width: 100%;
}

.meeeku-cart-subtotal-row {
  display: flex;
  justify-content: space-between;
  width: 100%;
  max-width: 360px;
  align-items: baseline;
}

.meeeku-cart-total-price {
  font-size: 2.6rem;
  font-weight: 800;
  color: #6B3FA0;
}

.meeeku-cart-buttons-row {
  display: flex;
  gap: 1rem;
  width: 100%;
  max-width: 360px;
}

.meeeku-btn-clear {
  flex: 1;
  border-radius: 30px;
  padding: 1.1rem;
  font-size: 1.35rem;
  border-color: #F8BBD0;
  color: #6B3FA0;
  font-weight: 700;
  background: #FFF;
  cursor: pointer;
  white-space: nowrap;
}

.meeeku-btn-checkout {
  flex: 2;
  border-radius: 30px;
  padding: 1.2rem 1.5rem;
  font-size: 1.5rem;
  font-weight: 800;
  background: linear-gradient(135deg, #FF6097, #E91E63);
  border: none;
  box-shadow: 0 4px 16px rgba(255, 96, 151, 0.4);
  color: #FFF;
  cursor: pointer;
  white-space: nowrap;
}

@media screen and (max-width: 749px) {
  .meeeku-cart-page-container {
    padding-left: 1.2rem;
    padding-right: 1.2rem;
  }
  .meeeku-cart-wrapper {
    padding: 1.4rem 1.2rem;
    border-radius: 18px;
    margin-top: 0.5rem;
  }
  .meeeku-cart-title {
    font-size: 1.9rem;
  }
  .meeeku-cart-header {
    padding-bottom: 1.2rem;
    margin-bottom: 1.5rem;
  }
  .meeeku-cart-row {
    flex-direction: column;
    align-items: stretch;
    gap: 1.2rem;
    padding: 1.2rem;
    border-radius: 16px;
  }
  .meeeku-cart-row-left {
    width: 100%;
  }
  .meeeku-cart-item-img {
    width: 75px;
    height: 92px;
  }
  .meeeku-cart-row-right {
    width: 100%;
    justify-content: space-between;
    border-top: 1px dashed #FCE4EC;
    padding-top: 0.9rem;
  }
  .meeeku-cart-summary-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .meeeku-cart-checkout-box {
    align-items: stretch;
  }
  .meeeku-cart-subtotal-row {
    max-width: 100%;
  }
  .meeeku-cart-total-price {
    font-size: 2.2rem;
  }
  .meeeku-cart-buttons-row {
    max-width: 100%;
  }
  .meeeku-btn-checkout {
    padding: 1.1rem;
    font-size: 1.4rem;
  }
}
</style>

<script>
function formatMeeekuPaise(paise) {
  var rupees = Math.round(paise / 100);
  return '₹' + rupees.toLocaleString('en-IN') + '.00';
}

function updateCartBadges(count) {
  var countBubbles = document.querySelectorAll('.cart-count-bubble span');
  countBubbles.forEach(function(b) { b.textContent = count; });
  var dot = document.getElementById('MeeekuCartDot');
  if (dot) {
    if (count > 0) dot.classList.add('has-items');
    else dot.classList.remove('has-items');
  }
}

function fetchMeeekuPageCart(callback) {
  fetch('/cart.js')
    .then(function(res) { return res.json(); })
    .then(function(cart) {
      renderMeeekuPageCartWithData(cart);
      updateCartBadges(cart.item_count || 0);
      if (typeof callback === 'function') callback(cart);
    })
    .catch(function(err) {
      console.error('Cart fetch error:', err);
    });
}

function renderMeeekuPageCartWithData(cart) {
  const wrapper = document.getElementById('MeeekuLocalCartWrapper');
  const emptyState = document.getElementById('MeeekuCartEmptyState');
  const list = document.getElementById('MeeekuLocalCartList');
  const totalEl = document.getElementById('MeeekuLocalCartTotal');
  const badgeEl = document.getElementById('MeeekuCartCountBadge');

  if (!wrapper || !emptyState || !list) return;

  const items = cart.items || [];

  if (items.length === 0) {
    wrapper.style.display = 'none';
    emptyState.style.display = 'block';
    return;
  }

  emptyState.style.display = 'none';
  wrapper.style.display = 'block';

  let html = '';

  items.forEach((item, index) => {
    const itemKey = item.key || item.id;
    const unitPriceFormatted = formatMeeekuPaise(item.final_price || item.price || 0);
    const lineTotalFormatted = formatMeeekuPaise(item.final_line_price || item.line_price || 0);
    const imgSrc = item.image || item.featured_image?.url || 'https://raw.githubusercontent.com/aaybwork-studio/meeeku/main/assets/meeeku_prod_yellow_lehenga.jpg';
    const variantTitle = item.variant_title ? item.variant_title : '';

    html += `
      <div class="meeeku-cart-row">
        
        <!-- Left: Image & Product Details -->
        <div class="meeeku-cart-row-left">
          <img src="${imgSrc}" alt="${item.product_title || item.title}" class="meeeku-cart-item-img">
          <div style="display: flex; flex-direction: column; gap: 0.35rem; min-width: 0;">
            <h3 style="margin: 0; color: #3D2355; font-size: 1.55rem; font-weight: 800; line-height: 1.3; word-break: break-word;">${item.product_title || item.title}</h3>
            
            ${variantTitle ? `
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.15rem;">
              <span style="font-size: 1.2rem; color: #666; font-weight: 600;">Size:</span>
              <span style="border: 1.5px solid #F8BBD0; background: #FFFDF7; color: #6B3FA0; font-weight: 700; font-size: 1.2rem; padding: 0.2rem 0.7rem; border-radius: 10px;">
                ${variantTitle}
              </span>
            </div>` : ''}

            <div style="font-size: 1.25rem; color: #888; font-weight: 600;">
              Unit Price: <span style="color: #6B3FA0; font-weight: 700;">${unitPriceFormatted}</span>
            </div>
          </div>
        </div>

        <!-- Right: Quantity Stepper, Line Total & Delete -->
        <div class="meeeku-cart-row-right">
          
          <!-- Quantity Stepper -->
          <div style="display: flex; align-items: center; background: #FFFDF7; border: 1.5px solid #F8BBD0; border-radius: 25px; padding: 0.3rem 0.8rem; box-shadow: 0 2px 6px rgba(107,63,160,0.05);">
            <button type="button" onclick="meeekuUpdatePageQty('${itemKey}', ${item.quantity - 1})" style="background: none; border: none; font-size: 1.7rem; font-weight: 800; color: #FF6097; cursor: pointer; padding: 0 0.4rem; line-height: 1;" title="Decrease quantity">−</button>
            <span style="font-size: 1.4rem; font-weight: 800; padding: 0 0.8rem; color: #3D2355; min-width: 20px; text-align: center;">${item.quantity}</span>
            <button type="button" onclick="meeekuUpdatePageQty('${itemKey}', ${item.quantity + 1})" style="background: none; border: none; font-size: 1.7rem; font-weight: 800; color: #FF6097; cursor: pointer; padding: 0 0.4rem; line-height: 1;" title="Increase quantity">+</button>
          </div>

          <!-- Total Price for this Line -->
          <div style="font-size: 1.75rem; font-weight: 800; color: #3D2355; text-align: right;">
            ${lineTotalFormatted}
          </div>

          <!-- Remove Item Button -->
          <button type="button" onclick="meeekuRemovePageItem('${itemKey}')" style="background: #FFF0F5; border: 1.5px solid #F8BBD0; color: #C2185B; border-radius: 50%; width: 34px; height: 34px; cursor: pointer; font-size: 1.3rem; display: flex; align-items: center; justify-content: center; transition: all 0.2s ease; flex-shrink: 0;" title="Remove from bag">
            ✕
          </button>
        </div>

      </div>
    `;
  });

  list.innerHTML = html;
  if (totalEl) totalEl.innerText = formatMeeekuPaise(cart.total_price || 0);
  if (badgeEl) badgeEl.innerText = (cart.item_count || 0) + (cart.item_count === 1 ? ' Item' : ' Items');
}

function meeekuUpdatePageQty(itemKey, newQty) {
  fetch('/cart/change.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: itemKey, quantity: parseInt(newQty) || 0 })
  })
  .then(function(res) { return res.json(); })
  .then(function(cart) {
    renderMeeekuPageCartWithData(cart);
    updateCartBadges(cart.item_count || 0);
  })
  .catch(function(err) {
    console.error('Error updating quantity on cart page:', err);
  });
}

function meeekuRemovePageItem(itemKey) {
  meeekuUpdatePageQty(itemKey, 0);
}

function meeekuClearCart() {
  if (confirm('Are you sure you want to clear your shopping bag?')) {
    fetch('/cart/clear.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    })
    .then(function(res) { return res.json(); })
    .then(function() {
      fetchMeeekuPageCart();
    })
    .catch(function(err) {
      console.error('Error clearing cart:', err);
    });
  }
}

function meeekuProceedToCheckout() {
  const btn = document.querySelector('.meeeku-btn-checkout');
  if (btn) btn.innerText = '⏳ Opening Checkout...';
  window.location.href = '/checkout';
}

document.addEventListener('DOMContentLoaded', function() {
  fetchMeeekuPageCart();
});
</script>

{% schema %}
{
  "name": "Meeeku Cart Items",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    }
  ]
}
{% endschema %}
