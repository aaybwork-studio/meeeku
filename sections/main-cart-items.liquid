{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Hide default Dawn duplicate cart footer */
  .cart__footer-wrapper,
  .cart__footer,
  #main-cart-footer,
  .main-cart-footer {
    display: none !important;
  }
{%- endstyle -%}

<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<div class="page-width section-{{ section.id }}-padding meeeku-cart-page-container">

  <!-- Smart Meeeku Cart Container -->
  <div id="MeeekuLocalCartWrapper" class="meeeku-cart-wrapper" style="display: none;">
    
    <!-- Cart Page Header -->
    <div class="meeeku-cart-header">
      <div style="display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap;">
        <h1 class="meeeku-cart-title">
          🛍️ Your Meeeku Shopping Bag
        </h1>
        <span id="MeeekuCartCountBadge" class="meeeku-cart-count-badge">
          0 Items
        </span>
      </div>
      <a href="/collections/all" class="meeeku-cart-continue-link">
        ← Continue Shopping
      </a>
    </div>

    <!-- Free Delivery Progress Bar (Threshold: ₹1,000) -->
    <div id="MeeekuPageShippingProgress" style="background: #FFF5F8; border: 1.5px solid #F8BBD0; border-radius: 16px; padding: 1.4rem 1.8rem; margin-bottom: 2rem;">
      <div id="MeeekuPageShippingMsg" style="font-size: 1.4rem; font-weight: 700; color: #3D2355; margin-bottom: 0.8rem; text-align: center; line-height: 1.4;">
        Add ₹1,000.00 more to unlock FREE Express Delivery! 🚚
      </div>
      <div style="width: 100%; height: 12px; background: #FFE0EC; border-radius: 10px; overflow: hidden; position: relative;">
        <div id="MeeekuPageShippingFill" style="width: 0%; height: 100%; background: linear-gradient(90deg, #FF6097, #6B3FA0); border-radius: 10px; transition: width 0.4s ease, background 0.4s ease;"></div>
      </div>
    </div>

    <!-- Product Rows Container -->
    <div id="MeeekuLocalCartList" class="meeeku-cart-items-list"></div>

    <!-- Order Summary & Checkout Section -->
    <div class="meeeku-cart-summary-wrapper">
      <div class="meeeku-cart-summary-grid">
        
        <!-- Left Column: Trust & Delivery Benefit -->
        <div class="meeeku-cart-shipping-box" id="MeeekuPageTrustShippingBox">
          <div style="font-size: 2.4rem; flex-shrink: 0;">🚚</div>
          <div>
            <div id="MeeekuPageTrustTitle" style="color: #2E7D32; font-size: 1.35rem; font-weight: 800;">Free Shipping Across India</div>
            <div id="MeeekuPageTrustSubtitle" style="color: #555; font-size: 1.2rem; margin-top: 0.2rem;">Delivered in 3–5 business days • 7-day hassle-free exchanges</div>
          </div>
        </div>

        <!-- Right Column: Subtotal & Actions -->
        <div class="meeeku-cart-checkout-box">
          <div style="display: flex; justify-content: space-between; align-items: center; font-size: 1.45rem; color: #666; margin-bottom: 0.5rem; width: 100%;">
            <span>Bag Subtotal:</span>
            <span id="MeeekuPageSubtotal" style="color: #3D2355; font-weight: 700; font-size: 1.55rem;">₹0.00</span>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center; font-size: 1.45rem; margin-bottom: 0.8rem; width: 100%;">
            <span>Delivery Charge:</span>
            <span id="MeeekuPageDeliveryFee" style="font-weight: 700; font-size: 1.45rem; color: #2E7D32;">FREE</span>
          </div>
          <div class="meeeku-cart-subtotal-row" style="border-top: 1px solid #FFE0EC; padding-top: 0.8rem; width: 100%;">
            <span style="font-size: 1.6rem; color: #3D2355; font-weight: 800;">Estimated Total:</span>
            <span id="MeeekuLocalCartTotal" class="meeeku-cart-total-price">₹0.00</span>
          </div>

          <div class="meeeku-cart-buttons-row">
            <button type="button" class="button button--secondary meeeku-btn-clear" onclick="meeekuClearCart()">
              Clear Bag
            </button>
            <button type="button" class="button button--primary meeeku-btn-checkout" onclick="meeekuProceedToCheckout()">
              🔒 Checkout
            </button>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- Empty State Fallback -->
  <div id="MeeekuCartEmptyState" class="cart__warnings" style="display: block; text-align: center; padding: 5rem 1rem;">
    <div style="font-size: 4.5rem; margin-bottom: 1.2rem;">🛍️</div>
    <h2 class="cart__empty-text" style="color: #3D2355; font-size: 2.4rem; font-weight: 800; margin-bottom: 0.8rem;">Your Meeeku shopping bag is empty</h2>
    <p style="font-size: 1.5rem; color: #777; margin-bottom: 2rem; max-width: 380px; margin-left: auto; margin-right: auto;">
      Discover our 100% skin-safe organic cotton tees, 2-piece co-ord sets, and handcrafted ethnic lehengas!
    </p>
    <a href="/collections/all" class="button button--primary" style="background: #6B3FA0; border-color: #6B3FA0; border-radius: 30px; padding: 1.2rem 3rem; font-size: 1.5rem; font-weight: 700; text-decoration: none;">
      Explore Collections ✨
    </a>
  </div>

</div>

<style>
.meeeku-cart-page-container {
  max-width: 1000px;
  margin: 0 auto;
  padding-left: 1.5rem;
  padding-right: 1.5rem;
}

.meeeku-cart-wrapper {
  background: #FFFDF7;
  border: 2px solid #F8BBD0;
  border-radius: 24px;
  padding: 2.5rem;
  box-shadow: 0 10px 30px rgba(107, 63, 160, 0.08);
  margin-top: 1rem;
}

.meeeku-cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2px solid #FCE4EC;
  padding-bottom: 1.8rem;
  margin-bottom: 2.2rem;
  flex-wrap: wrap;
  gap: 1rem;
}

.meeeku-cart-title {
  color: #3D2355;
  font-size: 2.4rem;
  font-weight: 800;
  margin: 0;
  display: flex;
  align-items: center;
  gap: 0.8rem;
}

.meeeku-cart-count-badge {
  background: #EDE7F6;
  color: #6B3FA0;
  font-size: 1.25rem;
  font-weight: 700;
  padding: 0.3rem 1rem;
  border-radius: 20px;
}

.meeeku-cart-continue-link {
  color: #6B3FA0;
  font-size: 1.35rem;
  font-weight: 700;
  text-decoration: none;
  border-bottom: 1.5px dashed #F8BBD0;
  padding-bottom: 0.2rem;
  transition: all 0.2s ease;
}

.meeeku-cart-continue-link:hover {
  color: #FF6097;
  border-color: #FF6097;
}

.meeeku-cart-items-list {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  margin-bottom: 2.5rem;
}

.meeeku-cart-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFF;
  border: 1.5px solid #F8BBD0;
  border-radius: 20px;
  padding: 1.6rem 2rem;
  box-shadow: 0 4px 14px rgba(107, 63, 160, 0.04);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.meeeku-cart-row:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(107, 63, 160, 0.08);
}

.meeeku-cart-row-left {
  display: flex;
  align-items: center;
  gap: 1.8rem;
  flex: 1;
}

.meeeku-cart-item-img {
  width: 90px;
  height: 110px;
  object-fit: cover;
  border-radius: 14px;
  border: 1.5px solid #FFE0EC;
  flex-shrink: 0;
}

.meeeku-cart-row-right {
  display: flex;
  align-items: center;
  gap: 2.5rem;
}

.meeeku-cart-summary-wrapper {
  border-top: 2px dashed #F8BBD0;
  padding-top: 2.2rem;
  margin-top: 1rem;
}

.meeeku-cart-summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  align-items: center;
}

.meeeku-cart-shipping-box {
  display: flex;
  align-items: center;
  gap: 1.2rem;
  background: #F1F8E9;
  border: 1.5px solid #C8E6C9;
  border-radius: 18px;
  padding: 1.4rem 1.6rem;
}

.meeeku-cart-checkout-box {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 1.2rem;
}

.meeeku-cart-subtotal-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  width: 100%;
  max-width: 360px;
}

.meeeku-cart-total-price {
  font-size: 2.5rem;
  font-weight: 800;
  color: #6B3FA0;
}

.meeeku-cart-buttons-row {
  display: flex;
  gap: 1rem;
  width: 100%;
  max-width: 360px;
}

.meeeku-btn-clear {
  flex: 1;
  border-radius: 30px;
  padding: 1.1rem;
  font-size: 1.35rem;
  border-color: #F8BBD0;
  color: #6B3FA0;
  font-weight: 700;
  background: #FFF;
