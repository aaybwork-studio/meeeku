{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<div class="page-width section-{{ section.id }}-padding" style="max-width: 1000px; margin: 0 auto;">

  <!-- Smart Meeeku Cart Container -->
  <div id="MeeekuLocalCartWrapper" style="display: none; background: #FFFDF7; border: 2px solid #F8BBD0; border-radius: 24px; padding: 2.8rem; box-shadow: 0 10px 30px rgba(107, 63, 160, 0.08); margin-top: 1rem;">
    
    <!-- Cart Page Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #FCE4EC; padding-bottom: 1.8rem; margin-bottom: 2.2rem; flex-wrap: wrap; gap: 1rem;">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <h1 style="color: #3D2355; font-size: 2.6rem; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 0.8rem;">
          🛍️ Your Meeeku Shopping Bag
        </h1>
        <span id="MeeekuCartCountBadge" style="background: #EDE7F6; color: #6B3FA0; font-size: 1.25rem; font-weight: 700; padding: 0.3rem 1rem; border-radius: 20px;">
          0 Items
        </span>
      </div>
      <a href="/collections/all" class="underlined-link" style="color: #6B3FA0; font-size: 1.4rem; font-weight: 700; text-decoration: none;">
        ← Continue Shopping
      </a>
    </div>

    <!-- Product Rows Container -->
    <div id="MeeekuLocalCartList" style="display: flex; flex-direction: column; gap: 1.5rem;"></div>

    <!-- Order Summary & Checkout Section -->
    <div style="margin-top: 2.8rem; border-top: 2px dashed #F8BBD0; padding-top: 2.2rem;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: center;">
        
        <!-- Left Column: Trust & Delivery Benefit -->
        <div style="background: #F1F8E9; border: 1.5px solid #C8E6C9; border-radius: 18px; padding: 1.2rem 1.6rem; display: flex; align-items: center; gap: 1.2rem;">
          <div style="font-size: 2.4rem;">🚚</div>
          <div>
            <div style="color: #2E7D32; font-size: 1.35rem; font-weight: 800;">Free Shipping Across India</div>
            <div style="color: #555; font-size: 1.2rem;">Delivered in 3–5 business days • 7-day hassle-free exchanges</div>
          </div>
        </div>

        <!-- Right Column: Subtotal & Actions -->
        <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 1.2rem;">
          <div style="display: flex; justify-content: space-between; width: 100%; max-width: 340px; align-items: baseline;">
            <span style="font-size: 1.5rem; color: #666; font-weight: 600;">Estimated Subtotal:</span>
            <span id="MeeekuLocalCartTotal" style="font-size: 2.8rem; font-weight: 800; color: #6B3FA0;">₹0.00</span>
          </div>

          <div style="display: flex; gap: 1rem; width: 100%; max-width: 340px;">
            <button type="button" class="button button--secondary" onclick="meeekuClearCart()" style="flex: 1; border-radius: 30px; padding: 1.1rem; font-size: 1.35rem; border-color: #F8BBD0; color: #6B3FA0; font-weight: 700; background: #FFF;">
              Clear Bag
            </button>
            <button type="button" class="button button--primary" onclick="meeekuProceedToCheckout()" style="flex: 2; border-radius: 30px; padding: 1.2rem; font-size: 1.5rem; font-weight: 800; background: linear-gradient(135deg, #FF6097, #E91E63); border: none; box-shadow: 0 4px 16px rgba(255, 96, 151, 0.4); color: #FFF; cursor: pointer;">
              🔒 Checkout
            </button>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- Empty State Fallback -->
  <div id="MeeekuCartEmptyState" class="cart__warnings" style="display: block; text-align: center; padding: 5rem 1rem;">
    <div style="font-size: 4.5rem; margin-bottom: 1.2rem;">🛍️</div>
    <h2 class="cart__empty-text" style="color: #3D2355; font-size: 2.4rem; font-weight: 800; margin-bottom: 0.8rem;">Your Meeeku shopping bag is empty</h2>
    <p style="font-size: 1.5rem; color: #777; margin-bottom: 2rem; max-width: 380px; margin-left: auto; margin-right: auto;">
      Discover our 100% skin-safe organic cotton tees, 2-piece co-ord sets, and handcrafted ethnic lehengas!
    </p>
    <a href="/collections/all" class="button button--primary" style="background: #6B3FA0; border-color: #6B3FA0; border-radius: 30px; padding: 1.2rem 3rem; font-size: 1.5rem; font-weight: 700; text-decoration: none;">
      Explore Collections ✨
    </a>
  </div>

</div>

<script>
// Available sizes definitions
const MEEEKU_TEE_COORD_SIZES = ['0 - 6M', '6 - 12M', '12 - 18M', '18 - 24M', '2 - 3Y'];
const MEEEKU_ETHNIC_SIZES = ['2 - 3Y', '4 - 5Y', '6 - 7Y'];

function getUnifiedCart() {
  try {
    let cart = JSON.parse(localStorage.getItem('meeeku_active_cart') || 'null');
    if (!cart || !Array.isArray(cart) || cart.length === 0) {
      // Fallback check older keys
      const old1 = JSON.parse(localStorage.getItem('meeeku_user_cart') || 'null');
      const old2 = JSON.parse(localStorage.getItem('meeeku_cart') || 'null');
      cart = old1 || old2 || [];
      if (cart.length > 0) {
        localStorage.setItem('meeeku_active_cart', JSON.stringify(cart));
      }
    }
    return cart;
  } catch (e) {
    return [];
  }
}

function saveUnifiedCart(cart) {
  try {
    localStorage.setItem('meeeku_active_cart', JSON.stringify(cart));
    localStorage.setItem('meeeku_user_cart', JSON.stringify(cart));
    localStorage.setItem('meeeku_cart', JSON.stringify(cart));
  } catch (e) {}
}

function renderMeeekuPageCart() {
  const cart = getUnifiedCart();
  const wrapper = document.getElementById('MeeekuLocalCartWrapper');
  const emptyState = document.getElementById('MeeekuCartEmptyState');
  const list = document.getElementById('MeeekuLocalCartList');
  const totalEl = document.getElementById('MeeekuLocalCartTotal');
  const badgeEl = document.getElementById('MeeekuCartCountBadge');

  if (!wrapper || !emptyState || !list) return;

  if (cart.length === 0) {
    wrapper.style.display = 'none';
    emptyState.style.display = 'block';
    return;
  }

  emptyState.style.display = 'none';
  wrapper.style.display = 'block';

  let totalPaise = 0;
  let totalItemsCount = 0;
  let html = '';

  cart.forEach((item, index) => {
    // Normalise Co-ords pricing to 1299 if it was an old price
    let titleLower = (item.title || '').toLowerCase();
    let isCoord = titleLower.includes('co-ord') || titleLower.includes('set') || titleLower.includes('lounge') || titleLower.includes('peplum') || titleLower.includes('eyelet') || titleLower.includes('stardust') || titleLower.includes('kitty') || titleLower.includes('meadow') || titleLower.includes('storybook');
    let isTee = titleLower.includes('tee') || titleLower.includes('t-shirt');

    let numericPrice = parseFloat((item.price || '0').replace(/[^0-9.]/g, '')) || 0;
    if (isCoord && (numericPrice === 799 || numericPrice === 849 || numericPrice === 899)) {
      numericPrice = 1299;
      item.price = '₹1,299.00';
    }

    const qty = item.qty || item.quantity || 1;
    totalItemsCount += qty;
    const lineTotal = numericPrice * qty;
    totalPaise += lineTotal;

    // Detect size range
    const availableSizes = (isTee || isCoord) ? MEEEKU_TEE_COORD_SIZES : MEEEKU_ETHNIC_SIZES;
    const currentSize = item.size || (isTee || isCoord ? '0 - 6M' : '2 - 3Y');

    let sizeOptionsHtml = '';
    availableSizes.forEach(sz => {
      const selected = sz.replace(/\s+/g, '') === currentSize.replace(/\s+/g, '') ? 'selected' : '';
      sizeOptionsHtml += `<option value="${sz}" ${selected}>${sz}</option>`;
    });

    html += `
      <div class="meeeku-cart-row" style="display: flex; align-items: center; justify-content: space-between; gap: 1.8rem; padding: 1.6rem; background: #FFFFFF; border: 1.5px solid #F8BBD0; border-radius: 18px; box-shadow: 0 2px 10px rgba(107, 63, 160, 0.04); flex-wrap: wrap;">
        
        <!-- Left: Image & Product Details -->
        <div style="display: flex; align-items: center; gap: 1.6rem; flex: 1; min-width: 280px;">
          <img src="${item.img || item.image || 'https://raw.githubusercontent.com/aaybwork-studio/meeeku/main/assets/meeeku_prod_yellow_lehenga.jpg'}" alt="${item.title}" style="width: 85px; height: 105px; object-fit: cover; border-radius: 14px; border: 1.5px solid #FCE4EC; flex-shrink: 0;">
          <div style="display: flex; flex-direction: column; gap: 0.4rem;">
            <h3 style="margin: 0; color: #3D2355; font-size: 1.65rem; font-weight: 800; line-height: 1.3;">${item.title}</h3>
            
            <!-- In-Cart Size Selector -->
            <div style="display: flex; align-items: center; gap: 0.6rem; margin-top: 0.2rem;">
              <span style="font-size: 1.25rem; color: #666; font-weight: 600;">Size:</span>
              <select onchange="meeekuChangeItemSize(${index}, this.value)" style="border: 1.5px solid #F8BBD0; background: #FFFDF7; color: #6B3FA0; font-weight: 700; font-size: 1.25rem; padding: 0.35rem 0.8rem; border-radius: 12px; cursor: pointer; outline: none;">
                ${sizeOptionsHtml}
              </select>
            </div>

            <div style="font-size: 1.35rem; color: #888; font-weight: 600; margin-top: 0.1rem;">
              Unit Price: <span style="color: #6B3FA0; font-weight: 700;">₹${numericPrice.toLocaleString('en-IN')}.00</span>
            </div>
          </div>
        </div>

        <!-- Right: Quantity Stepper, Line Total & Delete -->
        <div style="display: flex; align-items: center; gap: 2rem; justify-content: flex-end;">
          
          <!-- Quantity Stepper -->
          <div style="display: flex; align-items: center; background: #FFFDF7; border: 1.5px solid #F8BBD0; border-radius: 25px; padding: 0.35rem 0.9rem; box-shadow: 0 2px 6px rgba(107,63,160,0.05);">
            <button type="button" onclick="meeekuUpdatePageQty(${index}, -1)" style="background: none; border: none; font-size: 1.8rem; font-weight: 800; color: #FF6097; cursor: pointer; padding: 0 0.5rem; line-height: 1;" title="Decrease quantity">−</button>
            <span style="font-size: 1.5rem; font-weight: 800; padding: 0 1rem; color: #3D2355; min-width: 24px; text-align: center;">${qty}</span>
            <button type="button" onclick="meeekuUpdatePageQty(${index}, 1)" style="background: none; border: none; font-size: 1.8rem; font-weight: 800; color: #FF6097; cursor: pointer; padding: 0 0.5rem; line-height: 1;" title="Increase quantity">+</button>
          </div>

          <!-- Total Price for this Line -->
          <div style="font-size: 1.9rem; font-weight: 800; color: #3D2355; min-width: 110px; text-align: right;">
            ₹${lineTotal.toLocaleString('en-IN')}.00
          </div>

          <!-- Remove Item Button -->
          <button type="button" onclick="meeekuRemovePageItem(${index})" style="background: #FFF0F5; border: 1.5px solid #F8BBD0; color: #C2185B; border-radius: 50%; width: 38px; height: 38px; cursor: pointer; font-size: 1.4rem; display: flex; align-items: center; justify-content: center; transition: all 0.2s ease;" title="Remove from bag">
            ✕
          </button>
        </div>

      </div>
    `;
  });

  saveUnifiedCart(cart);
  list.innerHTML = html;
  if (totalEl) totalEl.innerText = '₹' + totalPaise.toLocaleString('en-IN') + '.00';
  if (badgeEl) badgeEl.innerText = totalItemsCount + (totalItemsCount === 1 ? ' Item' : ' Items');
}

function meeekuChangeItemSize(index, newSize) {
  const cart = getUnifiedCart();
  if (cart[index]) {
    cart[index].size = newSize;
    saveUnifiedCart(cart);
    renderMeeekuPageCart();
  }
}

function meeekuUpdatePageQty(index, delta) {
  let cart = getUnifiedCart();
  if (cart[index]) {
    let currentQty = cart[index].qty || cart[index].quantity || 1;
    currentQty += delta;
    if (currentQty <= 0) {
      cart.splice(index, 1);
    } else {
      cart[index].qty = currentQty;
      cart[index].quantity = currentQty;
    }
    saveUnifiedCart(cart);
    renderMeeekuPageCart();
  }
}

function meeekuRemovePageItem(index) {
  let cart = getUnifiedCart();
  cart.splice(index, 1);
  saveUnifiedCart(cart);
  renderMeeekuPageCart();
}

function meeekuClearCart() {
  saveUnifiedCart([]);
  renderMeeekuPageCart();
}

function meeekuProceedToCheckout() {
  window.location.href = '/checkout';
}

document.addEventListener('DOMContentLoaded', renderMeeekuPageCart);
</script>

<style>
@media screen and (max-width: 749px) {
  .meeeku-cart-row {
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 1.2rem !important;
  }
  .meeeku-cart-row > div:last-child {
    justify-content: space-between !important;
    width: 100% !important;
  }
}
</style>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
