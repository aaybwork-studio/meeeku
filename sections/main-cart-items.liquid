@media screen and (max-width: 749px) {
  .meeeku-cart-page-container {
    padding-left: 1.2rem;
    padding-right: 1.2rem;
  }
  .meeeku-cart-wrapper {
    padding: 1.4rem 1.2rem;
    border-radius: 18px;
    margin-top: 0.5rem;
  }
  .meeeku-cart-title {
    font-size: 1.9rem;
  }
  .meeeku-cart-header {
    padding-bottom: 1.2rem;
    margin-bottom: 1.5rem;
  }
  .meeeku-cart-row {
    flex-direction: column;
    align-items: stretch;
    gap: 1.2rem;
    padding: 1.2rem;
    border-radius: 16px;
  }
  .meeeku-cart-row-left {
    width: 100%;
  }
  .meeeku-cart-item-img {
    width: 75px;
    height: 92px;
  }
  .meeeku-cart-row-right {
    width: 100%;
    justify-content: space-between;
    border-top: 1px dashed #FCE4EC;
    padding-top: 0.9rem;
  }
  .meeeku-cart-summary-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .meeeku-cart-checkout-box {
    align-items: stretch;
  }
  .meeeku-cart-subtotal-row {
    max-width: 100%;
  }
  .meeeku-cart-total-price {
    font-size: 2.2rem;
  }
  .meeeku-cart-buttons-row {
    max-width: 100%;
  }
  .meeeku-btn-checkout {
    padding: 1.1rem;
    font-size: 1.4rem;
  }
}
</style>

<script>
function formatMeeekuPaise(paise) {
  var rupees = Math.round(paise / 100);
  return '₹' + rupees.toLocaleString('en-IN') + '.00';
}

function parseMeeekuPrice(priceStr) {
  if (typeof priceStr === 'number') return priceStr;
  var num = parseFloat(String(priceStr || '0').replace(/[^0-9.]/g, ''));
  return isNaN(num) ? 0 : num;
}

function updateCartBadges(count) {
  var c = parseInt(count) || 0;
  var countBubbles = document.querySelectorAll('.cart-count-bubble span');
  countBubbles.forEach(function(b) { b.textContent = c; });
  var dot = document.getElementById('MeeekuCartDot');
  if (dot) {
    if (c > 0) dot.classList.add('has-items');
    else dot.classList.remove('has-items');
  }
}

function updateMeeekuPageShippingProgress(subtotalRupees) {
  var box = document.getElementById('MeeekuPageShippingProgress');
  var msg = document.getElementById('MeeekuPageShippingMsg');
  var fill = document.getElementById('MeeekuPageShippingFill');
  var deliveryEl = document.getElementById('MeeekuPageDeliveryFee');
  var totalEl = document.getElementById('MeeekuLocalCartTotal');
  var trustTitle = document.getElementById('MeeekuPageTrustTitle');
  var trustSubtitle = document.getElementById('MeeekuPageTrustSubtitle');

  var subtotal = parseFloat(subtotalRupees) || 0;
  if (!box || !msg || !fill) return;

  if (subtotal <= 0) {
    box.style.display = 'none';
    return;
  }

  box.style.display = 'block';
  var threshold = 1000;
  var deliveryFee = 0;

  if (subtotal < threshold) {
    deliveryFee = 100;
    var diff = threshold - subtotal;
    var pct = Math.min(100, Math.max(8, (subtotal / threshold) * 100));
    msg.innerHTML = 'Add <strong style="color: #FF6097;">₹' + diff.toLocaleString('en-IN', {minimumFractionDigits: 2}) + '</strong> more for <span style="color: #2E7D32; font-weight: 800;">FREE Delivery!</span> 🚚';
    fill.style.width = pct + '%';
    fill.style.background = 'linear-gradient(90deg, #FF6097, #6B3FA0)';
    if (deliveryEl) {
      deliveryEl.innerText = '₹100.00';
      deliveryEl.style.color = '#E65100';
    }
    if (trustTitle) trustTitle.innerText = 'Standard Delivery (₹100)';
    if (trustSubtitle) trustSubtitle.innerText = 'Add ₹' + diff.toLocaleString('en-IN', {minimumFractionDigits: 2}) + ' more to get Free Express Delivery!';
  } else {
    deliveryFee = 0;
    msg.innerHTML = '🎉 <strong style="color: #2E7D32;">You\'ve unlocked FREE Express Delivery Across India!</strong>';
    fill.style.width = '100%';
    fill.style.background = 'linear-gradient(90deg, #4CAF50, #2E7D32)';
    if (deliveryEl) {
      deliveryEl.innerText = 'FREE (₹0.00)';
      deliveryEl.style.color = '#2E7D32';
    }
    if (trustTitle) trustTitle.innerText = 'Free Shipping Included';
    if (trustSubtitle) trustSubtitle.innerText = 'Delivered in 3–5 business days • 7-day hassle-free exchanges';
  }

  if (totalEl) {
    var finalTotal = subtotal + deliveryFee;
    totalEl.innerText = '₹' + finalTotal.toLocaleString('en-IN', {minimumFractionDigits: 2});
  }
}

function fetchMeeekuPageCart(callback) {
  fetch('/cart.js', { cache: 'no-store' })
    .then(function(res) {
      if (!res.ok) throw new Error('Status ' + res.status);
      return res.json();
    })
    .then(function(cart) {
      renderMeeekuPageCartWithData(cart);
      updateCartBadges(cart.item_count || 0);
      if (typeof callback === 'function') callback(cart);
    })
    .catch(function(err) {
      renderMeeekuPageCartWithLocalFallback();
      if (typeof callback === 'function') callback(null);
    });
}

function renderMeeekuPageCartWithLocalFallback() {
  var wrapper = document.getElementById('MeeekuLocalCartWrapper');
  var emptyState = document.getElementById('MeeekuCartEmptyState');
  var list = document.getElementById('MeeekuLocalCartList');
  var badgeEl = document.getElementById('MeeekuCartCountBadge');
  var subtotalEl = document.getElementById('MeeekuPageSubtotal');

  if (!wrapper || !emptyState || !list) return;

  var localCart = [];
  try {
    localCart = JSON.parse(localStorage.getItem('meeeku_active_cart') || localStorage.getItem('meeeku_user_cart') || localStorage.getItem('meeeku_cart') || '[]');
  } catch(e) {}

  if (localCart.length === 0) {
    wrapper.style.display = 'none';
    emptyState.style.display = 'block';
    updateCartBadges(0);
    return;
  }

  emptyState.style.display = 'none';
  wrapper.style.display = 'block';

  var totalCount = 0;
  var subtotal = 0;
  var html = '';

  localCart.forEach(function(item, idx) {
    var key = item.key || item.id || ('local_' + idx);
    var qty = parseInt(item.quantity || item.qty) || 1;
    totalCount += qty;
    var unitNum = parseMeeekuPrice(item.price);
    var lineTotal = unitNum * qty;
    subtotal += lineTotal;

    var unitPriceFormatted = '₹' + unitNum.toLocaleString('en-IN', {minimumFractionDigits: 2});
    var lineTotalFormatted = '₹' + lineTotal.toLocaleString('en-IN', {minimumFractionDigits: 2});
    var imgSrc = item.img || item.image || 'https://raw.githubusercontent.com/aaybwork-studio/meeeku/main/assets/meeeku_prod_yellow_lehenga.jpg';
    var sizeLabel = item.size || 'Standard';

    html += [
      '<div class="meeeku-cart-row">',
        '<div class="meeeku-cart-row-left">',
          '<img src="' + imgSrc + '" alt="' + (item.title || 'Meeeku Garment') + '" class="meeeku-cart-item-img">',
          '<div style="display: flex; flex-direction: column; gap: 0.35rem; min-width: 0;">',
            '<h3 style="margin: 0; color: #3D2355; font-size: 1.55rem; font-weight: 800; line-height: 1.3; word-break: break-word;">' + (item.title || 'Meeeku Garment') + '</h3>',
            '<div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.15rem;">',
              '<span style="font-size: 1.2rem; color: #666; font-weight: 600;">Size:</span>',
              '<span style="border: 1.5px solid #F8BBD0; background: #FFFDF7; color: #6B3FA0; font-weight: 700; font-size: 1.2rem; padding: 0.2rem 0.7rem; border-radius: 10px;">' + sizeLabel + '</span>',
            '</div>',
            '<div style="font-size: 1.25rem; color: #888; font-weight: 600;">',
              'Unit Price: <span style="color: #6B3FA0; font-weight: 700;">' + unitPriceFormatted + '</span>',
            '</div>',
          '</div>',
        '</div>',
        '<div class="meeeku-cart-row-right">',
          '<div style="display: flex; align-items: center; background: #FFFDF7; border: 1.5px solid #F8BBD0; border-radius: 25px; padding: 0.3rem 0.8rem; box-shadow: 0 2px 6px rgba(107,63,160,0.05);">',
            '<button type="button" onclick="meeekuUpdatePageQty(\'' + key + '\', ' + (qty - 1) + ')" style="background: none; border: none; font-size: 1.7rem; font-weight: 800; color: #FF6097; cursor: pointer; padding: 0 0.4rem; line-height: 1;" title="Decrease quantity">−</button>',
            '<span style="font-size: 1.4rem; font-weight: 800; padding: 0 0.8rem; color: #3D2355; min-width: 20px; text-align: center;">' + qty + '</span>',
            '<button type="button" onclick="meeekuUpdatePageQty(\'' + key + '\', ' + (qty + 1) + ')" style="background: none; border: none; font-size: 1.7rem; font-weight: 800; color: #FF6097; cursor: pointer; padding: 0 0.4rem; line-height: 1;" title="Increase quantity">+</button>',
          '</div>',
          '<div style="font-size: 1.75rem; font-weight: 800; color: #3D2355; text-align: right;">' + lineTotalFormatted + '</div>',
          '<button type="button" onclick="meeekuRemovePageItem(\'' + key + '\')" style="background: #FFF0F5; border: 1.5px solid #F8BBD0; color: #C2185B; border-radius: 50%; width: 34px; height: 34px; cursor: pointer; font-size: 1.3rem; display: flex; align-items: center; justify-content: center; transition: all 0.2s ease; flex-shrink: 0;" title="Remove from bag">✕</button>',
        '</div>',
      '</div>'
    ].join('');
  });

  list.innerHTML = html;
  if (subtotalEl) {
    subtotalEl.innerText = '₹' + subtotal.toLocaleString('en-IN', {minimumFractionDigits: 2});
  }
  updateMeeekuPageShippingProgress(subtotal);
  if (badgeEl) {
    badgeEl.innerText = totalCount + (totalCount === 1 ? ' Item' : ' Items');
  }
  updateCartBadges(totalCount);
}

function renderMeeekuPageCartWithData(cart) {
  var wrapper = document.getElementById('MeeekuLocalCartWrapper');
  var emptyState = document.getElementById('MeeekuCartEmptyState');
  var list = document.getElementById('MeeekuLocalCartList');
  var badgeEl = document.getElementById('MeeekuCartCountBadge');
  var subtotalEl = document.getElementById('MeeekuPageSubtotal');

  if (!wrapper || !emptyState || !list) return;

  var items = (cart && cart.items) ? cart.items : [];

  if (items.length === 0) {
    renderMeeekuPageCartWithLocalFallback();
    return;
  }

  emptyState.style.display = 'none';
  wrapper.style.display = 'block';

  var html = '';

  items.forEach(function(item) {
    var itemKey = item.key || item.id;
    var unitPriceFormatted = formatMeeekuPaise(item.final_price || item.price || 0);
    var lineTotalFormatted = formatMeeekuPaise(item.final_line_price || item.line_price || 0);
    var imgSrc = item.image || (item.featured_image ? item.featured_image.url : 'https://raw.githubusercontent.com/aaybwork-studio/meeeku/main/assets/meeeku_prod_yellow_lehenga.jpg');
    var variantTitle = item.variant_title ? item.variant_title : '';

    html += [
      '<div class="meeeku-cart-row">',
        '<div class="meeeku-cart-row-left">',
          '<img src="' + imgSrc + '" alt="' + (item.product_title || item.title) + '" class="meeeku-cart-item-img">',
          '<div style="display: flex; flex-direction: column; gap: 0.35rem; min-width: 0;">',
            '<h3 style="margin: 0; color: #3D2355; font-size: 1.55rem; font-weight: 800; line-height: 1.3; word-break: break-word;">' + (item.product_title || item.title) + '</h3>',
            (variantTitle ? [
              '<div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.15rem;">',
                '<span style="font-size: 1.2rem; color: #666; font-weight: 600;">Size:</span>',
                '<span style="border: 1.5px solid #F8BBD0; background: #FFFDF7; color: #6B3FA0; font-weight: 700; font-size: 1.2rem; padding: 0.2rem 0.7rem; border-radius: 10px;">' + variantTitle + '</span>',
              '</div>'
            ].join('') : ''),
            '<div style="font-size: 1.25rem; color: #888; font-weight: 600;">',
              'Unit Price: <span style="color: #6B3FA0; font-weight: 700;">' + unitPriceFormatted + '</span>',
            '</div>',
          '</div>',
        '</div>',
        '<div class="meeeku-cart-row-right">',
          '<div style="display: flex; align-items: center; background: #FFFDF7; border: 1.5px solid #F8BBD0; border-radius: 25px; padding: 0.3rem 0.8rem; box-shadow: 0 2px 6px rgba(107,63,160,0.05);">',
            '<button type="button" onclick="meeekuUpdatePageQty(\'' + itemKey + '\', ' + (item.quantity - 1) + ')" style="background: none; border: none; font-size: 1.7rem; font-weight: 800; color: #FF6097; cursor: pointer; padding: 0 0.4rem; line-height: 1;" title="Decrease quantity">−</button>',
            '<span style="font-size: 1.4rem; font-weight: 800; padding: 0 0.8rem; color: #3D2355; min-width: 20px; text-align: center;">' + item.quantity + '</span>',
            '<button type="button" onclick="meeekuUpdatePageQty(\'' + itemKey + '\', ' + (item.quantity + 1) + ')" style="background: none; border: none; font-size: 1.7rem; font-weight: 800; color: #FF6097; cursor: pointer; padding: 0 0.4rem; line-height: 1;" title="Increase quantity">+</button>',
          '</div>',
          '<div style="font-size: 1.75rem; font-weight: 800; color: #3D2355; text-align: right;">' + lineTotalFormatted + '</div>',
          '<button type="button" onclick="meeekuRemovePageItem(\'' + itemKey + '\')" style="background: #FFF0F5; border: 1.5px solid #F8BBD0; color: #C2185B; border-radius: 50%; width: 34px; height: 34px; cursor: pointer; font-size: 1.3rem; display: flex; align-items: center; justify-content: center; transition: all 0.2s ease; flex-shrink: 0;" title="Remove from bag">✕</button>',
        '</div>',
      '</div>'
    ].join('');
  });

  list.innerHTML = html;
  var subtotalInRupees = Math.round((cart.total_price || 0) / 100);
  if (subtotalEl) {
    subtotalEl.innerText = formatMeeekuPaise(cart.total_price || 0);
  }
  updateMeeekuPageShippingProgress(subtotalInRupees);
  if (badgeEl) {
    badgeEl.innerText = (cart.item_count || 0) + (cart.item_count === 1 ? ' Item' : ' Items');
  }
  updateCartBadges(cart.item_count || 0);
}

function meeekuUpdatePageQty(itemKey, newQty) {
  var q = parseInt(newQty) || 0;
  
  // 1. Update local storage first
  var localCart = [];
  try {
    localCart = JSON.parse(localStorage.getItem('meeeku_active_cart') || localStorage.getItem('meeeku_user_cart') || localStorage.getItem('meeeku_cart') || '[]');
  } catch(e) {}

  var updatedLocal = [];
  localCart.forEach(function(item) {
    var key = item.key || item.id;
    if (String(key) === String(itemKey) || String(item.id) === String(itemKey)) {
      if (q > 0) {
        item.qty = q;
        item.quantity = q;
        updatedLocal.push(item);
      }
    } else {
      updatedLocal.push(item);
    }
  });
  try {
    var str = JSON.stringify(updatedLocal);
    localStorage.setItem('meeeku_active_cart', str);
    localStorage.setItem('meeeku_user_cart', str);
    localStorage.setItem('meeeku_cart', str);
  } catch(e) {}

  renderMeeekuPageCartWithLocalFallback();

  // 2. Sync to server
  fetch('/cart/change.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
    body: JSON.stringify({ id: String(itemKey), quantity: q })
  })
  .then(function(res) {
    if (!res.ok) return fetch('/cart.js', { cache: 'no-store' }).then(function(r) { return r.json(); });
    return res.json();
  })
  .then(function(cart) {
    renderMeeekuPageCartWithData(cart);
  })
  .catch(function() {
    renderMeeekuPageCartWithLocalFallback();
  });
}

function meeekuRemovePageItem(itemKey) {
  meeekuUpdatePageQty(itemKey, 0);
}

function meeekuClearCart() {
  if (confirm('Are you sure you want to clear your shopping bag?')) {
    try {
      localStorage.setItem('meeeku_active_cart', '[]');
      localStorage.setItem('meeeku_user_cart', '[]');
      localStorage.setItem('meeeku_cart', '[]');
    } catch(e) {}
    renderMeeekuPageCartWithLocalFallback();

    fetch('/cart/clear.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    })
    .then(function() {
      fetchMeeekuPageCart();
    })
    .catch(function() {});
  }
}

function meeekuProceedToCheckout() {
  const btn = document.querySelector('.meeeku-btn-checkout');
  if (typeof meeekuGlobalProceedToCheckout === 'function') {
    meeekuGlobalProceedToCheckout(btn);
  } else {
    if (btn) {
      btn.setAttribute('disabled', 'true');
      btn.innerText = '⏳ Opening Checkout...';
    }
    fetch('/cart.js', { cache: 'no-store' })
      .then(function(res) { return res.json(); })
      .then(function(cart) {
        if (cart && cart.item_count > 0) {
          window.location.href = '/checkout';
        } else {
          if (btn) {
            btn.removeAttribute('disabled');
            btn.innerText = '🔒 Checkout';
          }
          if (typeof showMeeekuToast === 'function') showMeeekuToast('⚠️ Your bag is empty!');
        }
      })
      .catch(function() {
        window.location.href = '/checkout';
      });
  }
}

document.addEventListener('DOMContentLoaded', function() {
  fetchMeeekuPageCart();
});

window.addEventListener('pageshow', function() {
  fetchMeeekuPageCart();
  const btn = document.querySelector('.meeeku-btn-checkout');
  if (btn) {
    btn.removeAttribute('disabled');
    btn.innerText = '🔒 Checkout';
  }
});
</script>

