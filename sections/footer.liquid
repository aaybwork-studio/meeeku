{% comment %}
  Meeeku Balanced 4-Column Luxury Footer Section
{% endcomment %}

<footer class="meeeku-footer-wrapper">
  <div class="page-width">
    
    <!-- TOP SECTION: 4-Column Balanced Grid -->
    <div class="meeeku-footer-grid">
      
      <!-- Column 1: Brand Info -->
      <div class="meeeku-footer-col">
        <img src="{{ 'logo.png' | asset_url }}" alt="Meeeku Kidswear" class="meeeku-footer-logo" width="120" height="45">
        <p class="meeeku-footer-tagline">Crafting super-soft Indian Ethnic wear & cozy organic cotton sleepwear for your little dreamers.</p>
      </div>

      <!-- Column 2: Shop Collections -->
      <div class="meeeku-footer-col">
        <h4 class="meeeku-footer-heading">Shop Collections</h4>
        <ul class="meeeku-footer-links">
          <li><a href="/collections/all?category=boys">Boys Collection 👦 (In Stock)</a></li>
          <li><a href="/collections/all?category=ethnic">Royal Indian Ethnic 👑 (In Stock)</a></li>
          <li><a href="/collections/all?category=nightwear">Nightwear & Sleepsuits 🌙 (In Stock)</a></li>
          <li><a href="/collections/all?category=winterwear">Cozy Winterwear ❄️ (In Stock)</a></li>
          <li><a href="/collections/all?category=coords">Festive Co-ords 🌸 (In Stock)</a></li>
          <li><a href="/collections/all?category=tees">Everyday T-Shirts 👕 (In Stock)</a></li>
          <li><a href="/collections/all?category=pajamas">2-Pack Pajamas 🧸 (In Stock)</a></li>
          <li><a href="/collections/all?category=towels">Towels & Blankets 🛁 (In Stock)</a></li>
        </ul>
      </div>

      <!-- Column 3: Customer Care -->
      <div class="meeeku-footer-col">
        <h4 class="meeeku-footer-heading">Customer Care</h4>
        <ul class="meeeku-footer-links">
          <li><a href="/pages/contact">Contact Us</a></li>
          <li><a href="/pages/contact">Size & Fit Guide</a></li>
          <li><a href="/pages/contact">Wash & Fabric Care</a></li>
          <li><a href="mailto:Support@meeeku.com">Email: Support@meeeku.com</a></li>
          <li><a href="tel:8860204205">WhatsApp/Phone: +91 8860204205</a></li>
        </ul>
      </div>

      <!-- Column 4: Newsletter Signup -->
      <div class="meeeku-footer-col">
        <h4 class="meeeku-footer-heading">Join Meeeku Family 💕</h4>
        <p class="meeeku-footer-subtext">Get 20% OFF your first purchase site-wide with code <strong style="color: #FF6097;">WELCOME20</strong>!</p>
        {% form 'customer', id: 'MeeekuFooterForm', class: 'meeeku-footer-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="meeeku-footer-input-group">
            <input type="email" name="contact[email]" placeholder="Enter your email..." required class="meeeku-footer-input">
            <button type="submit" class="button button--primary meeeku-footer-btn">Join</button>
          </div>
        {% endform %}
      </div>

    </div>

    <!-- BOTTOM BAR: Copyright & Legal Policies -->
    <div class="meeeku-footer-bottom">
      <div class="meeeku-footer-copy">
        © 2026, Meeeku Kidswear. Powered by Shopify.
      </div>
      <div class="meeeku-footer-legal">
        <a href="/policies/privacy-policy">Privacy Policy</a>
        <span style="margin: 0 0.4rem;">•</span>
        <a href="/policies/terms-of-service">Terms of Service</a>
        <span style="margin: 0 0.4rem;">•</span>
        <a href="/policies/refund-policy">Refund & Return Policy</a>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "section-footer",
  "settings": [],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
