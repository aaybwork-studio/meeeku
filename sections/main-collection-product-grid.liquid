            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem;">
              <span class="meeeku-badge" style="background: #FFF8E1; color: #F57F17; font-size: 1rem; padding: 0.2rem 0.8rem;">Eyelet Collar Set</span>
