let currentCategory = 'all';

function setCategoryFilter(cat, btn) {
  currentCategory = cat;
  document.querySelectorAll('.meeeku-pill-filter').forEach(function(el) {
    el.classList.remove('active');
  });
  if (btn) btn.classList.add('active');
  applyCatalogFiltersAndSort();
}

function meeekuStorePdpClick(handle, title, price, img, badge) {
  try {
    const pdata = { handle: handle, title: title, price: price, img: img, badge: badge };
    sessionStorage.setItem('meeeku_current_pdp_product', JSON.stringify(pdata));
    localStorage.setItem('meeeku_last_viewed_product', JSON.stringify(pdata));
  } catch(e) {}
}

function applyCatalogFiltersAndSort() {
  const ageFilterEl = document.getElementById('MeeekuAgeFilter');
  const sortOptionEl = document.getElementById('MeeekuPriceSort');
  const ageFilter = ageFilterEl ? ageFilterEl.value : 'all';
  const sortOption = sortOptionEl ? sortOptionEl.value : 'featured';

  const grid = document.getElementById('MeeekuProductGrid');
  const items = Array.from(document.querySelectorAll('.meeeku-grid-item'));

  items.forEach(function(item) {
    const itemCat = (item.getAttribute('data-category') || '').toLowerCase();
    const itemAge = item.getAttribute('data-age') || '';

    const catTokens = itemCat.trim().split(/\s+/);
    const catMatch = (currentCategory === 'all' || catTokens.includes(currentCategory.toLowerCase()));
    const ageMatch = (ageFilter === 'all' || itemAge.includes(ageFilter));

    if (catMatch && ageMatch) {
      item.style.display = 'block';
      item.style.opacity = '1';
    } else {
      item.style.display = 'none';
      item.style.opacity = '0';
    }
  });

  items.sort(function(a, b) {
    const rankA = parseInt(a.getAttribute('data-bestseller-rank')) || 99;
    const rankB = parseInt(b.getAttribute('data-bestseller-rank')) || 99;
    const priceA = parseFloat(a.getAttribute('data-price')) || 0;
    const priceB = parseFloat(b.getAttribute('data-price')) || 0;
    const dateA = new Date(a.getAttribute('data-date')).getTime() || 0;
    const dateB = new Date(b.getAttribute('data-date')).getTime() || 0;

    if (sortOption === 'featured') {
      return rankA - rankB;
    } else if (sortOption === 'price-low') {
      return priceA - priceB;
    } else if (sortOption === 'price-high') {
      return priceB - priceA;
    } else if (sortOption === 'newest') {
      return dateB - dateA;
    }
    return rankA - rankB;
  });

  if (grid) {
    items.forEach(function(item) { grid.appendChild(item); });
  }
}

function createCatalogCardElement(p, idx) {
  const li = document.createElement('li');
  li.className = 'grid__item meeeku-grid-item';
  li.setAttribute('data-handle', p.handle);
  li.setAttribute('data-category', p.categories);
  li.setAttribute('data-price', p.price);
  li.setAttribute('data-age', p.ages);
  li.setAttribute('data-date', '2026-08-27');
  li.setAttribute('data-bestseller-rank', idx + 1);

  const priceFormatted = '₹' + p.price.toLocaleString('en-IN', {minimumFractionDigits: 2});
  const compareFormatted = p.compare_price > 0 ? ('₹' + p.compare_price.toLocaleString('en-IN', {minimumFractionDigits: 2})) : '';
  const discountPct = p.compare_price > p.price ? Math.round((p.compare_price - p.price) / p.compare_price * 100) : 0;
  const discountHtml = discountPct > 0 
    ? '<span style="font-size: 1.3rem; color: #888; text-decoration: line-through; margin-left: 0.5rem;">' + compareFormatted + '</span><span class="meeeku-badge" style="background: #E8F5E9; color: #2E7D32; font-size: 1rem; margin-left: 0.4rem; padding: 0.15rem 0.6rem;">' + discountPct + '% OFF</span>'
    : '';

  const img1Url = 'https://raw.githubusercontent.com/aaybwork-studio/meeeku/main/assets/' + p.images[0];
  const img2Url = p.images.length > 1 ? ('https://raw.githubusercontent.com/aaybwork-studio/meeeku/main/assets/' + p.images[1]) : img1Url;
  const productUrl = '/products/' + p.handle;

  li.innerHTML = [
    '<div class="card-wrapper meeeku-interactive-card">',
      '<div class="meeeku-card-media-wrapper">',
        '<a href="' + productUrl + '" class="meeeku-card-link" onclick="meeekuStorePdpClick(\'' + p.handle + '\', \'' + p.title.replace(/'/g, "\\'") + '\', \'' + priceFormatted + '\', \'' + img1Url + '\', \'' + p.badge.replace(/'/g, "\\'") + '\')">',
          '<img src="' + img1Url + '" alt="' + p.title.replace(/'/g, "\\'") + '" class="meeeku-card-img meeeku-img-primary" width="600" height="750" loading="lazy">',
          (p.images.length > 1 ? '<img src="' + img2Url + '" alt="' + p.title.replace(/'/g, "\\'") + '" class="meeeku-card-img meeeku-img-secondary" width="600" height="750" loading="lazy">' : ''),
        '</a>',
        '<button type="button" class="meeeku-card-hover-quick-add" onclick="meeekuAddToCartCatalog(\'' + p.title.replace(/'/g, "\\'") + '\', \'' + priceFormatted + '\', \'' + img1Url + '\', \'\', \'Standard\', \'' + p.handle + '\')">',
          '🛒 + Quick Add — ' + priceFormatted,
        '</button>',
      '</div>',
      '<div class="card__content" style="padding: 1.2rem 0.5rem 0;">',
        '<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem;">',
          '<span class="meeeku-badge" style="font-size: 1rem; padding: 0.2rem 0.8rem; ' + p.badge_style + '">' + p.badge + '</span>',
        '</div>',
        '<h3 style="margin: 0.4rem 0 0.3rem; font-size: 1.7rem; font-weight: 700;">',
          '<a href="' + productUrl + '" style="color: #3D2355; text-decoration: none;">' + p.title + '</a>',
        '</h3>',
        '<div style="font-size: 1.7rem; font-weight: 800; color: #6B3FA0;">',
          priceFormatted + discountHtml,
        '</div>',
      '</div>',
    '</div>'
  ].join('');

  return li;
}

function reconcileProductCatalog() {
  const grid = document.getElementById('MeeekuProductGrid');
  if (!grid) return;

  const existingItems = Array.from(grid.querySelectorAll('.meeeku-grid-item'));
  const existingHandles = new Set();

  existingItems.forEach(function(item) {
    let handle = item.getAttribute('data-handle');
    if (!handle) {
      const link = item.querySelector('a.meeeku-card-link, a[href*="/products/"]');
      if (link) {
        const href = link.getAttribute('href') || '';
        const match = href.match(/\/products\/([^/?#]+)/);
        if (match) handle = match[1];
      }
    }
    if (handle) existingHandles.add(handle.toLowerCase());
  });

  // If there are zero items or some items are missing, append them from fallback
  MEEKU_CATALOG_FALLBACK.forEach(function(p, idx) {
    if (!existingHandles.has(p.handle.toLowerCase())) {
      const cardEl = createCatalogCardElement(p, existingItems.length + idx);
      grid.appendChild(cardEl);
      existingHandles.add(p.handle.toLowerCase());
    }
  });

  // Re-run filter and sort
  applyCatalogFiltersAndSort();
}

document.addEventListener('DOMContentLoaded', function() {
  reconcileProductCatalog();

  const urlParams = new URLSearchParams(window.location.search);
  const catParam = urlParams.get('category');
  if (catParam) {
    const targetButton = document.querySelector('.meeeku-pill-filter[data-filter="' + catParam + '"]');
    if (targetButton) {
      setCategoryFilter(catParam, targetButton);
      return;
    }
  }
  applyCatalogFiltersAndSort();
});
</script>

