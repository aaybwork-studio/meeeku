              <img src="{{ 'meeeku_prod_pink_net_lehenga_model.jpg' | asset_url }}" alt="Blush Rose Net Lehenga Model View" class="meeeku-card-img meeeku-img-secondary" width="600" height="750" loading="lazy">
            </a>
            <button type="button" class="meeeku-card-hover-quick-add" onclick="meeekuAddToCartCatalog('Blush Rose Net Lehenga', '₹3,299.00', '{{ 'meeeku_prod_pink_net_lehenga.jpg' | asset_url }}', '')">
              🛒 + Quick Add — ₹3,299
            </button>
          </div>
          <div class="card__content" style="padding: 1.2rem 0.5rem 0;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem;">
              <span class="meeeku-badge meeeku-badge--ethnic" style="font-size: 1rem; padding: 0.2rem 0.8rem;">Tiered Soft Net</span>
              <span style="font-size: 1.1rem; color: #666; font-weight: 600;">2-3Y to 6-7Y</span>
            </div>
            <h3 style="margin: 0.4rem 0 0.3rem; font-size: 1.7rem; font-weight: 700;">
              <a href="/products/blush-rose-net-lehenga" style="color: #3D2355; text-decoration: none;">Blush Rose Net Lehenga</a>
            </h3>
            <div style="font-size: 1.7rem; font-weight: 800; color: #6B3FA0;">
              ₹3,299.00 <span style="font-size: 1.3rem; color: #888; text-decoration: line-through; margin-left: 0.5rem;">₹3,999.00</span>
              <span class="meeeku-badge" style="background: #E8F5E9; color: #2E7D32; font-size: 1rem; margin-left: 0.4rem; padding: 0.15rem 0.6rem;">18% OFF</span>
            </div>
          </div>
        </div>
      </li>
      {% endif %}
    </ul>
  </div>

  <!-- Toast Notification for Add to Cart -->
  <div id="MeeekuCartToastCatalog" class="meeeku-cart-toast">
    🎉 Product added to your Cart!
  </div>

</div>

<script>
let currentCategory = 'all';

function setCategoryFilter(cat, btn) {
  currentCategory = cat;
  document.querySelectorAll('.meeeku-pill-filter').forEach(el => el.classList.remove('active'));
  if (btn) btn.classList.add('active');
  applyCatalogFiltersAndSort();
}

document.addEventListener('DOMContentLoaded', function() {
  const urlParams = new URLSearchParams(window.location.search);
  const catParam = urlParams.get('category');
  if (catParam) {
    const targetButton = document.querySelector(`.meeeku-pill-filter[data-filter="${catParam}"]`);
    if (targetButton) {
      setCategoryFilter(catParam, targetButton);
      return;
    }
  }
  applyCatalogFiltersAndSort();

  const cardLinks = document.querySelectorAll('.meeeku-card-link');
  cardLinks.forEach(link => {
    let touchTimer = null;
    link.addEventListener('touchstart', function(e) {
      touchTimer = setTimeout(() => {
        link.classList.add('is-touch-active');
      }, 180);
    }, { passive: true });

    link.addEventListener('touchend', function() {
      clearTimeout(touchTimer);
      setTimeout(() => {
        link.classList.remove('is-touch-active');
      }, 1500);
    }, { passive: true });

    link.addEventListener('touchcancel', function() {
      clearTimeout(touchTimer);
      link.classList.remove('is-touch-active');
    }, { passive: true });
  });
});

const COMING_SOON_INFO = {
  'nightsuits': {
    title: '🌙 Organic Cotton Nightsuits — Launching Soon ⏳',
    desc: 'Our cloud-soft 100% organic cotton sleepwear sets with whimsical prints are currently in final production. Join our VIP waitlist to claim 15% OFF + early access at launch!',
    img: "{{ 'placeholder_nightsuit_1.jpg' | asset_url }}"
  },
  'boys': {
    title: '👦 Boys Line Collection — Launching Soon ⏳',
    desc: 'We are crafting handsome ethnic kurta sets and comfy pyjamas for your little princes. Enter your email to receive launch notifications & 15% OFF!',
    img: "{{ 'placeholder_boys_teaser.jpg' | asset_url }}"
  },
  'dresses': {
    title: '👗 Western & Tulle Partywear — Launching Soon ⏳',
    desc: 'New twirl-ready tulle net dresses and casual partywear silhouettes drop next month. Subscribe now for first access & 15% discount!',
    img: "{{ 'placeholder_ethnic_1.jpg' | asset_url }}"
  }
};

function applyCatalogFiltersAndSort() {
  const ageFilterEl = document.getElementById('MeeekuAgeFilter');
  const sortOptionEl = document.getElementById('MeeekuPriceSort');
  const ageFilter = ageFilterEl ? ageFilterEl.value : 'all';
  const sortOption = sortOptionEl ? sortOptionEl.value : 'featured';

  const grid = document.getElementById('MeeekuProductGrid');
  const items = Array.from(document.querySelectorAll('.meeeku-grid-item'));
  const banner = document.getElementById('MeeekuComingSoonBanner');
  const bannerTitle = document.getElementById('MeeekuComingSoonTitle');
  const bannerDesc = document.getElementById('MeeekuComingSoonDesc');
  const bannerImg = document.getElementById('MeeekuComingSoonImg');

  if (COMING_SOON_INFO[currentCategory]) {
    const info = COMING_SOON_INFO[currentCategory];
    if (bannerTitle) bannerTitle.innerText = info.title;
    if (bannerDesc) bannerDesc.innerText = info.desc;
    if (bannerImg && info.img) bannerImg.src = info.img;
    if (banner) banner.style.display = 'block';
  } else {
    if (banner) banner.style.display = 'none';
  }

  items.forEach(item => {
    const itemCat = item.getAttribute('data-category') || '';
    const itemAge = item.getAttribute('data-age') || '';

    const catMatch = (currentCategory === 'all' || itemCat.includes(currentCategory));
    const ageMatch = (ageFilter === 'all' || itemAge.includes(ageFilter));

    if (catMatch && ageMatch && !COMING_SOON_INFO[currentCategory]) {
      item.style.display = 'block';
      item.style.opacity = '1';
    } else {
      item.style.display = 'none';
      item.style.opacity = '0';
    }
  });

  items.sort((a, b) => {
    const rankA = parseInt(a.getAttribute('data-bestseller-rank')) || 99;
    const rankB = parseInt(b.getAttribute('data-bestseller-rank')) || 99;
    const priceA = parseFloat(a.getAttribute('data-price')) || 0;
    const priceB = parseFloat(b.getAttribute('data-price')) || 0;
    const dateA = new Date(a.getAttribute('data-date')).getTime() || 0;
    const dateB = new Date(b.getAttribute('data-date')).getTime() || 0;

    if (sortOption === 'featured') {
      return rankA - rankB;
    } else if (sortOption === 'price-low') {
      return priceA - priceB;
    } else if (sortOption === 'price-high') {
      return priceB - priceA;
    } else if (sortOption === 'newest') {
      return dateB - dateA;
    }
    return rankA - rankB;
  });

  if (grid) {
    items.forEach(item => grid.appendChild(item));
  }
}

function handleMeeekuWaitlistSubmit(e) {
  e.preventDefault();
  const input = e.target.querySelector('input[type="email"]');
  if (input && input.value) {
    showMeeekuToastCatalog('🎉 You are on the VIP Waitlist! 15% OFF code saved for launch.');
    input.value = '';
  }
}

function meeekuAddToCartCatalog(title, price, imgUrl, variantId) {
  let cart = [];
  try {
    cart = JSON.parse(localStorage.getItem('meeeku_active_cart') || localStorage.getItem('meeeku_user_cart') || localStorage.getItem('meeeku_cart') || '[]');
  } catch (e) { cart = []; }

  const itemKey = (variantId || title) + '_Standard';
  const existing = cart.find(i => i.title === title);
  if (existing) {
    let q = existing.qty || existing.quantity || 1;
    existing.qty = q + 1;
    existing.quantity = q + 1;
  } else {
    cart.push({
      key: itemKey,
      id: variantId || ('item_' + Date.now()),
      title: title,
      price: price,
      img: imgUrl,
      size: '2 - 3Y',
      qty: 1,
      quantity: 1
    });
  }

  localStorage.setItem('meeeku_active_cart', JSON.stringify(cart));
  localStorage.setItem('meeeku_user_cart', JSON.stringify(cart));
  localStorage.setItem('meeeku_cart', JSON.stringify(cart));

  if (variantId && !isNaN(parseInt(variantId))) {
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: parseInt(variantId), quantity: 1 }] })
    }).catch(() => {});
  }

  const dot = document.getElementById('MeeekuCartDot');
  if (dot) dot.classList.add('has-items');

  const totalCount = cart.reduce((sum, i) => sum + (i.quantity || i.qty || 1), 0);
  const countBubbles = document.querySelectorAll('.cart-count-bubble span');
  countBubbles.forEach(b => b.textContent = totalCount);

  showMeeekuToastCatalog(`🎉 ${title} added to your Cart!`);
}

function showMeeekuToastCatalog(msg) {
  const toast = document.getElementById('MeeekuCartToastCatalog') || document.getElementById('MeeekuCartToast');
  if (toast) {
    toast.innerText = msg;
    toast.classList.add('show');
    setTimeout(function() {
      toast.classList.remove('show');
    }, 2800);
  }
}
</script>

<style>
.meeeku-card-media-wrapper {
  position: relative;
  width: 100%;
