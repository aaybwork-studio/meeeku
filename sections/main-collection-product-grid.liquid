{% comment %}
  Meeeku Interactive Catalog & Category Filter Grid with Sort & Age Filters
{% endcomment %}

<div class="page-width meeeku-catalog-section" style="padding-top: 2rem; padding-bottom: 5rem;">
  
  <!-- Category Filter Pills Bar -->
  <div class="meeeku-catalog-pills" style="display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; margin-bottom: 2rem;">
    <button type="button" class="meeeku-pill-filter active" data-filter="all" onclick="setCategoryFilter('all', this)">
      ✨ All Products
    </button>
    <button type="button" class="meeeku-pill-filter" data-filter="ethnic" onclick="setCategoryFilter('ethnic', this)">
      👑 Royal Ethnic
    </button>
    <button type="button" class="meeeku-pill-filter" data-filter="nightsuits" onclick="setCategoryFilter('nightsuits', this)">
      🌙 Organic Nightsuits
    </button>
    <button type="button" class="meeeku-pill-filter" data-filter="coords" onclick="setCategoryFilter('coords', this)" style="background-color: #E0F2F1; color: #00695C; border-color: #80CBC4;">
      🌸 Co-ord Sets (NEW)
    </button>
    <button type="button" class="meeeku-pill-filter" data-filter="boys" onclick="setCategoryFilter('boys', this)" style="background-color: #FFF8E1; color: #F57F17; border-color: #FFE082;">
      👦 Boys Line
    </button>
  </div>

  <!-- Sort By Price & Age Filter Bar -->
  <div class="meeeku-filter-toolbar" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem; background: #FFFDF7; border: 2px solid #F8BBD0; border-radius: 20px; padding: 1rem 1.8rem; margin-bottom: 3rem;">
    <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
      <span style="font-weight: 700; color: #3D2355; font-size: 1.4rem;">👶 Filter by Age:</span>
      <select id="MeeekuAgeFilter" onchange="applyCatalogFiltersAndSort()" style="border: 2px solid #F8BBD0; border-radius: 15px; padding: 0.6rem 1.2rem; font-size: 1.35rem; color: #3D2355; background: #FFF; outline: none; cursor: pointer; font-weight: 600;">
        <option value="all">All Ages (0 - 6 Years)</option>
        <option value="infant">Infant (0 - 2 Years)</option>
        <option value="toddler">Toddler (2 - 4 Years)</option>
        <option value="kid">Kid (4 - 6 Years)</option>
      </select>
    </div>

    <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
      <span style="font-weight: 700; color: #3D2355; font-size: 1.4rem;">📊 Sort By:</span>
      <select id="MeeekuPriceSort" onchange="applyCatalogFiltersAndSort()" style="border: 2px solid #F8BBD0; border-radius: 15px; padding: 0.6rem 1.2rem; font-size: 1.35rem; color: #3D2355; background: #FFF; outline: none; cursor: pointer; font-weight: 600;">
        <option value="featured">Featured & Best Sellers</option>
        <option value="price-low">Price: Low to High</option>
        <option value="price-high">Price: High to Low</option>
        <option value="newest">Newest Arrivals</option>
      </select>
    </div>
  </div>

