</style>

{% schema %}
{
  "name": "Meeeku Catalog Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "options": [
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "3",
      "label": "Desktop columns"
    }
  ],
  "presets": [
    {
      "name": "Meeeku Catalog Grid"
    }
  ]
}
{% endschema %}
