{% comment %}
  Meeeku Reworked Product Catalog Section
{% endcomment %}

<div class="page-width meeeku-catalog-section" style="padding-top: 3rem; padding-bottom: 5rem;">
  <!-- Catalog Hero Header -->
  <div class="meeeku-catalog-header text-center" style="background: linear-gradient(135deg, #FFF0F5 0%, #FFFDF7 100%); padding: 3rem 2rem; border-radius: 28px; border: 2px solid #F8BBD0; margin-bottom: 3rem; box-shadow: 0 10px 30px rgba(107, 63, 160, 0.06);">
    <span class="meeeku-badge meeeku-badge--ethnic">Girls Collection (2-5 Years)</span>
    <h1 style="color: #3D2355; font-size: 3.6rem; font-weight: 800; margin-top: 1rem; margin-bottom: 0.5rem;">Explore All Kidswear & Sleepwear</h1>
    <p style="color: #6B3FA0; font-size: 1.6rem; max-width: 600px; margin: 0 auto 2rem;">Handcrafted Indian Ethnic wear & cloud-soft organic nightsuits lined with 100% breathable cotton.</p>

    <!-- Category Filter Pills -->
    <div class="meeeku-catalog-pills" style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/collections/all" class="button button--primary meeeku-pill-filter active" style="border-radius: 30px;">All Products</a>
      <a href="/collections/all" class="button button--secondary meeeku-pill-filter" style="border-radius: 30px;">Royal Indian Ethnic 👑</a>
      <a href="/collections/all" class="button button--secondary meeeku-pill-filter" style="border-radius: 30px;">Cozy Nightsuits 🌙</a>
      <a href="#meeeku-boys-waitlist" class="button button--secondary meeeku-pill-filter" style="border-radius: 30px; background-color: #FFF8E1; color: #F57F17; border-color: #FFE082;">Boys Teaser 👦</a>
    </div>
  </div>

  <!-- Product Grid -->
  <div class="meeeku-catalog-grid">
    <ul class="grid product-grid grid--2-col-tablet-down grid--3-col-desktop">
      <!-- Product 1 -->
      <li class="grid__item">
        <div class="card-wrapper">
          <div class="card card--standard card--media">
            <div class="card__inner color-scheme-2 gradient">
              <div class="card__media">
                <a href="/products/royal-pink-lehenga">
                  <img src="{{ 'placeholder_ethnic_1.jpg' | asset_url }}" alt="Royal Pink Lehenga Choli" width="600" height="750" loading="lazy" style="object-fit: cover; object-position: top center; width: 100%; height: 380px; border-top-left-radius: 22px; border-top-right-radius: 22px;">
                </a>
              </div>
            </div>
            <div class="card__content" style="padding: 1.8rem;">
              <span class="meeeku-badge meeeku-badge--ethnic" style="font-size: 1rem; padding: 0.2rem 0.8rem;">Indian Ethnic</span>
              <h3 style="margin-top: 0.8rem; margin-bottom: 0.4rem; font-size: 1.8rem; font-weight: 700;">
                <a href="/products/royal-pink-lehenga" style="color: #3D2355; text-decoration: none;">Royal Pink & Gold Lehenga Choli Set</a>
              </h3>
              <div style="font-size: 1.3rem; color: #FF6097; font-weight: 600; margin-bottom: 0.8rem;">⭐⭐⭐⭐⭐ (128)</div>
              <div style="font-size: 2rem; font-weight: 800; color: #6B3FA0; margin-bottom: 1.2rem;">₹2,499.00 <span style="font-size: 1.4rem; color: #888; text-decoration: line-through; margin-left: 0.5rem;">₹3,499.00</span></div>
              <button type="button" class="button button--primary" style="width: 100%; border-radius: 30px;" onclick="document.querySelector('cart-drawer').open()">
                🛒 Quick Add to Cart
              </button>
            </div>
          </div>
        </div>
      </li>

      <!-- Product 2 -->
      <li class="grid__item">
        <div class="card-wrapper">
          <div class="card card--standard card--media">
            <div class="card__inner color-scheme-2 gradient">
              <div class="card__media">
                <a href="/products/cozy-lavender-nightsuit">
                  <img src="{{ 'placeholder_nightsuit_1.jpg' | asset_url }}" alt="Lavender Organic Cotton Nightsuit" width="600" height="750" loading="lazy" style="object-fit: cover; object-position: top center; width: 100%; height: 380px; border-top-left-radius: 22px; border-top-right-radius: 22px;">
                </a>
              </div>
            </div>
            <div class="card__content" style="padding: 1.8rem;">
              <span class="meeeku-badge meeeku-badge--nightsuits" style="font-size: 1rem; padding: 0.2rem 0.8rem;">100% Organic</span>
              <h3 style="margin-top: 0.8rem; margin-bottom: 0.4rem; font-size: 1.8rem; font-weight: 700;">
                <a href="/products/cozy-lavender-nightsuit" style="color: #3D2355; text-decoration: none;">Cozy Lavender Organic Nightsuit Set</a>
              </h3>
              <div style="font-size: 1.3rem; color: #FF6097; font-weight: 600; margin-bottom: 0.8rem;">⭐⭐⭐⭐⭐ (94)</div>
              <div style="font-size: 2rem; font-weight: 800; color: #6B3FA0; margin-bottom: 1.2rem;">₹1,299.00 <span style="font-size: 1.4rem; color: #888; text-decoration: line-through; margin-left: 0.5rem;">₹1,799.00</span></div>
              <button type="button" class="button button--secondary" style="width: 100%; border-radius: 30px;" onclick="document.querySelector('cart-drawer').open()">
                🛒 Quick Add to Cart
              </button>
            </div>
          </div>
        </div>
      </li>

      <!-- Product 3 -->
      <li class="grid__item">
        <div class="card-wrapper">
          <div class="card card--standard card--media">
            <div class="card__inner color-scheme-2 gradient">
              <div class="card__media">
                <a href="/products/pastel-blue-kurta-set">
                  <img src="{{ 'placeholder_boys_teaser.jpg' | asset_url }}" alt="Pastel Blue Kurta Pyjama Set" width="600" height="750" loading="lazy" style="object-fit: cover; object-position: top center; width: 100%; height: 380px; border-top-left-radius: 22px; border-top-right-radius: 22px;">
                </a>
              </div>
            </div>
            <div class="card__content" style="padding: 1.8rem;">
              <span class="meeeku-badge meeeku-badge--coming-soon" style="font-size: 1rem; padding: 0.2rem 0.8rem;">Boys Collection</span>
              <h3 style="margin-top: 0.8rem; margin-bottom: 0.4rem; font-size: 1.8rem; font-weight: 700;">
                <a href="/products/pastel-blue-kurta-set" style="color: #3D2355; text-decoration: none;">Pastel Blue Ethnic Kurta Pyjama Set</a>
              </h3>
              <div style="font-size: 1.3rem; color: #FF6097; font-weight: 600; margin-bottom: 0.8rem;">⭐⭐⭐⭐⭐ (86)</div>
              <div style="font-size: 2rem; font-weight: 800; color: #6B3FA0; margin-bottom: 1.2rem;">₹1,899.00 <span style="font-size: 1.4rem; color: #888; text-decoration: line-through; margin-left: 0.5rem;">₹2,499.00</span></div>
              <button type="button" class="button button--primary" style="width: 100%; border-radius: 30px; background-color: #1976D2;" onclick="document.querySelector('cart-drawer').open()">
                🛒 Quick Add to Cart
              </button>
            </div>
          </div>
        </div>
      </li>
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Meeeku Collection Grid",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Meeeku Collection Grid"
    }
  ]
}
{% endschema %}
