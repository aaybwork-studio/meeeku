{% comment %}
  Meeeku Interactive Dynamic Catalog & Category Filter Grid with Sort & Age Filters
  Shopify OS 2.0 CMS Connected — Automatically syncs real Shopify product updates, images, titles, pricing, variants, and inventory.
{% endcomment %}

<div class="page-width meeeku-catalog-section" style="padding-top: 2rem; padding-bottom: 5rem;">
  
  <!-- Category Filter Pills Bar -->
  <div class="meeeku-catalog-pills" style="display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; margin-bottom: 2rem;">
    <button type="button" class="meeeku-pill-filter active" data-filter="all" onclick="setCategoryFilter('all', this)">
      ✨ All Products
    </button>
    <button type="button" class="meeeku-pill-filter" data-filter="tees" onclick="setCategoryFilter('tees', this)" style="background-color: #E8F5E9; color: #2E7D32; border-color: #A5D6A7; font-weight: 700;">
      👕 Everyday T-Shirts
    </button>
    <button type="button" class="meeeku-pill-filter" data-filter="ethnic" onclick="setCategoryFilter('ethnic', this)">
      👑 Royal Ethnic Lehengas
    </button>
    <button type="button" class="meeeku-pill-filter" data-filter="coords" onclick="setCategoryFilter('coords', this)" style="background-color: #E0F2F1; color: #00695C; border-color: #80CBC4; font-weight: 700;">
      🌸 2-Piece Co-ords
    </button>
    <button type="button" class="meeeku-pill-filter" data-filter="nightsuits" onclick="setCategoryFilter('nightsuits', this)" style="background-color: #F3E5F5; color: #4A148C; border-color: #CE93D8;">
      🌙 Organic Nightsuits <span style="font-size: 0.95rem; background: #9C27B0; color: #FFF; padding: 0.15rem 0.6rem; border-radius: 12px; margin-left: 0.4rem;">Coming Soon ⏳</span>
    </button>
    <button type="button" class="meeeku-pill-filter" data-filter="boys" onclick="setCategoryFilter('boys', this)" style="background-color: #FFF8E1; color: #F57F17; border-color: #FFE082;">
      👦 Boys Line <span style="font-size: 0.95rem; background: #F57F17; color: #FFF; padding: 0.15rem 0.6rem; border-radius: 12px; margin-left: 0.4rem;">Coming Soon ⏳</span>
    </button>
    <button type="button" class="meeeku-pill-filter" data-filter="dresses" onclick="setCategoryFilter('dresses', this)" style="background-color: #E0F7FA; color: #00838F; border-color: #80DEEA;">
      👗 Western Dresses <span style="font-size: 0.95rem; background: #00838F; color: #FFF; padding: 0.15rem 0.6rem; border-radius: 12px; margin-left: 0.4rem;">Coming Soon ⏳</span>
    </button>
  </div>

  <!-- Sort By Price & Age Filter Bar -->
  <div class="meeeku-filter-toolbar">
    <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
      <span style="font-weight: 700; color: #3D2355; font-size: 1.4rem;">👶 Filter by Age:</span>
      <div class="meeeku-select-wrapper">
        <select id="MeeekuAgeFilter" onchange="applyCatalogFiltersAndSort()" class="meeeku-filter-select">
          <option value="all">All Ages (0M – 7 Years)</option>
          <option value="0-6m">0 – 6 Months (Infant)</option>
          <option value="6-12m">6 – 12 Months (Infant)</option>
          <option value="1-2y">12 – 24 Months (1 – 2 Years)</option>
          <option value="2-3y">2 – 3 Years (Toddler)</option>
          <option value="3-7y">3 – 7 Years (Kids)</option>
        </select>
        <span class="meeeku-select-arrow">▾</span>
      </div>
    </div>

    <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
      <span style="font-weight: 700; color: #3D2355; font-size: 1.4rem;">📊 Sort By:</span>
      <div class="meeeku-select-wrapper">
        <select id="MeeekuPriceSort" onchange="applyCatalogFiltersAndSort()" class="meeeku-filter-select">
          <option value="featured">Featured & Best Sellers</option>
          <option value="price-low">Price: Low to High</option>
          <option value="price-high">Price: High to Low</option>
          <option value="newest">Newest Arrivals</option>
        </select>
        <span class="meeeku-select-arrow">▾</span>
      </div>
    </div>
  </div>

  <!-- Dynamic Coming Soon & VIP Waitlist Teaser Banner -->
  <div id="MeeekuComingSoonBanner" style="display: none; background: #FFFDF7; border: 2.5px dashed #CE93D8; border-radius: 24px; padding: 3rem 2rem; text-align: center; margin-bottom: 3rem; box-shadow: 0 10px 30px rgba(107, 63, 160, 0.06);">
    <span class="meeeku-badge" style="background: #EDE7F6; color: #512DA8; border: 1.5px solid #D1C4E9; font-weight: 800; font-size: 1.2rem; padding: 0.4rem 1.2rem; border-radius: 30px;">⏳ LAUNCHING SOON</span>
    
    <div id="MeeekuComingSoonImgWrap" style="margin: 1.5rem auto 1rem; max-width: 320px; max-height: 240px; border-radius: 20px; overflow: hidden; border: 2px solid #F8BBD0; box-shadow: 0 8px 20px rgba(0,0,0,0.06);">
      <img id="MeeekuComingSoonImg" src="{{ 'placeholder_coords_1.jpg' | asset_url }}" alt="Category Sneak Peek Teaser" style="width: 100%; height: 220px; object-fit: cover;">
    </div>

    <h3 id="MeeekuComingSoonTitle" style="color: #3D2355; font-size: 2.6rem; font-weight: 800; margin: 0.8rem 0 0.5rem;">Category Launching Soon</h3>
    <p id="MeeekuComingSoonDesc" style="color: #6B3FA0; font-size: 1.5rem; max-width: 600px; margin: 0 auto 1.8rem; line-height: 1.6;">
      We are currently crafting zero-itch, pure cotton sleepwear and festive outfits for this collection. Join our VIP waitlist to get early access & 15% OFF at launch!
    </p>
    <form onsubmit="handleMeeekuWaitlistSubmit(event)" style="display: flex; gap: 1rem; justify-content: center; max-width: 520px; margin: 0 auto; flex-wrap: wrap;">
      <input type="email" placeholder="Enter your email address" required style="border: 2px solid #CE93D8; border-radius: 30px; padding: 1rem 1.6rem; font-size: 1.35rem; flex: 1; min-width: 240px; outline: none; background: #FFF;">
      <button type="submit" class="button button--primary" style="border-radius: 30px; background: #7B1FA2; border-color: #7B1FA2; font-weight: 700; padding: 1rem 2rem; cursor: pointer; font-size: 1.35rem;">
        🔔 Join Launch Waitlist (15% OFF)
      </button>
    </form>
  </div>

  <!-- Interactive Catalog Grid -->
  <div class="meeeku-catalog-grid">
    <ul class="grid product-grid grid--2-col-tablet-down grid--3-col-desktop" id="MeeekuProductGrid">
      {% if collection.products.size > 0 %}
        {% for product in collection.products %}
          {% liquid
            assign p_type = product.type | downcase
            assign p_tags = product.tags | join: ',' | downcase
            assign p_title = product.title | downcase
            assign p_handle = product.handle | downcase

            assign is_ethnic = false
            assign is_tee = false
            assign is_dress = false
            assign is_nightsuit = false
            assign is_boy = false
            assign is_coord = false

            if p_title contains 'lehenga' or p_handle contains 'lehenga' or p_type contains 'lehenga' or p_type contains 'ethnic' or p_tags contains 'lehenga' or p_tags contains 'royal ethnic' or p_tags contains 'indian ethnic'
              assign is_ethnic = true
            elsif p_title contains 'tee' or p_title contains 't-shirt' or p_handle contains 'tee' or p_type contains 'tee' or p_type contains 't-shirt' or p_tags contains 'basic tee'
              assign is_tee = true
            elsif p_title contains 'dress' or p_handle contains 'dress' or p_type contains 'dress' or p_tags contains 'dresses'
              assign is_dress = true
            elsif p_title contains 'night' or p_title contains 'sleep' or p_type contains 'night' or p_tags contains 'nightsuit'
              assign is_nightsuit = true
            elsif p_title contains 'boy' or p_type contains 'boy' or p_tags contains 'boys'
              assign is_boy = true
            elsif p_title contains 'co-ord' or p_title contains 'coord' or p_handle contains 'coord' or p_type contains 'co-ord' or p_type contains 'coord' or p_tags contains 'co-ord' or p_tags contains 'coord'
              assign is_coord = true
            else
              assign is_ethnic = true
            endif

            assign cat_list = 'all '
            if is_ethnic
              assign cat_list = cat_list | append: 'ethnic'
              assign badge_label = 'Royal Ethnic Lehenga'
              assign badge_style = 'background: #FFF0F5; color: #6B3FA0; border: 1px solid #F8BBD0;'
            elsif is_tee
              assign cat_list = cat_list | append: 'tees'
              assign badge_label = '100% Combed Cotton'
              assign badge_style = 'background: #E8F5E9; color: #2E7D32; border: 1px solid #A5D6A7;'
            elsif is_coord
              assign cat_list = cat_list | append: 'coords'
              assign badge_label = '2-Piece Co-ord Set'
              assign badge_style = 'background: #E0F2F1; color: #00695C; border: 1px solid #80CBC4;'
            elsif is_dress
              assign cat_list = cat_list | append: 'dresses'
              assign badge_label = 'Indo-Western Dress'
              assign badge_style = 'background: #E0F7FA; color: #00838F; border: 1px solid #80DEEA;'
            elsif is_nightsuit
              assign cat_list = cat_list | append: 'nightsuits'
              assign badge_label = 'Organic Nightsuit'
              assign badge_style = 'background: #F3E5F5; color: #4A148C; border: 1px solid #CE93D8;'
            elsif is_boy
              assign cat_list = cat_list | append: 'boys'
              assign badge_label = 'Boys Line'
              assign badge_style = 'background: #FFF8E1; color: #F57F17; border: 1px solid #FFE082;'
            endif

            assign age_keys = 'all'
            assign all_v_titles = ''
            for v in product.variants
              assign all_v_titles = all_v_titles | append: ' ' | append: v.title | downcase
            endfor
            assign full_search_str = p_tags | append: ' ' | append: all_v_titles

            if full_search_str contains '0-6m' or full_search_str contains '0 - 6m' or full_search_str contains 'infant' or full_search_str contains '0-1y' or full_search_str contains '0 - 1y'
              assign age_keys = age_keys | append: ',0-6m'
            endif
            if full_search_str contains '6-12m' or full_search_str contains '6 - 12m' or full_search_str contains 'infant' or full_search_str contains '0-1y' or full_search_str contains '0 - 1y'
              assign age_keys = age_keys | append: ',6-12m'
            endif
            if full_search_str contains '12-18m' or full_search_str contains '18-24m' or full_search_str contains '1-2y' or full_search_str contains '1 - 2y' or full_search_str contains 'toddler'
              assign age_keys = age_keys | append: ',1-2y'
            endif
            if full_search_str contains '2-3y' or full_search_str contains '2 - 3y' or full_search_str contains 'toddler'
              assign age_keys = age_keys | append: ',2-3y'
            endif
            if full_search_str contains '3-4y' or full_search_str contains '4-5y' or full_search_str contains '5-6y' or full_search_str contains '6-7y' or full_search_str contains '3-7y' or full_search_str contains 'kids'
              assign age_keys = age_keys | append: ',3-7y'
            endif

            assign first_img = product.featured_media.preview_image | default: product.featured_image | default: product.images.first
            assign second_img = product.images[1] | default: first_img
            assign first_img_url = first_img | image_url: width: 600
            assign second_img_url = second_img | image_url: width: 600
            assign current_var = product.selected_or_first_available_variant
          %}
          <li class="grid__item meeeku-grid-item" data-category="{{ cat_list | strip }}" data-price="{{ product.price | divided_by: 100 }}" data-age="{{ age_keys }}" data-date="{{ product.published_at | date: '%Y-%m-%d' }}" data-bestseller-rank="{{ forloop.index }}">
            <div class="card-wrapper meeeku-interactive-card">
              <div class="meeeku-card-media-wrapper">
                <a href="{{ product.url }}" class="meeeku-card-link">
                  {% if first_img %}
                    <img src="{{ first_img_url }}" alt="{{ product.title | escape }}" class="meeeku-card-img meeeku-img-primary" width="600" height="750" loading="lazy">
                  {% endif %}
                  {% if second_img and second_img != first_img %}
                    <img src="{{ second_img_url }}" alt="{{ product.title | escape }}" class="meeeku-card-img meeeku-img-secondary" width="600" height="750" loading="lazy">
                  {% endif %}
                </a>
                <button type="button" class="meeeku-card-hover-quick-add" onclick="meeekuAddToCartCatalog('{{ product.title | escape }}', '{{ product.price | money }}', '{{ first_img | image_url: width: 400 }}', '{{ current_var.id }}')">
                  🛒 + Quick Add — {{ product.price | money }}
                </button>
              </div>
              <div class="card__content" style="padding: 1.2rem 0.5rem 0;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem;">
                  <span class="meeeku-badge" style="font-size: 1rem; padding: 0.2rem 0.8rem; {{ badge_style }}">{{ badge_label }}</span>
                </div>
                <h3 style="margin: 0.4rem 0 0.3rem; font-size: 1.7rem; font-weight: 700;">
                  <a href="{{ product.url }}" style="color: #3D2355; text-decoration: none;">{{ product.title }}</a>
                </h3>
                <div style="font-size: 1.7rem; font-weight: 800; color: #6B3FA0;">
                  {{ product.price | money }}
                  {% if product.compare_at_price > product.price %}
                    <span style="font-size: 1.3rem; color: #888; text-decoration: line-through; margin-left: 0.5rem;">{{ product.compare_at_price | money }}</span>
                    <span class="meeeku-badge" style="background: #E8F5E9; color: #2E7D32; font-size: 1rem; margin-left: 0.4rem; padding: 0.15rem 0.6rem;">
                      {{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}% OFF
                    </span>
                  {% endif %}
                </div>
              </div>
            </div>
          </li>
        {% endfor %}
      {% else %}
      <!-- JS will populate this from Shopify live API — see script below -->
      <li id="MeeekuCatalogFetchPlaceholder" class="grid__item" style="display:none;"></li>
      {% endif %}
    </ul>
  </div>

  <!-- Toast Notification for Add to Cart -->
  <div id="MeeekuCartToastCatalog" class="meeeku-cart-toast">
    🎉 Product added to your Cart!
  </div>

</div>

<script>
let currentCategory = 'all';

function setCategoryFilter(cat, btn) {
  currentCategory = cat;
  document.querySelectorAll('.meeeku-pill-filter').forEach(el => el.classList.remove('active'));
  if (btn) btn.classList.add('active');
  applyCatalogFiltersAndSort();
}

document.addEventListener('DOMContentLoaded', function() {
  const urlParams = new URLSearchParams(window.location.search);
  const catParam = urlParams.get('category');
  if (catParam) {
    const targetButton = document.querySelector(`.meeeku-pill-filter[data-filter="${catParam}"]`);
    if (targetButton) {
      setCategoryFilter(catParam, targetButton);
      return;
    }
  }
  applyCatalogFiltersAndSort();

  const cardLinks = document.querySelectorAll('.meeeku-card-link');
  cardLinks.forEach(link => {
    let touchTimer = null;
    link.addEventListener('touchstart', function(e) {
      touchTimer = setTimeout(() => {
        link.classList.add('is-touch-active');
      }, 180);
    }, { passive: true });

    link.addEventListener('touchend', function() {
      clearTimeout(touchTimer);
      setTimeout(() => {
        link.classList.remove('is-touch-active');
      }, 1500);
    }, { passive: true });

    link.addEventListener('touchcancel', function() {
      clearTimeout(touchTimer);
      link.classList.remove('is-touch-active');
    }, { passive: true });
  });
});

const COMING_SOON_INFO = {
  'nightsuits': {
    title: '🌙 Organic Cotton Nightsuits — Launching Soon ⏳',
    desc: 'Our cloud-soft 100% organic cotton sleepwear sets with whimsical prints are currently in final production. Join our VIP waitlist to claim 15% OFF + early access at launch!',
    img: "{{ 'placeholder_nightsuit_1.jpg' | asset_url }}"
  },
  'boys': {
    title: '👦 Boys Line Collection — Launching Soon ⏳',
    desc: 'We are crafting handsome ethnic kurta sets and comfy pyjamas for your little princes. Enter your email to receive launch notifications & 15% OFF!',
    img: "{{ 'placeholder_boys_teaser.jpg' | asset_url }}"
  },
  'dresses': {
    title: '👗 Western & Tulle Partywear — Launching Soon ⏳',
    desc: 'New twirl-ready tulle net dresses and casual partywear silhouettes drop next month. Subscribe now for first access & 15% discount!',
    img: "{{ 'placeholder_ethnic_1.jpg' | asset_url }}"
  }
};

function applyCatalogFiltersAndSort() {
  const ageFilterEl = document.getElementById('MeeekuAgeFilter');
  const sortOptionEl = document.getElementById('MeeekuPriceSort');
  const ageFilter = ageFilterEl ? ageFilterEl.value : 'all';
  const sortOption = sortOptionEl ? sortOptionEl.value : 'featured';

  const grid = document.getElementById('MeeekuProductGrid');
  const items = Array.from(document.querySelectorAll('.meeeku-grid-item'));
  const banner = document.getElementById('MeeekuComingSoonBanner');
  const bannerTitle = document.getElementById('MeeekuComingSoonTitle');
  const bannerDesc = document.getElementById('MeeekuComingSoonDesc');
  const bannerImg = document.getElementById('MeeekuComingSoonImg');

  if (COMING_SOON_INFO[currentCategory]) {
    const info = COMING_SOON_INFO[currentCategory];
    if (bannerTitle) bannerTitle.innerText = info.title;
    if (bannerDesc) bannerDesc.innerText = info.desc;
    if (bannerImg && info.img) bannerImg.src = info.img;
    if (banner) banner.style.display = 'block';
  } else {
    if (banner) banner.style.display = 'none';
  }

  items.forEach(item => {
    const itemCat = item.getAttribute('data-category') || '';
    const itemAge = item.getAttribute('data-age') || '';

    const catMatch = (currentCategory === 'all' || itemCat.includes(currentCategory));
    const ageMatch = (ageFilter === 'all' || itemAge.includes(ageFilter));

    if (catMatch && ageMatch && !COMING_SOON_INFO[currentCategory]) {
      item.style.display = 'block';
      item.style.opacity = '1';
    } else {
      item.style.display = 'none';
      item.style.opacity = '0';
    }
  });

  items.sort((a, b) => {
    const rankA = parseInt(a.getAttribute('data-bestseller-rank')) || 99;
    const rankB = parseInt(b.getAttribute('data-bestseller-rank')) || 99;
    const priceA = parseFloat(a.getAttribute('data-price')) || 0;
    const priceB = parseFloat(b.getAttribute('data-price')) || 0;
    const dateA = new Date(a.getAttribute('data-date')).getTime() || 0;
    const dateB = new Date(b.getAttribute('data-date')).getTime() || 0;

    if (sortOption === 'featured') {
      return rankA - rankB;
    } else if (sortOption === 'price-low') {
      return priceA - priceB;
    } else if (sortOption === 'price-high') {
      return priceB - priceA;
    } else if (sortOption === 'newest') {
      return dateB - dateA;
    }
    return rankA - rankB;
  });

  if (grid) {
    items.forEach(item => grid.appendChild(item));
  }
}

function handleMeeekuWaitlistSubmit(e) {
  e.preventDefault();
  const input = e.target.querySelector('input[type="email"]');
  if (input && input.value) {
    showMeeekuToastCatalog('🎉 You are on the VIP Waitlist! 15% OFF code saved for launch.');
    input.value = '';
  }
}

function meeekuAddToCartCatalog(title, price, imgUrl, variantId) {
  let cart = [];
  try {
    cart = JSON.parse(localStorage.getItem('meeeku_active_cart') || localStorage.getItem('meeeku_user_cart') || localStorage.getItem('meeeku_cart') || '[]');
  } catch (e) { cart = []; }

  const itemKey = (variantId || title) + '_Standard';
  const existing = cart.find(i => i.title === title);
  if (existing) {
    let q = existing.qty || existing.quantity || 1;
    existing.qty = q + 1;
    existing.quantity = q + 1;
  } else {
    cart.push({
      key: itemKey,
      id: variantId || ('item_' + Date.now()),
      title: title,
      price: price,
      img: imgUrl,
      size: '2 - 3Y',
      qty: 1,
      quantity: 1
    });
  }

  localStorage.setItem('meeeku_active_cart', JSON.stringify(cart));
  localStorage.setItem('meeeku_user_cart', JSON.stringify(cart));
  localStorage.setItem('meeeku_cart', JSON.stringify(cart));

  if (variantId && !isNaN(parseInt(variantId))) {
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: parseInt(variantId), quantity: 1 }] })
    }).catch(() => {});
  }

  const dot = document.getElementById('MeeekuCartDot');
  if (dot) dot.classList.add('has-items');

  const totalCount = cart.reduce((sum, i) => sum + (i.quantity || i.qty || 1), 0);
  const countBubbles = document.querySelectorAll('.cart-count-bubble span');
  countBubbles.forEach(b => b.textContent = totalCount);

  showMeeekuToastCatalog(`🎉 ${title} added to your Cart!`);
}

function showMeeekuToastCatalog(msg) {
  const toast = document.getElementById('MeeekuCartToastCatalog') || document.getElementById('MeeekuCartToast');
  if (toast) {
    toast.innerText = msg;
    toast.classList.add('show');
    setTimeout(function() {
      toast.classList.remove('show');
    }, 2800);
  }
}

// ─── Live Shopify fallback: fires when Liquid collection is empty ─────────────
(function() {
  var placeholder = document.getElementById('MeeekuCatalogFetchPlaceholder');
  if (!placeholder) return; // Liquid loop already rendered products — done

  var grid = document.getElementById('MeeekuProductGrid');
  if (!grid) return;

  fetch('/collections/all/products.json?limit=250&fields=handle,title,type,tags,images,variants,published_at,compare_at_price')
    .then(function(res) { return res.ok ? res.json() : Promise.reject(); })
    .then(function(data) {
      var products = (data.products || []);
      if (!products.length) return;

      placeholder.remove();

      products.forEach(function(prod, idx) {
        var title = prod.title || '';
        var handle = prod.handle || '';
        var url = '/products/' + handle;
        var type = (prod.type || '').toLowerCase();
        var tags = (prod.tags || []).join(',').toLowerCase();
        var titleLower = title.toLowerCase();

        // Category mapping
        var cat = 'all ';
        if (titleLower.indexOf('lehenga') !== -1 || handle.indexOf('lehenga') !== -1 || type.indexOf('lehenga') !== -1 || type.indexOf('ethnic') !== -1 || tags.indexOf('lehenga') !== -1 || tags.indexOf('ethnic') !== -1) {
          cat += 'ethnic';
        } else if (titleLower.indexOf('tee') !== -1 || handle.indexOf('tee') !== -1 || type.indexOf('tee') !== -1 || tags.indexOf('tee') !== -1) {
          cat += 'tees';
        } else if (titleLower.indexOf('dress') !== -1 || handle.indexOf('dress') !== -1 || type.indexOf('dress') !== -1 || tags.indexOf('dress') !== -1) {
          cat += 'dresses';
        } else if (titleLower.indexOf('night') !== -1 || titleLower.indexOf('sleep') !== -1 || type.indexOf('night') !== -1 || tags.indexOf('night') !== -1) {
          cat += 'nightsuits';
        } else if (titleLower.indexOf('boy') !== -1 || type.indexOf('boy') !== -1 || tags.indexOf('boy') !== -1) {
          cat += 'boys';
        } else if (titleLower.indexOf('co-ord') !== -1 || titleLower.indexOf('coord') !== -1 || handle.indexOf('coord') !== -1 || type.indexOf('coord') !== -1 || tags.indexOf('coord') !== -1) {
          cat += 'coords';
        } else {
          cat += 'ethnic';
        }

        // Age mapping from tags + variants
        var allVariantTitles = (prod.variants || []).map(function(v){ return (v.title||'').toLowerCase(); }).join(' ');
        var ageSearch = tags + ' ' + allVariantTitles;
        var ageKeys = 'all';
        if (ageSearch.indexOf('0-6m') !== -1 || ageSearch.indexOf('0 - 6m') !== -1 || ageSearch.indexOf('infant') !== -1) ageKeys += ',0-6m';
        if (ageSearch.indexOf('6-12m') !== -1 || ageSearch.indexOf('6 - 12m') !== -1) ageKeys += ',6-12m';
        if (ageSearch.indexOf('1-2y') !== -1 || ageSearch.indexOf('12-18m') !== -1 || ageSearch.indexOf('18-24m') !== -1) ageKeys += ',1-2y';
        if (ageSearch.indexOf('2-3y') !== -1 || ageSearch.indexOf('2 - 3y') !== -1) ageKeys += ',2-3y';
        if (ageSearch.indexOf('3-') !== -1 || ageSearch.indexOf('4-') !== -1 || ageSearch.indexOf('5-') !== -1 || ageSearch.indexOf('6-7') !== -1) ageKeys += ',3-7y';

        // Images — use Shopify CDN URLs directly
        var imgs = prod.images || [];
        var img1 = imgs[0] ? imgs[0].src : '';
        var img2 = imgs[1] ? imgs[1].src : img1;

        // Price
        var firstVar = (prod.variants || [])[0] || {};
        var price = firstVar.price ? '₹' + (parseFloat(firstVar.price)).toLocaleString('en-IN', {minimumFractionDigits: 2}) : '';
        var comparePrice = firstVar.compare_at_price ? parseFloat(firstVar.compare_at_price) : 0;
        var currPrice = firstVar.price ? parseFloat(firstVar.price) : 0;
        var discountPct = (comparePrice > currPrice) ? Math.round((comparePrice - currPrice) / comparePrice * 100) : 0;
        var priceNum = currPrice;
        var publishedAt = prod.published_at ? prod.published_at.substring(0, 10) : '2026-01-01';

        var li = document.createElement('li');
        li.className = 'grid__item meeeku-grid-item';
        li.setAttribute('data-category', cat.trim());
        li.setAttribute('data-price', priceNum);
        li.setAttribute('data-age', ageKeys);
        li.setAttribute('data-date', publishedAt);
        li.setAttribute('data-bestseller-rank', idx + 1);

        var discountHtml = discountPct > 0
          ? '<span class="meeeku-badge" style="background:#E8F5E9;color:#2E7D32;font-size:1rem;margin-left:0.4rem;padding:0.15rem 0.6rem;">' + discountPct + '% OFF</span>'
          : '';

        li.innerHTML = [
          '<div class="card-wrapper meeeku-interactive-card">',
            '<div class="meeeku-card-media-wrapper">',
              '<a href="' + url + '" class="meeeku-card-link">',
                img1 ? '<img src="' + img1 + '" alt="' + title + '" class="meeeku-card-img meeeku-img-primary" width="600" height="750" loading="lazy">' : '',
                (img2 && img2 !== img1) ? '<img src="' + img2 + '" alt="' + title + '" class="meeeku-card-img meeeku-img-secondary" width="600" height="750" loading="lazy">' : '',
              '</a>',
              '<button type="button" class="meeeku-card-hover-quick-add" onclick="meeekuAddToCartCatalog(\'' + title.replace(/'/g,"\'") + '\',\'' + price + '\',\'' + img1 + '\',\'' + (firstVar.id||'') + '\')">',
                '🛒 + Quick Add — ' + price,
              '</button>',
            '</div>',
            '<div class="card__content" style="padding:1.2rem 0.5rem 0;">',
              '<h3 style="margin:0.4rem 0 0.3rem;font-size:1.7rem;font-weight:700;">',
                '<a href="' + url + '" style="color:#3D2355;text-decoration:none;">' + title + '</a>',
              '</h3>',
              '<div style="font-size:1.7rem;font-weight:800;color:#6B3FA0;">' + price + discountHtml + '</div>',
            '</div>',
          '</div>',
        ].join('');

        grid.appendChild(li);
      });

      applyCatalogFiltersAndSort();
    })
    .catch(function() {
      // API unavailable — show a helpful fallback message
      if (placeholder) {
        placeholder.style.display = 'block';
        placeholder.innerHTML = '<div style="text-align:center;padding:3rem;color:#888;font-size:1.4rem;">Products loading... <a href="/collections/all" style="color:#6B3FA0;font-weight:700;">Browse all products</a></div>';
      }
    });
})();
</script>

<style>
.meeeku-card-media-wrapper {
  position: relative;
  width: 100%;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(107, 63, 160, 0.08);
  border: 2px solid #F8BBD0;
  background: #FFFDF7;
}

.meeeku-card-link {
  display: block;
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 5;
  overflow: hidden;
}

.meeeku-card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  transition: opacity 0.45s ease-in-out, transform 0.45s ease-in-out;
}

.meeeku-img-primary {
  position: relative;
  z-index: 1;
  opacity: 1;
}

.meeeku-img-secondary {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  opacity: 0;
}

.meeeku-card-link:hover .meeeku-img-secondary,
.meeeku-card-link.is-touch-active .meeeku-img-secondary {
  opacity: 1;
  transform: scale(1.05);
}

.meeeku-card-link:hover .meeeku-img-primary,
.meeeku-card-link.is-touch-active .meeeku-img-primary {
  opacity: 0;
}

.meeeku-catalog-pills {
  display: flex;
  gap: 0.8rem;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 2rem;
}

.meeeku-pill-filter {
  border: 2px solid #F8BBD0;
  border-radius: 30px;
  padding: 0.8rem 1.6rem;
  font-size: 1.35rem;
  font-weight: 700;
  color: #3D2355;
  background: #FFFDF7;
  cursor: pointer;
  transition: all 0.25s ease;
  min-height: 44px;
}

.meeeku-pill-filter:hover,
.meeeku-pill-filter.active {
  background: #FF6097;
  color: #FFF;
  border-color: #FF6097;
}

.meeeku-filter-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1.5rem;
  background: #FFFDF7;
  border: 1.5px solid #F8BBD0;
  border-radius: 20px;
  padding: 1.2rem 2rem;
  margin-bottom: 3rem;
  box-shadow: 0 4px 16px rgba(107, 63, 160, 0.05);
}

.meeeku-select-wrapper {
  position: relative;
  display: inline-flex;
  align-items: center;
}

.meeeku-filter-select {
  appearance: none;
  -webkit-appearance: none;
  border: 1.5px solid #F8BBD0;
  border-radius: 25px;
  padding: 0.7rem 2.8rem 0.7rem 1.4rem;
  font-size: 1.35rem;
  color: #3D2355;
  background: #FFFFFF;
  outline: none;
  cursor: pointer;
  font-weight: 700;
  transition: all 0.2s ease;
  box-shadow: 0 2px 8px rgba(107, 63, 160, 0.04);
}

.meeeku-filter-select:focus,
.meeeku-filter-select:hover {
  border-color: #6B3FA0;
}

.meeeku-select-arrow {
  position: absolute;
  right: 1.2rem;
  pointer-events: none;
  color: #6B3FA0;
  font-size: 1.2rem;
  font-weight: 800;
}

@media screen and (max-width: 749px) {
  .meeeku-catalog-pills {
    justify-content: flex-start !important;
    flex-wrap: nowrap !important;
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch !important;
    scrollbar-width: none !important;
    padding: 0.3rem 0.5rem 0.6rem !important;
    margin-bottom: 1.5rem !important;
  }
  .meeeku-catalog-pills::-webkit-scrollbar {
    display: none !important;
  }
  .meeeku-pill-filter {
    flex-shrink: 0 !important;
    white-space: nowrap !important;
    font-size: 1.25rem !important;
    padding: 0.6rem 1.2rem !important;
  }
  .meeeku-filter-toolbar {
    background: #FFFDF7 !important;
    border: 1.5px solid #F8BBD0 !important;
    border-radius: 16px !important;
    padding: 1rem !important;
    margin-bottom: 2rem !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0.8rem !important;
  }
  .meeeku-filter-toolbar > div {
    width: 100% !important;
    justify-content: space-between !important;
  }
  .meeeku-select-wrapper {
    flex: 1 !important;
    max-width: 220px !important;
  }
  .meeeku-filter-select {
    width: 100% !important;
    font-size: 1.2rem !important;
    padding: 0.6rem 2.2rem 0.6rem 1rem !important;
  }
  .meeeku-card-hover-quick-add {
    position: absolute !important;
    bottom: 10px !important;
    top: auto !important;
    left: 50% !important;
    right: auto !important;
    transform: translateX(-50%) !important;
    width: 88% !important;
    max-width: 260px !important;
    height: auto !important;
    border-radius: 30px !important;
    background: rgba(255, 253, 247, 0.94) !important;
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
    color: #3D2355 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0.6rem 1rem !important;
    box-shadow: 0 4px 14px rgba(107, 63, 160, 0.16) !important;
    border: 1.5px solid #F8BBD0 !important;
    opacity: 1 !important;
    z-index: 5 !important;
    font-size: 1.2rem !important;
    font-weight: 700 !important;
  }
}
</style>

{% schema %}
{
  "name": "Meeeku Catalog Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "options": [
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "3",
      "label": "Desktop columns"
    }
  ],
  "presets": [
    {
      "name": "Meeeku Catalog Grid"
    }
  ]
}
{% endschema %}
