  font-weight: 800;
}

@media screen and (max-width: 749px) {
  .meeeku-catalog-pills {
    justify-content: flex-start !important;
    flex-wrap: nowrap !important;
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch !important;
    scrollbar-width: none !important;
    padding: 0.3rem 0.5rem 0.6rem !important;
    margin-bottom: 1.5rem !important;
  }
  .meeeku-catalog-pills::-webkit-scrollbar {
    display: none !important;
  }
  .meeeku-pill-filter {
    flex-shrink: 0 !important;
    white-space: nowrap !important;
    font-size: 1.25rem !important;
    padding: 0.6rem 1.2rem !important;
  }
  .meeeku-filter-toolbar {
    background: #FFFDF7 !important;
    border: 1.5px solid #F8BBD0 !important;
    border-radius: 16px !important;
    padding: 1rem !important;
    margin-bottom: 2rem !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0.8rem !important;
  }
  .meeeku-filter-toolbar > div {
    width: 100% !important;
    justify-content: space-between !important;
  }
  .meeeku-select-wrapper {
    flex: 1 !important;
    max-width: 220px !important;
  }
  .meeeku-filter-select {
    width: 100% !important;
    font-size: 1.2rem !important;
    padding: 0.6rem 2.2rem 0.6rem 1rem !important;
  }
  .meeeku-card-hover-quick-add {
    position: absolute !important;
    bottom: 10px !important;
    top: auto !important;
    left: 50% !important;
    right: auto !important;
    transform: translateX(-50%) !important;
    width: 88% !important;
    max-width: 260px !important;
    height: auto !important;
    border-radius: 30px !important;
    background: rgba(255, 253, 247, 0.94) !important;
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
    color: #3D2355 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0.6rem 1rem !important;
    box-shadow: 0 4px 14px rgba(107, 63, 160, 0.16) !important;
    border: 1.5px solid #F8BBD0 !important;
    opacity: 1 !important;
    z-index: 5 !important;
    font-size: 1.2rem !important;
