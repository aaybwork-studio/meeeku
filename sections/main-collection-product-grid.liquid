{% comment %}
  Meeeku Clean Minimalist Catalog Product Grid (Hover Quick Add)
{% endcomment %}

<div class="page-width meeeku-catalog-section" style="padding-top: 2rem; padding-bottom: 5rem;">
  
  <!-- Category Filter Pills Bar (No bulky header block!) -->
  <div class="meeeku-catalog-pills" style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3rem;">
    <a href="/collections/all" class="button button--primary meeeku-pill-filter active" style="border-radius: 30px; font-size: 1.4rem; padding: 0.8rem 1.8rem;">All Products</a>
    <a href="/collections/all" class="button button--secondary meeeku-pill-filter" style="border-radius: 30px; font-size: 1.4rem; padding: 0.8rem 1.8rem;">Royal Ethnic 👑</a>
    <a href="/collections/all" class="button button--secondary meeeku-pill-filter" style="border-radius: 30px; font-size: 1.4rem; padding: 0.8rem 1.8rem;">Organic Nightsuits 🌙</a>
    <a href="#meeeku-boys-waitlist" class="button button--secondary meeeku-pill-filter" style="border-radius: 30px; font-size: 1.4rem; padding: 0.8rem 1.8rem; background-color: #FFF8E1; color: #F57F17; border-color: #FFE082;">Boys Line (2-5Y) 👦</a>
  </div>

  <!-- Clean Minimalist Product Grid -->
  <div class="meeeku-catalog-grid">
    <ul class="grid product-grid grid--2-col-tablet-down grid--3-col-desktop">
      
      <!-- Product 1: Royal Pink Lehenga -->
      <li class="grid__item">
        <div class="card-wrapper">
          <div class="meeeku-card-media-wrapper">
            <a href="/products/royal-pink-lehenga">
              <img src="{{ 'placeholder_ethnic_1.jpg' | asset_url }}" alt="Royal Pink Lehenga Choli" class="meeeku-card-img" width="600" height="750" loading="lazy">
            </a>
            <!-- Quick Add button visible ONLY on HOVER -->
            <button type="button" class="meeeku-card-hover-quick-add" onclick="document.querySelector('cart-drawer').open()">
              🛒 + Quick Add
            </button>
          </div>
          <div class="card__content" style="padding: 1.2rem 0.5rem 0;">
            <h3 style="margin: 0 0 0.3rem; font-size: 1.7rem; font-weight: 700;">
              <a href="/products/royal-pink-lehenga" style="color: #3D2355; text-decoration: none;">Royal Pink & Gold Lehenga Set</a>
            </h3>
            <div style="font-size: 1.7rem; font-weight: 800; color: #6B3FA0;">₹2,499.00 <span style="font-size: 1.3rem; color: #888; text-decoration: line-through; margin-left: 0.5rem;">₹3,499.00</span></div>
          </div>
        </div>
      </li>

      <!-- Product 2: Cozy Lavender Nightsuit -->
      <li class="grid__item">
        <div class="card-wrapper">
          <div class="meeeku-card-media-wrapper">
            <a href="/products/cozy-lavender-nightsuit">
              <img src="{{ 'placeholder_nightsuit_1.jpg' | asset_url }}" alt="Lavender Organic Cotton Nightsuit" class="meeeku-card-img" width="600" height="750" loading="lazy">
            </a>
            <!-- Quick Add button visible ONLY on HOVER -->
            <button type="button" class="meeeku-card-hover-quick-add" onclick="document.querySelector('cart-drawer').open()">
              🛒 + Quick Add
            </button>
          </div>
          <div class="card__content" style="padding: 1.2rem 0.5rem 0;">
            <h3 style="margin: 0 0 0.3rem; font-size: 1.7rem; font-weight: 700;">
              <a href="/products/cozy-lavender-nightsuit" style="color: #3D2355; text-decoration: none;">Cozy Lavender Organic Nightsuit</a>
            </h3>
            <div style="font-size: 1.7rem; font-weight: 800; color: #6B3FA0;">₹1,299.00 <span style="font-size: 1.3rem; color: #888; text-decoration: line-through; margin-left: 0.5rem;">₹1,799.00</span></div>
          </div>
        </div>
      </li>

      <!-- Product 3: Pastel Blue Kurta Set -->
      <li class="grid__item">
        <div class="card-wrapper">
          <div class="meeeku-card-media-wrapper">
            <a href="/products/pastel-blue-kurta-set">
              <img src="{{ 'placeholder_boys_teaser.jpg' | asset_url }}" alt="Pastel Blue Ethnic Kurta Pyjama Set" class="meeeku-card-img" width="600" height="750" loading="lazy">
            </a>
            <!-- Quick Add button visible ONLY on HOVER -->
            <button type="button" class="meeeku-card-hover-quick-add" onclick="document.querySelector('cart-drawer').open()">
              🛒 + Quick Add
            </button>
          </div>
          <div class="card__content" style="padding: 1.2rem 0.5rem 0;">
            <h3 style="margin: 0 0 0.3rem; font-size: 1.7rem; font-weight: 700;">
              <a href="/products/pastel-blue-kurta-set" style="color: #3D2355; text-decoration: none;">Pastel Blue Ethnic Kurta Set</a>
            </h3>
            <div style="font-size: 1.7rem; font-weight: 800; color: #6B3FA0;">₹1,899.00 <span style="font-size: 1.3rem; color: #888; text-decoration: line-through; margin-left: 0.5rem;">₹2,499.00</span></div>
          </div>
        </div>
      </li>

    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Meeeku Collection Grid",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Meeeku Collection Grid"
    }
  ]
}
{% endschema %}
