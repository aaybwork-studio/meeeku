            </div>
            <h3 style="margin: 0.4rem 0 0.3rem; font-size: 1.7rem; font-weight: 700;">
              <a href="/products/vanilla-cream-eyelet-coord" style="color: #3D2355; text-decoration: none;">Vanilla Cream Eyelet Co-ord Set</a>
            </h3>
            <div style="font-size: 1.7rem; font-weight: 800; color: #6B3FA0;">
              ₹1,299.00 <span style="font-size: 1.3rem; color: #888; text-decoration: line-through; margin-left: 0.5rem;">₹1,699.00</span>
              <span class="meeeku-badge" style="background: #E8F5E9; color: #2E7D32; font-size: 1rem; margin-left: 0.4rem; padding: 0.15rem 0.6rem;">24% OFF</span>
            </div>
          </div>
        </div>
      </li>

      <!-- Ethnic 1: Sunshine Chanderi Lehenga -->
      <li class="grid__item meeeku-grid-item" data-category="all ethnic" data-price="3199" data-age="all,1-2y,2-3y,3-7y" data-date="2026-08-17" data-bestseller-rank="1">
