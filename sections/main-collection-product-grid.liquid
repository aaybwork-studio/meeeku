            </button>
          </div>
          <div class="card__content" style="padding: 1.2rem 0.5rem 0;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem;">
              <span class="meeeku-badge" style="background: #FCE4EC; color: #C2185B; font-size: 1rem; padding: 0.2rem 0.8rem;">Everyday Cotton</span>
              <span style="font-size: 1.1rem; color: #666; font-weight: 600;">0-6M to 2-3Y</span>
            </div>
            <h3 style="margin: 0.4rem 0 0.3rem; font-size: 1.7rem; font-weight: 700;">
              <a href="/products/snuggle-bunny-blush-tee" style="color: #3D2355; text-decoration: none;">Snuggle Bunny Blush Cotton Tee</a>
            </h3>
            <div style="font-size: 1.7rem; font-weight: 800; color: #6B3FA0;">
              ₹599.00 <span style="font-size: 1.3rem; color: #888; text-decoration: line-through; margin-left: 0.5rem;">₹899.00</span>
              <span class="meeeku-badge" style="background: #E8F5E9; color: #2E7D32; font-size: 1rem; margin-left: 0.4rem; padding: 0.15rem 0.6rem;">33% OFF</span>
            </div>
          </div>
        </div>
      </li>

      <!-- Co-ord 1: Vanilla Cream Ruffled Eyelet Co-ord Set -->
      <li class="grid__item meeeku-grid-item" data-category="all coords" data-price="1299" data-age="all,0-6m,6-12m,1-2y,2-3y" data-date="2026-08-17" data-bestseller-rank="2">
        <div class="card-wrapper meeeku-interactive-card">
