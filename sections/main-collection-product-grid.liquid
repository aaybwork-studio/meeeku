              🛒 + Quick Add — ₹599
            </button>
          </div>
          <div class="card__content" style="padding: 1.2rem 0.5rem 0;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem;">
              <span class="meeeku-badge" style="background: #E8EAF6; color: #3F51B5; font-size: 1rem; padding: 0.2rem 0.8rem;">Ruffle Frill Collar</span>
              <span style="font-size: 1.1rem; color: #666; font-weight: 600;">0-6M to 2-3Y</span>
            </div>
            <h3 style="margin: 0.4rem 0 0.3rem; font-size: 1.7rem; font-weight: 700;">
              <a href="/products/daisy-frill-blue-tee" style="color: #3D2355; text-decoration: none;">Periwinkle Daisy Frill Tee</a>
            </h3>
            <div style="font-size: 1.7rem; font-weight: 800; color: #6B3FA0;">
              ₹599.00 <span style="font-size: 1.3rem; color: #888; text-decoration: line-through; margin-left: 0.5rem;">₹899.00</span>
              <span class="meeeku-badge" style="background: #E8F5E9; color: #2E7D32; font-size: 1rem; margin-left: 0.4rem; padding: 0.15rem 0.6rem;">33% OFF</span>
            </div>
          </div>
        </div>
      </li>

      <!-- T-Shirt 2: Snuggle Bunny Blush Cotton Tee -->
      <li class="grid__item meeeku-grid-item" data-category="all tees" data-price="599" data-age="all,0-6m,6-12m,1-2y,2-3y" data-date="2026-08-17" data-bestseller-rank="6">
        <div class="card-wrapper meeeku-interactive-card">
          <div class="meeeku-card-media-wrapper">
            <a href="/products/snuggle-bunny-blush-tee" class="meeeku-card-link">
              <img src="{{ 'meeeku_prod_bunny_tee.jpg' | asset_url }}" alt="Snuggle Bunny Blush Cotton Tee" class="meeeku-card-img meeeku-img-primary" width="600" height="750" loading="lazy">
