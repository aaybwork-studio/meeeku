{% comment %}
  Meeeku 2-Piece Organic Cotton Co-ord Sets Lineup Section (Shopify OS 2.0 Dynamic CMS Connected)
  Features 100% Breathable Combed Cotton 2-Piece Lounge & Festive Co-ord Sets (0-6M to 2-3Y) with dynamic product cards.
{% endcomment %}

{% liquid
  assign target_collection = section.settings.collection
  if target_collection == blank and collections['co-ord-sets'] != blank
    assign target_collection = collections['co-ord-sets']
  elsif target_collection == blank and collections['coords'] != blank
    assign target_collection = collections['coords']
  endif

  assign limit = section.settings.products_to_show | default: 6
%}

<div class="page-width meeeku-coords-section" id="MeeekuCoords-{{ section.id }}" style="padding-top: 4.5rem; padding-bottom: 5.5rem;">
  
  <!-- Section Header -->
  <div class="text-center" style="margin-bottom: 3.5rem; text-align: center;">
    {% if section.settings.badge != blank %}
      <span class="meeeku-badge" style="background: #E0F2F1; color: #00695C; font-size: 1.25rem; padding: 0.4rem 1.4rem; font-weight: 700; border-radius: 20px; display: inline-block;">
        {{ section.settings.badge }}
      </span>
    {% endif %}
    <h2 class="h1" style="color: #3D2355; margin-top: 1rem; font-size: 3.6rem; font-weight: 800; letter-spacing: -0.02em;">
      {{ section.settings.title | default: 'Cloud-Soft 2-Piece Co-ord Sets' }}
    </h2>
    <p style="color: #6B3FA0; font-size: 1.65rem; max-width: 720px; margin: 0.6rem auto 0; line-height: 1.5;">
      {{ section.settings.subtitle | default: 'Perfectly paired matching sets crafted from ultra-soft, 100% breathable organic cotton. Featuring ruffled Peter Pan collars, storybook prints, and zero-pinch elasticated waistbands for seamless all-day play.' }}
    </p>
    <div style="margin-top: 1.2rem; display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
      <span class="meeeku-badge" style="background: #EDE7F6; color: #512DA8; font-size: 1.2rem; padding: 0.35rem 1rem;">✨ 100% Breathable Cotton</span>
      <span class="meeeku-badge" style="background: #FFF3E0; color: #E65100; font-size: 1.2rem; padding: 0.35rem 1rem;">☁️ 2-Piece Top & Pants Sets</span>
      <span class="meeeku-badge" style="background: #E0F7FA; color: #00838F; font-size: 1.2rem; padding: 0.35rem 1rem;">👶 Sizes 0-6M to 2-3Y</span>
    </div>
  </div>

  <!-- Co-ords Product Grid -->
  <div class="meeeku-coords-grid">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% if block.settings.product != blank %}
          {% render 'meeeku-featured-card', product: block.settings.product, custom_badge: block.settings.custom_badge %}
        {% endif %}
      {% endfor %}
    {% elsif target_collection != blank and target_collection.products.size > 0 %}
      {% for prod in target_collection.products limit: limit %}
        {% render 'meeeku-featured-card', product: prod %}
      {% endfor %}
    {% else %}
      {% assign count = 0 %}
      {% for prod in collections.all.products %}
        {% assign p_type = prod.type | downcase %}
        {% assign p_tags = prod.tags | join: ',' | downcase %}
        {% if p_type contains 'coord' or p_type contains 'set' or p_tags contains 'coord' %}
          {% render 'meeeku-featured-card', product: prod %}
          {% assign count = count | plus: 1 %}
          {% if count >= limit %}{% break %}{% endif %}
        {% endif %}
      {% endfor %}
      {% if count == 0 %}
        <!-- Curated Fallbacks -->
        {% render 'meeeku-featured-card-fallback' %}
      {% endif %}
    {% endif %}
  </div>

  <!-- View All Co-ords CTA -->
  <div style="text-align: center; margin-top: 3.5rem;">
    <a href="{{ section.settings.view_all_link | default: '/collections/all?category=coords' }}" class="button button--primary meeeku-btn-pill" style="font-size: 1.5rem; padding: 1.2rem 3rem; background: #00695C; border-color: #00695C;">
      {{ section.settings.view_all_label | default: '🌸 Explore All 2-Piece Co-ord Sets →' }}
    </a>
  </div>

</div>

<style>
.meeeku-coords-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.2rem;
}

@media screen and (max-width: 890px) {
  .meeeku-coords-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem;
  }
}

@media screen and (max-width: 480px) {
  .meeeku-coords-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
}
</style>

{% schema %}
{
  "name": "Meeeku Co-ord Sets",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "🌸 NEW DROP • 2-PIECE ORGANIC CO-ORDS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Cloud-Soft 2-Piece Co-ord Sets"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Perfectly paired matching sets crafted from ultra-soft, 100% breathable organic cotton. Featuring ruffled Peter Pan collars, storybook prints, and zero-pinch elasticated waistbands for seamless all-day play."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Co-ords Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Products to show"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button Label",
      "default": "🌸 Explore All 2-Piece Co-ord Sets →"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Curated Co-ord",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "custom_badge",
          "label": "Custom Badge"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Meeeku Co-ord Sets"
    }
  ]
}
{% endschema %}
