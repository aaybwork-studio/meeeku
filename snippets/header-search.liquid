{% comment %}
  Meeeku Clean Slide-Down Floating Search Overlay
{% endcomment %}

<div class="meeeku-search-wrapper">
  <!-- Search Trigger Button -->
  <button type="button" class="header__icon header__icon--search link focus-inset" onclick="openMeeekuSearch()" aria-label="Search" style="background: transparent; border: none; cursor: pointer;">
    <span class="svg-wrapper">
      {{- 'icon-search.svg' | inline_asset_content -}}
    </span>
  </button>

  <!-- Full-Width Floating Search Overlay -->
  <div id="MeeekuSearchOverlay" class="meeeku-search-overlay">
    <div class="meeeku-search-container">
      <form action="{{ routes.search_url }}" method="get" role="search" class="meeeku-search-form">
        <div class="meeeku-search-input-box">
          <span class="meeeku-search-icon">🔍</span>
          <input
            type="search"
            name="q"
            id="MeeekuSearchInput"
            value="{{ search.terms | escape }}"
            placeholder="Search Royal Ethnic Lehengas, Organic Nightsuits, Kurta Sets..."
            class="meeeku-search-field"
            autocomplete="off"
          >
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" class="meeeku-search-submit-btn">Search</button>
        </div>
      </form>
      <button type="button" class="meeeku-search-close-btn" onclick="closeMeeekuSearch()" aria-label="Close search">✕</button>
    </div>
  </div>
</div>

<style>
.meeeku-search-wrapper {
  display: inline-block;
}

.meeeku-search-overlay {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 85px !important;
  background: rgba(255, 253, 247, 0.98) !important;
  backdrop-filter: blur(14px) !important;
  z-index: 10000 !important;
  border-bottom: 2px solid #F8BBD0 !important;
  box-shadow: 0 10px 30px rgba(107, 63, 160, 0.12) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  transform: translateY(-100%) !important;
  opacity: 0 !important;
  visibility: hidden !important;
  transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.35s ease, visibility 0.35s ease !important;
}

.meeeku-search-overlay.active {
  transform: translateY(0) !important;
  opacity: 1 !important;
  visibility: visible !important;
}

.meeeku-search-container {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.5rem;
  width: 100%;
  max-width: 820px;
  padding: 0 1.5rem;
}

.meeeku-search-form {
  flex-grow: 1;
}

.meeeku-search-input-box {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 2px solid #F8BBD0;
  border-radius: 30px;
  padding: 0.3rem 0.4rem 0.3rem 1.4rem;
  box-shadow: 0 4px 14px rgba(107, 63, 160, 0.05);
}

.meeeku-search-icon {
  font-size: 1.6rem;
  margin-right: 0.8rem;
  color: #6B3FA0;
}

.meeeku-search-field {
  border: none !important;
  outline: none !important;
  background: transparent !important;
  font-size: 1.5rem !important;
  color: #3D2355 !important;
  flex-grow: 1 !important;
  width: 100% !important;
}

.meeeku-search-submit-btn {
  background: #6B3FA0 !important;
  color: #FFFFFF !important;
  border: none !important;
  border-radius: 25px !important;
  padding: 0.7rem 1.6rem !important;
  font-size: 1.4rem !important;
  font-weight: 700 !important;
  cursor: pointer !important;
  white-space: nowrap !important;
}

.meeeku-search-close-btn {
  background: transparent;
  border: none;
  font-size: 2.2rem;
  color: #3D2355;
  cursor: pointer;
  padding: 0.5rem;
  line-height: 1;
  transition: transform 0.2s ease;
}

.meeeku-search-close-btn:hover {
  transform: scale(1.15);
  color: #FF6097;
}
</style>

<script>
function openMeeekuSearch() {
  const overlay = document.getElementById('MeeekuSearchOverlay');
  const input = document.getElementById('MeeekuSearchInput');
  if (overlay) {
    overlay.classList.add('active');
    setTimeout(() => { if (input) input.focus(); }, 150);
  }
}

function closeMeeekuSearch() {
  const overlay = document.getElementById('MeeekuSearchOverlay');
  if (overlay) {
    overlay.classList.remove('active');
  }
}
</script>
