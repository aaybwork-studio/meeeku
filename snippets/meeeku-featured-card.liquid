{% comment %}
  Dynamic Meeeku Product Card Snippet
  Renders a real Shopify product with dual-image hover, dynamic tags, pricing, and 1-click Quick Add.
{% endcomment %}

{% liquid
  assign primary_img = product.featured_media.preview_image | default: product.featured_image | default: product.images.first
  assign secondary_img = product.images[1] | default: primary_img
  assign current_variant = product.selected_or_first_available_variant

  assign has_discount = false
  if product.compare_at_price > product.price
    assign has_discount = true
    assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
  endif

  assign p_tags = product.tags | join: ',' | downcase
  assign p_type = product.type | downcase
  assign p_title = product.title | downcase
  assign p_handle = product.handle | downcase

  assign is_ethnic = false
  assign is_tee = false
  assign is_coord = false
  assign is_dress = false

  if p_title contains 'lehenga' or p_handle contains 'lehenga' or p_type contains 'lehenga' or p_type contains 'ethnic' or p_tags contains 'lehenga' or p_tags contains 'royal ethnic' or p_tags contains 'indian ethnic'
    assign is_ethnic = true
  elsif p_title contains 'tee' or p_title contains 't-shirt' or p_handle contains 'tee' or p_type contains 'tee' or p_type contains 't-shirt' or p_tags contains 'basic tee'
    assign is_tee = true
  elsif p_title contains 'co-ord' or p_title contains 'coord' or p_handle contains 'coord' or p_type contains 'co-ord' or p_type contains 'coord' or p_tags contains 'co-ord' or p_tags contains 'coord' or p_type contains 'set'
    assign is_coord = true
  elsif p_title contains 'dress' or p_handle contains 'dress' or p_type contains 'dress'
    assign is_dress = true
  else
    assign is_ethnic = true
  endif

  if is_ethnic
    assign category_label = 'Royal Ethnic Lehenga'
    assign default_badge = 'Handcrafted Heritage'
    assign badge_bg = 'background: rgba(255, 240, 245, 0.95); color: #6B3FA0; border: 1px solid #F8BBD0;'
  elsif is_tee
    assign category_label = '100% Combed Cotton'
    assign default_badge = 'Zero-Itch Fabric'
    assign badge_bg = 'background: rgba(232, 245, 233, 0.95); color: #2E7D32; border: 1px solid #A5D6A7;'
  elsif is_coord
    assign category_label = '2-Piece Co-ord Set'
    assign default_badge = 'Pure Cotton Lounge'
    assign badge_bg = 'background: rgba(224, 242, 241, 0.95); color: #00695C; border: 1px solid #80CBC4;'
  elsif is_dress
    assign category_label = 'Indo-Western Dress'
    assign default_badge = 'Handcrafted'
    assign badge_bg = 'background: rgba(224, 247, 250, 0.95); color: #00838F; border: 1px solid #80DEEA;'
  endif

  assign badge_text = custom_badge
  if badge_text == blank
    if p_tags contains 'bestseller' or p_tags contains 'best seller'
      assign badge_text = 'Bestseller'
      assign badge_bg = 'background: rgba(255, 248, 225, 0.95); color: #B78103; border: 1px solid #FFE082;'
    elsif p_tags contains 'new' or p_tags contains 'new arrival'
      assign badge_text = 'New Arrival'
      assign badge_bg = 'background: rgba(243, 229, 245, 0.95); color: #6A1B9A; border: 1px solid #CE93D8;'
    else
      assign badge_text = default_badge
    endif
  endif

  assign sizes_label = ''
  if product.variants.size > 1
    assign first_size = product.variants.first.title
    assign last_size = product.variants.last.title
    assign sizes_label = 'Sizes: ' | append: first_size | append: ' to ' | append: last_size
  elsif product.variants.size == 1 and product.variants.first.title != 'Default Title'
    assign sizes_label = 'Size: ' | append: product.variants.first.title
  else
    if is_tee or is_coord
      assign sizes_label = 'Sizes: 0-6M to 2-3Y'
    else
      assign sizes_label = 'Sizes: 0-1Y to 6-7Y'
    endif
  endif
%}

<div class="card-wrapper meeeku-product-card" id="product-card-{{ product.id }}-{{ block_id }}" style="background: #FFFDF7; border: 1.5px solid #F8BBD0; border-radius: 22px; overflow: hidden; transition: all 0.3s ease; box-shadow: 0 4px 14px rgba(107,63,160,0.06); display: flex; flex-direction: column; text-align: center;">
  
  <div class="meeeku-card-media-wrapper" style="position: relative; overflow: hidden; aspect-ratio: 3/4; background: transparent; border: none; border-radius: 20px 20px 0 0; box-shadow: none;">
    <a href="{{ product.url }}" style="display: block; width: 100%; height: 100%;">
      {% if primary_img %}
        <img src="{{ primary_img | image_url: width: 600 }}" 
             alt="{{ primary_img.alt | default: product.title | escape }}" 
             class="meeeku-card-img-primary" 
             width="600" 
             height="800" 
             loading="lazy" 
             style="width: 100%; height: 100%; object-fit: cover;">
      {% endif %}
      {% if secondary_img and secondary_img != primary_img %}
        <img src="{{ secondary_img | image_url: width: 600 }}" 
             alt="{{ secondary_img.alt | default: product.title | escape }}" 
             class="meeeku-card-img-secondary" 
             width="600" 
             height="800" 
             loading="lazy" 
             style="width: 100%; height: 100%; object-fit: cover;">
      {% endif %}
    </a>

    {% if badge_text != blank %}
      <div style="position: absolute; top: 1rem; left: 1rem; z-index: 5;">
        <span style="{{ badge_bg }} font-size: 1.1rem; font-weight: 700; padding: 0.35rem 0.85rem; border-radius: 20px; box-shadow: 0 2px 8px rgba(107,63,160,0.08); display: inline-block; letter-spacing: 0.2px;">
          {{ badge_text }}
        </span>
      </div>
    {% endif %}

    <button type="button" 
            class="meeeku-card-hover-quick-add" 
            onclick="meeekuAddToCartCatalog('{{ product.title | escape }}', '{{ product.price | money }}', '{{ primary_img | image_url: width: 400 }}', '{{ current_variant.id }}')">
      + Quick Add • {{ product.price | money }}
    </button>
  </div>

  <div style="padding: 1.5rem 1.2rem; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; align-items: center; text-align: center;">
    <div style="width: 100%;">
      <span style="font-size: 1.15rem; font-weight: 700; color: #FF6097; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 0.3rem;">
        {{ category_label }}
      </span>
      <h3 style="margin: 0 0 0.5rem; font-size: 1.65rem; font-weight: 700; color: #3D2355; line-height: 1.3; text-align: center;">
        <a href="{{ product.url }}" style="color: inherit; text-decoration: none;">
          {{ product.title }}
        </a>
      </h3>
      {% if sizes_label != blank %}
        <div style="font-size: 1.25rem; color: #777; margin-bottom: 0.8rem; text-align: center;">
          {{ sizes_label }}
        </div>
      {% endif %}
    </div>

    <div style="display: flex; align-items: center; justify-content: center; gap: 0.8rem; width: 100%; flex-wrap: wrap;">
      <span style="font-size: 1.85rem; font-weight: 800; color: #6B3FA0;">
        {{ product.price | money }}
      </span>
      {% if has_discount %}
        <span style="font-size: 1.35rem; color: #999; text-decoration: line-through;">
          {{ product.compare_at_price | money }}
        </span>
        <span class="meeeku-badge" style="background: #E8F5E9; color: #2E7D32; font-size: 1.05rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 12px;">
          {{ savings }}% OFF
        </span>
      {% endif %}
    </div>
  </div>

</div>
