{% comment %}
  Meeeku Size & Fit Guide (0-6Y Range)
{% endcomment %}

<div class="meeeku-accordion-container" style="margin-top: 1.5rem; border: 2px solid #F8BBD0; border-radius: 24px; background: #FFFDF7; overflow: hidden;">
  <button type="button" class="meeeku-accordion-trigger" onclick="toggleMeeekuAccordion(this)" style="width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 1.4rem 2rem; background: transparent; border: none; font-size: 1.6rem; font-weight: 700; color: #3D2355; cursor: pointer; text-align: left;">
    <span>📐 Size & Fit Guide (0 - 7 Years)</span>
    <span class="meeeku-accordion-arrow" style="transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1); color: #FF6097; font-size: 1.2rem;">▼</span>
  </button>

  <div class="meeeku-accordion-panel" style="max-height: 0; opacity: 0; overflow: hidden; transition: max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s ease, padding 0.35s ease; padding: 0 2rem; border-top: 1px solid transparent;">
    <div style="font-size: 1.35rem; color: #555; line-height: 1.6; padding-bottom: 1.5rem;">
      <p style="margin-top: 0; margin-bottom: 1rem; color: #6B3FA0; font-weight: 600;">Meeeku garments are tailored with elasticated waists & 1.5-inch inner margins for growing children!</p>
      
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 1.3rem;">
        <thead>
          <tr style="background: #FFF0F5; color: #3D2355; font-weight: 700;">
            <th style="padding: 0.8rem; border-radius: 10px 0 0 10px;">Age Group</th>
            <th style="padding: 0.8rem;">Chest (in)</th>
            <th style="padding: 0.8rem;">Waist (in)</th>
            <th style="padding: 0.8rem; border-radius: 0 10px 10px 0;">Top Length</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid #F8BBD0;">
            <td style="padding: 0.8rem; font-weight: 700; color: #6B3FA0;">0 - 1 Year (0-1Y)</td>
            <td style="padding: 0.8rem;">19 - 20"</td>
            <td style="padding: 0.8rem;">18 - 19"</td>
            <td style="padding: 0.8rem;">13"</td>
          </tr>
          <tr style="border-bottom: 1px solid #F8BBD0;">
            <td style="padding: 0.8rem; font-weight: 700; color: #6B3FA0;">1 - 2 Years (1-2Y)</td>
            <td style="padding: 0.8rem;">21 - 22"</td>
            <td style="padding: 0.8rem;">19 - 20"</td>
            <td style="padding: 0.8rem;">14"</td>
          </tr>
          <tr style="border-bottom: 1px solid #F8BBD0;">
            <td style="padding: 0.8rem; font-weight: 700; color: #6B3FA0;">2 - 3 Years (2-3Y)</td>
            <td style="padding: 0.8rem;">22 - 23"</td>
            <td style="padding: 0.8rem;">20 - 21"</td>
            <td style="padding: 0.8rem;">15"</td>
          </tr>
          <tr style="border-bottom: 1px solid #F8BBD0;">
            <td style="padding: 0.8rem; font-weight: 700; color: #6B3FA0;">3 - 4 Years (3-4Y)</td>
            <td style="padding: 0.8rem;">23 - 24"</td>
            <td style="padding: 0.8rem;">21 - 22"</td>
            <td style="padding: 0.8rem;">16"</td>
          </tr>
          <tr style="border-bottom: 1px solid #F8BBD0;">
            <td style="padding: 0.8rem; font-weight: 700; color: #6B3FA0;">4 - 5 Years (4-5Y)</td>
            <td style="padding: 0.8rem;">24 - 25"</td>
            <td style="padding: 0.8rem;">22 - 23"</td>
            <td style="padding: 0.8rem;">17.5"</td>
          </tr>
          <tr style="border-bottom: 1px solid #F8BBD0;">
            <td style="padding: 0.8rem; font-weight: 700; color: #6B3FA0;">5 - 6 Years (5-6Y)</td>
            <td style="padding: 0.8rem;">25 - 26"</td>
            <td style="padding: 0.8rem;">23 - 24"</td>
            <td style="padding: 0.8rem;">19"</td>
          </tr>
          <tr>
            <td style="padding: 0.8rem; font-weight: 700; color: #6B3FA0;">6 - 7 Years (6-7Y)</td>
            <td style="padding: 0.8rem;">26 - 27"</td>
            <td style="padding: 0.8rem;">24 - 25"</td>
            <td style="padding: 0.8rem;">20.5"</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
