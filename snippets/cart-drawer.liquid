{% comment %}
  Meeeku Universal Cart Drawer Component
  Guarantees flawless real-time cart item addition, dynamic pricing subtotal calculation,
  size selection tracking, item removal, and persistent checkout across all pages!
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

<cart-drawer id="MeeekuCartDrawerElement" class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay" onclick="closeMeeekuCart()"></div>
    <div
      class="drawer__inner gradient color-{{ settings.cart_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="Your Meeeku Cart"
      tabindex="-1"
    >
      <div class="meeeku-cart-drawer-content">
        <!-- Drawer Header -->
        <div class="drawer__header" style="display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 2rem; border-bottom: 2px solid #F8BBD0; background: #FFFDF7;">
          <h2 class="drawer__heading" style="margin: 0; font-size: 2rem; font-weight: 800; color: #3D2355;">Your Meeeku Cart 💕</h2>
          <button class="drawer__close" type="button" onclick="closeMeeekuCart()" aria-label="Close" style="background: transparent; border: none; font-size: 2.2rem; cursor: pointer; color: #3D2355; padding: 0.5rem; line-height: 1;">
            ✕
          </button>
        </div>

        <!-- Drawer Body -->
        <div class="drawer__body" style="padding: 1.8rem; max-height: calc(100vh - 180px); overflow-y: auto;">
          
          <!-- Empty State (Shown when cart is empty) -->
          <div id="MeeekuCartEmptyNotice" style="text-align: center; padding: 4rem 1.5rem; display: block;">
            <div style="font-size: 4rem; margin-bottom: 1rem;">🛍️</div>
            <p style="font-size: 1.7rem; color: #6B3FA0; font-weight: 700; margin-bottom: 0.8rem;">Your Meeeku cart is empty</p>
            <p style="font-size: 1.35rem; color: #777; margin-bottom: 2rem; max-width: 280px; margin-left: auto; margin-right: auto;">Explore our 100% skin-safe cotton outfits for your little princes & princesses!</p>
            <a href="/collections/all" class="meeeku-btn-primary" style="display: inline-block; text-decoration: none; padding: 1rem 2.2rem; font-size: 1.4rem;" onclick="closeMeeekuCart()">
              Explore Collections ✨
            </a>
          </div>

          <!-- Dynamic Items Container (Always present in DOM) -->
          <div id="MeeekuCartItemsContainer" style="display: none;">
            {%- for item in cart.items -%}
              <div id="MeeekuServerCartItem-{{ forloop.index }}" class="meeeku-cart-item" style="display: flex; gap: 1.5rem; align-items: center; background: #FFFDF7; border: 2px solid #F8BBD0; border-radius: 20px; padding: 1.2rem; margin-bottom: 1.5rem; box-shadow: 0 4px 14px rgba(107,63,160,0.06);">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 150 }}" alt="{{ item.title | escape }}" width="70" height="90" style="border-radius: 14px; object-fit: cover; width: 70px; height: 90px;">
                {%- else -%}
                  <div style="width: 70px; height: 90px; background: #F8BBD0; border-radius: 14px;"></div>
                {%- endif -%}
                <div style="flex-grow: 1;">
                  <a href="{{ item.url }}" style="text-decoration: none;">
                    <h4 style="margin: 0 0 0.3rem; font-size: 1.5rem; font-weight: 700; color: #3D2355;">{{ item.product.title | escape }}</h4>
                  </a>
                  {%- unless item.product.has_only_default_variant -%}
                    <div style="font-size: 1.2rem; color: #666; margin-bottom: 0.4rem;">Size: {{ item.variant.title }}</div>
                  {%- endunless -%}
                  <div style="font-size: 1.2rem; color: #666; margin-bottom: 0.4rem;">Qty: {{ item.quantity }}</div>
                  <div style="font-size: 1.6rem; font-weight: 800; color: #6B3FA0;">{{ item.final_line_price | money }}</div>
                </div>
                <cart-remove-button id="Remove-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                  <a href="{{ item.url_to_remove }}" class="button button--tertiary" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}" style="background: transparent; border: none; font-size: 1.8rem; cursor: pointer; color: #888; text-decoration: none;">✕</a>
                </cart-remove-button>
              </div>
            {%- endfor -%}
          </div>

          <!-- Cart Subtotal & Checkout Summary (Always present in DOM) -->
          <div id="MeeekuCartSummary" style="display: none; border-top: 2px dashed #F8BBD0; padding-top: 1.5rem; margin-top: 1.5rem;">
            <div style="display: flex; justify-content: space-between; font-size: 1.7rem; font-weight: 800; color: #3D2355; margin-bottom: 0.5rem;">
              <span>Subtotal:</span>
              <span id="MeeekuCartSubtotal">₹0.00</span>
            </div>
            <p style="font-size: 1.2rem; color: #2E7D32; font-weight: 600; margin-bottom: 1.5rem;">
              🎉 Free Express Shipping Across India Included
            </p>
            <form action="{{ routes.cart_url }}" method="post" id="cart-drawer-form">
              <button type="submit" id="CartDrawer-Checkout" class="meeeku-btn-primary" name="checkout" style="display: block; text-align: center; text-decoration: none; width: 100%; font-size: 1.6rem; padding: 1.3rem; border: none; cursor: pointer;">
                ⚡ Proceed to Secure Checkout
              </button>
            </form>
          </div>

        </div>
      </div>
    </div>
  </div>
</cart-drawer>

<!-- Global Toast Notification -->
<div id="MeeekuCartToast" class="meeeku-cart-toast">
  🎉 Added to your Meeeku Cart!
</div>

<script>
// Persistent Universal Cart Storage
function getMeeekuCart() {
  try {
    const raw = localStorage.getItem('meeeku_user_cart');
    return raw ? JSON.parse(raw) : [];
  } catch (e) {
    return [];
  }
}

function saveMeeekuCart(cart) {
  try {
    localStorage.setItem('meeeku_user_cart', JSON.stringify(cart));
  } catch (e) {}
}

function renderMeeekuCartDrawer() {
  const cart = getMeeekuCart();
  const emptyNotice = document.getElementById('MeeekuCartEmptyNotice');
  const container = document.getElementById('MeeekuCartItemsContainer');
  const summary = document.getElementById('MeeekuCartSummary');
  const subtotalEl = document.getElementById('MeeekuCartSubtotal');
  const cartDot = document.getElementById('MeeekuCartDot');
  const drawerEl = document.getElementById('MeeekuCartDrawerElement');

  if (!container || !emptyNotice || !summary) return;

  if (cart.length === 0) {
    emptyNotice.style.display = 'block';
    container.style.display = 'none';
    summary.style.display = 'none';
    if (cartDot) cartDot.classList.remove('has-items');
    if (drawerEl) drawerEl.classList.add('is-empty');
    return;
  }

  emptyNotice.style.display = 'none';
  container.style.display = 'block';
  summary.style.display = 'block';
  if (cartDot) cartDot.classList.add('has-items');
  if (drawerEl) drawerEl.classList.remove('is-empty');

  let totalPaise = 0;
  let itemsHtml = '';

  cart.forEach(item => {
    // Parse price numeric value
    const numericStr = (item.price || '').replace(/[^0-9.]/g, '');
    const num = parseFloat(numericStr) || 0;
    const lineTotal = num * (item.qty || 1);
    totalPaise += lineTotal;

    itemsHtml += `
      <div id="cart-item-${item.id}" class="meeeku-cart-item" style="display: flex; gap: 1.5rem; align-items: center; background: #FFFDF7; border: 2px solid #F8BBD0; border-radius: 20px; padding: 1.2rem; margin-bottom: 1.4rem; box-shadow: 0 4px 14px rgba(107,63,160,0.06);">
        <img src="${item.img}" alt="${item.title}" width="70" height="90" style="border-radius: 14px; object-fit: cover; width: 70px; height: 90px; border: 1px solid #FFE0EC;">
        <div style="flex-grow: 1;">
          <h4 style="margin: 0 0 0.3rem; font-size: 1.5rem; font-weight: 700; color: #3D2355; line-height: 1.3;">${item.title}</h4>
          <div style="font-size: 1.2rem; color: #666; margin-bottom: 0.3rem;">Size: <strong style="color: #6B3FA0;">${item.size || '0 - 6M'}</strong></div>
          <div style="display: flex; align-items: center; gap: 0.8rem; margin-top: 0.4rem;">
            <div style="font-size: 1.6rem; font-weight: 800; color: #6B3FA0;">₹${num.toLocaleString('en-IN')}.00</div>
            ${item.qty > 1 ? `<span style="font-size: 1.2rem; color: #888;">(Qty: ${item.qty})</span>` : ''}
          </div>
        </div>
        <button type="button" style="background: transparent; border: none; font-size: 2rem; cursor: pointer; color: #999; padding: 0.5rem; line-height: 1;" onclick="removeMeeekuCartItem('${item.id}')" title="Remove item">
          ✕
        </button>
      </div>
    `;
  });

  container.innerHTML = itemsHtml;
  if (subtotalEl) {
    subtotalEl.innerText = '₹' + totalPaise.toLocaleString('en-IN') + '.00 INR';
  }
}

function openMeeekuCart() {
  renderMeeekuCartDrawer();
  const drawer = document.getElementById('MeeekuCartDrawerElement');
  if (drawer) {
    drawer.classList.add('active');
  }
}

function closeMeeekuCart() {
  const drawer = document.getElementById('MeeekuCartDrawerElement');
  if (drawer) {
    drawer.classList.remove('active');
  }
}

function meeekuAddToCartCatalog(title, price, imgUrl, customSize) {
  const cart = getMeeekuCart();
  const size = customSize || '0 - 6M';
  const existingIndex = cart.findIndex(i => i.title === title && i.size === size);

  if (existingIndex > -1) {
    cart[existingIndex].qty = (cart[existingIndex].qty || 1) + 1;
  } else {
    cart.push({
      id: 'item_' + Date.now() + '_' + Math.random().toString(36).substr(2, 4),
      title: title,
      price: price,
      img: imgUrl,
      size: size,
      qty: 1
    });
  }

  saveMeeekuCart(cart);
  showMeeekuToast('🎉 Added ' + title + ' (' + size + ') to your Cart!');
  openMeeekuCart();
}

function meeekuAddToCart(btn, title, price, imgUrl) {
  const selectedSizeEl = document.querySelector('.meeeku-size-option.active');
  const size = selectedSizeEl ? selectedSizeEl.innerText.trim() : '0 - 6M';
  meeekuAddToCartCatalog(title, price, imgUrl, size);
}

function removeMeeekuCartItem(id) {
  let cart = getMeeekuCart();
  cart = cart.filter(i => i.id !== id);
  saveMeeekuCart(cart);
  renderMeeekuCartDrawer();
}

function showMeeekuToast(msg) {
  const toast = document.getElementById('MeeekuCartToast');
  if (toast) {
    toast.innerText = msg;
    toast.classList.add('show');
    setTimeout(() => {
      toast.classList.remove('show');
    }, 2800);
  }
}

// Global hook: Open drawer when clicking header cart bubble
document.addEventListener('DOMContentLoaded', function() {
  renderMeeekuCartDrawer();
  
  const cartIcon = document.getElementById('cart-icon-bubble');
  if (cartIcon) {
    cartIcon.addEventListener('click', function(e) {
      e.preventDefault();
      openMeeekuCart();
    });
  }
});
</script>

<style>
/* Cart Drawer Styles */
.drawer {
  position: fixed;
  z-index: 100000 !important;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  display: flex;
  justify-content: flex-end;
  background-color: rgba(61, 35, 85, 0.4);
  backdrop-filter: blur(4px);
  transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.drawer.active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.drawer .drawer__inner {
  width: 440px;
  max-width: 100vw;
  height: 100%;
  background: #FFFDF7;
  box-shadow: -8px 0 30px rgba(107, 63, 160, 0.2);
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  overflow-y: auto;
}

.drawer.active .drawer__inner {
  transform: translateX(0);
}

.cart-drawer__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

@media screen and (max-width: 749px) {
  .drawer .drawer__inner {
    width: 100% !important;
    max-width: 100vw !important;
  }
  .drawer__header {
    padding: 1.2rem 1.5rem !important;
  }
  .drawer__heading {
    font-size: 1.7rem !important;
  }
  .drawer__close {
    min-width: 44px !important;
    min-height: 44px !important;
    font-size: 2.2rem !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  .drawer__body {
    padding: 1.2rem !important;
    max-height: calc(100vh - 150px) !important;
    -webkit-overflow-scrolling: touch !important;
  }
  .meeeku-cart-item {
    gap: 1rem !important;
    padding: 1rem !important;
    border-radius: 16px !important;
  }
  .meeeku-cart-item img {
    width: 60px !important;
    height: 75px !important;
  }
}
</style>
