{% comment %}
  Meeeku Universal Slide-Out Cart Drawer Component
  Guarantees flawless real-time cart item addition, dynamic pricing subtotal calculation,
  in-cart size selection modification, item removal, and persistent checkout across all pages!
{% endcomment %}

<!-- Meeeku Dedicated Slide-out Cart Drawer -->
<div id="MeeekuCartDrawerElement" class="meeeku-cart-drawer">
  <div class="meeeku-drawer-overlay" onclick="closeMeeekuCart()"></div>
  <div class="meeeku-drawer-inner" role="dialog" aria-modal="true" aria-label="Your Meeeku Bag">
    
    <!-- Drawer Header -->
    <div class="meeeku-drawer-header">
      <div style="display: flex; align-items: center; gap: 0.8rem;">
        <span style="font-size: 2.2rem;">🛍️</span>
        <h2 style="margin: 0; font-size: 2rem; font-weight: 800; color: #3D2355;">Your Meeeku Bag</h2>
      </div>
      <button type="button" class="meeeku-drawer-close" onclick="closeMeeekuCart()" aria-label="Close Bag">
        ✕
      </button>
    </div>

    <!-- Drawer Body -->
    <div class="meeeku-drawer-body">
      
      <!-- Empty State -->
      <div id="MeeekuCartEmptyNotice" style="text-align: center; padding: 4rem 1.5rem; display: block;">
        <div style="font-size: 4.5rem; margin-bottom: 1.2rem;">🌸</div>
        <p style="font-size: 1.8rem; color: #3D2355; font-weight: 800; margin-bottom: 0.8rem;">Your shopping bag is empty</p>
        <p style="font-size: 1.4rem; color: #666; margin-bottom: 2.2rem; max-width: 280px; margin-left: auto; margin-right: auto; line-height: 1.5;">
          Discover 100% skin-safe cotton tees, cozy co-ords, and festive twirling lehengas!
        </p>
        <a href="/collections/all" class="meeeku-btn-primary" style="display: inline-block; text-decoration: none; padding: 1.1rem 2.5rem; font-size: 1.45rem; border-radius: 30px;" onclick="closeMeeekuCart()">
          Explore Collections ✨
        </a>
      </div>

      <!-- Dynamic Items Container -->
      <div id="MeeekuCartItemsContainer" style="display: none; flex-direction: column; gap: 1.2rem;"></div>

      <!-- Cart Subtotal & Checkout Summary -->
      <div id="MeeekuCartSummary" style="display: none; border-top: 2px dashed #F8BBD0; padding-top: 1.6rem; margin-top: 1.6rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 1.8rem; font-weight: 800; color: #3D2355; margin-bottom: 0.6rem;">
          <span>Subtotal:</span>
          <span id="MeeekuCartSubtotal" style="color: #6B3FA0; font-size: 2rem;">₹0.00</span>
        </div>
        <p style="font-size: 1.25rem; color: #2E7D32; font-weight: 700; margin: 0 0 1.5rem; display: flex; align-items: center; gap: 0.4rem;">
          <span>🚚</span> Free Express Shipping Included Across India
        </p>
        <div style="display: flex; flex-direction: column; gap: 0.9rem;">
          <a href="/cart" class="button button--secondary" style="width: 100%; border-radius: 25px; padding: 1.1rem; font-size: 1.45rem; font-weight: 700; color: #6B3FA0; border: 2px solid #F8BBD0; background: #FFF; text-align: center; text-decoration: none;">
            View Full Cart & Edit Sizes 📝
          </a>
          <a href="/checkout" class="meeeku-btn-primary" style="display: block; text-align: center; text-decoration: none; width: 100%; font-size: 1.65rem; padding: 1.25rem; border-radius: 30px; box-shadow: 0 6px 20px rgba(255, 96, 151, 0.4);">
            ⚡ Proceed to Checkout
          </a>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Global Toast Notification -->
<div id="MeeekuCartToast" class="meeeku-cart-toast">
  🎉 Added to your Meeeku Cart!
</div>

<script>
function formatMeeekuPaise(paise) {
  var rupees = Math.round(paise / 100);
  return '₹' + rupees.toLocaleString('en-IN') + '.00';
}

function updateCartBadges(count) {
  var countBubbles = document.querySelectorAll('.cart-count-bubble span');
  countBubbles.forEach(function(b) { b.textContent = count; });
  var dot = document.getElementById('MeeekuCartDot');
  if (dot) {
    if (count > 0) dot.classList.add('has-items');
    else dot.classList.remove('has-items');
  }
}

function fetchMeeekuShopifyCart(callback) {
  fetch('/cart.js')
    .then(function(res) { return res.json(); })
    .then(function(cart) {
      window.meeekuLiveShopifyCart = cart;
      renderMeeekuCartDrawerWithData(cart);
      updateCartBadges(cart.item_count || 0);
      if (typeof callback === 'function') callback(cart);
    })
    .catch(function(err) {
      console.error('Cart fetch error:', err);
    });
}

function renderMeeekuCartDrawerWithData(cart) {
  const emptyNotice = document.getElementById('MeeekuCartEmptyNotice');
  const container = document.getElementById('MeeekuCartItemsContainer');
  const summary = document.getElementById('MeeekuCartSummary');
  const subtotalEl = document.getElementById('MeeekuCartSubtotal');
  const cartDot = document.getElementById('MeeekuCartDot');

  if (!container || !emptyNotice || !summary) return;

  const items = cart.items || [];

  if (items.length === 0) {
    emptyNotice.style.display = 'block';
    container.style.display = 'none';
    summary.style.display = 'none';
    if (cartDot) cartDot.classList.remove('has-items');
    return;
  }

  emptyNotice.style.display = 'none';
  container.style.display = 'flex';
  summary.style.display = 'block';
  if (cartDot) cartDot.classList.add('has-items');

  let itemsHtml = '';

  items.forEach((item, index) => {
    const itemKey = item.key || item.id;
    const unitPriceFormatted = formatMeeekuPaise(item.final_price || item.price || 0);
    const lineTotalFormatted = formatMeeekuPaise(item.final_line_price || item.line_price || 0);
    const imgSrc = item.image || item.featured_image?.url || 'https://raw.githubusercontent.com/aaybwork-studio/meeeku/main/assets/meeeku_prod_yellow_lehenga.jpg';
    const variantTitle = item.variant_title ? item.variant_title : '';

    itemsHtml += `
      <div id="drawer-item-${item.id}" class="meeeku-cart-item" style="display: flex; gap: 1.2rem; align-items: center; background: #FFFDF7; border: 1.5px solid #F8BBD0; border-radius: 18px; padding: 1.2rem; box-shadow: 0 2px 10px rgba(107,63,160,0.04);">
        <img src="${imgSrc}" alt="${item.product_title || item.title}" width="70" height="90" style="border-radius: 12px; object-fit: cover; width: 68px; height: 88px; border: 1.5px solid #FFE0EC; flex-shrink: 0;">
        <div style="flex-grow: 1; min-width: 0;">
          <h4 style="margin: 0 0 0.3rem; font-size: 1.45rem; font-weight: 700; color: #3D2355; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            ${item.product_title || item.title}
          </h4>
          
          ${variantTitle ? `
          <div style="display: flex; align-items: center; gap: 0.5rem; margin: 0.3rem 0;">
            <span style="font-size: 1.15rem; color: #666; font-weight: 600;">Size:</span>
            <span style="border: 1px solid #F8BBD0; background: #FFF; color: #6B3FA0; font-weight: 700; font-size: 1.15rem; padding: 0.15rem 0.6rem; border-radius: 8px;">
              ${variantTitle}
            </span>
          </div>` : ''}

          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.4rem;">
            <div style="font-size: 1.55rem; font-weight: 800; color: #6B3FA0;">${unitPriceFormatted}</div>
            
            <div style="display: flex; align-items: center; background: #FFF; border: 1px solid #F8BBD0; border-radius: 20px; padding: 0.15rem 0.6rem;">
              <button type="button" onclick="meeekuDrawerUpdateQty('${itemKey}', ${item.quantity - 1})" style="background: none; border: none; font-size: 1.5rem; font-weight: 800; color: #FF6097; cursor: pointer; padding: 0 0.3rem; line-height: 1;" title="Decrease quantity">−</button>
              <span style="font-size: 1.3rem; font-weight: 800; padding: 0 0.5rem; color: #3D2355;">${item.quantity}</span>
              <button type="button" onclick="meeekuDrawerUpdateQty('${itemKey}', ${item.quantity + 1})" style="background: none; border: none; font-size: 1.5rem; font-weight: 800; color: #FF6097; cursor: pointer; padding: 0 0.3rem; line-height: 1;" title="Increase quantity">+</button>
            </div>
          </div>
        </div>
        <button type="button" style="background: transparent; border: none; font-size: 1.8rem; cursor: pointer; color: #BBB; padding: 0.4rem; line-height: 1;" onclick="removeMeeekuCartItem('${itemKey}')" title="Remove item">
          ✕
        </button>
      </div>
    `;
  });

  container.innerHTML = itemsHtml;
  if (subtotalEl) {
    subtotalEl.innerText = formatMeeekuPaise(cart.total_price || 0);
  }
}

function meeekuDrawerUpdateQty(itemKey, newQty) {
  fetch('/cart/change.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: itemKey, quantity: parseInt(newQty) || 0 })
  })
  .then(function(res) { return res.json(); })
  .then(function(cart) {
    window.meeekuLiveShopifyCart = cart;
    renderMeeekuCartDrawerWithData(cart);
    updateCartBadges(cart.item_count || 0);
  })
  .catch(function(err) {
    console.error('Error updating quantity:', err);
  });
}

function removeMeeekuCartItem(itemKey) {
  meeekuDrawerUpdateQty(itemKey, 0);
}

function openMeeekuCart() {
  fetchMeeekuShopifyCart(function() {
    const drawer = document.getElementById('MeeekuCartDrawerElement');
    if (drawer) {
      drawer.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  });
}

function closeMeeekuCart() {
  const drawer = document.getElementById('MeeekuCartDrawerElement');
  if (drawer) {
    drawer.classList.remove('active');
    document.body.style.overflow = '';
  }
}

function meeekuAddToCartCatalog(title, price, imgUrl, variantId) {
  if (variantId && !isNaN(parseInt(variantId))) {
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: parseInt(variantId), quantity: 1 }] })
    })
    .then(function(res) { return res.json(); })
    .then(function() {
      showMeeekuToast('🎉 Added ' + title + ' to Bag!');
      openMeeekuCart();
    })
    .catch(function() {
      showMeeekuToast('🎉 Added ' + title + ' to Bag!');
      openMeeekuCart();
    });
  } else {
    showMeeekuToast('🎉 Added ' + title + ' to Bag!');
    openMeeekuCart();
  }
}

function showMeeekuToast(msg) {
  const toast = document.getElementById('MeeekuCartToast');
  if (toast) {
    toast.innerText = msg;
    toast.classList.add('show');
    setTimeout(() => {
      toast.classList.remove('show');
    }, 2800);
  }
}

// Global hooks
document.addEventListener('DOMContentLoaded', function() {
  fetchMeeekuShopifyCart();
  
  const cartIcon = document.getElementById('cart-icon-bubble');
  if (cartIcon) {
    cartIcon.addEventListener('click', function(e) {
      e.preventDefault();
      openMeeekuCart();
    });
  }
});
</script>

<style>
/* Universal Meeeku Cart Drawer Styles */
.meeeku-cart-drawer {
  position: fixed !important;
  z-index: 999999 !important;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  display: flex;
  justify-content: flex-end;
  background-color: rgba(61, 35, 85, 0.45);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
  transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.meeeku-cart-drawer.active {
  opacity: 1 !important;
  visibility: visible !important;
  pointer-events: auto !important;
}

.meeeku-drawer-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  cursor: pointer;
}

.meeeku-drawer-inner {
  position: relative;
  width: 440px;
  max-width: 100vw;
  height: 100%;
  background: #FFFDF7;
  box-shadow: -8px 0 35px rgba(107, 63, 160, 0.25);
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 2;
  overflow: hidden;
}

.meeeku-cart-drawer.active .meeeku-drawer-inner {
  transform: translateX(0) !important;
}

.meeeku-drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem 2rem;
  border-bottom: 2px solid #F8BBD0;
  background: #FFFDF7;
  flex-shrink: 0;
}

.meeeku-drawer-close {
  background: #FFF;
  border: 1.5px solid #F8BBD0;
  border-radius: 50%;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.8rem;
  cursor: pointer;
  color: #3D2355;
  transition: all 0.2s ease;
}

.meeeku-drawer-close:hover {
  background: #FF6097;
  color: #FFF;
  border-color: #FF6097;
}

.meeeku-drawer-body {
  padding: 1.8rem;
  flex-grow: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.meeeku-cart-toast {
  position: fixed;
  bottom: 25px;
  right: 25px;
  background: #3D2355;
  color: #FFFFFF;
  padding: 1.2rem 2.2rem;
  border-radius: 30px;
  font-size: 1.45rem;
  font-weight: 700;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
  z-index: 1000000;
  transform: translateY(100px);
  opacity: 0;
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  pointer-events: none;
  border: 1.5px solid #F8BBD0;
}

.meeeku-cart-toast.show {
  transform: translateY(0);
  opacity: 1;
}

@media screen and (max-width: 749px) {
  .meeeku-drawer-inner {
    width: 100% !important;
    max-width: 100vw !important;
  }
  .meeeku-drawer-header {
    padding: 1.2rem 1.5rem !important;
  }
  .meeeku-drawer-body {
    padding: 1.2rem !important;
  }
  .meeeku-cart-item {
    gap: 1rem !important;
    padding: 1rem !important;
    border-radius: 16px !important;
  }
  .meeeku-cart-toast {
    bottom: 20px;
    right: 20px;
    left: 20px;
    text-align: center;
    font-size: 1.35rem;
  }
}
</style>
