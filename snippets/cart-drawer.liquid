  updateMeeekuShippingProgress(subtotalInRupees, 'MeeekuDrawerShippingProgress', 'MeeekuDrawerShippingMsg', 'MeeekuDrawerShippingFill', 'MeeekuCartDeliveryFee', 'MeeekuCartTotal');
