{% comment %}
  Meeeku Cart Drawer Component
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

<cart-drawer class="drawer">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay" onclick="this.closest('cart-drawer').close()"></div>
    <div
      class="drawer__inner gradient color-{{ settings.cart_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="Your Meeeku Cart"
      tabindex="-1"
    >
      <div class="meeeku-cart-drawer-content">
        <!-- Drawer Header -->
        <div class="drawer__header" style="display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 2rem; border-bottom: 2px solid #F8BBD0;">
          <h2 class="drawer__heading" style="margin: 0; font-size: 2rem; font-weight: 800; color: #3D2355;">Your Meeeku Cart 💕</h2>
          <button class="drawer__close" type="button" onclick="this.closest('cart-drawer').close()" aria-label="Close" style="background: transparent; border: none; font-size: 2rem; cursor: pointer; color: #3D2355;">
            ✕
          </button>
        </div>

        <!-- Drawer Body -->
        <div class="drawer__body" style="padding: 2rem; max-height: calc(100vh - 180px); overflow-y: auto;">
          
          <!-- Dynamic Items Container -->
          <div id="MeeekuCartItemsContainer">
            <div id="MeeekuCartItem-1" class="meeeku-cart-item" style="display: flex; gap: 1.5rem; align-items: center; background: #FFFDF7; border: 2px solid #F8BBD0; border-radius: 20px; padding: 1.2rem; margin-bottom: 1.5rem; box-shadow: 0 4px 14px rgba(107,63,160,0.06);">
              <img id="MeeekuCartItemImg" src="{{ 'placeholder_ethnic_1.jpg' | asset_url }}" alt="Royal Pink Lehenga Choli" width="80" height="100" style="border-radius: 14px; object-fit: cover; width: 70px; height: 90px;">
              <div style="flex-grow: 1;">
                <h4 id="MeeekuCartItemTitle" style="margin: 0 0 0.3rem; font-size: 1.5rem; font-weight: 700; color: #3D2355;">Royal Pink & Gold Lehenga Set</h4>
                <div style="font-size: 1.2rem; color: #666; margin-bottom: 0.4rem;">Size: 2 - 3 Years (2Y)</div>
                <div id="MeeekuCartItemPrice" style="font-size: 1.6rem; font-weight: 800; color: #6B3FA0;">₹2,499.00</div>
              </div>
              <button type="button" style="background: transparent; border: none; font-size: 1.8rem; cursor: pointer; color: #888;" onclick="removeMeeekuCartItem('MeeekuCartItem-1')">✕</button>
            </div>
          </div>

          <!-- Empty State (Hidden when items present) -->
          <div id="MeeekuCartEmptyNotice" style="display: none; text-align: center; padding: 3rem 1rem;">
            <p style="font-size: 1.6rem; color: #6B3FA0; font-weight: 600; margin-bottom: 1.5rem;">Your Meeeku cart is currently empty.</p>
            <a href="/collections/all" class="meeeku-btn-primary" style="display: inline-block; text-decoration: none;" onclick="document.querySelector('cart-drawer').close()">Explore Collections 👑</a>
          </div>

          <!-- Cart Subtotal & Checkout Summary -->
          <div id="MeeekuCartSummary" style="border-top: 2px dashed #F8BBD0; padding-top: 1.5rem; margin-top: 1.5rem;">
            <div style="display: flex; justify-content: space-between; font-size: 1.6rem; font-weight: 700; color: #3D2355; margin-bottom: 0.5rem;">
              <span>Subtotal:</span>
              <span id="MeeekuCartSubtotal">₹2,499.00 INR</span>
            </div>
            <p style="font-size: 1.2rem; color: #888; margin-bottom: 1.5rem;">Taxes included & free shipping across India 🚚</p>
            <a href="/checkout" class="meeeku-btn-primary" style="display: block; text-align: center; text-decoration: none; width: 100%; font-size: 1.6rem; padding: 1.2rem;">
              ⚡ Proceed to Secure Checkout
            </a>
          </div>

        </div>
      </div>
    </div>
  </div>
</cart-drawer>

<script>
function removeMeeekuCartItem(itemId) {
  const item = document.getElementById(itemId);
  if (item) item.remove();
  
  const container = document.getElementById('MeeekuCartItemsContainer');
  if (container && container.children.length === 0) {
    document.getElementById('MeeekuCartEmptyNotice').style.display = 'block';
    document.getElementById('MeeekuCartSummary').style.display = 'none';
    const dot = document.getElementById('MeeekuCartDot');
    if (dot) dot.classList.remove('has-items');
  }
}
</script>
