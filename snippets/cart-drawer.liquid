{% comment %}
  Meeeku Universal Cart Drawer Component
  Guarantees flawless real-time cart item addition, dynamic pricing subtotal calculation,
  in-cart size selection modification, item removal, and persistent checkout across all pages!
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

<cart-drawer id="MeeekuCartDrawerElement" class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay" onclick="closeMeeekuCart()"></div>
    <div
      class="drawer__inner gradient color-{{ settings.cart_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="Your Meeeku Cart"
      tabindex="-1"
    >
      <div class="meeeku-cart-drawer-content">
        <!-- Drawer Header -->
        <div class="drawer__header" style="display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 2rem; border-bottom: 2px solid #F8BBD0; background: #FFFDF7;">
          <h2 class="drawer__heading" style="margin: 0; font-size: 2rem; font-weight: 800; color: #3D2355;">Your Meeeku Bag 💕</h2>
          <button class="drawer__close" type="button" onclick="closeMeeekuCart()" aria-label="Close" style="background: transparent; border: none; font-size: 2.2rem; cursor: pointer; color: #3D2355; padding: 0.5rem; line-height: 1;">
            ✕
          </button>
        </div>

        <!-- Drawer Body -->
        <div class="drawer__body" style="padding: 1.8rem; max-height: calc(100vh - 180px); overflow-y: auto;">
          
          <!-- Empty State -->
          <div id="MeeekuCartEmptyNotice" style="text-align: center; padding: 4rem 1.5rem; display: block;">
            <div style="font-size: 4rem; margin-bottom: 1rem;">🛍️</div>
            <p style="font-size: 1.7rem; color: #6B3FA0; font-weight: 700; margin-bottom: 0.8rem;">Your shopping bag is empty</p>
            <p style="font-size: 1.35rem; color: #777; margin-bottom: 2rem; max-width: 280px; margin-left: auto; margin-right: auto;">Explore our 100% skin-safe cotton outfits for your little ones!</p>
            <a href="/collections/all" class="meeeku-btn-primary" style="display: inline-block; text-decoration: none; padding: 1rem 2.2rem; font-size: 1.4rem;" onclick="closeMeeekuCart()">
              Explore Collections ✨
            </a>
          </div>

          <!-- Dynamic Items Container -->
          <div id="MeeekuCartItemsContainer" style="display: none; flex-direction: column; gap: 1.2rem;"></div>

          <!-- Cart Subtotal & Checkout Summary -->
          <div id="MeeekuCartSummary" style="display: none; border-top: 2px dashed #F8BBD0; padding-top: 1.5rem; margin-top: 1.5rem;">
            <div style="display: flex; justify-content: space-between; font-size: 1.7rem; font-weight: 800; color: #3D2355; margin-bottom: 0.5rem;">
              <span>Subtotal:</span>
              <span id="MeeekuCartSubtotal">₹0.00</span>
            </div>
            <p style="font-size: 1.2rem; color: #2E7D32; font-weight: 600; margin-bottom: 1.5rem;">
              🎉 Free Express Shipping Across India Included
            </p>
            <div style="display: flex; flex-direction: column; gap: 0.8rem;">
              <button type="button" onclick="window.location.href='/cart'" class="button button--secondary" style="width: 100%; border-radius: 25px; padding: 1rem; font-size: 1.4rem; font-weight: 700; color: #6B3FA0; border-color: #F8BBD0; background: #FFF;">
                View Full Bag & Change Sizes
              </button>
              <button type="button" onclick="window.location.href='/checkout'" class="meeeku-btn-primary" style="display: block; text-align: center; text-decoration: none; width: 100%; font-size: 1.6rem; padding: 1.2rem; border: none; cursor: pointer;">
                ⚡ Proceed to Secure Checkout
              </button>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</cart-drawer>

<!-- Global Toast Notification -->
<div id="MeeekuCartToast" class="meeeku-cart-toast">
  🎉 Added to your Meeeku Cart!
</div>

<script>
const MEEEKU_SIZES_TEES_COORDS = ['0 - 6M', '6 - 12M', '12 - 18M', '18 - 24M', '2 - 3Y'];
const MEEEKU_SIZES_ETHNIC = ['2 - 3Y', '4 - 5Y', '6 - 7Y'];

function getMeeekuCart() {
  try {
    let cart = JSON.parse(localStorage.getItem('meeeku_active_cart') || 'null');
    if (!cart || !Array.isArray(cart) || cart.length === 0) {
      const old1 = JSON.parse(localStorage.getItem('meeeku_user_cart') || 'null');
      const old2 = JSON.parse(localStorage.getItem('meeeku_cart') || 'null');
      cart = old1 || old2 || [];
      if (cart.length > 0) {
        localStorage.setItem('meeeku_active_cart', JSON.stringify(cart));
      }
    }
    return cart;
  } catch (e) {
    return [];
  }
}

function saveMeeekuCart(cart) {
  try {
    localStorage.setItem('meeeku_active_cart', JSON.stringify(cart));
    localStorage.setItem('meeeku_user_cart', JSON.stringify(cart));
    localStorage.setItem('meeeku_cart', JSON.stringify(cart));
  } catch (e) {}
}

function renderMeeekuCartDrawer() {
  const cart = getMeeekuCart();
  const emptyNotice = document.getElementById('MeeekuCartEmptyNotice');
  const container = document.getElementById('MeeekuCartItemsContainer');
  const summary = document.getElementById('MeeekuCartSummary');
  const subtotalEl = document.getElementById('MeeekuCartSubtotal');
  const cartDot = document.getElementById('MeeekuCartDot');
  const drawerEl = document.getElementById('MeeekuCartDrawerElement');

  if (!container || !emptyNotice || !summary) return;

  if (cart.length === 0) {
    emptyNotice.style.display = 'block';
    container.style.display = 'none';
    summary.style.display = 'none';
    if (cartDot) cartDot.classList.remove('has-items');
    if (drawerEl) drawerEl.classList.add('is-empty');
    return;
  }

  emptyNotice.style.display = 'none';
  container.style.display = 'flex';
  summary.style.display = 'block';
  if (cartDot) cartDot.classList.add('has-items');
  if (drawerEl) drawerEl.classList.remove('is-empty');

  let totalPaise = 0;
  let itemsHtml = '';

  cart.forEach((item, index) => {
    let titleLower = (item.title || '').toLowerCase();
    let isCoord = titleLower.includes('co-ord') || titleLower.includes('set') || titleLower.includes('lounge') || titleLower.includes('peplum') || titleLower.includes('eyelet') || titleLower.includes('stardust') || titleLower.includes('kitty') || titleLower.includes('meadow') || titleLower.includes('storybook');
    let isTee = titleLower.includes('tee') || titleLower.includes('t-shirt');

    let numericPrice = parseFloat((item.price || '0').replace(/[^0-9.]/g, '')) || 0;
    if (isCoord && (numericPrice === 799 || numericPrice === 849 || numericPrice === 899)) {
      numericPrice = 1299;
      item.price = '₹1,299.00';
    }

    const qty = item.qty || item.quantity || 1;
    const lineTotal = numericPrice * qty;
    totalPaise += lineTotal;

    const availableSizes = (isTee || isCoord) ? MEEEKU_SIZES_TEES_COORDS : MEEEKU_SIZES_ETHNIC;
    const currentSize = item.size || (isTee || isCoord ? '0 - 6M' : '2 - 3Y');

    let sizeOptions = '';
    availableSizes.forEach(sz => {
      const isSel = sz.replace(/\s+/g, '') === currentSize.replace(/\s+/g, '') ? 'selected' : '';
      sizeOptions += `<option value="${sz}" ${isSel}>${sz}</option>`;
    });

    itemsHtml += `
      <div id="drawer-item-${item.id || index}" class="meeeku-cart-item" style="display: flex; gap: 1.2rem; align-items: center; background: #FFFDF7; border: 1.5px solid #F8BBD0; border-radius: 18px; padding: 1.2rem; box-shadow: 0 2px 10px rgba(107,63,160,0.04);">
        <img src="${item.img || item.image || 'https://raw.githubusercontent.com/aaybwork-studio/meeeku/main/assets/meeeku_prod_yellow_lehenga.jpg'}" alt="${item.title}" width="70" height="90" style="border-radius: 12px; object-fit: cover; width: 65px; height: 85px; border: 1px solid #FFE0EC; flex-shrink: 0;">
        <div style="flex-grow: 1;">
          <h4 style="margin: 0 0 0.3rem; font-size: 1.45rem; font-weight: 700; color: #3D2355; line-height: 1.3;">${item.title}</h4>
          
          <div style="display: flex; align-items: center; gap: 0.5rem; margin: 0.3rem 0;">
            <span style="font-size: 1.15rem; color: #666; font-weight: 600;">Size:</span>
            <select onchange="meeekuDrawerChangeSize(${index}, this.value)" style="border: 1px solid #F8BBD0; background: #FFF; color: #6B3FA0; font-weight: 700; font-size: 1.15rem; padding: 0.2rem 0.5rem; border-radius: 8px; cursor: pointer; outline: none;">
              ${sizeOptions}
            </select>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.4rem;">
            <div style="font-size: 1.5rem; font-weight: 800; color: #6B3FA0;">₹${numericPrice.toLocaleString('en-IN')}.00</div>
            
            <div style="display: flex; align-items: center; background: #FFF; border: 1px solid #F8BBD0; border-radius: 20px; padding: 0.15rem 0.6rem;">
              <button type="button" onclick="meeekuDrawerUpdateQty(${index}, -1)" style="background: none; border: none; font-size: 1.5rem; font-weight: 800; color: #FF6097; cursor: pointer; padding: 0 0.3rem; line-height: 1;">−</button>
              <span style="font-size: 1.3rem; font-weight: 800; padding: 0 0.5rem; color: #3D2355;">${qty}</span>
              <button type="button" onclick="meeekuDrawerUpdateQty(${index}, 1)" style="background: none; border: none; font-size: 1.5rem; font-weight: 800; color: #FF6097; cursor: pointer; padding: 0 0.3rem; line-height: 1;">+</button>
            </div>
          </div>
        </div>
        <button type="button" style="background: transparent; border: none; font-size: 1.8rem; cursor: pointer; color: #BBB; padding: 0.4rem; line-height: 1;" onclick="removeMeeekuCartItem(${index})" title="Remove item">
          ✕
        </button>
      </div>
    `;
  });

  saveMeeekuCart(cart);
  container.innerHTML = itemsHtml;
  if (subtotalEl) {
    subtotalEl.innerText = '₹' + totalPaise.toLocaleString('en-IN') + '.00';
  }
}

function meeekuDrawerChangeSize(index, newSize) {
  const cart = getMeeekuCart();
  if (cart[index]) {
    cart[index].size = newSize;
    saveMeeekuCart(cart);
    renderMeeekuCartDrawer();
  }
}

function meeekuDrawerUpdateQty(index, delta) {
  let cart = getMeeekuCart();
  if (cart[index]) {
    let currentQty = cart[index].qty || cart[index].quantity || 1;
    currentQty += delta;
    if (currentQty <= 0) {
      cart.splice(index, 1);
    } else {
      cart[index].qty = currentQty;
      cart[index].quantity = currentQty;
    }
    saveMeeekuCart(cart);
    renderMeeekuCartDrawer();
  }
}

function openMeeekuCart() {
  renderMeeekuCartDrawer();
  const drawer = document.getElementById('MeeekuCartDrawerElement');
  if (drawer) {
    drawer.classList.add('active');
  }
}

function closeMeeekuCart() {
  const drawer = document.getElementById('MeeekuCartDrawerElement');
  if (drawer) {
    drawer.classList.remove('active');
  }
}

function meeekuAddToCartCatalog(title, price, imgUrl, customSize) {
  let cart = getMeeekuCart();
  let titleLower = (title || '').toLowerCase();
  let isCoord = titleLower.includes('co-ord') || titleLower.includes('set') || titleLower.includes('lounge') || titleLower.includes('peplum') || titleLower.includes('eyelet') || titleLower.includes('stardust') || titleLower.includes('kitty') || titleLower.includes('meadow') || titleLower.includes('storybook');
  let isTee = titleLower.includes('tee') || titleLower.includes('t-shirt');

  let finalPrice = price;
  if (isCoord) {
    finalPrice = '₹1,299.00';
  }

  const size = customSize || (isTee || isCoord ? '0 - 6M' : '2 - 3Y');
  const existingIndex = cart.findIndex(i => i.title === title && i.size === size);

  if (existingIndex > -1) {
    let q = cart[existingIndex].qty || cart[existingIndex].quantity || 1;
    cart[existingIndex].qty = q + 1;
    cart[existingIndex].quantity = q + 1;
    cart[existingIndex].price = finalPrice;
  } else {
    cart.push({
      id: 'item_' + Date.now() + '_' + Math.random().toString(36).substr(2, 4),
      title: title,
      price: finalPrice,
      img: imgUrl,
      size: size,
      qty: 1,
      quantity: 1
    });
  }

  saveMeeekuCart(cart);
  showMeeekuToast('🎉 Added ' + title + ' (' + size + ') to Bag!');
  openMeeekuCart();
}

function meeekuAddToCart(btn, title, price, imgUrl) {
  const selectedSizeEl = document.querySelector('.meeeku-size-option.active, .meeeku-size-btn.active');
  const size = selectedSizeEl ? selectedSizeEl.innerText.trim() : '0 - 6M';
  meeekuAddToCartCatalog(title, price, imgUrl, size);
}

function removeMeeekuCartItem(index) {
  let cart = getMeeekuCart();
  if (typeof index === 'number') {
    cart.splice(index, 1);
  } else {
    cart = cart.filter(i => i.id !== index);
  }
  saveMeeekuCart(cart);
  renderMeeekuCartDrawer();
}

function showMeeekuToast(msg) {
  const toast = document.getElementById('MeeekuCartToast');
  if (toast) {
    toast.innerText = msg;
    toast.classList.add('show');
    setTimeout(() => {
      toast.classList.remove('show');
    }, 2800);
  }
}

// Global hook: Open drawer when clicking header cart bubble
document.addEventListener('DOMContentLoaded', function() {
  renderMeeekuCartDrawer();
  
  const cartIcon = document.getElementById('cart-icon-bubble');
  if (cartIcon) {
    cartIcon.addEventListener('click', function(e) {
      e.preventDefault();
      openMeeekuCart();
    });
  }
});
</script>

<style>
/* Cart Drawer Styles */
.drawer {
  position: fixed;
  z-index: 100000 !important;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  display: flex;
  justify-content: flex-end;
  background-color: rgba(61, 35, 85, 0.4);
  backdrop-filter: blur(4px);
  transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.drawer.active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.drawer .drawer__inner {
  width: 440px;
  max-width: 100vw;
  height: 100%;
  background: #FFFDF7;
  box-shadow: -8px 0 30px rgba(107, 63, 160, 0.2);
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  overflow-y: auto;
}

.drawer.active .drawer__inner {
  transform: translateX(0);
}

.cart-drawer__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

@media screen and (max-width: 749px) {
  .drawer .drawer__inner {
    width: 100% !important;
    max-width: 100vw !important;
  }
  .drawer__header {
    padding: 1.2rem 1.5rem !important;
  }
  .drawer__heading {
    font-size: 1.7rem !important;
  }
  .drawer__close {
    min-width: 44px !important;
    min-height: 44px !important;
    font-size: 2.2rem !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  .drawer__body {
    padding: 1.2rem !important;
    max-height: calc(100vh - 150px) !important;
    -webkit-overflow-scrolling: touch !important;
  }
  .meeeku-cart-item {
    gap: 1rem !important;
    padding: 1rem !important;
    border-radius: 16px !important;
  }
  .meeeku-cart-item img {
    width: 60px !important;
    height: 75px !important;
  }
}
</style>
