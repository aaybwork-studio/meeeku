async function meeekuAddToCartCatalog(title, price, imgUrl, variantId, size, handle) {
  var cleanSize = size || 'Standard';
  var numPrice = parseMeeekuPrice(price);
  var cleanPrice = '₹' + numPrice.toLocaleString('en-IN', {minimumFractionDigits: 2});

  // 1. Resolve numeric variant ID from product endpoint if needed
  var numericVariantId = (variantId && !isNaN(parseInt(variantId))) ? parseInt(variantId) : null;
  
  if (!numericVariantId && handle) {
    try {
      var prodRes = await fetch('/products/' + handle + '.js');
      if (prodRes.ok) {
        var prodJson = await prodRes.json();
        if (prodJson && prodJson.variants && prodJson.variants.length > 0) {
          var matched = prodJson.variants.find(function(v) {
            return (v.title || '').toLowerCase() === cleanSize.toLowerCase() || (v.option1 || '').toLowerCase() === cleanSize.toLowerCase();
          });
          numericVariantId = matched ? matched.id : prodJson.variants[0].id;
        }
      }
    } catch(e) {}
  }

  var itemKey = (numericVariantId || handle || title) + '_' + cleanSize;

  // 2. Post to Shopify server cart
  if (numericVariantId) {
    try {
      var addRes = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: numericVariantId, quantity: 1 })
      });
      if (addRes.ok) {
        var addedItem = await addRes.json();
        if (addedItem && addedItem.key) {
          itemKey = addedItem.key;
        }
      }
    } catch(e) {}
  }

  // 3. Add to local storage
  var cart = getMeeekuLocalCart();
  var existing = cart.find(function(i) { 
    return (i.title === title && i.size === cleanSize) || (String(i.key) === String(itemKey)) || (numericVariantId && String(i.id) === String(numericVariantId)); 
  });
  if (existing) {
    existing.qty = (existing.qty || existing.quantity || 1) + 1;
    existing.quantity = existing.qty;
    existing.price = cleanPrice;
    if (numericVariantId) existing.id = numericVariantId;
  } else {
    cart.push({
      key: itemKey,
      id: numericVariantId || ('item_' + Date.now()),
      handle: handle || '',
      title: title,
      price: cleanPrice,
      img: imgUrl,
      size: cleanSize,
      qty: 1,
      quantity: 1
    });
  }
  saveMeeekuLocalCart(cart);

  // 4. Update UI & open drawer with fresh cart
  fetchMeeekuShopifyCart();
  showMeeekuToast('🎉 Added ' + title + ' to Bag!');
  openMeeekuCart();
}

/**
 * Returns dynamic Shopify checkout URL including applied discount codes
 */
function getMeeekuCheckoutUrl() {
  var discount = sessionStorage.getItem('meeeku_active_discount') || localStorage.getItem('meeeku_active_discount');
  if (discount && discount.trim()) {
    var cleanCode = discount.trim();
    if (window.MEEEKU_PROMO_CONFIG && window.MEEEKU_PROMO_CONFIG.obsoleteCodes.indexOf(cleanCode.toUpperCase()) !== -1) {
      sessionStorage.removeItem('meeeku_active_discount');
      localStorage.removeItem('meeeku_active_discount');
      return '/checkout';
    }
    return '/discount/' + encodeURIComponent(cleanCode) + '?redirect=/checkout';
  }
  return '/checkout';
}

window.getMeeekuCheckoutUrl = getMeeekuCheckoutUrl;

window.meeekuApplyCartDiscount = function(code, cardEl) {
  if (!code) return;
  try {
    var cleanCode = String(code).trim();
    if (!cleanCode) return;

    if (window.MEEEKU_PROMO_CONFIG && window.MEEEKU_PROMO_CONFIG.obsoleteCodes.indexOf(cleanCode.toUpperCase()) !== -1) {
      var fallbackCode = (window.MEEEKU_PROMO_CONFIG.primaryPromo && window.MEEEKU_PROMO_CONFIG.primaryPromo.code) || 'Festive25';
      showMeeekuToast('⚠️ Promotion ' + cleanCode + ' has ended. Use active code ' + fallbackCode + '!');
      return;
    }

    var matchedPromo = window.MEEEKU_PROMO_CONFIG ? window.MEEEKU_PROMO_CONFIG.getPromoByCode(cleanCode) : null;
    var canonicalCode = matchedPromo ? matchedPromo.code : cleanCode;

    sessionStorage.setItem('meeeku_active_discount', canonicalCode);
    localStorage.setItem('meeeku_active_discount', canonicalCode);
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(canonicalCode);
    }

    // Prime the Shopify discount session cookie immediately and sync cart
    fetch('/discount/' + encodeURIComponent(canonicalCode), {
      credentials: 'same-origin'
    })
      .then(function() {
        return fetch('/cart.js', { cache: 'no-store' });
      })
      .then(function(res) {
        return res && res.ok ? res.json() : null;
      })
      .then(function(cart) {
        if (cart) {
          window.meeekuLiveShopifyCart = cart;
          if (window.MEEEKU_PROMO_CONFIG && typeof window.MEEEKU_PROMO_CONFIG.syncFromShopifyCartJson === 'function') {
            window.MEEEKU_PROMO_CONFIG.syncFromShopifyCartJson(cart);
          }
          renderMeeekuCartDrawerWithData(cart);
          if (typeof window.fetchMeeekuPageCart === 'function') {
            window.fetchMeeekuPageCart();
          }
        }
      })
      .catch(function(err) {
        if (window.MeeekuLogger) window.MeeekuLogger.error('ApplyCartDiscountFetch', err);
      });

    meeekuSyncDiscountUI();
    showMeeekuToast('🎉 Code ' + canonicalCode + ' applied! Discount active for checkout.');
  } catch (e) {
    if (window.MeeekuLogger) window.MeeekuLogger.error('ApplyCartDiscount', e);
  }
};

window.meeekuApplyCustomCodeInput = function(inputId) {
  try {
    var inputEl = document.getElementById(inputId);
    if (!inputEl) return;
    var val = (inputEl.value || '').trim();
    if (!val) {
      showMeeekuToast('⚠️ Please enter a promotional code first.');
      return;
    }
    if (window.MEEEKU_PROMO_CONFIG && window.MEEEKU_PROMO_CONFIG.obsoleteCodes.indexOf(val.toUpperCase()) !== -1) {
      var activeDefault = (window.MEEEKU_PROMO_CONFIG.primaryPromo && window.MEEEKU_PROMO_CONFIG.primaryPromo.code) || 'Festive25';
      showMeeekuToast('⚠️ Code ' + val.toUpperCase() + ' has expired. Try ' + activeDefault + '!');
      inputEl.value = '';
      return;
    }
    if (window.MEEEKU_PROMO_CONFIG && typeof window.MEEEKU_PROMO_CONFIG.registerDynamicPromo === 'function') {
      window.MEEEKU_PROMO_CONFIG.registerDynamicPromo({
        code: val,
        badge: 'SHOPIFY PROMO',
        cardBadge: 'PROMO',
        description: 'Applied Shopify discount code'
      });
    }
    inputEl.value = '';
    window.meeekuApplyCartDiscount(val);
  } catch (e) {
    if (window.MeeekuLogger) window.MeeekuLogger.error('ApplyCustomCodeInput', e);
  }
};

window.meeekuRemoveCartDiscount = function(e) {
  if (e) e.stopPropagation();
  sessionStorage.removeItem('meeeku_active_discount');
  localStorage.removeItem('meeeku_active_discount');
  meeekuSyncDiscountUI();
  showMeeekuToast('Discount code removed.');
};

window.meeekuSyncDiscountUI = function() {
  try {
    var rawCode = sessionStorage.getItem('meeeku_active_discount') || localStorage.getItem('meeeku_active_discount') || '';
    var code = rawCode.trim();

    if (code && window.MEEEKU_PROMO_CONFIG && window.MEEEKU_PROMO_CONFIG.obsoleteCodes.indexOf(code.toUpperCase()) !== -1) {
      sessionStorage.removeItem('meeeku_active_discount');
      localStorage.removeItem('meeeku_active_discount');
      code = '';
    }

    var upperActive = code.toUpperCase();
    var allCards = document.querySelectorAll('.meeeku-cart-discount-card[data-promo-code]');
    allCards.forEach(function(cardEl) {
      var cardCode = (cardEl.getAttribute('data-promo-code') || '').trim();
      var cardUpper = cardCode.toUpperCase();
      var btnEl = cardEl.querySelector('.meeeku-cart-discount-btn');
      if (upperActive && cardUpper === upperActive) {
        cardEl.classList.add('applied');
        if (btnEl) btnEl.innerText = 'Applied ✓';
      } else {
        cardEl.classList.remove('applied');
        if (btnEl) btnEl.innerText = 'Apply';
      }
    });

    var promoMeta = (code && window.MEEEKU_PROMO_CONFIG) ? window.MEEEKU_PROMO_CONFIG.getPromoByCode(code) : null;
    var displayCode = promoMeta ? promoMeta.code : code;
    var statusText = '';
    if (displayCode) {
      if (promoMeta && promoMeta.minOrder > 0) {
        var currentSub = window.meeekuLastDrawerSubtotal || window.meeekuLastPageSubtotal || 0;
        if (currentSub > 0 && currentSub < promoMeta.minOrder) {
          var needed = promoMeta.minOrder - currentSub;
          statusText = '🎉 Code <strong>' + displayCode + '</strong> saved! Add ₹' + needed.toLocaleString('en-IN') + ' more to unlock ' + (promoMeta.cardBadge || 'discount') + ' (Min. ₹' + promoMeta.minOrder.toLocaleString('en-IN') + ').';
        } else {
          statusText = '🎉 Code <strong>' + displayCode + '</strong> (' + (promoMeta.cardBadge || '25% OFF') + ') applied! Active for checkout.';
        }
      } else {
        statusText = '🎉 Code <strong>' + displayCode + '</strong> applied! Added at checkout.';
      }
    }

    var drawerAlert = document.getElementById('MeeekuDrawerDiscountAppliedAlert');
    var drawerMsg = document.getElementById('MeeekuDrawerDiscountAppliedMsg');
    if (drawerAlert && drawerMsg) {
      if (displayCode) {
        drawerAlert.style.display = 'flex';
        drawerMsg.innerHTML = statusText;
      } else {
        drawerAlert.style.display = 'none';
      }
    }

    var pageAlert = document.getElementById('MeeekuPageDiscountAppliedAlert');
    var pageMsg = document.getElementById('MeeekuPageDiscountAppliedMsg');
    if (pageAlert && pageMsg) {
      if (displayCode) {
        pageAlert.style.display = 'flex';
        pageMsg.innerHTML = statusText;
      } else {
        pageAlert.style.display = 'none';
      }
    }

    if (typeof window.meeekuLastDrawerSubtotal === 'number' && window.meeekuLastDrawerSubtotal > 0) {
      updateMeeekuShippingProgress(window.meeekuLastDrawerSubtotal, 'MeeekuDrawerShippingProgress', 'MeeekuDrawerShippingMsg', 'MeeekuDrawerShippingFill', 'MeeekuCartDeliveryFee', 'MeeekuCartTotal');
    }
    if (typeof window.updateMeeekuPageShippingProgress === 'function' && typeof window.meeekuLastPageSubtotal === 'number' && window.meeekuLastPageSubtotal > 0) {
      window.updateMeeekuPageShippingProgress(window.meeekuLastPageSubtotal);
    }
  } catch (err) {
    if (window.MeeekuLogger) window.MeeekuLogger.error('SyncDiscountUI', err);
  }
};

/**
 * Robust Checkout Engine:
 * Validates that server cart is in sync with local cart, prevents empty checkout errors,
 * and seamlessly handles Shopify checkout transitions with auto-applied discount codes.
 */
async function meeekuProceedToCheckout(btn) {
  var triggerBtn = btn || document.querySelector('.meeeku-btn-checkout') || document.getElementById('MeeekuDrawerCheckoutBtn');
  if (triggerBtn) {
    triggerBtn.setAttribute('disabled', 'true');
    triggerBtn.innerText = '⏳ Opening Checkout...';
  }

  try {
    var discount = sessionStorage.getItem('meeeku_active_discount') || localStorage.getItem('meeeku_active_discount');
    if (discount && discount.trim()) {
      try {
        await fetch('/discount/' + encodeURIComponent(discount.trim().toUpperCase()), { credentials: 'same-origin' });
      } catch(e) {}
    }

    // 1. Fetch live Shopify server cart
    var res = await fetch('/cart.js', { cache: 'no-store' });
    var cart = res.ok ? await res.json() : null;
    var localCart = getMeeekuLocalCart();

    // 2. If server cart has items, proceed safely
    if (cart && cart.items && cart.items.length > 0) {
      window.location.href = getMeeekuCheckoutUrl();
      return;
    }

    // 3. If server cart is empty BUT localCart has items, sync items to server cart first!
    if (localCart && localCart.length > 0) {
      var itemsToAdd = [];
      for (var i = 0; i < localCart.length; i++) {
        var item = localCart[i];
        var vId = (item.id && !isNaN(parseInt(item.id))) ? parseInt(item.id) : null;
        
        // If no numeric variant ID, look up by handle or title
        if (!vId && (item.handle || item.title)) {
          var h = item.handle || (item.title || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
          try {
            var prodRes = await fetch('/products/' + h + '.js');
            if (prodRes.ok) {
              var prodJson = await prodRes.json();
              if (prodJson && prodJson.variants && prodJson.variants.length > 0) {
                var sizeStr = (item.size || '').toLowerCase();
                var matched = prodJson.variants.find(function(v) {
                  return (v.title || '').toLowerCase() === sizeStr || (v.option1 || '').toLowerCase() === sizeStr;
                });
                vId = matched ? matched.id : prodJson.variants[0].id;
              }
            }
          } catch(e) {}
        }

        if (vId) {
          itemsToAdd.push({
            id: vId,
            quantity: parseInt(item.qty || item.quantity) || 1
          });
        }
      }

      if (itemsToAdd.length > 0) {
        var addRes = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: itemsToAdd })
        });
        if (addRes.ok) {
          window.location.href = getMeeekuCheckoutUrl();
          return;
        }
      }
    }

    // 4. If cart is completely empty, alert the user and stay on the page
    if (triggerBtn) {
      triggerBtn.removeAttribute('disabled');
      triggerBtn.innerText = '⚡ Proceed to Checkout';
    }
    showMeeekuToast('⚠️ Your bag is empty. Please add items to proceed!');
  } catch(e) {
    if (triggerBtn) {
      triggerBtn.removeAttribute('disabled');
      triggerBtn.innerText = '⚡ Proceed to Checkout';
    }
    window.location.href = getMeeekuCheckoutUrl();
  }
}

window.meeekuGlobalProceedToCheckout = meeekuProceedToCheckout;

function showMeeekuToast(msg) {
  var toast = document.getElementById('MeeekuCartToast') || document.getElementById('MeeekuCartToastCatalog');
  if (toast) {
    toast.innerText = msg;
    toast.classList.add('show');
    setTimeout(function() {
      toast.classList.remove('show');
    }, 2800);
  }
}

// Global hooks & BFCache (pageshow) recovery when navigating back from checkout/payment
document.addEventListener('DOMContentLoaded', function() {
  fetchMeeekuShopifyCart();
  
  var cartIcon = document.getElementById('cart-icon-bubble');
  if (cartIcon) {
    cartIcon.addEventListener('click', function(e) {
      e.preventDefault();
      openMeeekuCart();
    });
  }
});

window.addEventListener('pageshow', function(event) {
  document.body.style.overflow = '';
  fetchMeeekuShopifyCart();

  // Reset any buttons that were set to loading
  document.querySelectorAll('.meeeku-btn-checkout, #MeeekuDrawerCheckoutBtn, #MeeekuBuyNowBtn, #MeeekuAddToCartBtn').forEach(function(btn) {
    btn.removeAttribute('disabled');
    if (btn.classList.contains('meeeku-btn-checkout') || btn.id === 'MeeekuDrawerCheckoutBtn') {
      btn.innerText = '⚡ Proceed to Checkout';
    }
  });
});
</script>

