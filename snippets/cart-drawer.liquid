{% comment %}
  Meeeku Cart Drawer Component
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay" onclick="this.closest('cart-drawer').close()"></div>
    <div
      class="drawer__inner gradient color-{{ settings.cart_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="Your Meeeku Cart"
      tabindex="-1"
    >
      <div class="meeeku-cart-drawer-content">
        <!-- Drawer Header -->
        <div class="drawer__header" style="display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 2rem; border-bottom: 2px solid #F8BBD0;">
          <h2 class="drawer__heading" style="margin: 0; font-size: 2rem; font-weight: 800; color: #3D2355;">Your Meeeku Cart 💕</h2>
          <button class="drawer__close" type="button" onclick="this.closest('cart-drawer').close()" aria-label="Close" style="background: transparent; border: none; font-size: 2rem; cursor: pointer; color: #3D2355;">
            ✕
          </button>
        </div>

        <!-- Drawer Body -->
        <div class="drawer__body" style="padding: 2rem; max-height: calc(100vh - 180px); overflow-y: auto;">
          
          {%- if cart == empty -%}
            <!-- Empty State -->
            <div id="MeeekuCartEmptyNotice" style="text-align: center; padding: 3rem 1rem;">
              <p style="font-size: 1.6rem; color: #6B3FA0; font-weight: 600; margin-bottom: 1.5rem;">Your Meeeku cart is currently empty.</p>
              <a href="{{ routes.all_products_collection_url }}" class="meeeku-btn-primary" style="display: inline-block; text-decoration: none;" onclick="document.querySelector('cart-drawer').close()">Explore Collections 👑</a>
            </div>
          {%- else -%}
            <!-- Dynamic Items Container -->
            <div id="MeeekuCartItemsContainer">
              {%- for item in cart.items -%}
                <div id="MeeekuCartItem-{{ item.index | plus: 1 }}" class="meeeku-cart-item" style="display: flex; gap: 1.5rem; align-items: center; background: #FFFDF7; border: 2px solid #F8BBD0; border-radius: 20px; padding: 1.2rem; margin-bottom: 1.5rem; box-shadow: 0 4px 14px rgba(107,63,160,0.06);">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 150 }}" alt="{{ item.title | escape }}" width="70" height="90" style="border-radius: 14px; object-fit: cover; width: 70px; height: 90px;">
                  {%- else -%}
                    <div style="width: 70px; height: 90px; background: #F8BBD0; border-radius: 14px;"></div>
                  {%- endif -%}
                  <div style="flex-grow: 1;">
                    <a href="{{ item.url }}" style="text-decoration: none;">
                      <h4 style="margin: 0 0 0.3rem; font-size: 1.5rem; font-weight: 700; color: #3D2355;">{{ item.product.title | escape }}</h4>
                    </a>
                    {%- unless item.product.has_only_default_variant -%}
                      <div style="font-size: 1.2rem; color: #666; margin-bottom: 0.4rem;">{{ item.variant.title }}</div>
                    {%- endunless -%}
                    <div style="font-size: 1.2rem; color: #666; margin-bottom: 0.4rem;">Qty: {{ item.quantity }}</div>
                    <div style="font-size: 1.6rem; font-weight: 800; color: #6B3FA0;">{{ item.final_line_price | money }}</div>
                  </div>
                  <cart-remove-button id="Remove-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                    <a href="{{ item.url_to_remove }}" class="button button--tertiary" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}" style="background: transparent; border: none; font-size: 1.8rem; cursor: pointer; color: #888; text-decoration: none;">✕</a>
                  </cart-remove-button>
                </div>
              {%- endfor -%}
            </div>

            <!-- Cart Subtotal & Checkout Summary -->
            <div id="MeeekuCartSummary" style="border-top: 2px dashed #F8BBD0; padding-top: 1.5rem; margin-top: 1.5rem;">
              <div style="display: flex; justify-content: space-between; font-size: 1.6rem; font-weight: 700; color: #3D2355; margin-bottom: 0.5rem;">
                <span>Subtotal:</span>
                <span id="MeeekuCartSubtotal">{{ cart.total_price | money }}</span>
              </div>
              <p style="font-size: 1.2rem; color: #888; margin-bottom: 1.5rem;">Taxes included & free shipping across India 🚚</p>
              <form action="{{ routes.cart_url }}" method="post" id="cart-drawer-form">
                <button type="submit" id="CartDrawer-Checkout" class="meeeku-btn-primary" name="checkout" style="display: block; text-align: center; text-decoration: none; width: 100%; font-size: 1.6rem; padding: 1.2rem; border: none; cursor: pointer;">
                  ⚡ Proceed to Secure Checkout
                </button>
              </form>
            </div>
          {%- endif -%}

        </div>
      </div>
    </div>
  </div>
</cart-drawer>

<style>
@media screen and (max-width: 749px) {
  .cart-drawer .drawer__inner {
    width: 100% !important;
    max-width: 100vw !important;
  }
  .drawer__header {
    padding: 1.2rem 1.5rem !important;
  }
  .drawer__heading {
    font-size: 1.7rem !important;
  }
  .drawer__close {
    min-width: 44px !important;
    min-height: 44px !important;
    font-size: 2.2rem !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  .drawer__body {
    padding: 1.2rem !important;
    max-height: calc(100vh - 150px) !important;
    -webkit-overflow-scrolling: touch !important;
  }
  .meeeku-cart-item {
    gap: 1rem !important;
    padding: 1rem !important;
    border-radius: 16px !important;
  }
  .meeeku-cart-item img {
    width: 60px !important;
    height: 75px !important;
  }
}
</style>
