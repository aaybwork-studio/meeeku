{% comment %}
  Meeeku Universal Slide-Out Cart Drawer Component
  Guarantees flawless real-time cart item addition, dynamic pricing subtotal calculation,
  in-cart size selection modification, item removal, dynamic ₹1000 free delivery progress bar,
  and persistent checkout across all pages!
{% endcomment %}

<!-- Meeeku Dedicated Slide-out Cart Drawer -->
<div id="MeeekuCartDrawerElement" class="meeeku-cart-drawer">
  <div class="meeeku-drawer-overlay" onclick="closeMeeekuCart()"></div>
  <div class="meeeku-drawer-inner" role="dialog" aria-modal="true" aria-label="Your Meeeku Bag">
    
    <!-- Drawer Header -->
    <div class="meeeku-drawer-header">
      <div style="display: flex; align-items: center; gap: 0.8rem;">
        <span style="font-size: 2.2rem;">🛍️</span>
        <h2 style="margin: 0; font-size: 2rem; font-weight: 800; color: #3D2355;">Your Meeeku Bag</h2>
      </div>
      <button type="button" class="meeeku-drawer-close" onclick="closeMeeekuCart()" aria-label="Close Bag">
        ✕
      </button>
    </div>

    <!-- Drawer Body -->
    <div class="meeeku-drawer-body">
      
      <!-- Free Delivery Progress Bar (Threshold: ₹1,000) -->
      <div id="MeeekuDrawerShippingProgress" style="display: none; background: #FFF5F8; border: 1.5px solid #F8BBD0; border-radius: 16px; padding: 1rem 1.2rem; margin: 0;">
        <div id="MeeekuDrawerShippingMsg" style="font-size: 1.25rem; font-weight: 700; color: #3D2355; margin-bottom: 0.8rem; text-align: center; line-height: 1.4;">
          Add ₹1,000.00 more to unlock FREE Express Delivery! 🚚
        </div>
        <div style="width: 100%; height: 10px; background: #FFE0EC; border-radius: 10px; overflow: hidden; position: relative;">
          <div id="MeeekuDrawerShippingFill" style="width: 0%; height: 100%; background: linear-gradient(90deg, #FF6097, #6B3FA0); border-radius: 10px; transition: width 0.4s ease, background 0.4s ease;"></div>
        </div>
      </div>

      {% liquid
        assign cp1_enabled = settings.promo_1_enabled
        if cp1_enabled == nil
          assign cp1_enabled = true
        endif
        assign cp1_code = settings.promo_1_code | default: 'Festive25' | strip
        assign cp1_card_badge = settings.promo_1_card_badge | default: '25% OFF' | strip
        assign cp1_desc = settings.promo_1_description | default: '25% off entire order • Minimum purchase of ₹1,000.00' | strip

        assign cp2_enabled = settings.promo_2_enabled | default: false
        assign cp2_code = settings.promo_2_code | default: '' | strip
        assign cp2_card_badge = settings.promo_2_card_badge | default: settings.promo_2_badge | default: 'OFFER' | strip
        assign cp2_desc = settings.promo_2_description | default: '' | strip

        assign cp3_enabled = settings.promo_3_enabled | default: false
        assign cp3_code = settings.promo_3_code | default: '' | strip
        assign cp3_card_badge = settings.promo_3_card_badge | default: settings.promo_3_badge | default: 'OFFER' | strip
        assign cp3_desc = settings.promo_3_description | default: '' | strip
      %}

      <!-- Empty State -->
      <div id="MeeekuCartEmptyNotice" style="text-align: center; padding: 4rem 1.5rem; display: block;">
        <div style="font-size: 4.5rem; margin-bottom: 1.2rem;">🌸</div>
        <p style="font-size: 1.8rem; color: #3D2355; font-weight: 800; margin-bottom: 0.8rem;">Your shopping bag is empty</p>
        <p style="font-size: 1.4rem; color: #666; margin-bottom: 1.6rem; max-width: 280px; margin-left: auto; margin-right: auto; line-height: 1.5;">
          Discover 100% skin-safe cotton tees, cozy co-ords, and festive twirling lehengas!
        </p>
        {% if cp1_enabled and cp1_code != blank %}
        <div style="background: #FFF3E0; border: 1.5px dashed #FFB74D; border-radius: 12px; padding: 0.9rem 1.2rem; margin-bottom: 2rem; max-width: 320px; margin-left: auto; margin-right: auto;">
          <span style="font-size: 1.25rem; color: #E65100; font-weight: 700;">✨ Special Offer: <strong>{{ cp1_desc }}</strong> with code <strong style="text-decoration: underline;">{{ cp1_code }}</strong>!</span>
        </div>
        {% endif %}
        <a href="/collections/all" class="meeeku-btn-primary" style="display: inline-block; text-decoration: none; padding: 1.1rem 2.5rem; font-size: 1.45rem; border-radius: 30px;" onclick="closeMeeekuCart()">
          Explore Collections ✨
        </a>
      </div>

      <!-- Dynamic Items Container -->
      <div id="MeeekuCartItemsContainer" style="display: none; flex-direction: column; gap: 1rem; margin: 0;"></div>

      <!-- Available Discounts Carousel & Reminder Box (Synced with Shopify Admin Promo Property) -->
      <div id="MeeekuDrawerDiscountsBox" class="meeeku-cart-discounts-box" style="display: none;">
        <div class="meeeku-cart-discounts-header">
          <div style="display: flex; align-items: center; gap: 0.6rem;">
            <span style="font-size: 1.6rem;">🏷️</span>
            <span class="meeeku-cart-discounts-title">Available Discounts</span>
          </div>
          <span class="meeeku-cart-discounts-sub">Tap to apply at checkout</span>
        </div>

        <div class="meeeku-cart-discounts-carousel" id="MeeekuDrawerDiscountsCarousel">
          {% if cp1_enabled and cp1_code != blank %}
          <div class="meeeku-cart-discount-card" id="MeeekuCard-{{ cp1_code | upcase }}" data-promo-code="{{ cp1_code | escape }}" onclick="meeekuApplyCartDiscount('{{ cp1_code | escape }}', this)">
            <div class="meeeku-cart-discount-badge" style="background: #FFE082; color: #E65100;">{{ cp1_card_badge }}</div>
            <div class="meeeku-cart-discount-info">
              <div class="meeeku-cart-discount-code">{{ cp1_code }}</div>
              <div class="meeeku-cart-discount-text">{{ cp1_desc }}</div>
            </div>
            <button type="button" class="meeeku-cart-discount-btn" id="MeeekuBtn-{{ cp1_code | upcase }}">Apply</button>
          </div>
          {% endif %}

          {% if cp2_enabled and cp2_code != blank %}
          <div class="meeeku-cart-discount-card" id="MeeekuCard-{{ cp2_code | upcase }}" data-promo-code="{{ cp2_code | escape }}" onclick="meeekuApplyCartDiscount('{{ cp2_code | escape }}', this)">
            <div class="meeeku-cart-discount-badge" style="background: #FFE082; color: #E65100;">{{ cp2_card_badge }}</div>
            <div class="meeeku-cart-discount-info">
              <div class="meeeku-cart-discount-code">{{ cp2_code }}</div>
              <div class="meeeku-cart-discount-text">{{ cp2_desc }}</div>
            </div>
            <button type="button" class="meeeku-cart-discount-btn" id="MeeekuBtn-{{ cp2_code | upcase }}">Apply</button>
          </div>
          {% endif %}

          {% if cp3_enabled and cp3_code != blank %}
          <div class="meeeku-cart-discount-card" id="MeeekuCard-{{ cp3_code | upcase }}" data-promo-code="{{ cp3_code | escape }}" onclick="meeekuApplyCartDiscount('{{ cp3_code | escape }}', this)">
            <div class="meeeku-cart-discount-badge" style="background: #FFE082; color: #E65100;">{{ cp3_card_badge }}</div>
            <div class="meeeku-cart-discount-info">
              <div class="meeeku-cart-discount-code">{{ cp3_code }}</div>
              <div class="meeeku-cart-discount-text">{{ cp3_desc }}</div>
            </div>
            <button type="button" class="meeeku-cart-discount-btn" id="MeeekuBtn-{{ cp3_code | upcase }}">Apply</button>
          </div>
          {% endif %}
        </div>

        <!-- Custom Shopify Discount Code Input -->
        <div class="meeeku-custom-discount-row" style="display: flex; gap: 0.6rem; margin-top: 0.85rem;">
          <input type="text" id="MeeekuDrawerCustomCodeInput" placeholder="Enter promo code (e.g. {{ cp1_code }})..." style="flex: 1; border: 1.5px solid #F8BBD0; border-radius: 10px; padding: 0.65rem 1rem; font-size: 1.25rem; color: #3D2355; background: #FFF; outline: none; font-family: inherit;" onkeydown="if(event.key==='Enter'){event.preventDefault();meeekuApplyCustomCodeInput('MeeekuDrawerCustomCodeInput');}">
          <button type="button" onclick="meeekuApplyCustomCodeInput('MeeekuDrawerCustomCodeInput')" style="background: #6B3FA0; color: #FFF; border: none; border-radius: 10px; padding: 0.65rem 1.3rem; font-size: 1.2rem; font-weight: 700; cursor: pointer; white-space: nowrap;">Apply Code</button>
        </div>

        <div id="MeeekuDrawerDiscountAppliedAlert" class="meeeku-discount-applied-alert" style="display: none;">
          <span id="MeeekuDrawerDiscountAppliedMsg">🎉 Code <strong>{{ cp1_code }}</strong> applied!</span>
          <button type="button" class="meeeku-discount-remove-btn" onclick="meeekuRemoveCartDiscount(event)">Remove</button>
        </div>
      </div>

      <!-- Cart Subtotal & Checkout Summary -->
      <div id="MeeekuCartSummary" style="display: none; border-top: 1.5px dashed #F8BBD0; padding-top: 1.2rem; margin-top: 0.4rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 1.45rem; color: #666; margin-bottom: 0.5rem;">
          <span>Bag Subtotal:</span>
          <span id="MeeekuCartSubtotal" style="color: #3D2355; font-weight: 700; font-size: 1.55rem;">₹0.00</span>
        </div>
        <div id="MeeekuDrawerDiscountRow" style="display: none; justify-content: space-between; align-items: center; font-size: 1.4rem; margin-bottom: 0.5rem; background: #E8F5E9; padding: 0.4rem 0.8rem; border-radius: 10px; border: 1px dashed #81C784;">
          <span id="MeeekuDrawerDiscountRowLabel" style="color: #1B5E20; font-weight: 700;">🏷️ Promo Discount ({{ cp1_code }}):</span>
          <span id="MeeekuDrawerDiscountRowVal" style="font-weight: 800; font-size: 1.4rem; color: #2E7D32;">-₹0.00</span>
        </div>
        <div id="MeeekuDrawerGiftRow" style="display: none; justify-content: space-between; align-items: center; font-size: 1.45rem; margin-bottom: 0.5rem; background: #F3E5F5; padding: 0.4rem 0.8rem; border-radius: 10px; border: 1px dashed #CE93D8;">
          <span style="color: #6A1B9A; font-weight: 700;">🎁 Surprise Gift (Little Ones):</span>
          <span style="font-weight: 800; font-size: 1.35rem; color: #2E7D32;">FREE ✨</span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 1.45rem; margin-bottom: 0.8rem;">
          <span>Delivery Charge:</span>
          <span id="MeeekuCartDeliveryFee" style="font-weight: 700; font-size: 1.45rem; color: #2E7D32;">FREE</span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 1.85rem; font-weight: 800; color: #3D2355; margin-bottom: 1.2rem; border-top: 1px solid #FFE0EC; padding-top: 0.8rem;">
          <span>Estimated Total:</span>
          <span id="MeeekuCartTotal" style="color: #6B3FA0; font-size: 2.1rem;">₹0.00</span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.9rem;">
          <a href="/cart" class="button button--secondary" style="width: 100%; border-radius: 25px; padding: 1.1rem; font-size: 1.45rem; font-weight: 700; color: #6B3FA0; border: 2px solid #F8BBD0; background: #FFF; text-align: center; text-decoration: none;">
            View Full Cart & Edit Sizes 📝
          </a>
          <button type="button" id="MeeekuDrawerCheckoutBtn" class="meeeku-btn-primary meeeku-btn-checkout" onclick="meeekuProceedToCheckout(this)" style="display: block; text-align: center; width: 100%; font-size: 1.65rem; padding: 1.25rem; border-radius: 30px; box-shadow: 0 6px 20px rgba(255, 96, 151, 0.4); border: none; cursor: pointer; color: #FFF; background: linear-gradient(135deg, #FF6097, #E91E63);">
            ⚡ Proceed to Checkout
          </button>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Global Toast Notification -->
<div id="MeeekuCartToast" class="meeeku-cart-toast">
  🎉 Added to your Meeeku Cart!
</div>

<script>
function formatMeeekuPaise(paise) {
  var rupees = Math.round(paise / 100);
  return '₹' + rupees.toLocaleString('en-IN') + '.00';
}

function parseMeeekuPrice(priceStr) {
  if (typeof priceStr === 'number') return priceStr;
  var num = parseFloat(String(priceStr || '0').replace(/[^0-9.]/g, ''));
  return isNaN(num) ? 0 : num;
}

function getMeeekuLocalCart() {
  try {
    return JSON.parse(localStorage.getItem('meeeku_active_cart') || localStorage.getItem('meeeku_user_cart') || localStorage.getItem('meeeku_cart') || '[]');
  } catch (e) {
    return [];
  }
}

function saveMeeekuLocalCart(cartArray) {
  try {
    var data = JSON.stringify(cartArray || []);
    localStorage.setItem('meeeku_active_cart', data);
    localStorage.setItem('meeeku_user_cart', data);
    localStorage.setItem('meeeku_cart', data);
  } catch (e) {}
}

function updateCartBadges(count) {
  var c = parseInt(count) || 0;
  var countBubbles = document.querySelectorAll('.cart-count-bubble span');
  countBubbles.forEach(function(b) { b.textContent = c; });
  var dot = document.getElementById('MeeekuCartDot');
  if (dot) {
    if (c > 0) dot.classList.add('has-items');
    else dot.classList.remove('has-items');
  }
}

function calculateMeeekuPromoSavings(subtotalRupees) {
  var subtotal = parseFloat(subtotalRupees) || 0;
  var rawCode = sessionStorage.getItem('meeeku_active_discount') || localStorage.getItem('meeeku_active_discount') || '';
  var code = rawCode.trim();
  if (!code) return { code: '', discountAmount: 0, qualifies: false, minOrder: 0, percent: 0 };

  if (window.MEEEKU_PROMO_CONFIG && window.MEEEKU_PROMO_CONFIG.obsoleteCodes.indexOf(code.toUpperCase()) !== -1) {
    sessionStorage.removeItem('meeeku_active_discount');
    localStorage.removeItem('meeeku_active_discount');
    return { code: '', discountAmount: 0, qualifies: false, minOrder: 0, percent: 0 };
  }

  var promo = (window.MEEEKU_PROMO_CONFIG && window.MEEEKU_PROMO_CONFIG.getPromoByCode(code)) || null;
  var minOrder = promo ? (parseFloat(promo.minOrder) || 0) : 0;
  var percent = promo ? (parseFloat(promo.percent) || 0) : 0;

  if (minOrder > 0 && subtotal < minOrder) {
    return {
      code: promo ? promo.code : code,
      discountAmount: 0,
      qualifies: false,
      minOrder: minOrder,
      percent: percent,
      diff: minOrder - subtotal
    };
  }

  var discountAmount = 0;
  if (percent > 0 && subtotal > 0) {
    discountAmount = Math.round(subtotal * (percent / 100));
  } else if (window.meeekuLiveShopifyCart && window.meeekuLiveShopifyCart.total_discount > 0) {
    discountAmount = Math.round(window.meeekuLiveShopifyCart.total_discount / 100);
  }

  return {
    code: promo ? promo.code : code,
    discountAmount: discountAmount,
    qualifies: true,
    minOrder: minOrder,
    percent: percent,
    diff: 0
  };
}

window.calculateMeeekuPromoSavings = calculateMeeekuPromoSavings;

function updateMeeekuShippingProgress(subtotalRupees, progressBoxId, msgId, fillId, deliveryElId, totalElId) {
  var box = document.getElementById(progressBoxId || 'MeeekuDrawerShippingProgress');
  var msg = document.getElementById(msgId || 'MeeekuDrawerShippingMsg');
  var fill = document.getElementById(fillId || 'MeeekuDrawerShippingFill');
  var deliveryEl = document.getElementById(deliveryElId || 'MeeekuCartDeliveryFee');
  var totalEl = document.getElementById(totalElId || 'MeeekuCartTotal');

  var subtotal = parseFloat(subtotalRupees) || 0;
  window.meeekuLastDrawerSubtotal = subtotal;

  if (!box || !msg || !fill) return;

  if (subtotal <= 0) {
    box.style.display = 'none';
    var emptyDiscRow = document.getElementById('MeeekuDrawerDiscountRow');
    if (emptyDiscRow) emptyDiscRow.style.display = 'none';
    return;
  }

  box.style.display = 'block';
  var threshold = 1000;
  var deliveryFee = 0;

  if (subtotal < threshold) {
    deliveryFee = 100;
    var diff = threshold - subtotal;
    var pct = Math.min(100, Math.max(8, (subtotal / threshold) * 100));
    msg.innerHTML = 'Add <strong style="color: #FF6097;">₹' + diff.toLocaleString('en-IN', {minimumFractionDigits: 2}) + '</strong> more for <span style="color: #2E7D32; font-weight: 800;">FREE Delivery + FREE Gift!</span> 🎁🚚';
    fill.style.width = pct + '%';
    fill.style.background = 'linear-gradient(90deg, #FF6097, #6B3FA0)';
    if (deliveryEl) {
      deliveryEl.innerText = '₹100.00';
      deliveryEl.style.color = '#E65100';
    }
    var giftRow = document.getElementById('MeeekuDrawerGiftRow');
    if (giftRow) giftRow.style.display = 'none';
  } else {
    deliveryFee = 0;
    msg.innerHTML = '🎉 <strong style="color: #2E7D32;">Unlocked FREE Express Delivery + FREE Surprise Gift Inside! 🎁</strong>';
    fill.style.width = '100%';
    fill.style.background = 'linear-gradient(90deg, #4CAF50, #2E7D32)';
    if (deliveryEl) {
      deliveryEl.innerText = 'FREE (₹0.00)';
      deliveryEl.style.color = '#2E7D32';
    }
    var giftRow = document.getElementById('MeeekuDrawerGiftRow');
    if (giftRow) giftRow.style.display = 'flex';
  }

  var savingsInfo = calculateMeeekuPromoSavings(subtotal);
  var discRow = document.getElementById('MeeekuDrawerDiscountRow');
  var discLabel = document.getElementById('MeeekuDrawerDiscountRowLabel');
  var discVal = document.getElementById('MeeekuDrawerDiscountRowVal');

  if (discRow && discLabel && discVal) {
    if (savingsInfo.code && savingsInfo.qualifies && savingsInfo.discountAmount > 0) {
      discRow.style.display = 'flex';
      discLabel.innerText = '🏷️ Promo (' + savingsInfo.code + (savingsInfo.percent ? ' • ' + savingsInfo.percent + '% OFF' : '') + '):';
      discVal.innerText = '-₹' + savingsInfo.discountAmount.toLocaleString('en-IN', {minimumFractionDigits: 2});
    } else {
      discRow.style.display = 'none';
    }
  }

  if (totalEl) {
    var finalTotal = Math.max(0, subtotal - (savingsInfo.discountAmount || 0)) + deliveryFee;
    totalEl.innerText = '₹' + finalTotal.toLocaleString('en-IN', {minimumFractionDigits: 2});
  }
}

function fetchMeeekuShopifyCart(callback) {
  fetch('/cart.js', { cache: 'no-store' })
    .then(function(res) {
      if (!res.ok) throw new Error('Cart fetch status: ' + res.status);
      return res.json();
    })
    .then(function(cart) {
      window.meeekuLiveShopifyCart = cart;
      if (window.MEEEKU_PROMO_CONFIG && typeof window.MEEEKU_PROMO_CONFIG.syncFromShopifyCartJson === 'function') {
        window.MEEEKU_PROMO_CONFIG.syncFromShopifyCartJson(cart);
      }
      renderMeeekuCartDrawerWithData(cart);
      if (typeof callback === 'function') callback(cart);
    })
    .catch(function(err) {
      if (window.MeeekuLogger) window.MeeekuLogger.error('FetchShopifyCart', err);
      renderMeeekuCartDrawerWithLocalFallback();
      if (typeof callback === 'function') callback(null);
    });
}

function renderMeeekuCartDrawerWithLocalFallback() {
  var localCart = getMeeekuLocalCart();
  var totalCount = localCart.reduce(function(sum, i) { return sum + (parseInt(i.quantity || i.qty) || 1); }, 0);
  updateCartBadges(totalCount);

  var emptyNotice = document.getElementById('MeeekuCartEmptyNotice');
  var container = document.getElementById('MeeekuCartItemsContainer');
  var summary = document.getElementById('MeeekuCartSummary');
  var subtotalEl = document.getElementById('MeeekuCartSubtotal');
  var cartDot = document.getElementById('MeeekuCartDot');
  var progressBox = document.getElementById('MeeekuDrawerShippingProgress');
  var discBox = document.getElementById('MeeekuDrawerDiscountsBox');

  if (!container || !emptyNotice || !summary) return;

  if (localCart.length === 0) {
    emptyNotice.style.display = 'block';
    container.style.display = 'none';
    summary.style.display = 'none';
    if (discBox) discBox.style.display = 'none';
    if (progressBox) progressBox.style.display = 'none';
    if (cartDot) cartDot.classList.remove('has-items');
    return;
  }

  emptyNotice.style.display = 'none';
  container.style.display = 'flex';
  summary.style.display = 'block';
  if (discBox) discBox.style.display = 'block';
  if (cartDot) cartDot.classList.add('has-items');
  if (typeof meeekuSyncDiscountUI === 'function') meeekuSyncDiscountUI();

  var itemsHtml = '';
  var subtotal = 0;

  localCart.forEach(function(item, idx) {
    var key = item.key || item.id || ('local_' + idx);
    var qty = parseInt(item.quantity || item.qty) || 1;
    var unitNum = parseMeeekuPrice(item.price);
    var lineTotal = unitNum * qty;
    subtotal += lineTotal;

    var priceFmt = '₹' + unitNum.toLocaleString('en-IN', {minimumFractionDigits: 2});
    var imgSrc = item.img || item.image || 'https://raw.githubusercontent.com/aaybwork-studio/meeeku/main/assets/meeeku_prod_yellow_lehenga.jpg';
    var sizeLabel = item.size || 'Standard';

    itemsHtml += [
      '<div id="drawer-item-' + key + '" class="meeeku-cart-item" style="position: relative; display: flex; gap: 1.2rem; align-items: flex-start; background: #FFFDF7; border: 1.5px solid #F8BBD0; border-radius: 16px; padding: 1.1rem 1.2rem; box-shadow: 0 2px 8px rgba(107,63,160,0.04);">',
        '<img src="' + imgSrc + '" alt="' + (item.title || 'Meeeku Garment') + '" width="68" height="88" style="border-radius: 12px; object-fit: cover; width: 68px; height: 88px; border: 1.5px solid #FFE0EC; flex-shrink: 0;">',
        '<div style="flex-grow: 1; min-width: 0; padding-right: 2.2rem;">',
          '<h4 style="margin: 0 0 0.35rem; font-size: 1.4rem; font-weight: 700; color: #3D2355; line-height: 1.35; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="' + (item.title || 'Meeeku Garment') + '">',
            (item.title || 'Meeeku Garment'),
          '</h4>',
          '<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.6rem;">',
            '<span style="font-size: 1.15rem; color: #777; font-weight: 600;">Size:</span>',
            '<span style="border: 1px solid #F8BBD0; background: #FFF; color: #6B3FA0; font-weight: 700; font-size: 1.15rem; padding: 0.15rem 0.6rem; border-radius: 8px;">',
              sizeLabel,
            '</span>',
          '</div>',
          '<div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.3rem;">',
            '<div style="font-size: 1.55rem; font-weight: 800; color: #6B3FA0; letter-spacing: -0.01em;">' + priceFmt + '</div>',
            '<div style="display: flex; align-items: center; background: #FFF; border: 1.5px solid #F8BBD0; border-radius: 20px; padding: 0.15rem 0.5rem; box-shadow: 0 2px 6px rgba(107,63,160,0.05);">',
