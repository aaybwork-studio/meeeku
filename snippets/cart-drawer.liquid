{% comment %}
  Meeeku Universal Slide-Out Cart Drawer Component
  Guarantees flawless real-time cart item addition, dynamic pricing subtotal calculation,
  in-cart size selection modification, item removal, and persistent checkout across all pages!
{% endcomment %}

<!-- Meeeku Dedicated Slide-out Cart Drawer -->
<div id="MeeekuCartDrawerElement" class="meeeku-cart-drawer">
  <div class="meeeku-drawer-overlay" onclick="closeMeeekuCart()"></div>
  <div class="meeeku-drawer-inner" role="dialog" aria-modal="true" aria-label="Your Meeeku Bag">
    
    <!-- Drawer Header -->
    <div class="meeeku-drawer-header">
      <div style="display: flex; align-items: center; gap: 0.8rem;">
        <span style="font-size: 2.2rem;">🛍️</span>
        <h2 style="margin: 0; font-size: 2rem; font-weight: 800; color: #3D2355;">Your Meeeku Bag</h2>
      </div>
      <button type="button" class="meeeku-drawer-close" onclick="closeMeeekuCart()" aria-label="Close Bag">
        ✕
      </button>
    </div>

    <!-- Drawer Body -->
    <div class="meeeku-drawer-body">
      
      <!-- Free Delivery Progress Bar (Threshold: ₹1,000) -->
      <div id="MeeekuDrawerShippingProgress" style="display: none; background: #FFF5F8; border: 1.5px solid #F8BBD0; border-radius: 16px; padding: 1.2rem; margin-bottom: 1.4rem;">
        <div id="MeeekuDrawerShippingMsg" style="font-size: 1.25rem; font-weight: 700; color: #3D2355; margin-bottom: 0.8rem; text-align: center; line-height: 1.4;">
          Add ₹1,000.00 more to unlock FREE Express Delivery! 🚚
        </div>
        <div style="width: 100%; height: 10px; background: #FFE0EC; border-radius: 10px; overflow: hidden; position: relative;">
          <div id="MeeekuDrawerShippingFill" style="width: 0%; height: 100%; background: linear-gradient(90deg, #FF6097, #6B3FA0); border-radius: 10px; transition: width 0.4s ease, background 0.4s ease;"></div>
        </div>
      </div>

      <!-- Empty State -->
      <div id="MeeekuCartEmptyNotice" style="text-align: center; padding: 4rem 1.5rem; display: block;">
        <div style="font-size: 4.5rem; margin-bottom: 1.2rem;">🌸</div>
        <p style="font-size: 1.8rem; color: #3D2355; font-weight: 800; margin-bottom: 0.8rem;">Your shopping bag is empty</p>
        <p style="font-size: 1.4rem; color: #666; margin-bottom: 2.2rem; max-width: 280px; margin-left: auto; margin-right: auto; line-height: 1.5;">
          Discover 100% skin-safe cotton tees, cozy co-ords, and festive twirling lehengas!
        </p>
        <a href="/collections/all" class="meeeku-btn-primary" style="display: inline-block; text-decoration: none; padding: 1.1rem 2.5rem; font-size: 1.45rem; border-radius: 30px;" onclick="closeMeeekuCart()">
          Explore Collections ✨
        </a>
      </div>

      <!-- Dynamic Items Container -->
      <div id="MeeekuCartItemsContainer" style="display: none; flex-direction: column; gap: 1.2rem;"></div>

      <!-- Cart Subtotal & Checkout Summary -->
      <div id="MeeekuCartSummary" style="display: none; border-top: 2px dashed #F8BBD0; padding-top: 1.6rem; margin-top: 1.6rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 1.45rem; color: #666; margin-bottom: 0.5rem;">
          <span>Bag Subtotal:</span>
          <span id="MeeekuCartSubtotal" style="color: #3D2355; font-weight: 700; font-size: 1.55rem;">₹0.00</span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 1.45rem; margin-bottom: 0.8rem;">
          <span>Delivery Charge:</span>
          <span id="MeeekuCartDeliveryFee" style="font-weight: 700; font-size: 1.45rem; color: #2E7D32;">FREE</span>
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 1.85rem; font-weight: 800; color: #3D2355; margin-bottom: 1.2rem; border-top: 1px solid #FFE0EC; padding-top: 0.8rem;">
          <span>Estimated Total:</span>
          <span id="MeeekuCartTotal" style="color: #6B3FA0; font-size: 2.1rem;">₹0.00</span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.9rem;">
          <a href="/cart" class="button button--secondary" style="width: 100%; border-radius: 25px; padding: 1.1rem; font-size: 1.45rem; font-weight: 700; color: #6B3FA0; border: 2px solid #F8BBD0; background: #FFF; text-align: center; text-decoration: none;">
            View Full Cart & Edit Sizes 📝
          </a>
          <button type="button" id="MeeekuDrawerCheckoutBtn" class="meeeku-btn-primary meeeku-btn-checkout" onclick="meeekuProceedToCheckout(this)" style="display: block; text-align: center; width: 100%; font-size: 1.65rem; padding: 1.25rem; border-radius: 30px; box-shadow: 0 6px 20px rgba(255, 96, 151, 0.4); border: none; cursor: pointer; color: #FFF; background: linear-gradient(135deg, #FF6097, #E91E63);">
            ⚡ Proceed to Checkout
          </button>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Global Toast Notification -->
<div id="MeeekuCartToast" class="meeeku-cart-toast">
  🎉 Added to your Meeeku Cart!
</div>

<script>
function formatMeeekuPaise(paise) {
  var rupees = Math.round(paise / 100);
  return '₹' + rupees.toLocaleString('en-IN') + '.00';
}

function parseMeeekuPrice(priceStr) {
  if (typeof priceStr === 'number') return priceStr;
  var num = parseFloat(String(priceStr || '0').replace(/[^0-9.]/g, ''));
  return isNaN(num) ? 0 : num;
}

function getMeeekuLocalCart() {
  try {
    return JSON.parse(localStorage.getItem('meeeku_active_cart') || localStorage.getItem('meeeku_user_cart') || localStorage.getItem('meeeku_cart') || '[]');
  } catch (e) {
    return [];
  }
}

function saveMeeekuLocalCart(cartArray) {
  try {
    var data = JSON.stringify(cartArray || []);
    localStorage.setItem('meeeku_active_cart', data);
    localStorage.setItem('meeeku_user_cart', data);
    localStorage.setItem('meeeku_cart', data);
  } catch (e) {}
}

function updateCartBadges(count) {
  var c = parseInt(count) || 0;
  var countBubbles = document.querySelectorAll('.cart-count-bubble span');
  countBubbles.forEach(function(b) { b.textContent = c; });
  var dot = document.getElementById('MeeekuCartDot');
  if (dot) {
    if (c > 0) dot.classList.add('has-items');
    else dot.classList.remove('has-items');
  }
}

function fetchMeeekuShopifyCart(callback) {
  fetch('/cart.js', { cache: 'no-store' })
    .then(function(res) {
      if (!res.ok) throw new Error('Cart fetch status: ' + res.status);
      return res.json();
    })
    .then(function(cart) {
      window.meeekuLiveShopifyCart = cart;
      renderMeeekuCartDrawerWithData(cart);
      if (typeof callback === 'function') callback(cart);
    })
    .catch(function(err) {
      renderMeeekuCartDrawerWithLocalFallback();
      if (typeof callback === 'function') callback(null);
    });
}


function updateMeeekuShippingProgress(subtotalRupees, progressBoxId, msgId, fillId, deliveryElId, totalElId) {
  var box = document.getElementById(progressBoxId || 'MeeekuDrawerShippingProgress');
  var msg = document.getElementById(msgId || 'MeeekuDrawerShippingMsg');
  var fill = document.getElementById(fillId || 'MeeekuDrawerShippingFill');
  var deliveryEl = document.getElementById(deliveryElId || 'MeeekuCartDeliveryFee');
  var totalEl = document.getElementById(totalElId || 'MeeekuCartTotal');

  if (!box || !msg || !fill) return;

  var subtotal = parseFloat(subtotalRupees) || 0;
  if (subtotal <= 0) {
    box.style.display = 'none';
    return;
  }

  box.style.display = 'block';
  var threshold = 1000;
  var deliveryFee = 0;

  if (subtotal < threshold) {
    deliveryFee = 100;
    var diff = threshold - subtotal;
    var pct = Math.min(100, Math.max(8, (subtotal / threshold) * 100));
    msg.innerHTML = 'Add <strong style="color: #FF6097;">₹' + diff.toLocaleString('en-IN', {minimumFractionDigits: 2}) + '</strong> more for <span style="color: #2E7D32; font-weight: 800;">FREE Delivery!</span> 🚚';
    fill.style.width = pct + '%';
    fill.style.background = 'linear-gradient(90deg, #FF6097, #6B3FA0)';
    if (deliveryEl) {
      deliveryEl.innerText = '₹100.00';
      deliveryEl.style.color = '#E65100';
    }
  } else {
    deliveryFee = 0;
    msg.innerHTML = '🎉 <strong style="color: #2E7D32;">You\'ve unlocked FREE Express Delivery!</strong>';
    fill.style.width = '100%';
    fill.style.background = 'linear-gradient(90deg, #4CAF50, #2E7D32)';
    if (deliveryEl) {
      deliveryEl.innerText = 'FREE (₹0.00)';
      deliveryEl.style.color = '#2E7D32';
    }
  }

  if (totalEl) {
    var finalTotal = subtotal + deliveryFee;
    totalEl.innerText = '₹' + finalTotal.toLocaleString('en-IN', {minimumFractionDigits: 2});
  }
}

function renderMeeekuCartDrawerWithLocalFallback() {
  var localCart = getMeeekuLocalCart();
  var totalCount = localCart.reduce(function(sum, i) { return sum + (parseInt(i.quantity || i.qty) || 1); }, 0);
  updateCartBadges(totalCount);

  var emptyNotice = document.getElementById('MeeekuCartEmptyNotice');
  var container = document.getElementById('MeeekuCartItemsContainer');
  var summary = document.getElementById('MeeekuCartSummary');
  var subtotalEl = document.getElementById('MeeekuCartSubtotal');
  var cartDot = document.getElementById('MeeekuCartDot');

  if (!container || !emptyNotice || !summary) return;

  if (localCart.length === 0) {
    emptyNotice.style.display = 'block';
    container.style.display = 'none';
    summary.style.display = 'none';
    if (cartDot) cartDot.classList.remove('has-items');
    return;
  }

  emptyNotice.style.display = 'none';
  container.style.display = 'flex';
  summary.style.display = 'block';
  if (cartDot) cartDot.classList.add('has-items');

  var itemsHtml = '';
  var subtotal = 0;

  localCart.forEach(function(item, idx) {
    var key = item.key || item.id || ('local_' + idx);
    var qty = parseInt(item.quantity || item.qty) || 1;
    var unitNum = parseMeeekuPrice(item.price);
    var lineTotal = unitNum * qty;
    subtotal += lineTotal;

    var priceFmt = '₹' + unitNum.toLocaleString('en-IN', {minimumFractionDigits: 2});
    var imgSrc = item.img || item.image || 'https://raw.githubusercontent.com/aaybwork-studio/meeeku/main/assets/meeeku_prod_yellow_lehenga.jpg';
    var sizeLabel = item.size || 'Standard';

    itemsHtml += [
      '<div id="drawer-item-' + key + '" class="meeeku-cart-item" style="display: flex; gap: 1.2rem; align-items: center; background: #FFFDF7; border: 1.5px solid #F8BBD0; border-radius: 18px; padding: 1.2rem; box-shadow: 0 2px 10px rgba(107,63,160,0.04);">',
        '<img src="' + imgSrc + '" alt="' + (item.title || 'Meeeku Garment') + '" width="70" height="90" style="border-radius: 12px; object-fit: cover; width: 68px; height: 88px; border: 1.5px solid #FFE0EC; flex-shrink: 0;">',
        '<div style="flex-grow: 1; min-width: 0;">',
          '<h4 style="margin: 0 0 0.3rem; font-size: 1.45rem; font-weight: 700; color: #3D2355; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">',
            (item.title || 'Meeeku Garment'),
          '</h4>',
          '<div style="display: flex; align-items: center; gap: 0.5rem; margin: 0.3rem 0;">',
            '<span style="font-size: 1.15rem; color: #666; font-weight: 600;">Size:</span>',
            '<span style="border: 1px solid #F8BBD0; background: #FFF; color: #6B3FA0; font-weight: 700; font-size: 1.15rem; padding: 0.15rem 0.6rem; border-radius: 8px;">',
              sizeLabel,
            '</span>',
          '</div>',
          '<div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.4rem;">',
            '<div style="font-size: 1.55rem; font-weight: 800; color: #6B3FA0;">' + priceFmt + '</div>',
            '<div style="display: flex; align-items: center; background: #FFF; border: 1px solid #F8BBD0; border-radius: 20px; padding: 0.15rem 0.6rem;">',
              '<button type="button" onclick="meeekuDrawerUpdateQty('' + key + '', ' + (qty - 1) + ')" style="background: none; border: none; font-size: 1.5rem; font-weight: 800; color: #FF6097; cursor: pointer; padding: 0 0.3rem; line-height: 1;" title="Decrease quantity">−</button>',
              '<span style="font-size: 1.3rem; font-weight: 800; padding: 0 0.5rem; color: #3D2355;">' + qty + '</span>',
              '<button type="button" onclick="meeekuDrawerUpdateQty('' + key + '', ' + (qty + 1) + ')" style="background: none; border: none; font-size: 1.5rem; font-weight: 800; color: #FF6097; cursor: pointer; padding: 0 0.3rem; line-height: 1;" title="Increase quantity">+</button>',
            '</div>',
          '</div>',
        '</div>',
        '<button type="button" style="background: transparent; border: none; font-size: 1.8rem; cursor: pointer; color: #BBB; padding: 0.4rem; line-height: 1;" onclick="removeMeeekuCartItem('' + key + '')" title="Remove item">✕</button>',
      '</div>'
    ].join('');
  });

  container.innerHTML = itemsHtml;
  if (subtotalEl) {
    subtotalEl.innerText = '₹' + subtotal.toLocaleString('en-IN', {minimumFractionDigits: 2});
  }
  updateMeeekuShippingProgress(subtotal, 'MeeekuDrawerShippingProgress', 'MeeekuDrawerShippingMsg', 'MeeekuDrawerShippingFill', 'MeeekuCartDeliveryFee', 'MeeekuCartTotal');
}

function renderMeeekuCartDrawerWithData(cart) {
  var items = (cart && cart.items) ? cart.items : [];
  
  if (items.length === 0) {
    var local = getMeeekuLocalCart();
    if (local && local.length > 0) {
      renderMeeekuCartDrawerWithLocalFallback();
      return;
    }
  }

  var emptyNotice = document.getElementById('MeeekuCartEmptyNotice');
  var container = document.getElementById('MeeekuCartItemsContainer');
  var summary = document.getElementById('MeeekuCartSummary');
  var subtotalEl = document.getElementById('MeeekuCartSubtotal');
  var cartDot = document.getElementById('MeeekuCartDot');

  if (!container || !emptyNotice || !summary) return;

  if (items.length === 0) {
    emptyNotice.style.display = 'block';
    container.style.display = 'none';
    summary.style.display = 'none';
    if (cartDot) cartDot.classList.remove('has-items');
    updateCartBadges(0);
    saveMeeekuLocalCart([]);
    return;
  }

  updateCartBadges(cart.item_count || 0);

  // Sync server items to local storage
  var mirroredLocal = items.map(function(item) {
    return {
      key: item.key || item.id,
      id: item.variant_id || item.id,
      handle: item.handle || '',
      title: item.product_title || item.title,
      price: formatMeeekuPaise(item.final_price || item.price || 0),
      img: item.image || (item.featured_image ? item.featured_image.url : ''),
      size: item.variant_title || 'Standard',
      qty: item.quantity,
      quantity: item.quantity
    };
  });
  saveMeeekuLocalCart(mirroredLocal);

  emptyNotice.style.display = 'none';
  container.style.display = 'flex';
  summary.style.display = 'block';
  if (cartDot) cartDot.classList.add('has-items');

  var itemsHtml = '';

  items.forEach(function(item) {
    var itemKey = item.key || item.id;
    var unitPriceFormatted = formatMeeekuPaise(item.final_price || item.price || 0);
    var imgSrc = item.image || (item.featured_image ? item.featured_image.url : 'https://raw.githubusercontent.com/aaybwork-studio/meeeku/main/assets/meeeku_prod_yellow_lehenga.jpg');
    var variantTitle = item.variant_title ? item.variant_title : '';

    itemsHtml += [
      '<div id="drawer-item-' + item.id + '" class="meeeku-cart-item" style="display: flex; gap: 1.2rem; align-items: center; background: #FFFDF7; border: 1.5px solid #F8BBD0; border-radius: 18px; padding: 1.2rem; box-shadow: 0 2px 10px rgba(107,63,160,0.04);">',
        '<img src="' + imgSrc + '" alt="' + (item.product_title || item.title) + '" width="70" height="90" style="border-radius: 12px; object-fit: cover; width: 68px; height: 88px; border: 1.5px solid #FFE0EC; flex-shrink: 0;">',
        '<div style="flex-grow: 1; min-width: 0;">',
          '<h4 style="margin: 0 0 0.3rem; font-size: 1.45rem; font-weight: 700; color: #3D2355; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">',
            (item.product_title || item.title),
          '</h4>',
          (variantTitle ? [
            '<div style="display: flex; align-items: center; gap: 0.5rem; margin: 0.3rem 0;">',
              '<span style="font-size: 1.15rem; color: #666; font-weight: 600;">Size:</span>',
              '<span style="border: 1px solid #F8BBD0; background: #FFF; color: #6B3FA0; font-weight: 700; font-size: 1.15rem; padding: 0.15rem 0.6rem; border-radius: 8px;">',
                variantTitle,
              '</span>',
            '</div>'
          ].join('') : ''),
          '<div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.4rem;">',
            '<div style="font-size: 1.55rem; font-weight: 800; color: #6B3FA0;">' + unitPriceFormatted + '</div>',
            '<div style="display: flex; align-items: center; background: #FFF; border: 1px solid #F8BBD0; border-radius: 20px; padding: 0.15rem 0.6rem;">',
              '<button type="button" onclick="meeekuDrawerUpdateQty('' + itemKey + '', ' + (item.quantity - 1) + ')" style="background: none; border: none; font-size: 1.5rem; font-weight: 800; color: #FF6097; cursor: pointer; padding: 0 0.3rem; line-height: 1;" title="Decrease quantity">−</button>',
              '<span style="font-size: 1.3rem; font-weight: 800; padding: 0 0.5rem; color: #3D2355;">' + item.quantity + '</span>',
              '<button type="button" onclick="meeekuDrawerUpdateQty('' + itemKey + '', ' + (item.quantity + 1) + ')" style="background: none; border: none; font-size: 1.5rem; font-weight: 800; color: #FF6097; cursor: pointer; padding: 0 0.3rem; line-height: 1;" title="Increase quantity">+</button>',
            '</div>',
          '</div>',
        '</div>',
        '<button type="button" style="background: transparent; border: none; font-size: 1.8rem; cursor: pointer; color: #BBB; padding: 0.4rem; line-height: 1;" onclick="removeMeeekuCartItem('' + itemKey + '')" title="Remove item">✕</button>',
      '</div>'
    ].join('');
  });

  container.innerHTML = itemsHtml;
  var subtotalInRupees = Math.round((cart.total_price || 0) / 100);
  if (subtotalEl) {
    subtotalEl.innerText = formatMeeekuPaise(cart.total_price || 0);
  }
  updateMeeekuShippingProgress(subtotalInRupees, 'MeeekuDrawerShippingProgress', 'MeeekuDrawerShippingMsg', 'MeeekuDrawerShippingFill', 'MeeekuCartDeliveryFee', 'MeeekuCartTotal');
}

function meeekuDrawerUpdateQty(itemKey, newQty) {
  var q = parseInt(newQty) || 0;
  
  // 1. Update local storage first
  var localCart = getMeeekuLocalCart();
  var updatedLocal = [];
  localCart.forEach(function(item) {
    var key = item.key || item.id;
    if (String(key) === String(itemKey) || String(item.id) === String(itemKey)) {
      if (q > 0) {
        item.qty = q;
        item.quantity = q;
        updatedLocal.push(item);
      }
    } else {
      updatedLocal.push(item);
    }
  });
  saveMeeekuLocalCart(updatedLocal);
  renderMeeekuCartDrawerWithLocalFallback();

  // 2. Resolve server item key if available
  var serverId = itemKey;
  if (window.meeekuLiveShopifyCart && window.meeekuLiveShopifyCart.items) {
    var matchedItem = window.meeekuLiveShopifyCart.items.find(function(it) {
      return String(it.key) === String(itemKey) || String(it.id) === String(itemKey) || String(it.variant_id) === String(itemKey);
    });
    if (matchedItem) {
      serverId = matchedItem.key || matchedItem.id;
    }
  }

  fetch('/cart/change.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
    body: JSON.stringify({ id: String(serverId), quantity: q })
  })
  .then(function(res) {
    if (!res.ok) {
      return fetch('/cart.js', { cache: 'no-store' }).then(function(r) { return r.json(); });
    }
    return res.json();
  })
  .then(function(cart) {
    window.meeekuLiveShopifyCart = cart;
    renderMeeekuCartDrawerWithData(cart);
  })
  .catch(function() {
    renderMeeekuCartDrawerWithLocalFallback();
  });
}

function removeMeeekuCartItem(itemKey) {
  meeekuDrawerUpdateQty(itemKey, 0);
}

function openMeeekuCart() {
  fetchMeeekuShopifyCart(function() {
    var drawer = document.getElementById('MeeekuCartDrawerElement');
    if (drawer) {
      drawer.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  });
}

function closeMeeekuCart() {
  var drawer = document.getElementById('MeeekuCartDrawerElement');
  if (drawer) {
    drawer.classList.remove('active');
    document.body.style.overflow = '';
  }
}

async function meeekuAddToCartCatalog(title, price, imgUrl, variantId, size, handle) {
  var cleanSize = size || 'Standard';
  var numPrice = parseMeeekuPrice(price);
  var cleanPrice = '₹' + numPrice.toLocaleString('en-IN', {minimumFractionDigits: 2});

  // 1. Resolve numeric variant ID from product endpoint if needed
  var numericVariantId = (variantId && !isNaN(parseInt(variantId))) ? parseInt(variantId) : null;
  
  if (!numericVariantId && handle) {
    try {
      var prodRes = await fetch('/products/' + handle + '.js');
      if (prodRes.ok) {
        var prodJson = await prodRes.json();
        if (prodJson && prodJson.variants && prodJson.variants.length > 0) {
          var matched = prodJson.variants.find(function(v) {
            return (v.title || '').toLowerCase() === cleanSize.toLowerCase() || (v.option1 || '').toLowerCase() === cleanSize.toLowerCase();
          });
          numericVariantId = matched ? matched.id : prodJson.variants[0].id;
        }
      }
    } catch(e) {}
  }

  var itemKey = (numericVariantId || handle || title) + '_' + cleanSize;

  // 2. Post to Shopify server cart
  if (numericVariantId) {
    try {
      var addRes = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: numericVariantId, quantity: 1 })
      });
      if (addRes.ok) {
        var addedItem = await addRes.json();
        if (addedItem && addedItem.key) {
          itemKey = addedItem.key;
        }
      }
    } catch(e) {}
  }

  // 3. Add to local storage
  var cart = getMeeekuLocalCart();
  var existing = cart.find(function(i) { 
    return (i.title === title && i.size === cleanSize) || (String(i.key) === String(itemKey)) || (numericVariantId && String(i.id) === String(numericVariantId)); 
  });
  if (existing) {
    existing.qty = (existing.qty || existing.quantity || 1) + 1;
    existing.quantity = existing.qty;
    existing.price = cleanPrice;
    if (numericVariantId) existing.id = numericVariantId;
  } else {
    cart.push({
      key: itemKey,
      id: numericVariantId || ('item_' + Date.now()),
      handle: handle || '',
      title: title,
      price: cleanPrice,
      img: imgUrl,
      size: cleanSize,
      qty: 1,
      quantity: 1
    });
  }
  saveMeeekuLocalCart(cart);

  // 4. Update UI & open drawer with fresh cart
  fetchMeeekuShopifyCart();
  showMeeekuToast('🎉 Added ' + title + ' to Bag!');
  openMeeekuCart();
}

/**
 * Robust Checkout Engine:
 * Validates that server cart is in sync with local cart, prevents empty checkout errors,
 * and seamlessly handles Shopify checkout transitions.
 */
async function meeekuProceedToCheckout(btn) {
  var triggerBtn = btn || document.querySelector('.meeeku-btn-checkout') || document.getElementById('MeeekuDrawerCheckoutBtn');
  if (triggerBtn) {
    triggerBtn.setAttribute('disabled', 'true');
    triggerBtn.innerText = '⏳ Opening Checkout...';
  }

  try {
    // 1. Fetch live Shopify server cart
    var res = await fetch('/cart.js', { cache: 'no-store' });
    var cart = res.ok ? await res.json() : null;
    var localCart = getMeeekuLocalCart();

    // 2. If server cart has items, proceed safely
    if (cart && cart.items && cart.items.length > 0) {
      window.location.href = '/checkout';
      return;
    }

    // 3. If server cart is empty BUT localCart has items, sync items to server cart first!
    if (localCart && localCart.length > 0) {
      var itemsToAdd = [];
      for (var i = 0; i < localCart.length; i++) {
        var item = localCart[i];
        var vId = (item.id && !isNaN(parseInt(item.id))) ? parseInt(item.id) : null;
        
        // If no numeric variant ID, look up by handle or title
        if (!vId && (item.handle || item.title)) {
          var h = item.handle || (item.title || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
          try {
            var prodRes = await fetch('/products/' + h + '.js');
            if (prodRes.ok) {
              var prodJson = await prodRes.json();
              if (prodJson && prodJson.variants && prodJson.variants.length > 0) {
                var sizeStr = (item.size || '').toLowerCase();
                var matched = prodJson.variants.find(function(v) {
                  return (v.title || '').toLowerCase() === sizeStr || (v.option1 || '').toLowerCase() === sizeStr;
                });
                vId = matched ? matched.id : prodJson.variants[0].id;
              }
            }
          } catch(e) {}
        }

        if (vId) {
          itemsToAdd.push({
            id: vId,
            quantity: parseInt(item.qty || item.quantity) || 1
          });
        }
      }

      if (itemsToAdd.length > 0) {
        var addRes = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: itemsToAdd })
        });
        if (addRes.ok) {
          window.location.href = '/checkout';
          return;
        }
      }
    }

    // 4. If cart is completely empty, alert the user and stay on the page
    if (triggerBtn) {
      triggerBtn.removeAttribute('disabled');
      triggerBtn.innerText = '⚡ Proceed to Checkout';
    }
    showMeeekuToast('⚠️ Your bag is empty. Please add items to proceed!');
  } catch(e) {
    if (triggerBtn) {
      triggerBtn.removeAttribute('disabled');
      triggerBtn.innerText = '⚡ Proceed to Checkout';
    }
    window.location.href = '/checkout';
  }
}

window.meeekuGlobalProceedToCheckout = meeekuProceedToCheckout;

function showMeeekuToast(msg) {
  var toast = document.getElementById('MeeekuCartToast') || document.getElementById('MeeekuCartToastCatalog');
  if (toast) {
    toast.innerText = msg;
    toast.classList.add('show');
    setTimeout(function() {
      toast.classList.remove('show');
    }, 2800);
  }
}

// Global hooks & BFCache (pageshow) recovery when navigating back from checkout/payment
document.addEventListener('DOMContentLoaded', function() {
  fetchMeeekuShopifyCart();
  
  var cartIcon = document.getElementById('cart-icon-bubble');
  if (cartIcon) {
    cartIcon.addEventListener('click', function(e) {
      e.preventDefault();
      openMeeekuCart();
    });
  }
});

window.addEventListener('pageshow', function(event) {
  document.body.style.overflow = '';
  fetchMeeekuShopifyCart();

  // Reset any buttons that were set to loading
  document.querySelectorAll('.meeeku-btn-checkout, #MeeekuDrawerCheckoutBtn, #MeeekuBuyNowBtn, #MeeekuAddToCartBtn').forEach(function(btn) {
    btn.removeAttribute('disabled');
    if (btn.classList.contains('meeeku-btn-checkout') || btn.id === 'MeeekuDrawerCheckoutBtn') {
      btn.innerText = '⚡ Proceed to Checkout';
    }
  });
});
</script>

