{% comment %}
  Meeeku Kidswear Smooth Expandable Wash & Care Guide Snippet
{% endcomment %}

<div class="meeeku-accordion-item" id="PdpWashCareAcc" style="margin-top: 1.5rem; margin-bottom: 1.5rem;">
  <div class="meeeku-accordion-header" onclick="document.getElementById('PdpWashCareAcc').classList.toggle('active')">
    <span>🧺 Wash & Fabric Care Instructions</span>
    <span class="meeeku-accordion-icon">▼</span>
  </div>
  <div class="meeeku-accordion-content">
    <ul style="padding-left: 1.5rem; margin: 0; line-height: 1.7; font-size: 1.4rem; color: #555;">
      <li><strong>Gentle Machine Wash</strong> in cold water (30°C) with like colors.</li>
      <li>Use mild, hypoallergenic child-safe detergent without bleach.</li>
      <li>Iron inside out on low heat to protect delicate embroidery & silk prints.</li>
      <li>Dry in shade to preserve vibrant pastel colors.</li>
    </ul>
  </div>
</div>
